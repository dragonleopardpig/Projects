+function showMainWindow() {
+  if (!global.win || global.win.isDestroyed()) return;
+  if (global.win.isMinimized()) global.win.restore();
+  global.win.show();
+  global.win.focus();
+}
+
+function runControl(action) {
+  const controller = process.env.SCRAMBLE_CONTROL;
+  if (!controller || !fs.existsSync(controller)) return Promise.resolve();
+  return new Promise((resolve, reject) => {
+    execFile(controller, [action], (error) => error ? reject(error) : resolve());
+  });
+}
+
+function controlAction(action) {
+  void runControl(action).catch((error) => log.error('Scramble tray action failed:', error));
+}
