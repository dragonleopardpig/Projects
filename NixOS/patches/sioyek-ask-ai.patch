+        ai_chat_document ? ai_chat_document->get_checksum() : std::string(),
+        ai_chat_document ? QByteArray::fromStdString(ai_chat_document->get_document_password()) : QByteArray(),
+        page, excerpt, snapshot, anchor, choose_agent);
+}
