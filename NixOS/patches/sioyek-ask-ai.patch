+QString quoteMarkdown(const QString& text) {
+    QString quoted = QStringLiteral("> ");
+    for (const QChar c : text) {
+        if (c == u'\n') {
+            quoted += QStringLiteral("\n> ");
+        } else if (c != u'\r') {
+            if (QStringLiteral("\\`*_{}[]<>()#+-.!$|~").contains(c))
+                quoted += u'\\';
+            quoted += c;
+        }
+    }
+    return quoted;
+}
