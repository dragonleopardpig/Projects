+QString agentExecutable(Agent agent) {
+    switch (agent) {
+    case Codex: return QStringLiteral("codex");
+    case ClaudeCode: return QStringLiteral("claude");
+    case Antigravity: return QStringLiteral("agy");
+    default: return {};
+    }
+}
