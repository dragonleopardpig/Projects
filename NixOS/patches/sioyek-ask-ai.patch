+void AiPanel::setZoom(int percent) {
+    zoomPercent = std::clamp(percent, MinimumZoom, MaximumZoom);
+    zoomReset->setText(tr("%1%").arg(zoomPercent));
+    paneSettings().setValue(QStringLiteral("zoom"), zoomPercent);
+    rebuildTranscript();
+}
