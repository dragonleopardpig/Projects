+    else if (std::abs(pos.x - rect.x1) <= margin) edges |= 2;
+    if (std::abs(pos.y - rect.y0) <= margin) edges |= 4;
+    else if (std::abs(pos.y - rect.y1) <= margin) edges |= 8;
