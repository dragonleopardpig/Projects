         logger.debug("downloading from %s" % download_url)
+        # NixOS: a chromedriver downloaded from the internet has no dynamic
+        # loader here and will not execute. The one from the Nix store is
+        # already linked for this system, but is read-only, and patch_exe()
+        # rewrites the binary in place -- so hand back a writable copy.
+        nix_driver = os.environ.get("NIX_CHROMEDRIVER", "@NIX_CHROMEDRIVER@")
+        if nix_driver and os.path.exists(nix_driver):
+            fd, dst = tempfile.mkstemp(prefix="chromedriver-")
+            os.close(fd)
+            shutil.copy(nix_driver, dst)
+            os.chmod(dst, 0o755)
+            return dst
