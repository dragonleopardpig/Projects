+void surfaceBackupsDialog(QPointer<QmlDialogWrapper<BackupCandidatesComponent>> dialog)
+{
+    if (!dialog)
+    {
+        return;
+    }
+
+    dialog->show();
+    dialog->activateWindow();
+    dialog->raise();
+
+    if (auto backupsWindow = dynamic_cast<QmlDialog*>(dialog->windowHandle()))
