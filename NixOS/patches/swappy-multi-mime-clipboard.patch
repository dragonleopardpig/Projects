From a7ac080654edfca9648446f52d9c4f1bcd40675d Mon Sep 17 00:00:00 2001
From: dragonleopardpig <dragonleopardpig@gmail.com>
Date: Sun, 8 Nov 2026 14:21:04 +0800
Subject: [PATCH] feat(clipboard): offer every image type while swappy is open

Copy sets the GTK clipboard from swappy's own window with
gtk_clipboard_set_with_data() and GTK's image targets, so the image is
offered as image/png, image/bmp, image/tiff, image/jpeg, ... like Pinta
or GIMP do, and applications that need a format other than PNG (e.g.
Remmina) can paste it. The window has focus when the user copies, so
every compositor accepts the selection.

When swappy exits and still owns the clipboard, the image is handed to
wl-copy as PNG, as before, so it outlives swappy. If another application
took the clipboard in the meantime (the clear callback fires), nothing
is handed off. With early_exit=true, the clipboard is PNG only, as
before.

Fixes the regressions of the first version: no helper process, no
serial-0 selection rejected by wlroots, KDE or GNOME, no execlp of
whichever swappy is on PATH, and nothing left running.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01K8z2P5Z4RtBxMWi3qWQ1vE
---
 README.md           |  2 +-
 include/clipboard.h |  4 +++
 src/application.c   |  1 +
 src/clipboard.c     | 72 +++++++++++++++++++++++++++++++++++++++++----
 4 files changed, 72 insertions(+), 7 deletions(-)

diff --git a/README.md b/README.md
index f533728..956c1ad 100644
--- a/README.md
+++ b/README.md
@@ -139,7 +139,7 @@ Other compositors usually have an equivalent rule that matches on app id.
 
 ## Limitations
 
-- **Copy**: If you don't have [wl-clipboard] installed, copy to clipboard won't work if you close swappy (the content of the clipboard is lost). This because GTK 3.24 [has not implemented persistent storage on wayland backend yet](https://gitlab.gnome.org/GNOME/gtk/blob/3.24.13/gdk/wayland/gdkdisplay-wayland.c#L857). We need to do it on the [Wayland level](https://github.com/swaywm/wlr-protocols/blob/master/unstable/wlr-data-control-unstable-v1.xml), or wait for GTK 4. For now, we use `wl-copy` if installed and revert to `gtk` clipboard if not found.
+- **Copy**: While swappy is open, the copied image is offered in every image format GTK supports (`image/png`, `image/bmp`, `image/tiff`, ...), so applications that need a format other than PNG (e.g. Remmina) can paste it. When swappy exits, it hands the image to `wl-copy`, as PNG only. If you don't have [wl-clipboard] installed, the clipboard is lost when you close swappy. This is because GTK 3.24 [has not implemented persistent storage on wayland backend yet](https://gitlab.gnome.org/GNOME/gtk/blob/3.24.13/gdk/wayland/gdkdisplay-wayland.c#L857). We need to do it on the [Wayland level](https://github.com/swaywm/wlr-protocols/blob/master/unstable/wlr-data-control-unstable-v1.xml), or wait for GTK 4.
 - **Fonts**: Swappy relies on Font Awesome 5 being present to properly render the icons. On Arch you can simply install those with: `sudo pacman -S otf-font-awesome`
 - **Output Format**: Only PNG is supported.
 
diff --git a/include/clipboard.h b/include/clipboard.h
index a701ebb..d819216 100644
--- a/include/clipboard.h
+++ b/include/clipboard.h
@@ -3,3 +3,7 @@
 #include "swappy.h"
 
 bool clipboard_copy_drawing_area_to_selection(struct swappy_state *state);
+
+// Before swappy exits: if it still owns the clipboard, hand the image to
+// `wl-copy` so it outlives swappy.
+void clipboard_hand_off_selection(void);
diff --git a/src/application.c b/src/application.c
index 16cbdf4..dce01c9 100644
--- a/src/application.c
+++ b/src/application.c
@@ -72,6 +72,7 @@ static void update_ui_transparent_toggle_button(struct swappy_state *state) {
 
 void application_finish(struct swappy_state *state) {
   g_debug("application finishing, cleaning up");
+  clipboard_hand_off_selection();
   paint_free_all(state);
   pixbuf_free(state);
   cairo_surface_destroy(state->rendering_surface);
diff --git a/src/clipboard.c b/src/clipboard.c
index dd03dd9..1024fac 100644
--- a/src/clipboard.c
+++ b/src/clipboard.c
@@ -10,6 +10,10 @@
 #define gtk_clipboard_t GtkClipboard
 #define gdk_pixbuf_t GdkPixbuf
 
+// The image swappy holds on the clipboard while it owns it. Set back to NULL
+// when another application takes the clipboard (see on_clear).
+static gdk_pixbuf_t *owned_pixbuf = NULL;
+
 static gboolean send_pixbuf_to_wl_copy(gdk_pixbuf_t *pixbuf) {
   pid_t clipboard_process = 0;
   int pipefd[2];
@@ -66,18 +70,56 @@ static gboolean send_pixbuf_to_wl_copy(gdk_pixbuf_t *pixbuf) {
   return false;
 }
 
-static void send_pixbuf_to_gdk_clipboard(gdk_pixbuf_t *pixbuf) {
+static void on_get(gtk_clipboard_t *clipboard, GtkSelectionData *selection_data,
+                   guint info, gpointer data) {
+  gtk_selection_data_set_pixbuf(selection_data, GDK_PIXBUF(data));
+}
+
+static void on_clear(gtk_clipboard_t *clipboard, gpointer data) {
+  if (data == owned_pixbuf) {
+    owned_pixbuf = NULL;
+  }
+  g_object_unref(data);
+}
+
+// Offer the image in every format GTK can convert a pixbuf to (image/png,
+// image/bmp, image/tiff, ...), like Pinta or GIMP do. The selection is set from
+// swappy's own window, which has focus when the user copies, so every
+// compositor accepts it.
+static gboolean send_pixbuf_to_gtk_clipboard(gdk_pixbuf_t *pixbuf) {
   gtk_clipboard_t *clipboard = gtk_clipboard_get(GDK_SELECTION_CLIPBOARD);
-  gtk_clipboard_set_image(clipboard, pixbuf);
-  gtk_clipboard_store(clipboard);  // Does not work for Wayland gdk backend
+  GtkTargetList *list = gtk_target_list_new(NULL, 0);
+  GtkTargetEntry *targets;
+  gint count = 0;
+  gboolean done;
+
+  gtk_target_list_add_image_targets(list, 0, TRUE);
+  targets = gtk_target_table_new_from_list(list, &count);
+  gtk_target_list_unref(list);
+
+  // Replacing our own earlier copy calls on_clear for it first.
+  done = gtk_clipboard_set_with_data(clipboard, targets, count, on_get,
+                                     on_clear, g_object_ref(pixbuf));
+  gtk_target_table_free(targets, count);
+
+  if (!done) {
+    g_object_unref(pixbuf);
+    return false;
+  }
+
+  owned_pixbuf = pixbuf;
+  gtk_clipboard_set_can_store(clipboard, NULL, 0);
+
+  return true;
 }
 
 bool clipboard_copy_drawing_area_to_selection(struct swappy_state *state) {
   gdk_pixbuf_t *pixbuf = pixbuf_get_from_state(state);
 
-  // Try `wl-copy` first and fall back to gtk function. See README.md.
-  if (!send_pixbuf_to_wl_copy(pixbuf)) {
-    send_pixbuf_to_gdk_clipboard(pixbuf);
+  // Hold the image on the GTK clipboard while swappy runs, and hand it to
+  // `wl-copy` when it exits (see clipboard_hand_off_selection). See README.md.
+  if (!send_pixbuf_to_gtk_clipboard(pixbuf)) {
+    send_pixbuf_to_wl_copy(pixbuf);
   }
 
   g_object_unref(pixbuf);
@@ -88,3 +130,21 @@ bool clipboard_copy_drawing_area_to_selection(struct swappy_state *state) {
 
   return true;
 }
+
+void clipboard_hand_off_selection(void) {
+  gdk_pixbuf_t *pixbuf = owned_pixbuf;
+
+  // Another application took the clipboard, or nothing was copied.
+  if (pixbuf == NULL) {
+    return;
+  }
+
+  // GTK cannot keep the clipboard once swappy exits on Wayland: hand the image
+  // to `wl-copy`, as PNG, so it stays on the clipboard.
+  g_object_ref(pixbuf);
+  if (!send_pixbuf_to_wl_copy(pixbuf)) {
+    // Only X11 clipboard managers can store it.
+    gtk_clipboard_store(gtk_clipboard_get(GDK_SELECTION_CLIPBOARD));
+  }
+  g_object_unref(pixbuf);
+}
