+int MySortFilterProxyModel::compute_file_score(const QString& filter_string, const QString& item_string) const {
+    const QString file_name = QFileInfo(item_string).fileName();
+    const QStringList terms = filter_string.simplified().split(' ', Qt::SkipEmptyParts);
+    int score = 1;
+    for (const QString& term : terms) {
+        auto position = file_name.indexOf(term, 0, Qt::CaseInsensitive);
+        if (position < 0) {
+            return 0;
+        }
+        score += term.size();
+        if (position == 0) {
+            score += 2 * term.size();
+        }
+        else if (!file_name.at(position - 1).isLetterOrNumber()) {
+            score += term.size();
+        }
+    }
+    return score;
+}
