+    // Glyph and name of built-in widget types, where they have no face of their own.
+    struct BuiltinWidgetLook {
+      std::string_view type;
+      std::string_view glyph;
+      std::string_view label;
+    };
+    constexpr std::array<BuiltinWidgetLook, 19> kBuiltinWidgetLooks{{
+        {"active_window", "app-window", "Window title"},
+        {"battery", "battery", "Battery"},
+        {"bluetooth", "bluetooth", "Bluetooth"},
+        {"caffeine", "coffee", "Caffeine"},
+        {"clock", "clock", "Clock"},
+        {"control-center", "adjustments", "Control centre"},
+        {"keyboard_layout", "keyboard", "Keyboard layout"},
+        {"launcher", "layout-grid", "Launcher"},
+        {"media", "music", "Media"},
+        {"network", "network", "Network"},
+        {"notifications", "bell", "Notifications"},
+        {"privacy", "shield-lock", "Privacy"},
+        {"session", "power", "Power"},
+        {"settings", "settings", "Settings"},
+        {"sysmon", "cpu", "System monitor"},
+        {"taskbar", "layout-bottombar", "Taskbar"},
+        {"volume", "volume", "Volume"},
+        {"weather", "cloud", "Weather"},
+        {"workspaces", "layout-board", "Workspaces"},
+    }};
+
+    const WidgetConfig* widgetConfigFor(std::string_view name) {
+      if (g_config == nullptr) {
+        return nullptr;
+      }
+      const auto it = g_config->config().widgets.find(std::string(name));
+      return it != g_config->config().widgets.end() ? &it->second : nullptr;
+    }
+
+    // The settings' action picker label of an IPC verb, or empty.
+    std::string verbLabel(const WidgetAction& action) {
+      if (action.kind != WidgetAction::Kind::Ipc) {
+        return {};
+      }
+      return std::string(i18n::Service::instance().lookup("settings.widgets.actions.commands." + action.verb + ".label"));
+    }
+
+    // Below a top bar, above a bottom one, beside a side bar (as the screenshot widget's menu).
+    ContextMenuPopupPlacement placementForBar(std::string_view barPosition, float contentScale) {
+      const std::int32_t gap = std::max(2, static_cast<std::int32_t>(std::lround(Style::spaceMd * contentScale)));
+      if (barPosition == "bottom") {
+        return ContextMenuPopupPlacement{
+            .anchor = XDG_POSITIONER_ANCHOR_TOP,
+            .gravity = XDG_POSITIONER_GRAVITY_TOP,
+            .offsetX = 0,
+            .offsetY = -gap,
+            .chromeAttachment = popup_chrome::Attachment{
+                .horizontal = popup_chrome::HorizontalAttachment::Center,
+                .vertical = popup_chrome::VerticalAttachment::Bottom,
+            },
+        };
+      }
+      if (barPosition == "left") {
+        return ContextMenuPopupPlacement{
+            .anchor = XDG_POSITIONER_ANCHOR_RIGHT,
+            .gravity = XDG_POSITIONER_GRAVITY_RIGHT,
+            .offsetX = gap,
+            .offsetY = 0,
+            .chromeAttachment = popup_chrome::Attachment{
+                .horizontal = popup_chrome::HorizontalAttachment::Left,
+                .vertical = popup_chrome::VerticalAttachment::Center,
+            },
+        };
+      }
+      if (barPosition == "right") {
+        return ContextMenuPopupPlacement{
+            .anchor = XDG_POSITIONER_ANCHOR_LEFT,
+            .gravity = XDG_POSITIONER_GRAVITY_LEFT,
+            .offsetX = -gap,
+            .offsetY = 0,
+            .chromeAttachment = popup_chrome::Attachment{
+                .horizontal = popup_chrome::HorizontalAttachment::Right,
+                .vertical = popup_chrome::VerticalAttachment::Center,
+            },
+        };
+      }
+      return ContextMenuPopupPlacement{
+          .anchor = XDG_POSITIONER_ANCHOR_BOTTOM,
+          .gravity = XDG_POSITIONER_GRAVITY_BOTTOM,
+          .offsetX = 0,
+          .offsetY = gap,
+          .chromeAttachment = popup_chrome::Attachment{
+              .horizontal = popup_chrome::HorizontalAttachment::Center,
+              .vertical = popup_chrome::VerticalAttachment::Top,
+          },
+      };
+    }
