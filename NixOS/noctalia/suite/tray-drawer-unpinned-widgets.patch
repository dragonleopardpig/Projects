+namespace noctalia::bar {
+
+  // Bound to a bar widget's right click as `actions.right = "widget-menu"`: a native menu with
+  // what the widget can do -- its click action (Open ...), its type's own right-click action,
+  // the entries its plugin declares -- then Unpin from bar. An unpinned widget
+  // (`[widget.<name>] enabled = false`) sits in the tray's drawer, where the same menu ends
+  // with Pin to bar.
+  inline constexpr std::string_view kWidgetMenuVerb = "widget-menu";
+
+  // The config the menus read and pin through; the bar sets it when it initializes.
+  void setPinMenuConfig(ConfigService* config) noexcept;
+  ConfigService* pinMenuConfig() noexcept;
+
+  // How a widget shows where it has no face of its own (the drawer, the menu's Open entry).
+  struct WidgetLook {
+    std::string glyph;
+    std::string label;
+  };
+  WidgetLook widgetLook(std::string_view name, std::string_view type);
+
+  // One action entry of the menu.  Every action is a config-style action (IPC verb or exec),
+  // so it runs the same with the widget on the bar or unpinned in the drawer.
+  struct PinMenuItem {
+    std::string label;
+    WidgetAction action;
+  };
+  // Open (its click action), its type's default right-click action (labelled as in the
+  // settings' action picker), then a plugin's `menu = [{ label, action }]` entries.
+  std::vector<PinMenuItem> pinMenuItems(std::string_view name, std::string_view type);
+
+  // Pin (true) or unpin (false) the bar widget `name`.
+  bool setWidgetPinned(std::string_view name, bool pinned);
+
+  struct PinMenuRequest {
+    std::string name;
+    bool pinned = true;
+    std::vector<PinMenuItem> items;
+    // The clicked item, in the coordinates of the surface under the pointer.
+    float x = 0.0F;
+    float y = 0.0F;
+    float width = 1.0F;
+    float height = 1.0F;
+    float contentScale = 1.0F;
+    // Inside a panel (the tray drawer) the panel routes the menu's input; on a bar, the bar does.
+    bool inPanel = false;
+    const void* owner = nullptr;
+    std::function<void(const WidgetAction&)> run;
+    std::function<void()> afterPinChange;
+  };
+
+  // One native menu at a time, bar or drawer, like the tray's own menu.
+  class PinMenu {
+  public:
+    static PinMenu& instance();
+    bool open(PinMenuRequest request);
+    // Bar input while a bar-attached menu is open; true when consumed.
+    bool onBarPointerEvent(const PointerEvent& event);
+    // Closes the menu if `owner` opened it (a widget going away).
+    void closeFor(const void* owner);
+    void close();
+
+  private:
+    std::unique_ptr<ContextMenuPopup> m_popup;
+    const void* m_owner = nullptr;
+    bool m_inPanel = false;
+    wl_surface* m_panelSurface = nullptr;
+  };
+
