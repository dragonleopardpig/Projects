index 0000000..39d33fb
--- /dev/null
+++ b/src/shell/bar/widget_pin_menu.cpp
@@ -0,0 +1,266 @@
+#include "shell/bar/widget_pin_menu.h"
+
+#include "config/config_service.h"
+#include "i18n/i18n.h"
+#include "i18n/i18n_service.h"
+#include "scripting/plugin_registry.h"
+#include "shell/bar/widget_gesture_defaults.h"
+#include "shell/panel/panel_manager.h"
+#include "shell/wayland/layer_shell.h"
+#include "ui/controls/context_menu.h"
+#include "ui/controls/context_menu_popup.h"
+#include "ui/style.h"
+#include "wayland/wayland_connection.h"
+#include "wayland/wayland_seat.h"
+#include "xdg-shell-client-protocol.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace noctalia::bar {
+
+  namespace {
+
+    ConfigService* g_config = nullptr;
+
+    constexpr std::int32_t kEntryOwn = 1;
+    constexpr std::int32_t kEntryPin = 2;
+
+    // Below a top bar, above a bottom one, beside a side bar (as the screenshot widget's menu).
+    ContextMenuPopupPlacement placementForBar(std::string_view barPosition, float contentScale) {
+      const std::int32_t gap = std::max(2, static_cast<std::int32_t>(std::lround(Style::spaceMd * contentScale)));
+      if (barPosition == "bottom") {
+        return ContextMenuPopupPlacement{
+            .anchor = XDG_POSITIONER_ANCHOR_TOP,
+            .gravity = XDG_POSITIONER_GRAVITY_TOP,
+            .offsetX = 0,
+            .offsetY = -gap,
+            .chromeAttachment = popup_chrome::Attachment{
+                .horizontal = popup_chrome::HorizontalAttachment::Center,
+                .vertical = popup_chrome::VerticalAttachment::Bottom,
+            },
+        };
+      }
+      if (barPosition == "left") {
+        return ContextMenuPopupPlacement{
+            .anchor = XDG_POSITIONER_ANCHOR_RIGHT,
+            .gravity = XDG_POSITIONER_GRAVITY_RIGHT,
+            .offsetX = gap,
+            .offsetY = 0,
+            .chromeAttachment = popup_chrome::Attachment{
+                .horizontal = popup_chrome::HorizontalAttachment::Left,
+                .vertical = popup_chrome::VerticalAttachment::Center,
+            },
+        };
+      }
+      if (barPosition == "right") {
+        return ContextMenuPopupPlacement{
+            .anchor = XDG_POSITIONER_ANCHOR_LEFT,
+            .gravity = XDG_POSITIONER_GRAVITY_LEFT,
+            .offsetX = -gap,
+            .offsetY = 0,
+            .chromeAttachment = popup_chrome::Attachment{
+                .horizontal = popup_chrome::HorizontalAttachment::Right,
+                .vertical = popup_chrome::VerticalAttachment::Center,
+            },
+        };
+      }
+      return ContextMenuPopupPlacement{
+          .anchor = XDG_POSITIONER_ANCHOR_BOTTOM,
+          .gravity = XDG_POSITIONER_GRAVITY_BOTTOM,
+          .offsetX = 0,
+          .offsetY = gap,
+          .chromeAttachment = popup_chrome::Attachment{
+              .horizontal = popup_chrome::HorizontalAttachment::Center,
+              .vertical = popup_chrome::VerticalAttachment::Top,
+          },
+      };
+    }
+
+  } // namespace
+
+  void setPinMenuConfig(ConfigService* config) noexcept { g_config = config; }
+
+  ConfigService* pinMenuConfig() noexcept { return g_config; }
+
+  std::optional<OwnRightClick> ownRightClick(std::string_view name, std::string_view type) {
+    const WidgetConfig* widgetConfig = nullptr;
+    if (g_config != nullptr) {
+      if (const auto it = g_config->config().widgets.find(std::string(name)); it != g_config->config().widgets.end()) {
+        widgetConfig = &it->second;
+      }
+    }
+    for (const auto& binding : gestureDefaultsForType(type, widgetConfig)) {
+      if (binding.gesture != Gesture::Right) {
+        continue;
+      }
+      auto parsed = parseWidgetAction(binding.action);
+      if (!parsed.has_value() || !parsed->isBound()) {
+        return std::nullopt;
+      }
+      std::string label;
+      if (parsed->kind == WidgetAction::Kind::Ipc) {
+        label = std::string(i18n::Service::instance().lookup("settings.widgets.actions.commands." + parsed->verb + ".label"));
+      }
+      if (label.empty()) {
+        label = parsed->kind == WidgetAction::Kind::Ipc ? parsed->commandLine() : parsed->args;
+      }
+      return OwnRightClick{.label = std::move(label), .action = std::move(*parsed)};
+    }
+    auto& registry = scripting::PluginRegistry::instance();
+    registry.ensureScanned();
+    if (const auto plugin = registry.resolve(type);
+        plugin.has_value() && plugin->entry != nullptr && !plugin->entry->rightClickLabel.empty()) {
+      return OwnRightClick{.label = plugin->entry->rightClickLabel, .script = true};
+    }
+    return std::nullopt;
+  }
+
+  bool setWidgetPinned(std::string_view name, bool pinned) {
+    if (g_config == nullptr || name.empty()) {
+      return false;
+    }
+    return g_config->setOverride({"widget", std::string(name), "enabled"}, pinned);
+  }
+
+  PinMenu& PinMenu::instance() {
+    static PinMenu menu;
+    return menu;
+  }
+
+  bool PinMenu::open(PinMenuRequest request) {
+    WaylandConnection* wayland = PanelManager::instance().wayland();
+    RenderContext* renderContext = PanelManager::instance().renderContext();
+    if (wayland == nullptr || renderContext == nullptr || request.name.empty()) {
+      return false;
+    }
+    close();
+
+    std::vector<ContextMenuControlEntry> entries;
+    if (request.own.has_value() && request.runOwn) {
+      entries.push_back(ContextMenuControlEntry{.id = kEntryOwn, .label = request.own->label, .enabled = true});
+    }
+    entries.push_back(
+        ContextMenuControlEntry{
+            .id = kEntryPin,
+            .label = request.pinned ? std::string("Unpin from bar") : std::string("Pin to bar"),
+            .enabled = true,
+        }
+    );
+
+    if (m_popup == nullptr) {
+      m_popup = std::make_unique<ContextMenuPopup>(*wayland, *renderContext);
+    }
+    if (g_config != nullptr) {
+      m_popup->setShadowConfig(g_config->config().shell.shadow);
+    }
+    m_popup->setOnActivate([name = request.name, pinned = request.pinned, runOwn = request.runOwn,
+                            afterPinChange = request.afterPinChange](const ContextMenuControlEntry& entry) {
+      if (entry.id == kEntryOwn && runOwn) {
+        runOwn();
+      } else if (entry.id == kEntryPin) {
+        setWidgetPinned(name, !pinned);
+        if (afterPinChange) {
+          afterPinChange();
+        }
+      }
+    });
+
+    const float scale = request.contentScale;
+    const PopupAnchorRect anchor{
+        .x = static_cast<std::int32_t>(std::lround(request.x)),
+        .y = static_cast<std::int32_t>(std::lround(request.y)),
+        .width = std::max(1, static_cast<std::int32_t>(std::lround(request.width))),
+        .height = std::max(1, static_cast<std::int32_t>(std::lround(request.height))),
+    };
+    constexpr float kMenuWidth = 220.0F;
+
+    if (request.inPanel) {
+      const auto parent = PanelManager::instance().fallbackPopupParentContext();
+      if (!parent.has_value()) {
+        return false;
+      }
+      m_inPanel = true;
+      m_panelSurface = parent->surface;
+      PanelManager::instance().beginAttachedPopup(parent->surface);
+      PanelManager::instance().setActivePopup(m_popup.get());
+      m_popup->setOnDismissed([this, surface = parent->surface] {
+        PanelManager::instance().clearActivePopup();
+        PanelManager::instance().endAttachedPopup(surface);
+        if (m_panelSurface == surface) {
+          m_panelSurface = nullptr;
+        }
+      });
+      m_owner = request.owner;
+      m_popup->open(
+          ContextMenuPopupRequest{
+              .entries = std::move(entries),
+              .minMenuWidth = kMenuWidth * scale,
+              .maxMenuWidth = Style::menuAutoMaxWidth * scale,
+              .maxVisible = 4,
+              .anchor = anchor,
+              .parent = PopupSurfaceParent{.attach = parent->attach, .output = parent->output},
+          }
+      );
+      return true;
+    }
+
+    wl_surface* pointerSurface = wayland->lastPointerSurface();
+    auto& layerShell = wayland->extension<LayerShell>();
+    auto* layerSurface = layerShell.layerSurfaceFor(pointerSurface);
+    if (layerSurface == nullptr) {
+      return false;
+    }
+    std::string barPosition = "top";
+    if (g_config != nullptr && !g_config->config().bars.empty()) {
+      barPosition = g_config->config().bars.front().position;
+    }
+    m_inPanel = false;
+    m_owner = request.owner;
+    m_popup->setOnDismissed([] {});
+    m_popup->open(
+        ContextMenuPopupRequest{
+            .entries = std::move(entries),
+            .minMenuWidth = kMenuWidth * scale,
+            .maxMenuWidth = Style::menuAutoMaxWidth * scale,
+            .maxVisible = 4,
+            .anchor = anchor,
+            .parent =
+                PopupSurfaceParent{
+                    .attach = LayerShell::popupAttach(layerSurface),
+                    .output = wayland->lastPointerOutput(),
+                    .keyboardGrab = layerShell.popupKeyboardGrab(pointerSurface),
+                },
+            .pointerParentSurface = pointerSurface,
+            .placement = placementForBar(barPosition, scale),
+        }
+    );
+    return true;
+  }
+
+  bool PinMenu::onBarPointerEvent(const PointerEvent& event) {
+    if (m_popup == nullptr || m_inPanel || !m_popup->isOpen()) {
+      return false;
+    }
+    const bool consumed = m_popup->onPointerEvent(event);
+    if (!consumed && event.type == PointerEvent::Type::Button && event.pressed) {
+      m_popup->close();
+      return true;
+    }
+    return consumed;
+  }
+
+  void PinMenu::closeFor(const void* owner) {
+    if (owner != nullptr && owner == m_owner) {
+      close();
+    }
+  }
+
+  void PinMenu::close() {
+    if (m_popup != nullptr && m_popup->isOpen()) {
+      m_popup->close();
+    }
+    m_owner = nullptr;
+  }
+
+} // namespace noctalia::bar
diff --git a/src/shell/bar/widget_pin_menu.h b/src/shell/bar/widget_pin_menu.h
new file mode 100644
index 0000000..16c9bb9
--- /dev/null
+++ b/src/shell/bar/widget_pin_menu.h
@@ -0,0 +1,76 @@
+#pragma once
+
+#include "shell/bar/widget_action.h"
+
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+class ConfigService;
+class ContextMenuPopup;
+struct PointerEvent;
+struct WidgetConfig;
+struct wl_surface;
+
+namespace noctalia::bar {
+
+  // Bound to a bar widget's right click as `actions.right = "widget-menu"`: a native menu with the
+  // widget's own right-click action first (if it has one), then Unpin from bar. An unpinned widget
+  // (`[widget.<name>] enabled = false`) sits in the tray's drawer, where its menu offers Pin to bar.
+  inline constexpr std::string_view kWidgetMenuVerb = "widget-menu";
+
+  // The config the menus pin and unpin through; the bar sets it when it initializes.
+  void setPinMenuConfig(ConfigService* config) noexcept;
+  ConfigService* pinMenuConfig() noexcept;
+
+  // A widget's own right-click action, offered first in its menu: the type's default binding,
+  // labelled as in the settings' action picker, or a plugin's onRightClick when its manifest
+  // names it (`right_click_label` on the [[widget]] entry).
+  struct OwnRightClick {
+    std::string label;
+    std::optional<WidgetAction> action;
+    bool script = false;
+  };
+  std::optional<OwnRightClick> ownRightClick(std::string_view name, std::string_view type);
+
+  // Pin (true) or unpin (false) the bar widget `name`.
+  bool setWidgetPinned(std::string_view name, bool pinned);
+
+  struct PinMenuRequest {
+    std::string name;
+    bool pinned = true;
+    std::optional<OwnRightClick> own;
+    // The clicked item, in the coordinates of the surface under the pointer.
+    float x = 0.0F;
+    float y = 0.0F;
+    float width = 1.0F;
+    float height = 1.0F;
+    float contentScale = 1.0F;
+    // Inside a panel (the tray drawer) the panel routes the menu's input; on a bar, the bar does.
+    bool inPanel = false;
+    const void* owner = nullptr;
+    std::function<void()> runOwn;
+    std::function<void()> afterPinChange;
+  };
+
+  // One native menu at a time, bar or drawer, like the tray's own menu.
+  class PinMenu {
+  public:
+    static PinMenu& instance();
+    bool open(PinMenuRequest request);
+    // Bar input while a bar-attached menu is open; true when consumed.
+    bool onBarPointerEvent(const PointerEvent& event);
+    // Closes the menu if `owner` opened it (a widget going away).
+    void closeFor(const void* owner);
+    void close();
+
+  private:
+    std::unique_ptr<ContextMenuPopup> m_popup;
+    const void* m_owner = nullptr;
+    bool m_inPanel = false;
+    wl_surface* m_panelSurface = nullptr;
+  };
+
+} // namespace noctalia::bar
