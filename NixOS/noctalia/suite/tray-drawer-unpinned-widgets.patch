+std::vector<TrayWidget::UnpinnedBarWidget> TrayWidget::unpinnedBarWidgets(const ConfigService& config) {
+  std::vector<UnpinnedBarWidget> unpinned;
+  const Config& cfg = config.config();
+  if (cfg.bars.empty()) {
+    return unpinned;
+  }
+  const BarConfig& bar = cfg.bars.front();
+  for (const auto* names : {&bar.startWidgets, &bar.centerWidgets, &bar.endWidgets}) {
+    for (const auto& name : *names) {
+      const auto it = cfg.widgets.find(name);
+      if (it == cfg.widgets.end() || it->second.getBool("enabled", true)) {
+        continue;
+      }
+      if (std::ranges::any_of(unpinned, [&](const UnpinnedBarWidget& seen) { return seen.name == name; })) {
+        continue;
+      }
+      const WidgetConfig& widget = it->second;
+      UnpinnedBarWidget entry{.name = name, .type = widget.type.empty() ? name : widget.type};
+      if (entry.type == "tray") {
+        continue;
+      }
+      auto look = noctalia::bar::widgetLook(name, entry.type);
+      entry.glyph = std::move(look.glyph);
+      entry.label = std::move(look.label);
+      unpinned.push_back(std::move(entry));
+    }
+  }
+  return unpinned;
+}
+
+void TrayWidget::openUnpinnedBarWidgetMenu(const UnpinnedBarWidget& widget, InputArea& area) {
+  float x = 0.0F;
+  float y = 0.0F;
+  Node::absolutePosition(&area, x, y);
+  noctalia::bar::PinMenuRequest request{
+      .name = widget.name,
+      .pinned = false,
+      .items = noctalia::bar::pinMenuItems(widget.name, widget.type),
+      .x = x,
+      .y = y,
+      .width = area.width(),
+      .height = area.height(),
+      .contentScale = m_contentScale,
+      .inPanel = true,
+      .owner = this,
+      .run = [this](const noctalia::bar::WidgetAction& action) { runWidgetAction(action, true); },
+  };
+  // Pinned back: drop its cell, and close the drawer once nothing is left in it.
+  request.afterPinChange = [this] {
+    m_rebuildPending = true;
+    requestUpdate();
+    if (unpinnedBarWidgets(m_config).empty() && !std::ranges::any_of(m_items, [this](const TrayItemInfo& item) {
+          return !(m_hidePassive && tray::isPassiveStatus(item)) && !isHiddenItem(item) && !isPinnedItem(item);
+        })) {
+      PanelManager::instance().close();
+    }
+  };
+  (void)noctalia::bar::PinMenu::instance().open(std::move(request));
+}
+
+void TrayWidget::runUnpinnedBarWidgetAction(const UnpinnedBarWidget& widget) {
+  const Config& cfg = m_config.config();
+  const auto it = cfg.widgets.find(widget.name);
+  const WidgetConfig* widgetConfig = it != cfg.widgets.end() ? &it->second : nullptr;
+  const auto typeDefaults = noctalia::bar::gestureDefaultsForType(widget.type, widgetConfig);
+  const std::string widgetContext = "widget." + widget.name;
+  noctalia::bar::WidgetActionBindings bindings;
+  bindings.resolve(
+      noctalia::bar::WidgetActionBindings::Inputs{
+          .builtinDefaults = noctalia::bar::builtinGestureDefaults(),
+          .widgetDefaults = typeDefaults,
+          .barActions = nullptr,
+          .widgetActions = noctalia::bar::findActionTable(widgetConfig),
+          .reserved = noctalia::bar::reservedGesturesForType(widget.type),
+          .widgetContext = widgetContext,
+          .barContext = {},
+          .widgetName = widget.name,
+          .widgetType = widget.type,
+      }
+  );
+  if (const auto* click = bindings.find(noctalia::bar::Gesture::Left); click != nullptr) {
+    runWidgetAction(*click, true);
+  }
+}
+
+void TrayWidget::runWidgetAction(const noctalia::bar::WidgetAction& action, bool closeDrawer) {
+  if (action.kind == noctalia::bar::WidgetAction::Kind::Exec) {
+    (void)process::runAsync(action.args);
+  } else if (action.kind == noctalia::bar::WidgetAction::Kind::Ipc) {
+    // The drawer has no action dispatcher, and closes right after: hand the command to a
+    // `noctalia msg` of this very binary, so panels open once the drawer is gone.
+    std::error_code error;
+    const auto self = std::filesystem::read_symlink("/proc/self/exe", error);
+    std::vector<std::string> argv{error ? std::string("noctalia") : self.string(), "msg", action.verb};
+    for (std::string_view rest = action.args; !rest.empty();) {
+      const auto start = rest.find_first_not_of(' ');
+      if (start == std::string_view::npos) {
+        break;
+      }
+      rest.remove_prefix(start);
+      const auto end = rest.find(' ');
+      argv.emplace_back(rest.substr(0, end));
+      rest = end == std::string_view::npos ? std::string_view{} : rest.substr(end);
+    }
+    (void)process::runAsync(argv);
+  }
+  if (closeDrawer && m_itemActivated) {
+    m_itemActivated();
+  }
+}
