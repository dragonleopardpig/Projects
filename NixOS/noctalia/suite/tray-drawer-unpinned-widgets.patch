+
+  void setPinMenuConfig(ConfigService* config) noexcept { g_config = config; }
+
+  ConfigService* pinMenuConfig() noexcept { return g_config; }
+
+  WidgetLook widgetLook(std::string_view name, std::string_view type) {
+    WidgetLook look;
+    if (const WidgetConfig* config = widgetConfigFor(name); config != nullptr) {
+      look.glyph = config->getString("glyph");
+    }
+    for (const auto& builtin : kBuiltinWidgetLooks) {
+      if (builtin.type == type) {
+        if (look.glyph.empty()) {
+          look.glyph = std::string(builtin.glyph);
+        }
+        look.label = std::string(builtin.label);
+        break;
+      }
+    }
+    if (look.label.empty()) {
+      auto& registry = scripting::PluginRegistry::instance();
+      registry.ensureScanned();
+      if (const auto plugin = registry.resolve(type); plugin.has_value() && plugin->manifest != nullptr) {
+        look.label = plugin->manifest->name;
+        if (look.glyph.empty()) {
+          look.glyph = plugin->manifest->icon;
+        }
+      }
+    }
+    if (look.glyph.empty() || !GlyphRegistry::contains(look.glyph)) {
+      look.glyph = "point";
+    }
+    if (look.label.empty()) {
+      look.label = std::string(name);
+    }
+    return look;
+  }
+
+  std::vector<PinMenuItem> pinMenuItems(std::string_view name, std::string_view type) {
+    std::vector<PinMenuItem> items;
+    const WidgetConfig* config = widgetConfigFor(name);
+    const std::string label = widgetLook(name, type).label;
+    const auto add = [&items](std::string itemLabel, const WidgetAction& action) {
+      if (!action.isBound() || (action.kind == WidgetAction::Kind::Ipc && action.verb == kWidgetMenuVerb)) {
+        return;
+      }
+      const bool same = std::ranges::any_of(items, [&](const PinMenuItem& item) {
+        return item.action.kind == action.kind && item.action.verb == action.verb && item.action.args == action.args;
+      });
+      if (!same) {
+        items.push_back(PinMenuItem{.label = std::move(itemLabel), .action = action});
+      }
+    };
+
+    // The plugin's own entries first: they name what they do best.
+    std::vector<PinMenuItem> declared;
+    auto& registry = scripting::PluginRegistry::instance();
+    registry.ensureScanned();
+    if (const auto plugin = registry.resolve(type); plugin.has_value() && plugin->entry != nullptr) {
+      for (const auto& [itemLabel, line] : plugin->entry->menuItems) {
+        if (auto parsed = parseWidgetAction(line); parsed.has_value()) {
+          declared.push_back(PinMenuItem{.label = itemLabel, .action = std::move(*parsed)});
+        }
+      }
+    }
+
+    // Its click: resolved as the widget resolves it (type defaults, then its config).
+    const auto typeDefaults = gestureDefaultsForType(type, config);
+    WidgetActionBindings bindings;
+    const std::string widgetContext = "widget." + std::string(name);
+    bindings.resolve(
+        WidgetActionBindings::Inputs{
+            .builtinDefaults = builtinGestureDefaults(),
+            .widgetDefaults = typeDefaults,
+            .barActions = nullptr,
+            .widgetActions = findActionTable(config),
+            .reserved = reservedGesturesForType(type),
+            .widgetContext = widgetContext,
+            .barContext = {},
+            .widgetName = name,
+            .widgetType = type,
+        }
+    );
+    if (const auto* click = bindings.find(Gesture::Left); click != nullptr) {
+      const bool declaredToo = std::ranges::any_of(declared, [&](const PinMenuItem& item) {
+        return item.action.kind == click->kind && item.action.verb == click->verb && item.action.args == click->args;
+      });
+      if (!declaredToo) {
+        std::string clickLabel;
+        if (click->kind == WidgetAction::Kind::Ipc && isAnchoredPanelVerb(click->verb)) {
+          clickLabel = "Open " + label;
+        } else {
+          clickLabel = verbLabel(*click);
+          if (clickLabel.empty()) {
+            clickLabel = label;
+          }
+        }
+        add(std::move(clickLabel), *click);
+      }
+    }
+    for (auto& item : declared) {
+      add(std::move(item.label), item.action);
+    }
+    // Its type's own right-click action (config binds the right click to this menu).
+    for (const auto& binding : typeDefaults) {
+      if (binding.gesture != Gesture::Right) {
+        continue;
+      }
+      if (auto parsed = parseWidgetAction(binding.action); parsed.has_value()) {
+        std::string rightLabel = verbLabel(*parsed);
+        if (rightLabel.empty()) {
+          rightLabel = parsed->kind == WidgetAction::Kind::Ipc ? parsed->commandLine() : parsed->args;
+        }
+        add(std::move(rightLabel), *parsed);
+      }
+    }
+    return items;
+  }
+
+  bool setWidgetPinned(std::string_view name, bool pinned) {
+    if (g_config == nullptr || name.empty()) {
+      return false;
+    }
+    return g_config->setOverride({"widget", std::string(name), "enabled"}, pinned);
+  }
+
+  PinMenu& PinMenu::instance() {
+    static PinMenu menu;
+    return menu;
+  }
+
+  bool PinMenu::open(PinMenuRequest request) {
+    WaylandConnection* wayland = PanelManager::instance().wayland();
+    RenderContext* renderContext = PanelManager::instance().renderContext();
+    if (wayland == nullptr || renderContext == nullptr || request.name.empty()) {
+      return false;
+    }
+    close();
+
+    std::vector<ContextMenuControlEntry> entries;
+    for (std::size_t i = 0; i < request.items.size(); ++i) {
+      entries.push_back(
+          ContextMenuControlEntry{
+              .id = static_cast<std::int32_t>(i),
+              .label = request.items[i].label,
+              .enabled = static_cast<bool>(request.run),
+          }
+      );
+    }
+    if (!entries.empty()) {
+      entries.push_back(ContextMenuControlEntry{.id = kEntrySeparator, .label = {}, .enabled = false, .separator = true});
+    }
+    entries.push_back(
+        ContextMenuControlEntry{
+            .id = kEntryPin,
+            .label = request.pinned ? std::string("Unpin from bar") : std::string("Pin to bar"),
+            .enabled = true,
+        }
+    );
+
+    if (m_popup == nullptr) {
+      m_popup = std::make_unique<ContextMenuPopup>(*wayland, *renderContext);
+    }
+    if (g_config != nullptr) {
+      m_popup->setShadowConfig(g_config->config().shell.shadow);
+    }
+    m_popup->setOnActivate([name = request.name, pinned = request.pinned, items = request.items, run = request.run,
+                            afterPinChange = request.afterPinChange](const ContextMenuControlEntry& entry) {
+      if (entry.id >= 0 && static_cast<std::size_t>(entry.id) < items.size() && run) {
+        run(items[static_cast<std::size_t>(entry.id)].action);
+      } else if (entry.id == kEntryPin) {
+        setWidgetPinned(name, !pinned);
+        if (afterPinChange) {
+          afterPinChange();
+        }
+      }
+    });
+
+    const float scale = request.contentScale;
+    const PopupAnchorRect anchor{
+        .x = static_cast<std::int32_t>(std::lround(request.x)),
+        .y = static_cast<std::int32_t>(std::lround(request.y)),
+        .width = std::max(1, static_cast<std::int32_t>(std::lround(request.width))),
+        .height = std::max(1, static_cast<std::int32_t>(std::lround(request.height))),
+    };
+    constexpr float kMenuWidth = 220.0F;
+
+    if (request.inPanel) {
+      const auto parent = PanelManager::instance().fallbackPopupParentContext();
+      if (!parent.has_value()) {
+        return false;
+      }
+      m_inPanel = true;
+      m_panelSurface = parent->surface;
+      PanelManager::instance().beginAttachedPopup(parent->surface);
+      PanelManager::instance().setActivePopup(m_popup.get());
+      m_popup->setOnDismissed([this, surface = parent->surface] {
+        TooltipManager::instance().setMenuOpen(false);
+        PanelManager::instance().clearActivePopup();
+        PanelManager::instance().endAttachedPopup(surface);
+        if (m_panelSurface == surface) {
+          m_panelSurface = nullptr;
+        }
+      });
+      m_owner = request.owner;
+      // The tooltip of the item under the pointer would sit on top of the menu.
+      TooltipManager::instance().setMenuOpen(true);
+      m_popup->open(
+          ContextMenuPopupRequest{
+              .entries = std::move(entries),
+              .minMenuWidth = kMenuWidth * scale,
+              .maxMenuWidth = Style::menuAutoMaxWidth * scale,
+              .maxVisible = 12,
+              .anchor = anchor,
+              .parent = PopupSurfaceParent{.attach = parent->attach, .output = parent->output},
+          }
+      );
+      return true;
+    }
+
+    wl_surface* pointerSurface = wayland->lastPointerSurface();
+    auto& layerShell = wayland->extension<LayerShell>();
+    auto* layerSurface = layerShell.layerSurfaceFor(pointerSurface);
+    if (layerSurface == nullptr) {
+      return false;
+    }
+    std::string barPosition = "top";
+    if (g_config != nullptr && !g_config->config().bars.empty()) {
+      barPosition = g_config->config().bars.front().position;
+    }
+    m_inPanel = false;
+    m_owner = request.owner;
+    m_popup->setOnDismissed([] { TooltipManager::instance().setMenuOpen(false); });
+    // The tooltip of the icon under the pointer would sit on top of the menu.
+    TooltipManager::instance().setMenuOpen(true);
+    m_popup->open(
+        ContextMenuPopupRequest{
+            .entries = std::move(entries),
+            .minMenuWidth = kMenuWidth * scale,
+            .maxMenuWidth = Style::menuAutoMaxWidth * scale,
+            .maxVisible = 12,
+            .anchor = anchor,
+            .parent =
+                PopupSurfaceParent{
+                    .attach = LayerShell::popupAttach(layerSurface),
+                    .output = wayland->lastPointerOutput(),
+                    .keyboardGrab = layerShell.popupKeyboardGrab(pointerSurface),
+                },
+            .pointerParentSurface = pointerSurface,
+            .placement = placementForBar(barPosition, scale),
+        }
+    );
+    return true;
+  }
+
+  bool PinMenu::onBarPointerEvent(const PointerEvent& event) {
+    if (m_popup == nullptr || m_inPanel || !m_popup->isOpen()) {
+      return false;
+    }
+    const bool consumed = m_popup->onPointerEvent(event);
+    if (!consumed && event.type == PointerEvent::Type::Button && event.pressed) {
+      m_popup->close();
+      return true;
+    }
+    return consumed;
+  }
+
+  void PinMenu::closeFor(const void* owner) {
+    if (owner != nullptr && owner == m_owner) {
+      close();
+    }
+  }
+
+  void PinMenu::close() {
+    if (m_popup != nullptr && m_popup->isOpen()) {
+      m_popup->close();
+    }
+    m_owner = nullptr;
+  }
