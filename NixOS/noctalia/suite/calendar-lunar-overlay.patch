+
+    constexpr std::array<const char*, 10> kTianGan = {
+        "甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸"
+    };
+    constexpr std::array<const char*, 12> kDiZhi = {
+        "子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"
+    };
+    constexpr std::array<const char*, 12> kZodiac = {
+        "鼠", "牛", "虎", "兔", "龙", "蛇", "马", "羊", "猴", "鸡", "狗", "猪"
+    };
+    constexpr std::array<const char*, 13> kLunarMonths = {
+        "", "正", "二", "三", "四", "五", "六", "七", "八", "九", "十", "冬", "腊"
+    };
+    constexpr std::array<const char*, 31> kLunarDays = {
+        "",
+        "初一", "初二", "初三", "初四", "初五", "初六", "初七", "初八", "初九", "初十",
+        "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十",
+        "廿一", "廿二", "廿三", "廿四", "廿五", "廿六", "廿七", "廿八", "廿九", "三十"
+    };
+
+    int bitSlice(std::uint32_t data, int length, int shift) noexcept {
+      return static_cast<int>((data >> shift) & ((1U << length) - 1U));
+    }
+
+    int solarToDays(int y, int m, int d) noexcept {
+      const auto ymd = std::chrono::year{y} / std::chrono::month{static_cast<unsigned>(m)} / std::chrono::day{static_cast<unsigned>(d)};
+      return static_cast<int>(std::chrono::sys_days{ymd}.time_since_epoch().count());
+    }
+
+    bool isValidSolar(int y, int m, int d) noexcept {
+      if (y < kMinSupportedYear || y > kMaxSupportedYear || m < 1 || m > 12 || d < 1 || d > 31) {
+        return false;
+      }
+      const auto ymd = std::chrono::year{y} / std::chrono::month{static_cast<unsigned>(m)} / std::chrono::day{static_cast<unsigned>(d)};
+      return ymd.ok();
+    }
+
+    LunarDate convertSolarToLunar(int solarYear, int solarMonth, int solarDay) noexcept {
+      std::size_t index = static_cast<std::size_t>(solarYear - kTableStartYear);
+      if (index == 0 || index >= kSolarNewYear.size()) {
+        return {};
+      }
+      const std::uint32_t packedSolar =
+          (static_cast<std::uint32_t>(solarYear) << 9) | (static_cast<std::uint32_t>(solarMonth) << 5)
+          | static_cast<std::uint32_t>(solarDay);
+      if (kSolarNewYear[index] > packedSolar) {
+        --index;
+      }
+      if (index == 0 || index >= kLunarMonthDays.size()) {
+        return {};
+      }
+
+      const std::uint32_t cnyPacked = kSolarNewYear[index];
+      const int cnyYear = bitSlice(cnyPacked, 12, 9);
+      const int cnyMonth = bitSlice(cnyPacked, 4, 5);
+      const int cnyDay = bitSlice(cnyPacked, 5, 0);
+      int offset = solarToDays(solarYear, solarMonth, solarDay) - solarToDays(cnyYear, cnyMonth, cnyDay) + 1;
+
+      const std::uint32_t monthBits = kLunarMonthDays[index];
+      const int leapMonth = bitSlice(monthBits, 4, 13);
+
+      int lunarMonth = 1;
+      for (int i = 0; i < 13; ++i) {
+        const int daysInLunarMonth = bitSlice(monthBits, 1, 12 - i) == 1 ? 30 : 29;
+        if (offset > daysInLunarMonth) {
+          ++lunarMonth;
+          offset -= daysInLunarMonth;
+        } else {
+          break;
+        }
+      }
+
+      LunarDate out;
+      out.year = kTableStartYear + static_cast<int>(index);
+      out.month = lunarMonth;
+      out.day = offset;
+      out.isLeap = false;
+      if (leapMonth != 0 && lunarMonth > leapMonth) {
+        out.month = lunarMonth - 1;
+        if (lunarMonth == leapMonth + 1) {
+          out.isLeap = true;
+        }
+      }
+      return out;
+    }
+
+    std::string_view solarTermFor(int solarYear, int solarMonth, int solarDay) noexcept {
+      if (solarYear < kMinSupportedYear || solarYear > kMaxSupportedYear) {
+        return {};
+      }
+      const std::uint64_t packed = kPackedSolarTerms[static_cast<std::size_t>(solarYear - kMinSupportedYear)];
+      for (std::size_t i = 0; i < 24; ++i) {
+        if (kSolarTermMonths[i] != solarMonth) {
+          continue;
+        }
+        const int offset = static_cast<int>((packed >> (2U * i)) & 0x3ULL);
+        if (kSolarTermBaseDays[i] + offset == solarDay) {
+          return kSolarTermNames[i];
+        }
+      }
+      return {};
+    }
+
+    struct FestivalMatch {
+      std::string_view full;
+      std::string_view compact;
+    };
+
+    FestivalMatch festivalFor(
+        int solarYear, int solarMonth, int solarDay, const LunarDate& lunar, std::string_view solarTerm
+    ) noexcept {
+      // Check Chinese New Year's Eve (除夕): the day immediately before non-leap 正月初一.
+      const auto nextSys =
+          std::chrono::sys_days{std::chrono::year{solarYear} / std::chrono::month{static_cast<unsigned>(solarMonth)} / std::chrono::day{static_cast<unsigned>(solarDay)}}
+          + std::chrono::days{1};
+      const std::chrono::year_month_day nextYmd{nextSys};
+      const LunarDate nextLunar = convertSolarToLunar(
+          static_cast<int>(nextYmd.year()), static_cast<int>(static_cast<unsigned>(nextYmd.month())),
+          static_cast<int>(static_cast<unsigned>(nextYmd.day()))
+      );
+      if (!nextLunar.isLeap && nextLunar.month == 1 && nextLunar.day == 1) {
+        return {"除夕", "除夕"};
+      }
+
+      if (!lunar.isLeap) {
+        if (lunar.month == 1 && lunar.day == 1) {
+          return {"春节", "春节"};
+        }
+        if (lunar.month == 1 && lunar.day == 5) {
+          return {"破五节", "破五"};
+        }
+        if (lunar.month == 1 && lunar.day == 15) {
+          return {"元宵节", "元宵"};
+        }
+        if (lunar.month == 2 && lunar.day == 2) {
+          return {"龙抬头", "龙抬头"};
+        }
+        if (lunar.month == 5 && lunar.day == 5) {
+          return {"端午节", "端午"};
+        }
+        if (lunar.month == 7 && lunar.day == 7) {
+          return {"七夕节", "七夕"};
+        }
+        if (lunar.month == 7 && lunar.day == 15) {
+          return {"中元节", "中元"};
+        }
+        if (lunar.month == 8 && lunar.day == 15) {
+          return {"中秋节", "中秋"};
+        }
+        if (lunar.month == 9 && lunar.day == 9) {
+          return {"重阳节", "重阳"};
+        }
+        if (lunar.month == 10 && lunar.day == 1) {
+          return {"寒衣节", "寒衣"};
+        }
+        if (lunar.month == 12 && lunar.day == 8) {
+          return {"腊八节", "腊八"};
+        }
+        if (lunar.month == 12 && lunar.day == 23) {
+          return {"小年", "小年"};
+        }
+      }
+
+      if (solarTerm == "清明") {
+        return {"清明节", "清明"};
+      }
+      return {};
+    }
+
+  } // namespace
+
+  LunarDayInfo lookup(int solarYear, int solarMonth1Based, int solarDay) {
+    LunarDayInfo info;
+    if (!isValidSolar(solarYear, solarMonth1Based, solarDay)) {
+      return info;
+    }
+
+    const LunarDate lunar = convertSolarToLunar(solarYear, solarMonth1Based, solarDay);
+    if (lunar.month < 1 || lunar.month > 12 || lunar.day < 1 || lunar.day > 30) {
+      return info;
+    }
+
+    info.valid = true;
+    info.lunar = lunar;
+
+    if (lunar.isLeap) {
+      info.monthName = "闰";
+    }
+    info.monthName += kLunarMonths[static_cast<std::size_t>(lunar.month)];
+    info.monthName += "月";
+    info.dayName = kLunarDays[static_cast<std::size_t>(lunar.day)];
+    info.fullDate = info.monthName + info.dayName;
+
+    const int ganIdx = ((lunar.year - 4) % 10 + 10) % 10;
+    const int zhiIdx = ((lunar.year - 4) % 12 + 12) % 12;
+    info.ganzhiYear = std::string(kTianGan[static_cast<std::size_t>(ganIdx)])
+        + kDiZhi[static_cast<std::size_t>(zhiIdx)] + "年";
+    info.zodiac = kZodiac[static_cast<std::size_t>(zhiIdx)];
+
+    const std::string_view term = solarTermFor(solarYear, solarMonth1Based, solarDay);
+    if (!term.empty()) {
+      info.solarTerm = std::string(term);
+    }
+
+    const FestivalMatch fest = festivalFor(solarYear, solarMonth1Based, solarDay, lunar, term);
+    if (!fest.full.empty()) {
+      info.festival = std::string(fest.full);
+    }
+
+    if (!fest.compact.empty()) {
+      info.cellLabel = std::string(fest.compact);
+      info.cellKind = CellKind::Festival;
+    } else if (!info.solarTerm.empty()) {
+      info.cellLabel = info.solarTerm;
+      info.cellKind = CellKind::SolarTerm;
+    } else if (lunar.day == 1) {
+      info.cellLabel = info.monthName;
+      info.cellKind = CellKind::MonthFirst;
+    } else {
+      info.cellLabel = info.dayName;
+      info.cellKind = CellKind::Normal;
+    }
+
+    return info;
+  }
+
+} // namespace lunar_calendar
