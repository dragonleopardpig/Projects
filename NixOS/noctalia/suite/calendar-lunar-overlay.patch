new file mode 100644
index 0000000..3f5d8ac
--- /dev/null
+++ b/src/shell/calendar/lunar_calendar.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace lunar_calendar {
+
+  struct LunarDate {
+    int year = 0;
+    int month = 0; // 1..12
+    int day = 0;   // 1..30
+    bool isLeap = false;
+  };
+
+  enum class CellKind : std::uint8_t {
+    Normal,
+    MonthFirst,
+    SolarTerm,
+    Festival,
+  };
+
+  struct LunarDayInfo {
+    bool valid = false;
+    LunarDate lunar;
+    std::string monthName;  // e.g. "正月", "闰六月"
+    std::string dayName;    // e.g. "初一", "十五"
+    std::string fullDate;   // e.g. "正月初一"
+    std::string ganzhiYear; // e.g. "丙午年"
+    std::string zodiac;     // e.g. "马"
+    std::string festival;   // e.g. "春节" (empty when none)
+    std::string solarTerm;  // e.g. "立春" (empty when none)
+    std::string cellLabel;  // compact label for calendar grid cell
+    CellKind cellKind = CellKind::Normal;
+  };
+
+  // Convert a Gregorian date (1900..2100) into Chinese lunar calendar metadata.
+  LunarDayInfo lookup(int solarYear, int solarMonth1Based, int solarDay);
+
+} // namespace lunar_calendar
