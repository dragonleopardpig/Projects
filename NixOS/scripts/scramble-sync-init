#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ $# -gt 1 ]]; then
    echo 'Usage: scramble-sync-init [private|all]' >&2
    exit 2
fi
scope=${1:-private}
case "$scope" in
    private|all) ;;
    *)
        echo 'Public sync has been retired. Use scramble-sync-init for the single encrypted private folder.' >&2
        exit 2
        ;;
esac

config="$HOME/.config/rclone/rclone.conf"
export RCLONE_CONFIG="$config"
import="$HOME/.config/rclone/scramble-private-import.conf"
ready="$HOME/.config/rclone/scramble-private-v2-ready"

if [[ -e "$ready" ]]; then
    systemctl --user start scramble-private-sync.timer
    echo 'The single offline Scramble Private folder is already initialized.'
    exit 0
fi

if [[ ! -f "$config" ]]; then
    echo 'Configure local Scramble WebDAV first with scramble-host-prepare.' >&2
    exit 1
fi
if ! rclone listremotes | grep -qx 'scramble_drive:'; then
    echo 'The scramble_drive remote is missing; run scramble-host-prepare first.' >&2
    exit 1
fi

if [[ -e "$import" ]]; then
    python3 - "$config" "$import" <<'PY'
from configparser import RawConfigParser
from pathlib import Path
import os
import sys
import tempfile

target_path, import_path = map(Path, sys.argv[1:])
target = RawConfigParser()
target.read(target_path)
source = RawConfigParser()
source.read(import_path)
if source.sections() != ['scramble_private']:
    raise SystemExit('The import must contain only the scramble_private section')
if source.get('scramble_private', 'remote') != 'scramble_drive:EncryptedSync':
    raise SystemExit('Unexpected crypt destination')
if target.has_section('scramble_private'):
    if dict(target.items('scramble_private')) != dict(source.items('scramble_private')):
        raise SystemExit('A different crypt key already exists; refusing to overwrite it')
else:
    target.add_section('scramble_private')
    for key, value in source.items('scramble_private'):
        target.set('scramble_private', key, value)
    fd, temp = tempfile.mkstemp(dir=target_path.parent, prefix='.rclone-conf-')
    try:
        with os.fdopen(fd, 'w') as file:
            target.write(file)
        os.chmod(temp, 0o600)
        os.replace(temp, target_path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)
import_path.unlink()
PY
fi

if ! rclone listremotes | grep -qx 'scramble_private:'; then
    echo 'The existing private crypt key is missing. Transfer it from an initialized host; do not generate a replacement.' >&2
    exit 1
fi
systemctl --user start --no-block scramble-consolidate.service
echo 'Consolidation into ~/Scramble Private is running in the background. Check scramble-sync-status.'
