#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ $# -gt 1 ]]; then
    echo 'Usage: scramble-sync-init [public|private|all]' >&2
    exit 2
fi
scope=${1:-all}
case "$scope" in
    public|private|all) ;;
    *)
        echo 'Usage: scramble-sync-init [public|private|all]' >&2
        exit 2
        ;;
esac

config="$HOME/.config/rclone/rclone.conf"
export RCLONE_CONFIG="$config"
import="$HOME/.config/rclone/scramble-private-import.conf"
ready="$HOME/.config/rclone/scramble-ready"
public_ready="$HOME/.config/rclone/scramble-public-ready"
local_folder="$HOME/Documents/Scramble Sync"
public_folder="$HOME/Documents/Scramble Public"
units=(scramble-public-mount.service)
if [[ $scope != private ]]; then
    units+=(scramble-public-sync.timer)
fi
if [[ $scope != public ]]; then
    units+=(scramble-private-sync.timer scramble-private-mount.service)
fi

if [[ ( $scope == public || -e "$ready" ) && ( $scope == private || -e "$public_ready" ) ]]; then
    systemctl --user enable --now "${units[@]}"
    echo "The requested $scope sync is already initialized."
    exit 0
fi

if [[ ! -f "$config" ]]; then
    echo 'Configure local Scramble WebDAV first with scramble-host-prepare.' >&2
    exit 1
fi
if ! rclone listremotes | grep -qx 'scramble_drive:'; then
    echo 'The scramble_drive remote is missing; run scramble-host-prepare first.' >&2
    exit 1
fi

if [[ $scope != public && -e "$import" ]]; then
    python3 - "$config" "$import" <<'PY'
from configparser import RawConfigParser
from pathlib import Path
import os
import sys
import tempfile

target_path, import_path = map(Path, sys.argv[1:])
target = RawConfigParser()
target.read(target_path)
source = RawConfigParser()
source.read(import_path)
if source.sections() != ['scramble_private']:
    raise SystemExit('The import must contain only the scramble_private section')
if source.get('scramble_private', 'remote') != 'scramble_drive:EncryptedSync':
    raise SystemExit('Unexpected crypt destination')
if target.has_section('scramble_private'):
    if dict(target.items('scramble_private')) != dict(source.items('scramble_private')):
        raise SystemExit('A different crypt key already exists; refusing to overwrite it')
else:
    target.add_section('scramble_private')
    for key, value in source.items('scramble_private'):
        target.set('scramble_private', key, value)
    fd, temp = tempfile.mkstemp(dir=target_path.parent, prefix='.rclone-conf-')
    try:
        with os.fdopen(fd, 'w') as file:
            target.write(file)
        os.chmod(temp, 0o600)
        os.replace(temp, target_path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)
import_path.unlink()
PY
fi

rclone lsf scramble_drive: --max-depth 1 >/dev/null
systemctl --user enable --now scramble-public-mount.service

if [[ $scope != public && ! -e "$ready" ]]; then
    if ! rclone listremotes | grep -qx 'scramble_private:'; then
        echo 'The existing private crypt key is missing. Transfer it from an initialized host; do not generate a replacement.' >&2
        echo 'Public cloud browsing does not need this key. Run scramble-sync-init public to initialize only the public local folder.' >&2
        exit 1
    fi
    rclone cat scramble_private:Current/RCLONE_TEST >/dev/null
    if [[ -L "$local_folder" ]]; then
        echo 'The private sync folder is a symlink; refusing to initialize.' >&2
        exit 1
    fi
    mkdir -p "$local_folder"
    chmod 700 "$local_folder"
    if [[ -n $(find "$local_folder" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
        echo 'The private sync folder contains files; move them aside before the first sync.' >&2
        exit 1
    fi

    rclone copyto scramble_private:Current/RCLONE_TEST "$local_folder/RCLONE_TEST"
    rclone bisync "$local_folder" scramble_private:Current \
        --resync --check-access --max-delete 50 \
        --resilient --recover --max-lock 10m \
        --compare size,checksum --download-hash --color NEVER

    touch "$ready"
    chmod 600 "$ready"
fi

if [[ $scope != private && ! -e "$public_ready" ]]; then
    if [[ -L "$public_folder" ]]; then
        echo 'The public sync folder is a symlink; refusing to initialize.' >&2
        exit 1
    fi
    mkdir -p "$public_folder"
    chmod 700 "$public_folder"
    if [[ -n $(find "$public_folder" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
        echo 'The public sync folder contains files; move them aside before the first sync.' >&2
        exit 1
    fi

    rclone mkdir scramble_drive:PublicSync/Current
    public_markers=$(rclone lsf scramble_drive:PublicSync/Current --files-only --include RCLONE_TEST --max-depth 1)
    if ! grep -qx RCLONE_TEST <<<"$public_markers"; then
        printf '%s\n' 'Scramble public sync access check' | rclone rcat scramble_drive:PublicSync/Current/RCLONE_TEST
    fi
    rclone copyto scramble_drive:PublicSync/Current/RCLONE_TEST "$public_folder/RCLONE_TEST"
    rclone bisync "$public_folder" scramble_drive:PublicSync/Current \
        --resync --check-access --max-delete 50 \
        --resilient --recover --max-lock 10m \
        --compare size,checksum --download-hash --color NEVER

    touch "$public_ready"
    chmod 600 "$public_ready"
fi

systemctl --user enable --now "${units[@]}"
echo "The requested $scope sync is ready. Run scramble-sync-status to check both folders."
