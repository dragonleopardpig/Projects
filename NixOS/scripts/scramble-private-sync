#!/usr/bin/env bash
set -euo pipefail
umask 077

rclone=@RCLONE@
export RCLONE_CONFIG="$HOME/.config/rclone/rclone.conf"
local_folder="$HOME/Scramble Private"
local_history="$HOME/.local/state/scramble/history"
remote_folder='scramble_private:Current'
remote_history='scramble_private:History'

if [[ $# -gt 0 && ( $# -ne 1 || $1 != private ) ]]; then
    echo 'Usage: scramble-private-sync [private]' >&2
    exit 2
fi
if [[ ! -f $HOME/.config/rclone/scramble-private-v2-ready || ! -d $local_folder || -L $local_folder ]] ||
   mountpoint --quiet "$local_folder"; then
    echo 'Finish scramble-sync-init before syncing the real offline Scramble Private folder.' >&2
    exit 1
fi

# Scramble's WebDAV server is local to this host and may still be starting.
for attempt in {1..30}; do
    if "$rclone" lsf scramble_drive: --max-depth 1 >/dev/null 2>&1; then
        break
    fi
    sleep 1
done
"$rclone" lsf scramble_drive: --max-depth 1 >/dev/null

mkdir -p "$local_history"
stamp="$(date +%Y%m%d-%H%M%S)-$(hostname)"

"$rclone" bisync "$local_folder" "$remote_folder" \
    --check-access \
    --max-delete 50 \
    --resilient --recover --max-lock 10m \
    --compare size,checksum --download-hash --ignore-times \
    --exclude '/References/**' --exclude '/Misc/**' \
    --header-upload 'Content-Type: application/octet-stream' \
    --webdav-encoding Colon \
    --transfers 1 --checkers 2 --tpslimit 2 --retries-sleep 30s \
    --contimeout 10s --timeout 30m \
    --backup-dir1 "$local_history/$stamp" \
    --backup-dir2 "$remote_history/$stamp" \
    --color NEVER

library_options=(
    --webdav-encoding Colon --header-upload 'Content-Type: application/octet-stream'
    --transfers 1 --checkers 2 --tpslimit 2 --contimeout 10s --timeout 30m
    --retries-sleep 30s --color NEVER
)
for library in References Misc; do
    if [[ -L "$local_folder/$library" ]]; then
        echo "The $library library must be a real folder, not a symlink." >&2
        exit 1
    fi
    if [[ ! -d "$local_folder/$library" ]]; then
        if ! "$rclone" lsf "$remote_folder" --dirs-only --max-depth 1 | grep -Fxq "$library/"; then
            continue
        fi
        mkdir -p "$local_folder/$library"
    fi
    "$rclone" mkdir "$remote_folder/$library" "${library_options[@]}"
    "$rclone" copy "$local_folder/$library" "$remote_folder/$library" --ignore-existing "${library_options[@]}"
    "$rclone" copy "$remote_folder/$library" "$local_folder/$library" --ignore-existing "${library_options[@]}"
done
