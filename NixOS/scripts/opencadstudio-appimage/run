#!/usr/bin/env bash
set -euo pipefail

app_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/opencadstudio-appimage"
appimage="${app_dir}/current.AppImage"

if [[ ! -f "${appimage}" ]]; then
  zenity --error --title="Open CAD Studio" \
    --text="No AppImage is installed yet. Connect to the internet and launch Open CAD Studio again to download it." \
    --width=460 || true
  exit 1
fi

if ! command -v appimage-run >/dev/null 2>&1; then
  zenity --error --title="Open CAD Studio" \
    --text="The AppImage is downloaded, but NixOS AppImage support is not active yet." \
    --width=460 || true
  exit 1
fi

exec appimage-run "${appimage}" "$@"
