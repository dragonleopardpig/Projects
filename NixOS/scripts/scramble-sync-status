#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 1 || ( $# -eq 1 && $1 != --brief ) ]]; then
    echo 'Usage: scramble-sync-status [--brief]' >&2
    exit 2
fi

ready="$HOME/.config/rclone/scramble-private-v2-ready"
folder="$HOME/Scramble Private"
phase_file="$HOME/.local/state/scramble/consolidation/phase"
if [[ $(hostname) == M90aPro ]]; then
    backend=scramble-desktop.service
    backend_name='Scramble Desktop'
else
    backend=scramble-webdav.service
    backend_name='Scramble CLI WebDAV'
fi

state=ok
summary='Scramble Private is healthy'
last=''
migration_state=$(systemctl --user show --value -p ActiveState scramble-consolidate.service)

if [[ -f $HOME/.local/state/scramble/stopped ]] &&
   ! systemctl --user is-active --quiet scramble-desktop.service &&
   ! systemctl --user is-active --quiet "$backend"; then
    state=stopped
    summary='Scramble is stopped; launch Scramble Desktop to reconnect'
elif [[ ! -f $HOME/.config/rclone/rclone.conf ]]; then
    state=pending
    summary='Complete the Scramble folder-sync login and import the existing private crypt key'
elif [[ $migration_state =~ ^(active|activating|deactivating)$ ]]; then
    state=busy
    summary='Consolidating all files into the encrypted Scramble Private folder'
    if [[ -s $phase_file ]]; then summary=$(cat "$phase_file"); fi
elif [[ ! -f $ready ]]; then
    state=pending
    summary='Launch Scramble Desktop to consolidate the existing folders using the original crypt key'
    if systemctl --user is-failed --quiet scramble-consolidate.service; then
        state=error
        summary='Consolidation is paused safely; use Sync Now to retry'
        if [[ -s $phase_file ]]; then summary=$(cat "$phase_file"); fi
    fi
elif systemctl --user is-failed --quiet scramble-session.service; then
    state=error
    summary='Automatic startup failed; check journalctl --user -u scramble-session.service'
elif ! systemctl --user is-active --quiet "$backend"; then
    state=error
    summary="$backend_name is stopped"
elif ! systemctl --user is-active --quiet scramble-cloud-mount.service ||
     ! mountpoint --quiet "$HOME/Scramble Cloud"; then
    state=error
    summary='The Scramble Cloud view is unmounted; use Sync Now to reconnect'
elif [[ ! -d $folder || -L $folder ]] || mountpoint --quiet "$folder"; then
    state=error
    summary='Scramble Private must be the real writable offline folder, not a cloud mount'
elif ! systemctl --user is-active --quiet scramble-private-sync.timer; then
    state=error
    summary='The private sync timer is stopped'
else
    unit=scramble-private-sync.service
    sync_state=$(systemctl --user show --value -p ActiveState "$unit")
    result=$(systemctl --user show --value -p Result "$unit")
    exit_status=$(systemctl --user show --value -p ExecMainStatus "$unit")
    last_us=$(systemctl --user show --value -p ExecMainExitTimestampMonotonic "$unit")
    if [[ $sync_state == active || $sync_state == activating ]]; then
        state=busy
        summary='Private sync is running now'
    elif [[ $result != success || $exit_status != 0 ]]; then
        state=error
        summary='The last private sync failed'
    elif [[ ! $last_us =~ ^[0-9]+$ || $last_us -eq 0 ]]; then
        state=pending
        summary='Waiting for the first private sync'
    else
        read -r uptime _ < /proc/uptime
        age=$(( ${uptime%%.*} - last_us / 1000000 ))
        if (( age < 0 )); then age=0; fi
        last="Last completed sync $((age / 60)) minute(s) ago"
        if (( age > 900 )); then
            state=error
            summary='Private sync is overdue by more than 15 minutes'
        fi
    fi
fi

if [[ ${1:-} == --brief ]]; then
    printf '%s|%s.%s\n' "$state" "$summary" "${last:+ $last.}"
else
    printf 'Scramble: %s\n' "$summary"
    printf 'Connection: %s (%s)\n' "$backend_name" "$(systemctl --user is-active "$backend" 2>/dev/null || true)"
    printf 'Desktop: %s\n' "$(systemctl --user is-active scramble-desktop.service 2>/dev/null || true)"
    printf 'Private sync timer: %s\n' "$(systemctl --user is-active scramble-private-sync.timer 2>/dev/null || true)"
    if [[ -n $last ]]; then printf '%s\n' "$last"; fi
    printf 'Offline folder: %s\n' "$folder"
    printf 'Cloud view: %s (decrypted private folder, read-only; %s)\n' "$HOME/Scramble Cloud" "$(systemctl --user is-active scramble-cloud-mount.service 2>/dev/null || true)"
    printf 'Cloud storage: rclone-crypt encrypted private storage\n'
    printf 'Libraries: References and Misc copy new files without overwriting existing ones\n'
fi
