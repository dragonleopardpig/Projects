#!/usr/bin/env bash

export DIRENV_WARN_TIMEOUT=20s

# ~/Projects only needs Node.js/npm. Do not load devenv/flake here; child
# projects with their own .envrc can opt into their own environments.
if ! command -v npm >/dev/null 2>&1 && [[ -x /run/current-system/sw/bin/npm ]]; then
  PATH_add /run/current-system/sw/bin
fi

export NPM_CONFIG_PREFIX="$PWD/.direnv/npm-global"
mkdir -p "$NPM_CONFIG_PREFIX/bin"
PATH_add "$NPM_CONFIG_PREFIX/bin"
