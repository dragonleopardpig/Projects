;;; strata-dirvish-window-tests.el --- Window integration regression tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'term)
(require 'hl-line)
(require 'transpose-frame)
(require 'strata-dirvish)

(defmacro strata-window-test--with-browser (mode &rest body)
  "Create an isolated browser in MODE, then evaluate BODY."
  (declare (indent 1) (debug t))
  `(let* ((directory (make-temp-file "strata-window-test-" t))
          (strata-dirvish-state-dir (make-temp-file "strata-window-state-" t))
          (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
          (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
          (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
          (strata-prefs-current (strata-prefs--create :browser-mode ,mode :sidebar-expanded t
                                                    :restore-tabs nil :show-thumbnails nil))
          (strata-workspace-tabs nil) (strata-active-tab-index 0)
          (strata-sidebar-window nil) (strata-preview-standalone-window nil)
          (strata-visited-folders nil)
          (override dirvish-override-dired-mode)
          (width (frame-width)) (height (frame-height)))
     (unwind-protect
         (save-window-excursion
           (let ((ignore-window-parameters t))
             (strata-windows--unatom (frame-root-window))
             (delete-other-windows)
             (strata-windows--tag (selected-window) nil nil))
           (set-frame-size (selected-frame) 200 65)
           (make-directory (expand-file-name "literature" directory))
           (write-region "A preview file\n" nil (expand-file-name "sample.txt" directory) nil 'silent)
           (dirvish-override-dired-mode 1)
           (strata-dirvish-setup)
           (strata-open-location directory)
           (when (eq ,mode 'columns)
             ;; Window-buffer-change hooks are deferred in batch Emacs.
             (setf (dv-curr-layout (dirvish-curr)) dirvish-default-layout)
             (dirvish--build-layout (dirvish-curr)))
           (let* ((main (selected-window))
                  (group (window-parameter main 'strata-window-group))
                  (pane (strata-active-pane)))
             ,@body))
       (dirvish-override-dired-mode (if override 1 -1))
       (set-frame-size (selected-frame) width height)
       (dolist (buffer (buffer-list))
         (when (and (buffer-live-p buffer)
                    (or (string-prefix-p "*Strata Window Test" (buffer-name buffer))
                   (with-current-buffer buffer
                      (and default-directory (string-prefix-p directory default-directory)))))
           (let ((kill-buffer-query-functions nil))
             (when-let ((process (get-buffer-process buffer)))
               (delete-process process))
             (kill-buffer buffer))))
       (delete-directory directory t)
       (delete-directory strata-dirvish-state-dir t))))

(defun strata-window-test--roles (group)
  "Return GROUP's sorted visible window roles."
  (sort (mapcar (lambda (w) (window-parameter w 'strata-window-role))
                (strata-windows--owned group)) #'string<))

(ert-deftest strata-test-window-standard-splits-contain-columns ()
  "C-x 2/3 leave all browser windows together and preserve navigation."
  (strata-window-test--with-browser 'columns
    (let ((roles (strata-window-test--roles group))
          (buffer (get-buffer-create "*Strata Window Test Editor*")))
      (should (memq 'parent roles))
      (should (memq 'preview roles))
      (should (memq 'sidebar roles))
      (should (eq (key-binding (kbd "C-x 3")) #'split-window-right))
      (dolist (split '(split-window-right split-window-below))
        (let ((other (funcall split)))
          (should-not (window-parameter other 'strata-window-group))
          (should-not (window-dedicated-p other))
          ;; A new split initially clones the Dired buffer without stealing DV.
          (with-selected-window other
            (dirvish-pre-redisplay-h other)
            (dirvish-winbuf-change-h other))
          (should (eq (dv-root-window (strata-windows--group-dv group)) main))
          (set-window-buffer other buffer)
          (strata-open-location (expand-file-name "literature" directory))
          (dirvish--build-layout (dirvish-curr))
          (should (eq (window-buffer other) buffer))
          (should (equal roles (strata-window-test--roles group)))
          (should-not (strata-windows--ancestor-p
                       (strata-windows--root (strata-windows--owned group)) other))
          (delete-window other)
          (strata-open-location directory))))))

(ert-deftest strata-test-window-transpose-preserves-bundle-and-references ()
  "Transpose/rotate preserve columns, focus, window overlays and editor state."
  (strata-window-test--with-browser 'columns
    (let* ((roles (strata-window-test--roles group))
           (dv (dirvish-curr))
           (other (split-window-right))
           (buffer (get-buffer-create "*Strata Window Test Editor*"))
           (overlay (with-current-buffer (window-buffer main) (make-overlay (point-min) (point-min)))))
      (set-window-buffer other buffer)
      (overlay-put overlay 'window main)
      (unwind-protect
          (dolist (command '(transpose-frame transpose-frame flop-frame flip-frame
                             rotate-frame-clockwise rotate-frame-anticlockwise))
            (funcall command)
            (setq main (dv-root-window dv))
            (should (window-live-p main))
            (should (eq (selected-window) main))
            (should (eq (strata-pane-state-window pane) main))
            (should (eq (window-parameter (dv-preview-window dv) 'strata-window-role) 'preview))
            (should (eq (window-parameter strata-sidebar-window 'strata-window-role) 'sidebar))
            (should (equal roles (strata-window-test--roles group)))
            (should (eq (overlay-get overlay 'window) main))
            (let ((editor (get-buffer-window buffer)))
              (should (window-live-p editor))
              (should-not (window-parameter editor 'strata-window-group)))
            (should (< (car (window-edges main)) (car (window-edges (dv-preview-window dv))))))
        (delete-overlay overlay)))))

(ert-deftest strata-test-window-terminal-transpose-and-toggle ()
  "Transposition keeps terminal processes and pane references usable."
  (strata-window-test--with-browser 'columns
    (let ((buffer (get-buffer-create "*Strata Window Test Terminal*")))
      (with-current-buffer buffer (term-mode))
      (let ((process (make-process :name "strata-window-test-terminal" :buffer buffer
                                   :command '("cat") :noquery t)))
        (cl-letf (((symbol-function 'strata-pane--spawn-terminal) (lambda (&rest _) buffer)))
          (strata-toggle-pane-terminal))
        (let* ((terminal (selected-window))
               (dv (strata-windows--group-dv group))
               (roles (strata-window-test--roles group)))
          (should (eq (window-parameter terminal 'strata-window-role) 'terminal))
          (transpose-frame)
          (setq terminal (get-buffer-window buffer) main (dv-root-window dv))
          (should (eq (selected-window) terminal))
          (should (eq (strata-pane-state-window pane) main))
          (should (< (car (window-edges main)) (car (window-edges terminal))))
          (should (equal roles (strata-window-test--roles group)))
          (strata-panes--sync-active-pane-from-window terminal)
          (should (eq (strata-pane-state-window pane) main))
          (strata-toggle-pane-terminal)
          (should-not (get-buffer-window buffer))
          (should (eq (selected-window) main))
          (should (process-live-p process))
          (strata-toggle-pane-terminal)
          (should (eq (window-buffer (selected-window)) buffer))
          (should (eq (get-buffer-process buffer) process))
          ;; With an outside editor, transpose the complete app as one unit.
          (let* ((editor (split-window-right))
                 (editor-buffer (get-buffer-create "*Strata Window Test Editor*")))
            (set-window-buffer editor editor-buffer)
            (transpose-frame)
            (should (window-live-p (get-buffer-window editor-buffer)))
            (should (equal roles (strata-window-test--roles group)))
            (should (eq (get-buffer-process buffer) process))
            (strata-toggle-pane-terminal)
            (should (window-live-p (strata-pane-state-window pane)))))))))

(ert-deftest strata-test-window-view-switch-and-quit-preserve-editor ()
  "All views, preview/sidebar toggles and quitting stay within the browser."
  (strata-window-test--with-browser 'columns
    (let* ((other (split-window-right))
           (buffer (get-buffer-create "*Strata Window Test Editor*")))
      (set-window-buffer other buffer)
      (dolist (mode '(list compact icons columns list columns))
        (strata-switch-view-mode mode)
        (should (eq (window-buffer other) buffer))
        (should (eq (window-parameter (selected-window) 'strata-window-group) group))
        (if (eq mode 'columns)
            (dirvish--build-layout (dirvish-curr))
          (strata-goto-file (expand-file-name "sample.txt" directory))
          (strata-preview-at-point)
          (should (window-live-p strata-preview-standalone-window)))
        (transpose-frame)
        (setq other (get-buffer-window buffer))
        (should (window-live-p other))
        (should-not (window-parameter other 'strata-window-group))
        (unless (eq mode 'columns)
          (should (eq (window-parameter strata-preview-standalone-window 'strata-window-role)
                      'standalone-preview))))
      (strata-sidebar-toggle)
      (should (window-live-p (selected-window)))
      (should (eq (window-buffer other) buffer))
      (strata-sidebar-toggle)
      (should (window-live-p strata-sidebar-window))
      (dirvish-quit)
      (should (window-live-p other))
      (should (eq (window-buffer other) buffer)))))

(ert-deftest strata-test-window-default-maximize-close-and-switch-buffer ()
  "C-x 0/1 and C-x b retain normal Emacs meanings around the browser."
  (strata-window-test--with-browser 'columns
    (let ((other (split-window-right))
          (buffer (get-buffer-create "*Strata Window Test Editor*"))
          (roles (strata-window-test--roles group)))
      (set-window-buffer other buffer)
      (delete-other-windows)
      (should-not (window-live-p other))
      (should (equal roles (strata-window-test--roles group)))
      ;; Keeping the only application group is harmless.
      (delete-other-windows)
      (let ((editor (split-window-right)))
        (set-window-buffer editor buffer)
        (delete-window main)
        (should (eq (window-buffer (selected-window)) buffer))
        (should (one-window-p t)))
      (strata-open-location directory)
      (when (dv-curr-layout (dirvish-curr)) (dirvish--build-layout (dirvish-curr)))
      (switch-to-buffer buffer)
      (strata-windows--reconcile)
      (should (eq (window-buffer (selected-window)) buffer))
      (should (one-window-p t))
      (should-not (window-parameter (selected-window) 'strata-window-group)))))

(ert-deftest strata-test-window-transpose-error-restores-usable-layout ()
  "A failed layout transformation restores editor buffers and window roles."
  (strata-window-test--with-browser 'columns
    (let* ((other (split-window-right))
           (buffer (get-buffer-create "*Strata Window Test Editor*"))
           (roles (strata-window-test--roles group))
           (dv (dirvish-curr)))
      (set-window-buffer other buffer)
      (let ((arrangement (transpose-frame-get-arrangement)))
        (should-error (strata-windows--transpose-set
                       (lambda (&rest _) (delete-other-windows) (error "Test interrupted layout"))
                       arrangement nil 'transpose)))
      (should (window-live-p (get-buffer-window buffer)))
      (should (window-live-p (dv-root-window dv)))
      (should (eq (strata-pane-state-window pane) (dv-root-window dv)))
      (should (window-live-p (dv-preview-window dv)))
      (should (equal roles (strata-window-test--roles group))))))

(provide 'strata-dirvish-window-tests)
;;; strata-dirvish-window-tests.el ends here
