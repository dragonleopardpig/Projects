(ert-deftest strata-test-mouse-back-forward-target-pane-history ()
  "Thumb buttons use the hovered pane, advance once, and stop at history ends."
  (dolist (view '(columns list compact icons))
    (strata-test--with-selection-view view
      (let* ((left (selected-window))
             (right (split-window-right))
             (buffer (generate-new-buffer " *Strata Mouse History*"))
             (pane1 (make-strata-pane-state :id 1 :dir "left" :window left :buffer strata-test--buf))
             (pane2 (make-strata-pane-state :id 2 :dir "third" :window right :buffer buffer
                                            :history-back '("second" "first")))
             (tab (make-strata-tab-state :split-p t :pane1 pane1 :pane2 pane2))
             (strata-workspace-tabs (list tab)) (strata-active-tab-index 0))
        (unwind-protect
            (progn
              (with-current-buffer buffer (strata-compact-mode))
              (set-window-buffer right buffer)
              (cl-letf (((symbol-function 'strata-open-location)
                         (lambda (location &optional _)
                           (setf (strata-pane-state-dir (strata-active-pane)) location))))
                (dolist (tenxer '(nil t))
                  (select-window left)
                  (strata-dirvish-tenxer-mode (if tenxer 1 -1))
                  (setf (strata-tab-state-active-pane tab) 1)
                  (let ((last-input-event (list 'mouse-8 (list right 1 '(10 . 10) 0) 1)))
                    (call-interactively (key-binding [mouse-8])))
                  (should (= (strata-tab-state-active-pane tab) 2))
                  (should (equal (strata-pane-state-dir pane2) "second"))
                  (should (equal (strata-pane-state-dir pane1) "left"))
                  ;; Press is consumed; release, double-click and hardware
                  ;; aliases each represent exactly one navigation action.
                  (call-interactively (lookup-key strata-default-keymap [down-mouse-8]))
                  (should (equal (strata-pane-state-dir pane2) "second"))
                  (let ((last-input-event 'XF86Forward))
                    (call-interactively (lookup-key strata-default-keymap [XF86Forward])))
                  (should (equal (strata-pane-state-dir pane2) "third"))
                  (strata-mouse-history-forward)
                  (should (equal (strata-pane-state-dir pane2) "third")))
                (strata-mouse-history-back (list 'double-mouse-8 (list right 1 '(10 . 10) 0) 2))
                (should (equal (strata-pane-state-dir pane2) "second"))
                (strata-mouse-history-back (list 'mouse-8 (list right 1 '(10 . 10) 0) 1))
                (should (equal (strata-pane-state-dir pane2) "first"))
                (strata-mouse-history-back)
                (should (equal (strata-pane-state-dir pane2) "first"))))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(defun strata-test--wait-for-job (job)
  "Wait for archive JOB and require success, including its output on failure."
  (let ((deadline (+ (float-time) 20)))
    (while (and (eq (plist-get job :status) 'running) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (equal (list (plist-get job :status) (and (not (eq (plist-get job :status) 'done))
                                                   (plist-get job :output)))
                   '(done nil)))))

(defun strata-test--archive-roundtrip (format encrypted)
  "Create and extract real archives in FORMAT, optionally ENCRYPTED."
  (let* ((root (make-temp-file "strata-archive-test-" t))
         (default-directory (file-name-as-directory root))
         (file (expand-file-name "-notes with spaces.txt" root))
         (folder (expand-file-name "folder with spaces" root))
         (archive (expand-file-name (concat "bundle." format) root))
         (destination (expand-file-name "extracted" root))
         (strata-jobs-list nil) (strata-next-job-id 0)
         (secret "test archive password")
         confirmed)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory (file-name-as-directory root))
          (write-region "file contents" nil file nil 'silent)
          (make-directory folder)
          (write-region "nested contents" nil (expand-file-name "nested.txt" folder) nil 'silent)
          (make-directory destination)
          (cl-letf (((symbol-function 'strata-selected-files) (lambda () (list file folder)))
                    ((symbol-function 'strata-ui-read-string) (lambda (&rest _) "bundle"))
                    ((symbol-function 'strata-ui-completing-read) (lambda (&rest _) format))
                    ((symbol-function 'strata-ui-y-or-n-p) (lambda (&rest _) nil))
                    ((symbol-function 'strata-ui-read-passwd)
                     (lambda (_prompt &optional confirm &rest _)
                       (setq confirmed confirm) (copy-sequence secret)))
                    ((symbol-function 'strata-refresh-active-view) #'ignore)
                    ((symbol-function 'strata-goto-file) #'ignore))
            (if encrypted (strata-archive-compress-encrypted) (strata-archive-compress))
            (strata-test--wait-for-job (car strata-jobs-list))
            (should (file-exists-p archive))
            (should (eq (not (null confirmed)) encrypted))
            (should (equal (sort (strata-archive--top-level-roots archive (when encrypted secret)) #'string<)
                           '("-notes with spaces.txt" "folder with spaces")))
            (when encrypted
              ;; Both ZIP data and 7z encrypted headers reject a wrong password.
              (should-not (eq 0 (call-process "7z" nil nil nil "t" "-pwrong" "--" archive))))
            (cl-letf (((symbol-function 'strata-current-file) (lambda () archive))
                      ((symbol-function 'strata-ui-read-directory-name) (lambda (&rest _) destination)))
              (strata-archive-extract t))
            (strata-test--wait-for-job (car strata-jobs-list))
            (let ((unpacked (expand-file-name "bundle" destination)))
              (should (equal (with-temp-buffer
                               (insert-file-contents (expand-file-name "-notes with spaces.txt" unpacked))
                               (buffer-string)) "file contents"))
              (should (equal (with-temp-buffer
                               (insert-file-contents (expand-file-name "folder with spaces/nested.txt" unpacked))
                               (buffer-string)) "nested contents")))))
      (delete-directory root t))))

(ert-deftest strata-test-archive-compress-and-extract-real-formats ()
  "ZIP, 7z and compressed tar round trips preserve files, folders and spaces."
  (skip-unless (and (executable-find "7z") (executable-find "tar") (executable-find "zstd")))
  (dolist (format '("zip" "7z" "tar" "tar.gz" "tar.zst"))
    (ert-info ((format "Archive format: %s" format))
      (strata-test--archive-roundtrip format nil))))

(ert-deftest strata-test-archive-encrypted-roundtrip ()
  "Encrypted archives require confirmation, reject wrong passwords and reopen."
  (skip-unless (executable-find "7z"))
  (dolist (format '("7z" "zip"))
    (ert-info ((format "Encrypted format: %s" format))
      (strata-test--archive-roundtrip format t))))

(ert-deftest strata-test-archive-invalid-name-and-empty-password ()
  "Invalid names and empty encryption passwords never start a background job."
  (strata-test--with-selection-view 'list
    (let ((name "../escape") (password "unused") started)
      (cl-letf (((symbol-function 'strata-ui-read-string) (lambda (&rest _) name))
                ((symbol-function 'strata-ui-completing-read) (lambda (&rest _) "7z"))
                ((symbol-function 'strata-ui-read-passwd) (lambda (&rest _) (copy-sequence password)))
                ((symbol-function 'strata-run-job) (lambda (&rest _) (setq started t))))
        (should-error (strata-archive-compress-encrypted) :type 'user-error)
        (setq name "encrypted" password "")
        (should-error (strata-archive-compress-encrypted) :type 'user-error)
        (should-not started)
        (should-not (file-exists-p (expand-file-name "encrypted.7z" strata-test--dir)))))))

(ert-deftest strata-test-archive-failed-job-skips-success-callback ()
  "A failed archive command records the error without announcing extraction."
  (let ((strata-jobs-list nil) called)
    (let* ((job (strata-run-job "Test failure" '("false") (lambda () (setq called t))))
           (deadline (+ (float-time) 5)))
      (while (and (eq (plist-get job :status) 'running) (< (float-time) deadline))
        (accept-process-output nil 0.05))
      (should (eq (plist-get job :status) 'failed))
      (should-not called))))

(ert-deftest strata-test-context-archive-actions-at-top-level ()
  "Right-click exposes extraction, compression and encryption in all views."
  (dolist (view '(columns list compact icons))
    (strata-test--with-selection-view view
      (let ((archive (expand-file-name "example.ZIP" strata-test--dir)) menu)
        (write-region "fixture" nil archive nil 'silent)
        (strata-refresh-active-view)
        (cl-letf (((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                  ((symbol-function 'popup-menu) (lambda (value &rest _) (setq menu value))))
          (strata-mouse-context-menu (strata-test--selection-event 'mouse-3 archive))
          (should (eq (strata-test--popup-menu-command menu "Extract Here") 'strata-archive-extract))
          (should (eq (strata-test--popup-menu-command menu "Compress…") 'strata-archive-compress))
          (should (eq (strata-test--popup-menu-command menu "Compress with Encryption…")
                      'strata-archive-compress-encrypted))
          (let ((item (cl-find-if (lambda (entry) (and (consp entry) (equal (nth 2 entry) "Extract Here")))
                                  (cdr menu))))
            (should (or (not (plist-member (nthcdr 4 item) :visible))
                        (plist-get (nthcdr 4 item) :visible))))
          ;; A marked group keeps the batch; extraction is hidden for that group.
          (strata-view--set-entry-mark archive t)
          (strata-view--set-entry-mark (car strata-test--files) t)
          (strata-mouse-context-menu (strata-test--selection-event 'mouse-3 archive))
          (let ((item (cl-find-if (lambda (entry) (and (consp entry) (equal (nth 2 entry) "Extract Here")))
                                  (cdr menu))))
            (should-not (plist-get (nthcdr 4 item) :visible)))
          (should (= (length (strata-selected-files)) 2)))))))

(ert-deftest strata-test-mouse-drop-selection-into-sibling-folder ()
  "Marked files drop into sibling folders, with native tracking and fallback."
  (dolist (view '(columns list compact icons))
    (dolist (tracked '(t nil))
      (strata-test--with-selection-view view
        (let* ((folder (expand-file-name "target folder" strata-test--dir))
               (a (car strata-test--files)) (c (nth 2 strata-test--files))
               (strata-sidebar-window nil) (strata-undo-stack nil) (strata-redo-stack nil))
          (make-directory folder)
          (strata-refresh-active-view)
          (strata-view--set-entry-mark a t)
          (strata-view--set-entry-mark c t)
          (let* ((start (event-start (strata-test--selection-event 'down-mouse-1 a)))
                 (end (event-start (strata-test--selection-event 'mouse-1 folder 80))))
            (if tracked
                (progn
                  (strata-mouse-down-entry (list 'down-mouse-1 start 1))
                  (should (plist-get strata-mouse--drag-state :carry-marked-p))
                  ;; Passing another file must not add it to the carried group.
                  (strata-mouse--drag-move (strata-test--selection-event 'mouse-movement (nth 1 strata-test--files) 30))
                  (strata-mouse--drag-move (list 'S-mouse-movement end))
                  (strata-mouse--on-drag-exit)
                  (strata-mouse-drag-move (list 'S-drag-mouse-1 start end)))
              (strata-mouse-drag-move (list 'S-drag-mouse-1 start end))))
          (dolist (file (list a c))
            (should-not (file-exists-p file))
            (should (file-exists-p (expand-file-name (file-name-nondirectory file) folder))))
          (should (file-exists-p (nth 1 strata-test--files)))
          (should-not (strata-marked-files-only))
          (strata-undo)
          (should (file-exists-p a))
          (should (file-exists-p c)))))))

(ert-deftest strata-test-mouse-copy-single-file-into-sibling-folder ()
  "Ctrl-drag copies an unmarked file rather than marks swept over en route."
  (dolist (view '(columns list compact icons))
    (strata-test--with-selection-view view
      (let* ((folder (expand-file-name "target" strata-test--dir))
             (a (car strata-test--files)) (strata-undo-stack nil))
