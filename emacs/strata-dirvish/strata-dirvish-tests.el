(ert-deftest strata-test-ui-gtk-output-cancel-and-quit-cleanup ()
  "GTK output excludes diagnostics, preserves literal names and cleans up on cancel/C-g."
  (let* ((root (make-temp-file "strata-gtk-test-" t))
         (program (expand-file-name "dialog" root))
         (find-executable (symbol-function 'executable-find)))
    (unwind-protect
        (cl-letf (((symbol-function 'executable-find)
                   (lambda (name &rest args)
                     (if (equal name "zenity") program (apply find-executable name args)))))
          (dolist (outcome '(success cancel quit))
            (with-temp-file program
              (insert "#!/bin/sh\n")
              (pcase outcome
                ('success (insert "printf '%s\\n' 'GTK diagnostic' >&2\nprintf '%s\\n' 'a;$(literal) & <name>.txt'\n"))
                ('cancel (insert "exit 1\n"))
                ('quit (insert "exec sleep 30\n"))))
            (set-file-modes program #o700)
            (if (eq outcome 'success)
                (should (equal (strata-ui--gtk-entry "Name:" "initial") "a;$(literal) & <name>.txt"))
              (should
               (eq (condition-case nil
                       (if (eq outcome 'quit)
                           (cl-letf (((symbol-function 'accept-process-output)
                                      (lambda (&rest _) (signal 'quit nil))))
                             (strata-ui--gtk-entry "Name:"))
                         (strata-ui--gtk-entry "Name:"))
                     (quit 'cancelled))
                   'cancelled)))
            (should-not (cl-some (lambda (buffer)
                                  (string-prefix-p " *Strata dialog" (buffer-name buffer)))
                                (buffer-list)))
            (should-not (cl-some (lambda (process)
                                  (and (string-prefix-p "strata-dialog" (process-name process))
                                       (process-live-p process)))
                                (process-list)))))
      (delete-directory root t))))

(defun strata-test--main-menu-item (&rest labels)
  "Return the actual menu item reached through LABELS in the Strata main menu."
  (let ((menu strata-menu-map) item)
    (dolist (label labels)
      (setq item (cl-find-if (lambda (entry) (and (consp entry) (eq (cadr entry) 'menu-item)
                                                (equal (nth 2 entry) label))) (cdr menu)))
      (should item)
      (setq menu (nth 3 item)))
    item))

(defun strata-test--main-menu-enabled-p (&rest labels)
  "Evaluate the real menu enable expression for LABELS."
  (eval (plist-get (nthcdr 4 (apply #'strata-test--main-menu-item labels)) :enable) t))

(ert-deftest strata-test-main-menu-installed-global-and-idempotent ()
  "A global menu offers launch/help outside browsers and disables file operations."
  (strata-menu-install)
  (strata-menu-install)
  (should (keymapp (lookup-key global-map [menu-bar strata])))
  (should (= (cl-count #'strata-menu--update menu-bar-update-hook) 1))
  (let ((strata-workspace-tabs nil) (strata-clipboard nil))
    (save-window-excursion
      (with-temp-buffer
        (switch-to-buffer (current-buffer))
        (strata-menu--update)
        (should-not strata-workspace-tabs)
        (should (strata-test--main-menu-enabled-p "Go" "Open File Browser"))
        (should (strata-test--main-menu-enabled-p "Tools & Help" "Shortcut Reference"))
        (should-not (strata-test--main-menu-enabled-p "Files" "Rename…"))
        (should-not (strata-test--main-menu-enabled-p "Files" "New File…"))
        (should-not (strata-test--main-menu-enabled-p "View & Sort" "Columns"))
        (should-not (strata-test--main-menu-enabled-p "Clipboard & Transfers" "Paste (Keep Both)"))
        ;; An unrelated shell must not be mistaken for Strata's drawer.
        (setq major-mode 'eshell-mode)
        (strata-menu--update)
        (should-not (strata-test--main-menu-enabled-p "Panes, Tabs & Sidebar" "Toggle Pane Terminal"))))))

(ert-deftest strata-test-main-menu-selection-clipboard-and-layouts ()
  "Every directory layout updates checked states and selection-sensitive actions."
  (dolist (view '(columns list compact icons))
    (strata-test--with-selection-view view
      (let ((strata-clipboard nil))
        (strata-menu--update)
        (should (strata-test--main-menu-enabled-p "Files" "Rename…"))
        (should (strata-test--main-menu-enabled-p "Files" "New Folder…"))
        (should-not (strata-test--main-menu-enabled-p "Selection" "Clear Selection"))
        (should-not (strata-test--main-menu-enabled-p "Clipboard & Transfers" "Paste (Replace)"))
        (should (strata-menu--selected-p (list 'view view)))
        (strata-view--set-entry-mark (car strata-test--files) t)
        (strata-view--set-entry-mark (nth 1 strata-test--files) t)
        (setq strata-clipboard (list :mode 'copy :files strata-test--files))
        (strata-menu--update)
        (should-not (strata-test--main-menu-enabled-p "Files" "Rename…"))
        (should (strata-test--main-menu-enabled-p "Files" "Move to Trash…"))
        (should (strata-test--main-menu-enabled-p "Selection" "Clear Selection"))
        (should (strata-test--main-menu-enabled-p "Clipboard & Transfers" "Paste (Replace)"))
        (should (eq (not (null (strata-test--main-menu-enabled-p "View & Sort" "Larger Icons"))) (eq view 'icons)))
        (strata-mouse-click-entry (list 'mouse-1 (list (selected-window) (point-max) '(10 . 400) 0) 1))
        (strata-menu--update)
        (should-not (strata-test--main-menu-enabled-p "Files" "Open / Edit"))
        (should-not (strata-test--main-menu-enabled-p "Files" "Delete Permanently…"))
        (should (strata-test--main-menu-enabled-p "Files" "New File…"))
        (setf (strata-prefs-sort-key strata-prefs-current) 'unsorted)
        (strata-menu--update)
        (should-not (strata-test--main-menu-enabled-p "View & Sort" "Ascending"))
        (should-not (strata-test--main-menu-enabled-p "View & Sort" "Natural Numeric Names"))))))

(ert-deftest strata-test-main-menu-permissions-and-no-cloud-probes ()
  "Read-only local folders disable mutation; opening a cloud menu does not stat files."
  (strata-test--with-selection-view 'compact
    (unwind-protect
        (progn
          (set-file-modes strata-test--dir #o500)
          (strata-menu--update)
          (should (strata-test--main-menu-enabled-p "Clipboard & Transfers" "Copy"))
          (should-not (strata-test--main-menu-enabled-p "Files" "New Folder…"))
          (should-not (strata-test--main-menu-enabled-p "Clipboard & Transfers" "Cut")))
      (set-file-modes strata-test--dir #o700))
    (let ((native-comp-enable-subr-trampolines nil))
      (cl-letf (((symbol-function 'strata-path-mount-kind) (lambda (_) 'cloud))
              ((symbol-function 'file-writable-p) (lambda (&rest _) (ert-fail "Menu probed cloud permissions")))
              ((symbol-function 'file-exists-p) (lambda (&rest _) (ert-fail "Menu statted a marked file")))
              ((symbol-function 'strata-devices-list) (lambda (&rest _) (ert-fail "Menu scanned drives"))))
      (setq strata-marked-entries (list (car strata-test--files)))
      (strata-menu--update)
        (should (strata-test--main-menu-enabled-p "Files" "Rename…"))))))

(ert-deftest strata-test-main-menu-drive-trash-and-preview-context ()
  "Drive mount states, trash rows and preview types enable only applicable commands."
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (strata-computer-mode)
      (let ((dev (make-strata-device :name "Disk" :placement 'removable :mounted-p nil)))
        (let ((inhibit-read-only t)) (insert (propertize "Disk\n" 'strata-device dev)))
        (goto-char (point-min))
        (strata-menu--update)
        (should (strata-test--main-menu-enabled-p "Drives & Trash" "Mount / Unlock Drive"))
        (should-not (strata-test--main-menu-enabled-p "Drives & Trash" "Unmount Drive"))
        (setf (strata-device-mounted-p dev) t (strata-device-mountpoint dev) "/")
        (strata-menu--update)
        (should-not (strata-test--main-menu-enabled-p "Drives & Trash" "Unmount Drive"))
        (should-not (strata-test--main-menu-enabled-p "Drives & Trash" "Safely Eject Drive")))
      (strata-trash-mode)
      (let ((inhibit-read-only t)) (erase-buffer))
      (strata-menu--update)
      (should-not (strata-test--main-menu-enabled-p "Drives & Trash" "Empty Trash…"))
      (let ((inhibit-read-only t)) (insert (propertize "file\n" 'strata-trash-item '(:name "file"))))
      (goto-char (point-min))
      (strata-menu--update)
      (should (strata-test--main-menu-enabled-p "Drives & Trash" "Restore Trashed Item"))
      (should-not (strata-test--main-menu-enabled-p "Files" "Rename…"))
      (fundamental-mode)
      (setq-local strata-preview-read-mode t)
      (let ((strata-active-preview-kind 'pdf))
        (strata-menu--update)
        (should (strata-test--main-menu-enabled-p "Preview & Media" "Next PDF Page"))
        (should-not (strata-test--main-menu-enabled-p "Preview & Media" "Wrap Preview Lines")))
      (let ((strata-active-preview-kind 'text))
        (strata-menu--update)
        (should (strata-test--main-menu-enabled-p "Preview & Media" "Wrap Preview Lines"))
        (should-not (strata-test--main-menu-enabled-p "Preview & Media" "Next PDF Page"))))))

(ert-deftest strata-test-main-menu-command-coverage ()
  "All public feature commands have menu entries, apart from equivalent entry points."
  (let (listed)
    (cl-labels ((walk (entries)
                  (dolist (entry entries)
                    (cond ((vectorp entry)
                           (should (fboundp (aref entry 1)))
                           (push (aref entry 1) listed))
                          ((consp entry) (walk (cdr entry)))))))
      (walk strata-menu--catalog))
    (dolist (command (apropos-internal "\\`strata-" #'commandp))
      (unless (or (string-match-p "--\\|mouse\\|chord\\|-mode\\'" (symbol-name command))
                  ;; Context menu is the keyboard-only hub; the other two
                  ;; are equivalent wrappers of commands/submenus above.
                  (memq command '(strata-context-menu strata-view-activate-at-point strata-view-menu)))
        (should (memq command listed))))))

(ert-deftest strata-test-main-menu-pane-tab-and-history-context ()
  "Transfer, history and tab actions follow the active workspace state."
  (strata-test--with-selection-view 'compact
    (let* ((dest (expand-file-name "dest" strata-test--root))
           (pane1 (make-strata-pane-state :id 1 :dir strata-test--dir))
           (pane2 (make-strata-pane-state :id 2 :dir dest))
           (tab (make-strata-tab-state :split-p t :pane1 pane1 :pane2 pane2))
           (strata-workspace-tabs (list tab)))
      (make-directory dest)
      (strata-menu--update)
      (should (strata-test--main-menu-enabled-p "Clipboard & Transfers" "Copy to Other Pane"))
      (should-not (strata-test--main-menu-enabled-p "Go" "Back"))
      (should-not (strata-test--main-menu-enabled-p "Panes, Tabs & Sidebar" "Next Tab"))
      (setf (strata-pane-state-dir pane2) strata-test--dir
            (strata-pane-state-history-back pane1) '("~/"))
      (setq strata-workspace-tabs (list tab (make-strata-tab-state)))
      (strata-menu--update)
      (should-not (strata-test--main-menu-enabled-p "Clipboard & Transfers" "Copy to Other Pane"))
      (should (strata-test--main-menu-enabled-p "Go" "Back"))
      (should (strata-test--main-menu-enabled-p "Panes, Tabs & Sidebar" "Next Tab"))
      (should (strata-test--main-menu-enabled-p "Panes, Tabs & Sidebar" "Move Tab Right"))
      (should-not (strata-test--main-menu-enabled-p "Panes, Tabs & Sidebar" "Move Tab Left")))))

(ert-deftest strata-test-main-menu-dispatch-retains-mouse-dialogs ()
  "A native menu-bar action executes in its source buffer with GUI follow-up prompts."
  (strata-test--with-selection-view 'compact
    (strata-menu--update)
    (let ((last-input-event '(menu-bar strata files rename))
          (last-nonmenu-event '(mouse-1 nil))
          asked)
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                ((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                ((symbol-function 'strata-ui--gtk-entry) (lambda (&rest _) (setq asked t) "from-menu.txt"))
                ((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Menu-bar rename opened text prompt")))
                ((symbol-function 'strata-refresh-active-view) #'ignore))
        (call-interactively (nth 3 (strata-test--main-menu-item "Files" "Rename…")))
        (should asked)
        (should (file-exists-p (expand-file-name "from-menu.txt" strata-test--dir)))))))

(ert-deftest strata-test-menu-bar-mouse-routing-and-guards ()
  "Menu bar handles dead buffers, keyboard `last-nonmenu-event' and marked archives."
  (let ((strata-menu--context nil))
    (should-not (strata-menu--selected-p '(view columns))))
  (let* ((tmp-dead (generate-new-buffer " *strata-dead-menu*"))
         (strata-menu--context (list :buffer tmp-dead :browser t)))
    (kill-buffer tmp-dead)
    (should-not (strata-menu--selected-p '(view columns))))
  (strata-test--with-selection-view 'compact
    (let* ((sub (expand-file-name "sub" strata-test--dir))
           (zip (expand-file-name "pkg.zip" strata-test--dir)))
      (make-directory sub t)
      (write-region "pk" nil zip nil 'silent)
      (strata-compact-refresh)
      (strata-goto-file zip)
      (strata-view-toggle-mark)
      (strata-goto-file sub)
      (strata-menu--update)
      (should (strata-test--main-menu-enabled-p "Files" "Extract Here"))
      (let ((last-input-event '(menu-bar strata files rename))
            (last-nonmenu-event ?j)
            asked)
        (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                  ((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                  ((symbol-function 'strata-ui--gtk-entry) (lambda (&rest _) (setq asked t) "renamed.txt"))
                  ((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Menu click fell back to text prompt")))
                  ((symbol-function 'strata-refresh-active-view) #'ignore))
          (strata-goto-file (car strata-test--files))
          (strata-clear-all-marks)
          (strata-menu--update)
          (call-interactively (nth 3 (strata-test--main-menu-item "Files" "Rename…")))
          (should asked))))))

(ert-deftest strata-test-paste-replace-directories-and-self ()
  "Replacing directories via Copy/Cut replaces cleanly and self-replace errors."
  (let* ((tmp (make-temp-file "strata-replace-" t))
         (src-root (expand-file-name "src" tmp))
         (dst-root (expand-file-name "dst" tmp))
         (src-sub (expand-file-name "sub" src-root))
         (dst-sub (expand-file-name "sub" dst-root))
         (same (expand-file-name "same.txt" tmp))
         (strata-undo-stack nil))
    (unwind-protect
        (progn
          (make-directory src-sub t)
          (make-directory dst-sub t)
          (write-region "new" nil (expand-file-name "new.txt" src-sub) nil 'silent)
          (write-region "old" nil (expand-file-name "stale.txt" dst-sub) nil 'silent)
          (write-region "self" nil same nil 'silent)
          (cl-letf (((symbol-function 'strata-refresh-active-view) #'ignore))
            ;; Same-folder replace refuses to overwrite itself
            (let ((default-directory (file-name-as-directory tmp)))
              (should-error (strata--transfer-files (list same) tmp 'copy nil t) :type 'user-error))
            ;; Copy+replace replaces destination directory cleanly without stale files
            (let ((default-directory (file-name-as-directory dst-root)))
              (strata--transfer-files (list src-sub) dst-root 'copy nil t)
              (should (file-exists-p (expand-file-name "new.txt" dst-sub)))
              (should-not (file-exists-p (expand-file-name "stale.txt" dst-sub)))
              (should-not (file-exists-p (expand-file-name "sub/new.txt" dst-sub)))
              ;; Cut+replace onto non-empty directory succeeds cleanly
              (write-region "stale2" nil (expand-file-name "stale2.txt" dst-sub) nil 'silent)
              (strata--transfer-files (list src-sub) dst-root 'cut nil t)
              (should (file-exists-p (expand-file-name "new.txt" dst-sub)))
              (should-not (file-exists-p (expand-file-name "stale2.txt" dst-sub)))
              (should-not (file-exists-p src-sub)))))
      (ignore-errors (delete-directory tmp t)))))

(ert-deftest strata-test-folder-double-click-does-not-activate-child ()
  "Double-clicking a directory navigates into it without activating an inner file."
  (let* ((tmp (make-temp-file "strata-dbl-" t))
         (sub (expand-file-name "sub" tmp))
         (secret (expand-file-name "secret.txt" sub))
         (topfile (expand-file-name "top.txt" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-dbl-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :browser-mode 'compact :sidebar-expanded nil))
         (strata-workspace-tabs nil)
         (strata-active-tab-index 0)
         (strata-mouse--recent-dir-open nil)
         opened)
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory sub t)
          (write-region "s" nil secret nil 'silent)
          (write-region "t" nil topfile nil 'silent)
          (strata-open-location tmp)
          (cl-letf (((symbol-function 'strata-preview-edit-file) (lambda (f) (setq opened f)))
                    ((symbol-function 'find-file) (lambda (f &optional _w) (setq opened f))))
            ;; Double-click on folder: click 1 opens sub/, click 2 double-mouse-1 is suppressed
            (let* ((ev1 (strata-test--selection-event 'mouse-1 sub))
                   (pt1 (posn-point (event-end ev1))))
              (strata-mouse-click-entry ev1)
              (should (equal (directory-file-name default-directory) (directory-file-name sub)))
              (let* ((pt2 (min pt1 (1- (point-max))))
                     (ev2 (list 'double-mouse-1 (list (selected-window) pt2 '(10 . 10) 0 nil pt2 nil nil 0 0))))
                (strata-mouse-activate-at-event ev2)
                (should-not opened)))
            ;; Double-click on regular file still opens/edits it
            (strata-open-location tmp)
            (strata-mouse-click-entry (strata-test--selection-event 'mouse-1 topfile))
            (strata-mouse-activate-at-event (strata-test--selection-event 'double-mouse-1 topfile))
            (should (equal (directory-file-name opened) (directory-file-name topfile)))))
      (dolist (b (buffer-list))
        (when (string-prefix-p "*Strata" (buffer-name b))
          (kill-buffer b)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-standalone-preview-controls-and-cleanup ()
  "Zoom, wrap, find and render toggle affect `*Strata Preview*' in Compact/Icons."
  (let* ((tmp (make-temp-file "strata-pv-" t))
         (md (expand-file-name "doc.md" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-pv-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :browser-mode 'compact :sidebar-expanded nil :preview-text-wrap t))
         (strata-preview-standalone-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (write-region "# Heading\n\nfind-needle-here line\n" nil md nil 'silent)
          (let ((buf (get-buffer-create "*Strata Compact: pv*")))
            (switch-to-buffer buf)
            (strata-compact-mode)
            (strata-compact-render tmp)
            (strata-goto-file md)
            (strata-toggle-peek)
            (let* ((pwin strata-preview-standalone-window)
                   (pbuf (window-buffer pwin)))
              (should (window-live-p pwin))
              (should (eq strata-active-preview-kind 'text))
              (strata-preview-zoom-in)
              (should (= (buffer-local-value 'text-scale-mode-amount pbuf) 1))
              (strata-toggle-preview-wrap)
              (should (buffer-local-value 'truncate-lines pbuf))
              (cl-letf (((symbol-function 'strata-ui-read-string) (lambda (&rest _) "find-needle-here")))
                (strata-preview-find))
              (should (> (with-selected-window pwin (point)) 1))
              (strata-toggle-rendered-document)
              (should (with-current-buffer pbuf (string-match-p "# Heading" (buffer-string))))
              ;; Switching to list closes standalone preview
              (strata-switch-view-mode 'list)
              (should-not (window-live-p strata-preview-standalone-window)))))
      (dolist (b (buffer-list))
        (when (or (string-prefix-p "*Strata" (buffer-name b))
                  (eq (buffer-local-value 'major-mode b) 'dired-mode))
          (kill-buffer b)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-search-fd-flags-and-dir-trailing-slashes ()
  "Subfolder `fd' handles leading dashes and Global Search strips trailing slashes."
  (skip-unless (executable-find "fd"))
  (let* ((tmp (make-temp-file "strata-fd-" t))
         (sub (expand-file-name "folder-sub" tmp))
         (dashed (expand-file-name "-dash-file.txt" sub))
         picked-loc)
    (unwind-protect
        (save-window-excursion
          (make-directory sub t)
          (write-region "x" nil dashed nil 'silent)
          (let ((dbuf (dired-noselect tmp)))
            (switch-to-buffer dbuf)
            (cl-letf (((symbol-function 'strata-ui-read-string) (lambda (&rest _) "-dash"))
                      ((symbol-function 'strata-ui-completing-read) (lambda (_p cands &rest _) (car cands)))
                      ((symbol-function 'strata-open-location) (lambda (d &rest _) (setq picked-loc d)))
                      ((symbol-function 'strata-goto-file) #'ignore))
              (strata-filter-pane t)
              (should (equal (directory-file-name picked-loc) (directory-file-name sub))))
            (kill-buffer dbuf))
          ;; Search result open-folder strips trailing slash on directories
          (with-temp-buffer
            (insert (propertize "   dir  folder-sub\n" 'strata-search-path (file-name-as-directory sub)))
            (goto-char (point-min))
            (cl-letf (((symbol-function 'strata-open-location) (lambda (d &rest _) (setq picked-loc d)))
                      ((symbol-function 'strata-goto-file) #'ignore))
              (strata-search-open-folder-at-point)
              (should (equal (directory-file-name picked-loc) (directory-file-name tmp))))))
      (ignore-errors (delete-directory tmp t)))))

(ert-deftest strata-test-custom-actions-order-compress-and-thumbs-scale ()
  "Custom actions preserve arg order; empty compress errors; nil scale resets."
  (let* ((tmp (make-temp-file "strata-ops-fixes-" t))
         (strata-dirvish-config-dir (expand-file-name "cfg" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-ops-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :icons-thumbnail-size 96))
         (act-dir (expand-file-name "actions/order-act" strata-dirvish-config-dir))
         (file-a (expand-file-name "a.txt" tmp))
         (file-b (expand-file-name "b.txt" tmp))
         cmds)
    (unwind-protect
        (progn
          (make-directory act-dir t)
          (write-region "a" nil file-a nil 'silent)
          (write-region "b" nil file-b nil 'silent)
          (write-region
           "name = \"Order Act\"\n[run]\nruntime = \"bash\"\nentrypoint = \"run.sh\"\nmode = \"whole-selection\"\nargs = [\"--flag\", \"{parent}\", \"{path}\", \"{paths}\", \"--end\"]\n"
           nil (expand-file-name "action.toml" act-dir) nil 'silent)
          (cl-letf (((symbol-function 'strata-run-job) (lambda (_n cmd &optional _cb) (push cmd cmds)))
                    ((symbol-function 'strata-selected-files) (lambda () (list file-a file-b))))
            (let ((default-directory (file-name-as-directory tmp)))
              (strata-run-custom-action 1)))
          (should (equal (cdr (cdr (car cmds)))
                         (list "--flag" (file-name-as-directory tmp) file-a file-a file-b "--end")))
          ;; Compress with empty selection signals user-error cleanly
          (cl-letf (((symbol-function 'strata-selected-files) (lambda () nil)))
            (let ((default-directory (file-name-as-directory tmp)))
              (should-error (strata-archive-compress) :type 'user-error)))
          ;; Interactive `strata-thumbnails-scale' with nil resets to 64 without error
          (call-interactively #'strata-thumbnails-scale)
          (should (= (strata-prefs-icons-thumbnail-size (strata-prefs)) 64)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-split-state-sync-and-desktop-parser ()
  "Split-pane state, view-mode pane sync, desktop parsing and mouse routing stay consistent."
  (let* ((tmp (make-temp-file "strata-split-sync-" t))
         (d1 (expand-file-name "d1" tmp))
         (d2 (expand-file-name "d2" tmp))
         (desktop-dir (expand-file-name "apps" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-split-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :browser-mode 'list :restore-tabs t :sidebar-expanded nil))
         (strata-workspace-tabs nil)
         (strata-active-tab-index 0))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory d1 t)
          (make-directory d2 t)
          (make-directory desktop-dir t)
          ;; Dangling :split-p without pane2 cannot claim split active
          (with-temp-file strata-tabs-state-file
            (prin1 (list :active 0 :tabs (list (list :dir d1 :split-p t))) (current-buffer)))
          (strata-tabs-load)
          (should-not (strata-split-active-p))
          ;; Switch view updates active pane buffer
          (strata-open-location d1)
          (strata-switch-view-mode 'compact)
          (should (eq (strata-pane-state-buffer (strata-active-pane)) (current-buffer)))
          ;; Desktop parser unquotes Exec=, skips NoDisplay=true and ignores Desktop Action
          (let ((good (expand-file-name "good.desktop" desktop-dir))
                (hidden (expand-file-name "hidden.desktop" desktop-dir)))
            (write-region
             "[Desktop Entry]\nType=Application\nName=GoodApp\nExec=\"/bin/sh\" -c %u\n\n[Desktop Action Extra]\nName=Wrong\nExec=/usr/bin/nonexistent\n"
             nil good nil 'silent)
            (write-region
             "[Desktop Entry]\nType=Application\nName=HiddenApp\nExec=/bin/sh\nNoDisplay=true\n"
             nil hidden nil 'silent)
            (should (equal (strata-desktop--parse-file good) '("GoodApp (good.desktop)" . "/bin/sh")))
            (should-not (strata-desktop--parse-file hidden)))
          ;; Mouse routing covers modifier selection & context menu guards single-file Rename
          (should (advice-member-p #'strata-ui--mouse-command 'strata-mouse-toggle-select))
          (should (advice-member-p #'strata-ui--mouse-command 'strata-view-menu))
          (write-region "1" nil (expand-file-name "a.txt" d1) nil 'silent)
          (write-region "2" nil (expand-file-name "b.txt" d1) nil 'silent)
          (strata-compact-refresh)
          (strata-select-all)
          (let* ((menu (strata-context--popup-menu))
                 (rename-item (cl-find-if (lambda (it)
                                            (and (consp it) (eq (cadr it) 'menu-item)
                                                 (equal (nth 2 it) "Rename…")))
                                          (cdr menu))))
            (should rename-item)
            (should-not (eval (plist-get (nthcdr 4 rename-item) :enable)))))
      (dolist (b (buffer-list))
        (when (or (string-prefix-p "*Strata" (buffer-name b))
                  (eq (buffer-local-value 'major-mode b) 'dired-mode))
          (kill-buffer b)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-compact-columns-align-long-and-wide-names ()
  "Compact columns align with full long names, wide text and mixed icon widths."
  (strata-test--with-selection-view 'compact
    (dolist (name (list "00-short.txt"
                        (concat "01-" (make-string 140 ?a) ".txt")
                        (concat "02-" (make-string 24 ?界) ".txt")
                        (concat "03-" (make-string 30 ?é) ".txt")))
      (write-region "fixture" nil (expand-file-name name strata-test--dir) nil 'silent))
    (let ((focus (nth 1 strata-test--files))
          (marked (car strata-test--files)))
      (strata-view--set-entry-mark marked t)
      (strata-goto-file focus)
      (cl-letf (((symbol-function 'window-body-height) (lambda (&rest _) 8))
                ((symbol-function 'strata-file--glyph)
                 (lambda (path &optional _)
                   (if (string-prefix-p "02-" (file-name-nondirectory path)) "界" "▤"))))
        (dolist (full '(nil t))
          (setf (strata-prefs-compact-full-names strata-prefs-current) full)
          (strata-compact-refresh)
          (when full (should (> strata-compact-col-width 140)))
          (should (equal (strata-current-file) focus))
          (should (equal (strata-marked-files-only) (list marked)))
          (save-excursion
            (goto-char (point-min))
            (let ((row 0) (column 0) match)
              (while (setq match (text-property-search-forward 'strata-entry nil
                                                               (lambda (_ path) path)))
                (let* ((start (prop-match-beginning match))
                       (end (prop-match-end match))
                       (line (line-number-at-pos start)))
                  (unless (= line row) (setq row line column 0))
                  (save-excursion
                    (goto-char start)
                    (should (= (current-column) (* column strata-compact-col-width))))
                  (when full
                    (let* ((label (next-single-property-change start 'strata-entry-label nil end))
                           (text (buffer-substring-no-properties label end)))
                      (should (equal text (file-name-nondirectory (prop-match-value match))))))
                  (cl-incf column)))))
          ;; Wider cells retain the existing column navigation order.
          (let ((files (strata-view--entry-order)))
            (strata-goto-file (car files))
            (strata-compact-next-col)
            (should (equal (strata-current-file) (nth strata-compact-rows files)))
            (strata-compact-prev-col)
            (should (equal (strata-current-file) (car files)))
            (strata-goto-file focus)))))))

(ert-deftest strata-test-compact-empty-click-keeps-viewport ()
  "Blank clicks deselect a full Compact listing without hiding its early rows."
  (strata-test--with-selection-view 'compact
    (dotimes (i 80)
      (make-directory (expand-file-name (format "folder-%02d" i) strata-test--dir)))
    (strata-compact-refresh)
    (let ((entries (strata-view--entry-order))
          (win (selected-window)))
      (dolist (kind '(mouse-1 native mouse-3))
        (strata-goto-file (nth (+ strata-compact-rows 4) entries))
        (strata-view-toggle-mark)
        (set-window-start win (save-excursion (goto-char (point-min)) (forward-line 2) (point)) t)
        (set-window-hscroll win 3)
        (redisplay t)
        (let* ((start (window-start win))
               (hscroll (window-hscroll win))
               (posn (list win (point-max) '(800 . 200) 0)))
          (pcase kind
            ('native (strata-test--play-events (list 'down-mouse-1 posn 1)
                                              (list 'mouse-1 posn 1)))
            ('mouse-3
             (cl-letf (((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                       ((symbol-function 'popup-menu) #'ignore))
               (strata-mouse-context-menu (list kind posn 1))))
            (_ (strata-mouse-click-entry (list kind posn 1))))
          (let ((this-command 'strata-mouse-click-entry)) (run-hooks 'post-command-hook))
          (redisplay t)
          (should (= (window-start win) start))
          (should (= (window-hscroll win) hscroll))
          (should (equal entries (strata-view--entry-order)))
          (should-not (strata-current-file))
          (should-not (strata-marked-files-only))
          (should-not strata--selection-overlays)
          ;; Every directory still has a rendered cell, including the first.
          (dolist (file entries)
            (should (save-excursion
                      (goto-char (point-min))
                      (text-property-search-forward 'strata-entry file t))))
          (strata-compact-next-item)
          (should (strata-current-file))
          (should-not strata--empty-click-p))))))

(ert-deftest strata-test-delete-keeps-adjacent-file-in-all-views ()
  "Trash and permanent delete focus one surviving neighbour in listing order."
  (dolist (view '(columns list compact icons))
    (dolist (command '(strata-move-to-trash strata-delete-permanently))
      (dolist (spec '(((2) 3 2) ((0) 1 0) ((5) 4 5) ((1 2 3) 4 2)
                      ((1 4) 2 1) ((0 1 2 3 4 5) nil 2)))
        (ert-info ((format "%S / %S / %S" view command spec))
          (strata-test--with-selection-view view
            (let* ((removed (mapcar (lambda (i) (nth i strata-test--files)) (car spec)))
                   (expected (and (nth 1 spec) (nth (nth 1 spec) strata-test--files)))
                   (trash (expand-file-name "trash" strata-test--root))
                   (strata-undo-stack nil) (strata-redo-stack nil))
              (make-directory trash)
              (when (cdr removed)
                (dolist (file removed) (strata-view--set-entry-mark file t t))
                (strata-view--refresh-after-mark))
              (strata-goto-file (nth (nth 2 spec) strata-test--files))
              (cl-letf (((symbol-function 'strata-ui-yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'strata--trash-with-gio-fallback)
                         (lambda (file)
                           (let ((target (expand-file-name (file-name-nondirectory file) trash)))
                             (rename-file file target)
                             target))))
                (let ((this-command command))
                  (call-interactively command)
                  (run-hooks 'post-command-hook)))
              (dolist (file removed) (should-not (file-exists-p file)))
              (should (equal (strata-current-file) expected))
              (should-not (strata-marked-files-only))
              (should-not strata--selection-range-active)
              (if expected
                  (progn
                    (should (= (length strata--selection-overlays) 1))
                    (let ((overlay (car strata--selection-overlays)))
                      (should (equal (buffer-substring-no-properties
                                      (overlay-start overlay) (overlay-end overlay))
                                     (file-name-nondirectory expected)))))
                (should-not strata--selection-overlays)))))))))

(ert-deftest strata-test-delete-cancellation-keeps-focus-and-files ()
  "Declining either deletion confirmation preserves the original selection."
  (dolist (view '(columns list compact icons))
    (dolist (command '(strata-move-to-trash strata-delete-permanently))
      (strata-test--with-selection-view view
        (let ((file (nth 2 strata-test--files)))
          (strata-goto-file file)
          (cl-letf (((symbol-function 'strata-ui-yes-or-no-p) (lambda (&rest _) nil)))
            (call-interactively command))
          (should (equal (strata-current-file) file))
          (should (= (length strata--selection-overlays) 1))
          (dolist (entry strata-test--files) (should (file-exists-p entry))))))))

(ert-deftest strata-test-control-arrows-move-focus-and-preserve-marks ()
  "Ctrl+Space and Ctrl+Arrows select scattered files in both keyboard modes."
  (dolist (view '(columns list compact icons))
    (strata-test--with-selection-view view
      (when (eq view 'icons)
        ;; Keep a second grid row even on a wide graphical frame.
        (dotimes (i 30)
          (write-region "test" nil (expand-file-name (format "g-%02d.txt" i) strata-test--dir) nil 'silent))
        (strata-icons-refresh))
      (dolist (tenxer '(nil t))
        (strata-dirvish-tenxer-mode (if tenxer 1 -1))
        (strata-clear-all-marks)
        (let* ((files (strata-view--entry-order))
               (first (car files))
               (next (nth (if (eq view 'icons) strata-icons--ncols 1) files)))
          (strata-goto-file first)
          (call-interactively (key-binding (kbd "C-SPC")))
          (call-interactively (key-binding (kbd "C-<down>")))
          (should (equal (strata-current-file) next))
          (should (equal (strata-marked-files-only) (list first)))
          (call-interactively (key-binding (kbd "C-SPC")))
          (should (= (length (strata-marked-files-only)) 2))
          (call-interactively (key-binding (kbd "C-<up>")))
          (should (equal (strata-current-file) first))
          ;; Some keyboard backends send NUL / C-@ for Ctrl+Space.
          (call-interactively (key-binding (kbd "C-@")))
          (should (equal (strata-marked-files-only) (list next)))
          (should-not mark-active)
          (call-interactively (key-binding (kbd "C-<right>")))
          (should (equal (strata-current-file) (if (eq view 'compact) first (nth 1 files))))
          (should (equal (strata-marked-files-only) (list next)))
          (call-interactively (key-binding (kbd "C-<left>")))
          (should (equal (strata-current-file) first))
          (call-interactively (key-binding (kbd "C-<up>")))
          (should (equal (strata-current-file) first))
          (strata-goto-file (car (last files)))
          (call-interactively (key-binding (kbd "C-<down>")))
          (should (equal (strata-current-file) (car (last files))))
          (should (equal (strata-marked-files-only) (list next))))))))

(ert-deftest strata-test-control-arrows-compact-column-boundaries ()
