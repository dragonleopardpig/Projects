(ert-deftest strata-test-spc-preview-and-ret-direct-edit ()
  (should (eq (lookup-key strata-default-keymap (kbd "SPC")) #'strata-preview-at-point))
  (should (eq (lookup-key strata-default-keymap (kbd "RET")) #'strata-open-or-edit-at-point))
  (should (eq (lookup-key strata-compact-mode-map (kbd "SPC")) #'strata-preview-at-point))
  (should (eq (lookup-key strata-compact-mode-map (kbd "RET")) #'strata-open-or-edit-at-point))
  (should (eq (lookup-key strata-icons-mode-map (kbd "SPC")) #'strata-preview-at-point))
  (should (eq (lookup-key strata-icons-mode-map (kbd "RET")) #'strata-open-or-edit-at-point))
  (let* ((tmp (make-temp-file "strata-edit-" t))
         (subdir (expand-file-name "sub" tmp))
         (fpath (expand-file-name "sample.txt" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-state-" t))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-workspace-tabs nil)
         (strata-closed-tabs nil)
         (strata-active-tab-index 0)
         (strata-visited-folders nil)
         (strata-folder-view-lru nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory subdir t)
          (with-temp-file fpath
            (insert "hello strata"))
          (let* ((left-win (selected-window))
                 (right-win (split-window-right))
                 (dv (dirvish--new :curr-layout '(1 0.14 0.48)))
                 (strata-preview-standalone-window right-win)
                 (before-wins (window-list nil nil left-win))
                 (before-edges (mapcar #'window-edges (window-list nil nil left-win)))
                 (opened-dir nil))
            (unwind-protect
                (with-current-buffer (get-buffer-create " *strata-test-browser*")
                  (let ((inhibit-read-only t))
                    (erase-buffer)
                    (strata-compact-mode)
                    (insert (propertize "  sub/\n" 'strata-entry (file-name-as-directory subdir)))
                    (insert (propertize "  sample.txt\n" 'strata-entry fpath)))
                  (set-window-buffer left-win (current-buffer))
                  (select-window left-win)
                  ;; 1. SPC previews without closing preview pane or altering layout.
                  (goto-char (point-min))
                  (forward-line 1)
                  (strata-preview-at-point)
                  (should (window-live-p right-win))
                  (should (eq (selected-window) left-win))
                  (should (equal (window-list nil nil left-win) before-wins))
                  (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                  (should (string-match-p "hello strata"
                                          (with-current-buffer (window-buffer right-win)
                                            (buffer-string))))
                  ;; Pressing SPC again keeps preview pane open (does not close it).
                  (strata-preview-at-point)
                  (should (window-live-p right-win))
                  (should (equal (window-list nil nil left-win) before-wins))
                  ;; 2. RET replaces any Dirvish throwaway `PREVIEW :: ...' buffer with real writable buffer (ZERO layout change).
                  (let ((fake-preview (generate-new-buffer "PREVIEW :: 00:00 :: sample.txt")))
                    (with-current-buffer fake-preview
                      (insert "TRUNCATED PREVIEW")
                      (setq buffer-file-name fpath)
                      (set-buffer-modified-p nil)
                      (setq buffer-read-only t))
                    (cl-pushnew fake-preview (dv-preview-buffers dv))
                    (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv)))
                      (setf (dv-preview-window dv) right-win)
                      (strata-open-or-edit-at-point)
                      (should-not (buffer-live-p fake-preview))
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                      (should (eq (selected-window) right-win))
                      (let ((real-buf (window-buffer right-win)))
                        (should-not (string-prefix-p "PREVIEW :: " (buffer-name real-buf)))
                        (should-not (memq real-buf (dv-preview-buffers dv)))
                        (with-current-buffer real-buf
                          (should (equal (file-truename buffer-file-name)
                                         (file-truename fpath)))
                          (should-not buffer-read-only)
                          (should strata-preview-edit-mode)
                          (should (eq (key-binding (kbd "C-<left>")) #'strata-preview-edit-leave))
                          (should (eq (key-binding (kbd "C-c q")) #'strata-preview-edit-exit))
                          (should (eq (key-binding (kbd "C-<escape>")) #'strata-preview-edit-exit))
                          (should (eq (key-binding (kbd "C-c k")) #'strata-preview-edit-abort))
                          ;; Edit buffer, seed stale preview hash, cancel save-prompt with quit -> stays in edit mode.
                          (puthash fpath "STALE PREVIEW" (dv-preview-hash dv))
                          (goto-char (point-max))
                          (insert " + saved"))
                        (select-window right-win)
                        (condition-case nil
                            (cl-letf (((symbol-function 'map-y-or-n-p)
                                       (lambda (&rest _) (signal 'quit nil))))
                              (strata-preview-edit-leave))
                          (quit nil))
                        (with-current-buffer real-buf
                          (should strata-preview-edit-mode))
                        (should (eq (selected-window) right-win))
                        ;; Now confirm save in `C-<left>' (`save-some-buffers') -> saves, clears stale cache, returns left.
                        (select-window right-win)
                        (cl-letf (((symbol-function 'map-y-or-n-p)
                                   (lambda (_prompter actor list &rest _)
                                     (funcall actor (car list))
                                     1)))
                          (strata-preview-edit-leave))
                        (with-current-buffer real-buf
                          (should-not (buffer-modified-p real-buf))
                          (should-not strata-preview-edit-mode))
                        (should (eq (selected-window) left-win))
                        (should (equal (window-list nil nil left-win) before-wins))
                        (should (string-match-p "hello strata \\+ saved"
                                                (with-current-buffer (window-buffer right-win)
                                                  (buffer-string))))
                        ;; Abort (`C-c k`) still reverts dirty edits back to saved file contents.
                        (set-buffer (window-buffer left-win))
                        (strata-open-or-edit-at-point)
                        (with-current-buffer (window-buffer right-win)
                          (goto-char (point-max))
                          (insert " + discard-me"))
                        (select-window right-win)
                        (cl-letf (((symbol-function 'y-or-n-p) (lambda (_prompt) t)))
                          (strata-preview-edit-abort))
                        (should (eq (selected-window) left-win))
                        (with-current-buffer real-buf
                          (should-not (buffer-modified-p))
                          (should-not strata-preview-edit-mode)
                          (should (string= (string-trim-right (buffer-string))
                                           "hello strata + saved"))))))
                  ;; 3. RET on a directory opens it in the browser pane.
                  (select-window left-win)
                  (set-buffer (window-buffer left-win))
                  (goto-char (point-min))
                  (cl-letf (((symbol-function 'strata-open-location)
                             (lambda (loc &optional _hist) (setq opened-dir loc))))
                    (strata-open-or-edit-at-point)
                    (should (string= (directory-file-name opened-dir)
                                     (directory-file-name subdir))))
                  ;; 4. Right arrow / `strata-tree-expand-or-open' on a file enters preview in read-only mode,
                  ;;    and `C-<left>' (`strata-preview-read-leave') returns focus to the left browser pane.
                  (should (eq (lookup-key strata-default-keymap (kbd "<right>")) #'strata-tree-expand-or-open))
                  (should (eq (lookup-key strata-10xer-keymap (kbd "l")) #'strata-tree-expand-or-open))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "C-<left>")) #'strata-preview-read-leave))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "SPC")) #'strata-preview-read-scroll-down))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "DEL")) #'strata-preview-read-scroll-up))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "q")) #'strata-preview-read-leave))
                  (select-window left-win)
                  (set-buffer (window-buffer left-win))
                  (goto-char (point-min))
                  (forward-line 1)
                  (let ((visited (find-buffer-visiting fpath)))
                    (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv))
                              ((symbol-function 'strata-dirvish--flatten-layout)
                               (lambda () (error "Must not flatten Dirvish layout")))
                              ((symbol-function 'dired-find-file)
                               (lambda () (error "Must not collapse Dirvish via dired-find-file"))))
                      (setf (dv-preview-window dv) right-win)
                      (strata-preview--capture-browser-context left-win)
                      (strata-tree-expand-or-open)
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                      (should (eq (selected-window) right-win))
                      (with-current-buffer (window-buffer right-win)
                        (should strata-preview-read-mode)
                        (should buffer-read-only)
                        (should-not strata-preview-edit-mode))
                      (with-current-buffer visited
                        (should-not strata-preview-edit-mode))
                      (strata-preview-read-leave)
                      (should (eq (selected-window) left-win))
                      ;; 4b. Clicking into the preview pane enables read-only mode & blocks background resets.
                      (strata-preview--on-window-selection-change)
                      (select-window right-win)
                      (strata-preview--on-window-selection-change)
                      (with-current-buffer (window-buffer right-win)
                        (should strata-preview-read-mode)
                        (should buffer-read-only)
                        (should-not strata-preview-edit-mode))
                      (let ((orig-pbuf (window-buffer right-win)))
                        (with-current-buffer orig-pbuf
                          (goto-char (point-max)))
                        (dirvish--preview-update dv fpath)
                        (should (eq (selected-window) right-win))
                        (should (eq (window-buffer right-win) orig-pbuf))
                        (with-current-buffer orig-pbuf
                          (should (= (point) (point-max)))))
                      (strata-preview-read-leave)
                      (should (eq (selected-window) left-win))
                      ;; 5. Mouse activation (double-click) or RET opens direct-edit without collapsing layout.
                      (strata-mouse--open-path fpath nil)
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (eq (selected-window) right-win))
                      (should (eq (window-buffer right-win) visited))
                      (with-current-buffer visited
                        (should strata-preview-edit-mode)
                        (should-not strata-preview-read-mode)
                        (should-not buffer-read-only))
                      (select-window right-win)
                      (strata-preview-edit-exit)
                      (should (eq (selected-window) left-win)))))
              (when-let ((b (find-buffer-visiting fpath)))
                (with-current-buffer b (set-buffer-modified-p nil))
                (kill-buffer b))
              (remhash (dv-id dv) dirvish--sessions))))
      (delete-directory tmp t)
      (delete-directory strata-dirvish-state-dir t))))

(ert-deftest strata-test-preview-read-mode-click-scroll-and-leave ()
  "Right-arrow and clicking preview enter read-only mode, allow scrolling, and C-<left>/C-x k restore browser."
  (let* ((tmp (make-temp-file "strata-ro-preview-" t))
         (strata-dirvish-state-dir (make-temp-file "strata-ro-state-" t))
         (fpath (expand-file-name "long.txt" tmp))
         (strata-prefs-current (strata-prefs--create :folders-first t))
         (strata-preview-standalone-window nil)
         (strata-preview--last-browser-context nil)
         (dired-buf nil)
         (pbuf-preview nil))
    (unwind-protect
        (save-window-excursion
          (with-temp-file fpath
            (dotimes (i 120)
              (insert (format "line-%03d of sample preview document\n" (1+ i)))))
          (delete-other-windows)
          (setq dired-buf (dired-noselect tmp))
          (let* ((left-win (selected-window))
                 (right-win (split-window-right)))
            (setq strata-preview-standalone-window right-win)
            (set-window-buffer left-win dired-buf)
            (select-window left-win)
            (goto-char (point-min))
            (re-search-forward "long\\.txt")
            (goto-char (match-beginning 0))
            (cl-letf (((symbol-function 'dirvish-curr) (lambda () nil)))
              ;; 1. `<right>' enters standalone preview in read-only mode & supports keyboard scrolling.
              (strata-tree-expand-or-open)
              (should (eq (selected-window) right-win))
              (let ((sbuf (get-buffer "*Strata Preview*")))
                (should (buffer-live-p sbuf))
                (should (eq (window-buffer right-win) sbuf))
                (with-current-buffer sbuf
                  (should strata-preview-read-mode)
                  (should buffer-read-only)
                  (should cursor-type)
                  (should-not strata-preview-edit-mode)
                  (goto-char (point-min))
                  (strata-preview-read-scroll-down)
                  (strata-preview-read-scroll-down)
                  (let ((scrolled-pos (point))
                        (scrolled-ws (window-start right-win)))
                    (should (> scrolled-pos 1))
                    (should (> scrolled-ws 1))
                    ;; Background move-sync must not overwrite or reset scroll while preview is selected.
                    (with-current-buffer dired-buf
                      (strata-view--sync-preview-on-move))
                    (should (= (point) scrolled-pos))
                    (should (= (window-start right-win) scrolled-ws))
                    ;; `C-<left>' returns focus to left browser without losing scroll position.
                    (strata-preview-read-leave)
                    (should (eq (selected-window) left-win))
                    (should (= (with-current-buffer sbuf (point)) scrolled-pos))
                    ;; Clicking preview again re-attaches read-only mode & scrolls back up.
                    (strata-preview--on-window-selection-change)
                    (select-window right-win)
                    (strata-preview--on-window-selection-change)
                    (should strata-preview-read-mode)
                    (should buffer-read-only)
                    (strata-preview-read-scroll-up)
                    (should (< (window-start right-win) scrolled-ws))
                    (strata-preview-read-leave)
                    (should (eq (selected-window) left-win)))))
              ;; 2. Pressing RET after read-only preview unlocks into writable edit mode cleanly.
              (set-buffer (window-buffer (selected-window)))
              (strata-open-or-edit-at-point)
              (let ((visited (find-buffer-visiting fpath)))
                (should (buffer-live-p visited))
                (should (eq (selected-window) right-win))
                (should (eq (window-buffer right-win) visited))
                (with-current-buffer visited
                  (should strata-preview-edit-mode)
                  (should-not strata-preview-read-mode)
                  (should-not buffer-read-only))
                (strata-preview-edit-exit)
                (should (eq (selected-window) left-win)))
              ;; 3. Clicking a Dirvish `PREVIEW ::' buffer attaches read-only mode; maximizing + C-<left>/C-x k restores browser.
              (setq pbuf-preview (get-buffer-create "PREVIEW :: long.txt"))
              (with-current-buffer pbuf-preview
                (insert-file-contents fpath nil nil nil t)
                (setq-local buffer-read-only t)
                (setq-local strata-active-preview-file fpath))
              (set-window-buffer right-win pbuf-preview)
              (strata-preview--on-window-selection-change)
              (select-window right-win)
              (strata-preview--on-window-selection-change)
              (with-current-buffer pbuf-preview
                (should strata-preview-read-mode)
                (should buffer-read-only))
              (delete-other-windows right-win)
              (should (one-window-p t))
              (strata-preview-read-leave)
              (should (eq (window-buffer (selected-window)) dired-buf))
              (let ((rw (or (window-in-direction 'right (selected-window))
                            (split-window-right))))
                (set-window-buffer rw pbuf-preview)
                (strata-preview--on-window-selection-change)
                (select-window rw)
                (strata-preview--on-window-selection-change)
                (delete-other-windows rw)
                (should (one-window-p t))
                (kill-buffer pbuf-preview)
                (should (eq (window-buffer (selected-window)) dired-buf))))))
      (when (buffer-live-p pbuf-preview)
        (kill-buffer pbuf-preview))
      (when-let ((sb (get-buffer "*Strata Preview*")))
        (kill-buffer sb))
      (when-let ((fb (find-buffer-visiting fpath)))
        (kill-buffer fb))
      (when (buffer-live-p dired-buf)
        (kill-buffer dired-buf))
      (delete-directory tmp t)
      (delete-directory strata-dirvish-state-dir t))))

(ert-deftest strata-test-icons-no-wrap-grid-nav-and-wrapping ()
  "Icons & Compact suppress `global-visual-line-mode', wrap long names, and navigate 2D cards."
  (let* ((tmp (make-temp-file "strata-icons-" t))
         (orig-gvl global-visual-line-mode)
         (strata-prefs-current (strata-prefs--create :icons-thumbnail-size 64 :folders-first t)))
    (unwind-protect
        (progn
          ;; Create 6 entries -> with batch window width 80 and stride 20, ncols = 4 (2 rows).
          (make-directory (expand-file-name "01-dir" tmp))
          (dolist (nm '("02-alpha.txt" "03-beta.txt" "04-gamma.txt"
                        "05-delta.txt" "06-very-long-filename-archive-2026.txt"))
            (write-region "x" nil (expand-file-name nm tmp)))
          ;; Enable global-visual-line-mode to replicate init.el behavior.
          (global-visual-line-mode 1)
          (dolist (mode '(compact icons))
            (with-temp-buffer
              (if (eq mode 'compact) (strata-compact-mode) (strata-icons-mode))
              (should-not visual-line-mode)
              (should truncate-lines)
              (should-not word-wrap)))
          ;; Verify clean 1-or-2-line name wrapping helper.
          (should (equal (strata-icons--wrap-name "Desktop" 16) '("Desktop")))
          (let ((wrapped (strata-icons--wrap-name "my_very_long_project_archive.tar.gz" 16)))
            (should (= (length wrapped) 2))
            (should (<= (string-width (car wrapped)) 16))
            (should (<= (string-width (cadr wrapped)) 16)))
          ;; Render Icons grid cleanly and verify 2D navigation & label cursor placement.
          (with-temp-buffer
            (let ((w (selected-window)))
              (set-window-buffer w (current-buffer))
              (strata-icons-mode)
              (setq strata-view-directory (file-name-as-directory tmp))
              (strata-icons-render)
              (should-not visual-line-mode)
              (should truncate-lines)
              (should (> strata-icons--ncols 1))
              (should (= strata-icons--count 6))
              ;; Point starts cleanly on card 0 label (NOT on the icon span).
              (should (= (get-text-property (point) 'strata-grid-idx) 0))
              (should (get-text-property (point) 'strata-grid-label))
              ;; Right / `strata-tree-expand-or-open' steps right one card.
              (strata-tree-expand-or-open)
              (should (= (get-text-property (point) 'strata-grid-idx) 1))
              (should (get-text-property (point) 'strata-grid-label))
              ;; Down / `strata-nav-next-line' steps down one grid row cleanly.
              (let ((expected-row-idx (min (1- strata-icons--count) (+ 1 strata-icons--ncols))))
                (strata-nav-next-line)
                (should (= (get-text-property (point) 'strata-grid-idx) expected-row-idx))
                (should (get-text-property (point) 'strata-grid-label))
                ;; Up / `strata-nav-prev-line' returns to card 1 when ncols < 6.
                (when (< strata-icons--ncols 6)
                  (strata-nav-prev-line)
                  (should (= (get-text-property (point) 'strata-grid-idx) 1))))
              ;; Left / `strata-tree-collapse-or-up' steps back to card 0.
              (strata-goto-file (expand-file-name "02-alpha.txt" tmp))
              (should (= (get-text-property (point) 'strata-grid-idx) 1))
              (strata-tree-collapse-or-up)
              (should (= (get-text-property (point) 'strata-grid-idx) 0))
              ;; Footer hints must not mention removed F1 binding.
              (should-not (string-search "F1" (dirvish-strata-footer-ml))))))
      (global-visual-line-mode (if orig-gvl 1 -1))
      (delete-directory tmp t))))

(ert-deftest strata-test-selection-highlight-all-views ()
  "Navigating Up/Down highlights the full file/dir name across Dired, Compact, and Icons."
  (let* ((tmp (make-temp-file "strata-sel-" t))
         (d1 (expand-file-name "01-folder" tmp))
         (f1 (expand-file-name "02-document-example.txt" tmp))
         (f2 (expand-file-name "03-another-long-file-name-wrap.txt" tmp))
         (strata-prefs-current (strata-prefs--create :folders-first t)))
    (unwind-protect
        (progn
          (make-directory d1 t)
          (write-region "a" nil f1)
          (write-region "b" nil f2)
          ;; 1. Dired (Columns / List): hl-line off, full filename highlighted cleanly.
          (let ((dbuf (dired-noselect tmp)))
            (unwind-protect
                (with-current-buffer dbuf
                  (strata-dirvish--enable-in-browser)
                  (should-not hl-line-mode)
                  (dired-goto-file d1)
                  (strata-view--update-selection-highlight)
                  (should (= (length strata--selection-overlays) 1))
                  (let ((ov (car strata--selection-overlays)))
                    (should (eq (overlay-get ov 'face) 'strata-entry-selected))
                    (should (string= (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))
                                     "01-folder"))
                    (should (= (point) (overlay-start ov))))
                  (strata-nav-next-line)
                  (strata-view--update-selection-highlight)
                  (let ((ov (car strata--selection-overlays)))
                    (should (string= (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))
                                     "02-document-example.txt"))
                    (should (= (point) (overlay-start ov)))))
              (when (buffer-live-p dbuf) (kill-buffer dbuf))))
          ;; 2. Compact view: full shown filename highlighted cleanly with cursor at name start.
          (with-temp-buffer
            (strata-compact-mode)
            (strata-compact-render tmp)
            (strata-goto-file d1)
            (should (= (length strata--selection-overlays) 1))
            (let ((ov (car strata--selection-overlays)))
              (should (eq (overlay-get ov 'face) 'strata-entry-selected))
              (should (string= (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))
                               "01-folder"))
              (should (= (point) (overlay-start ov))))
            (strata-compact-next-item)
            (let ((ov (car strata--selection-overlays)))
              (should (string-prefix-p "02-document"
                                       (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))))
              (should (= (point) (overlay-start ov)))))
          ;; 3. Icons view: 1-line and 2-line wrapped filenames highlight cleanly across spans.
          (with-temp-buffer
            (let ((w (selected-window)))
              (set-window-buffer w (current-buffer))
              (strata-icons-mode)
              (strata-icons-render tmp)
              (strata-goto-file f2)
              (should (= (length strata--selection-overlays) 2))
              (let ((spans (sort (mapcar (lambda (o)
                                           (buffer-substring-no-properties (overlay-start o) (overlay-end o)))
                                         strata--selection-overlays)
                                 #'string<)))
                (should (cl-some (lambda (s) (string-search "03-another" s)) spans))
                (should (cl-some (lambda (s) (string-search "file-name-wrap" s)) spans))))))
      (delete-directory tmp t))))

(ert-deftest strata-test-selection-highlight-unrecognized-dired-rows ()
  "An unrecognized marked listing row cannot restart the highlighting scan."
  (with-temp-buffer
    (setq major-mode 'dired-mode)
    (insert "*---------- malformed listing row\n*---------- another malformed row\n")
    (let ((dired-re-mark "^\\*")
          (directory-listing-before-filename-regexp "\\`UNRECOGNIZED\\'")
          (original (symbol-function 'dired-move-to-filename))
          (calls 0))
      ;; Bound the old failure without hanging the test runner.  The real
      ;; filename parser returns to BOL when it cannot recognize metadata.
      (should-not
       (catch 'strata-repeated-row
         (cl-letf (((symbol-function 'dired-move-to-filename)
                    (lambda (&rest args)
                      (when (> (cl-incf calls) 2) (throw 'strata-repeated-row t))
                      (apply original args))))
           (strata--highlight-marked-dired nil nil))))
      (should (= calls 2)))))

(ert-deftest strata-test-dashboard-visible-dirvish-shortcut ()
  "Dashboard renders one navigator and its Dirvish button launches the browser."
  (require 'dashboard)
  (let ((dashboard-navigator-buttons nil)
        (dashboard-startupify-list '(dashboard-insert-banner-title dashboard-insert-items))
        (launched nil))
    (strata-dirvish-dashboard-install)
    (strata-dirvish-dashboard-install)
    (should (= (cl-count #'dashboard-insert-navigator dashboard-startupify-list) 1))
    (should (< (cl-position #'dashboard-insert-navigator dashboard-startupify-list)
               (cl-position #'dashboard-insert-items dashboard-startupify-list)))
    (with-temp-buffer
      (let ((dashboard-init-info "250 packages loaded in 1.2 seconds"))
        (dashboard-insert-init-info))
      (should-not (bolp))
      (dashboard-insert-navigator)
      (widget-setup)
      ;; Fixed display widths survive Dashboard's face rewriting and keep
      ;; wide Nerd glyphs clear of their labels in variable-pitch themes.
      (let ((pos (point-min)) (padding 0))
        (while (< pos (point-max))
          (when (equal (get-text-property pos 'display) '(space :width 1.5))
            (setq padding (1+ padding)))
          (setq pos (1+ pos)))
        (should (= padding 6)))
      (goto-char (point-min))
      (should (search-forward "Dirvish" nil t))
      (should (= (line-number-at-pos) 2))
      (cl-letf (((symbol-function 'strata-dirvish-launch)
                 (lambda (&rest _) (setq launched t))))
        (widget-button-press (1- (point))))
      (should launched))))

(ert-deftest strata-test-terminal-launch-disables-fastfetch ()
  "Terminals launched from Dirvish pass FASTFETCH_ENABLED=0."
  (let* ((tmp (make-temp-file "strata-term-" t))
         (seen-vterm-env nil)
         (seen-ext-env nil))
    (unwind-protect
        (cl-letf (((symbol-function 'vterm)
                   (lambda (buf-name)
                     (setq seen-vterm-env (copy-sequence process-environment))
                     (get-buffer-create buf-name)))
                  ((symbol-function 'executable-find)
                   (lambda (bin &rest _) (when (string= bin "kitty") "/usr/bin/kitty")))
                  ((symbol-function 'make-process)
                   (lambda (&rest _)
                     (setq seen-ext-env (copy-sequence process-environment))
                     nil)))
          (let ((b (strata-pane--spawn-terminal " *strata-test-term*" tmp)))
            (when (buffer-live-p b) (kill-buffer b)))
          (strata-open-external-terminal tmp)
