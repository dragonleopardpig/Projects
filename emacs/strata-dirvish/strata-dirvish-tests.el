        (strata-refresh-active-view)
        (let* ((start (event-start (strata-test--selection-event 'C-down-mouse-1 a)))
               (end (event-start (strata-test--selection-event 'mouse-1 folder 80))))
          (strata-mouse-down-entry (list 'C-down-mouse-1 start 1))
          (strata-mouse--drag-move (strata-test--selection-event 'C-mouse-movement (nth 2 strata-test--files) 30))
          (strata-mouse--on-drag-exit)
          (strata-mouse-drag-copy (list 'C-drag-mouse-1 start end)))
        (should (file-exists-p a))
        (should (equal (directory-files folder nil "\\`[^.]") '("a.txt")))))))

(ert-deftest strata-test-mouse-folder-drop-rejects-self-and-descendants ()
  "A drag cannot move its own destination or any ancestor into the destination."
  (strata-test--with-selection-view 'list
    (let* ((folder (expand-file-name "parent" strata-test--dir))
           (child (expand-file-name "child" folder))
           (a (car strata-test--files)))
      (make-directory child t)
      (strata-refresh-active-view)
      (strata-view--set-entry-mark a t)
      (strata-view--set-entry-mark folder t)
      (let* ((win (selected-window))
             (end (event-start (strata-test--selection-event 'mouse-1 folder))))
        (should-not (strata-mouse--drop-dir win win end a (list a folder)))
        (cl-letf (((symbol-function 'strata-mouse--drag-target-dir) (lambda (&rest _) child)))
          (should-error (strata-mouse--drag-drop-now win win nil end a (list a folder) 'cut)
                        :type 'user-error)))
      (should (file-exists-p a))
      (should (file-directory-p child)))))

