  (strata-test--with-selection-view 'compact
    (let ((a (car strata-test--files)) (b (nth 1 strata-test--files))
          (last-input-event ?x) (last-nonmenu-event ?x) asked)
      (cl-letf (((symbol-function 'strata-ui-mouse-p)
                 (lambda () (eq strata-ui-input-method 'mouse)))
                ((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                ((symbol-function 'popup-menu)
                 (lambda (menu &rest _)
                   (call-interactively (strata-test--popup-menu-command menu "Rename…"))))
                ((symbol-function 'strata-ui--gtk-entry)
                 (lambda (&rest _) (push 'entry asked) "b.txt"))
                ((symbol-function 'x-popup-dialog)
                 (lambda (&rest _) (push 'confirm asked) t))
                ((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Mouse name was textual")))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) (ert-fail "Mouse confirm was textual")))
                ((symbol-function 'strata-refresh-active-view) #'ignore))
