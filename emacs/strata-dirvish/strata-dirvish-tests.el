(ert-deftest strata-test-launch-skips-stale-or-missing-tab-directories ()
  "Launching `C-c d' skips stale tabs and always falls back to `~/'."
  (let* ((tmp (make-temp-file "strata-stale-" t))
         (live-dir (expand-file-name "live" tmp))
         (missing-dir (expand-file-name "gone-dv-Q7Cf5Q" tmp))
         (home (directory-file-name (expand-file-name "~/")))
         (strata-dirvish-state-dir (make-temp-file "strata-stale-state-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :restore-tabs t :default-directory live-dir))
         (strata-workspace-tabs nil)
         (strata-closed-tabs nil)
         (strata-active-tab-index 0)
         (strata-visited-folders nil)
         (opened nil))
    (unwind-protect
        (progn
          (make-directory live-dir t)
          ;; 1. Saved `tabs.eld' with stale first tab and live second tab picks the live tab.
          (with-temp-file strata-tabs-state-file
            (prin1 (list :active 0
                         :tabs (list (list :dir missing-dir :split-p nil)
                                     (list :dir live-dir :split-p nil)))
                   (current-buffer)))
          (with-current-buffer (get-buffer-create "*dashboard*")
            (cl-letf (((symbol-function 'strata-open-location)
                       (lambda (loc &optional _rec) (setq opened loc))))
              (strata-dirvish-launch)
              (should (equal (directory-file-name opened)
                             (directory-file-name live-dir)))
              (should (= (length strata-workspace-tabs) 1))))
          ;; 2. All saved/in-memory tabs stale from `*dashboard*' (even with another
          ;; buffer `default-directory' or `prefs' default-directory) -> falls back to `~/'.
          (setq strata-workspace-tabs
                (list (make-strata-tab-state
                       :id 99 :label "gone" :dir missing-dir
                       :pane1 (make-strata-pane-state :id 1 :dir missing-dir)))
                strata-active-tab-index 0
                opened nil)
          (with-current-buffer (get-buffer-create "*dashboard*")
            (let ((default-directory (file-name-as-directory live-dir)))
              (cl-letf (((symbol-function 'strata-open-location)
                         (lambda (loc &optional _rec) (setq opened loc))))
                (strata-dirvish-launch)
                (should (equal (directory-file-name opened) home))
                (should (null strata-workspace-tabs)))))
          ;; 3. Explicit non-existent `dir' falls back to `~/'.
          (setq opened nil)
          (with-temp-buffer
            (let ((default-directory (file-name-as-directory live-dir)))
              (cl-letf (((symbol-function 'strata-open-location)
                         (lambda (loc &optional _rec) (setq opened loc))))
                (strata-dirvish-launch missing-dir)
                (should (equal (directory-file-name opened) home)))))
          ;; 4. `strata-open-location' on non-existent path falls back to `~/' without error.
          (setq strata-workspace-tabs nil
                strata-active-tab-index 0
                opened nil)
          (let ((strata-prefs-current (strata-prefs--create :restore-tabs nil)))
            (save-window-excursion
              (cl-letf (((symbol-function 'strata-sidebar-ensure) (lambda () t))
                        ((symbol-function 'strata-sidebar-refresh) (lambda () nil))
                        ((symbol-function 'strata-dirvish--flatten-layout) (lambda () nil))
                        ((symbol-function 'dirvish-find-entry-a) (lambda (&rest _) nil)))
                (strata-open-location missing-dir)
                (should (equal (directory-file-name (strata-tab-state-dir (strata-active-tab)))
                               home))))))
      (when (get-buffer "*dashboard*")
        (kill-buffer "*dashboard*"))
      (delete-directory tmp t)
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-split-pane-address-and-places-target-cursor-pane ()
  "Clicking Places or address breadcrumbs updates the pane where cursor/click happened."
  (let* ((tmp (make-temp-file "strata-split-target-" t))
         (dir-a (expand-file-name "dirA" tmp))
         (dir-b (expand-file-name "dirB" tmp))
         (dir-c (expand-file-name "dirC" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-split-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :browser-mode 'list :restore-tabs nil :sidebar-expanded t))
         (strata-workspace-tabs nil)
         (strata-closed-tabs nil)
         (strata-active-tab-index 0)
         (strata-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory dir-a)
          (make-directory dir-b)
          (make-directory dir-c)
          (strata-open-location dir-a)
          (strata-toggle-extra-pane)
          (strata-open-location dir-b)
          (let* ((tab (strata-active-tab))
                 (p1 (strata-tab-state-pane1 tab))
                 (p2 (strata-tab-state-pane2 tab))
                 (w1 (strata-pane-state-window p1))
                 (w2 (strata-pane-state-window p2)))
            (should (window-live-p w1))
            (should (window-live-p w2))
            (should (not (eq w1 w2)))
            (should (= (strata-tab-state-active-pane tab) 2))
            ;; 1. Move cursor into Pane 1 (`w1`) -> window selection change must activate Pane 1.
            (select-window w1)
            (strata-panes--on-window-selection-change)
            (should (= (strata-tab-state-active-pane tab) 1))
            ;; 2. Click Places entry inside sidebar while Pane 1 was last active -> must update Pane 1 only!
            (when (window-live-p strata-sidebar-window)
              (select-window strata-sidebar-window))
            (strata-open-location dir-c t)
            (should (eq (selected-window) w1))
            (should (equal (directory-file-name (strata-pane-state-dir p1))
                           (directory-file-name dir-c)))
            (should (equal (directory-file-name (strata-pane-state-dir p2))
                           (directory-file-name dir-b)))
            ;; 3. Click address breadcrumb of inactive Pane 2 (`w2`) -> must update Pane 2 (`w2`), not Pane 1!
            (select-window w1)
            (strata-panes--on-window-selection-change)
            (should (= (strata-tab-state-active-pane tab) 1))
            (let* ((seg (with-current-buffer (window-buffer w2)
                          (strata-crumb--make-segment "root" tmp)))
                   (km (get-text-property 0 'keymap seg))
                   (fn (lookup-key km [header-line mouse-1]))
                   (ev `(mouse-1 (,w2 1 (10 . 1) 0) 1)))
              (should (functionp fn))
              (funcall fn ev))
            (should (eq (selected-window) w2))
            (should (= (strata-tab-state-active-pane tab) 2))
            (should (equal (directory-file-name (strata-pane-state-dir p2))
                           (directory-file-name tmp)))
            (should (equal (directory-file-name (strata-pane-state-dir p1))
                           (directory-file-name dir-c)))
            ;; 4. `C-l' (`strata-location-prompt') syncs to the pane where cursor sits (`w1`).
            (select-window w1)
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt _coll &rest _) dir-a)))
              (strata-location-prompt))
            (should (equal (directory-file-name (strata-pane-state-dir p1))
                           (directory-file-name dir-a)))
            (should (equal (directory-file-name (strata-pane-state-dir p2))
                           (directory-file-name tmp)))))
      (when (window-live-p strata-sidebar-window)
        (ignore-errors (delete-window strata-sidebar-window))
        (setq strata-sidebar-window nil))
      (when-let ((sb (get-buffer "*Strata Sidebar*")))
        (kill-buffer sb))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-multi-select-highlight-drag-and-context-copy ()
  "Multi-selection highlights across views and drags/right-clicks to copy or move across panes."
  (let* ((tmp (make-temp-file "strata-multi-" t))
         (src (expand-file-name "src" tmp))
         (dst (expand-file-name "dst" tmp))
         (fa (expand-file-name "a.txt" src))
         (fb (expand-file-name "b.txt" src))
         (fc (expand-file-name "c.txt" src))
         (fd (expand-file-name "d.txt" src))
         (strata-dirvish-state-dir (make-temp-file "strata-multi-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :browser-mode 'list :folders-first t :restore-tabs nil :sidebar-expanded nil))
         (strata-workspace-tabs nil)
         (strata-closed-tabs nil)
         (strata-active-tab-index 0)
         (strata-undo-stack nil)
         (strata-redo-stack nil)
         (strata-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory src)
          (make-directory dst)
          (dolist (f (list fa fb fc fd))
            (write-region (concat "content-" (file-name-nondirectory f)) nil f))
          ;; Verify keymap mouse & Shift-arrow bindings exist in both maps.
          (dolist (km (list strata-default-keymap strata-10xer-keymap))
            (should (eq (lookup-key km (kbd "<drag-mouse-1>")) #'strata-mouse-drag-drop))
            (should (eq (lookup-key km (kbd "<C-mouse-1>")) #'strata-mouse-toggle-select))
            (should (eq (lookup-key km (kbd "<S-mouse-1>")) #'strata-mouse-range-select))
            (should (eq (lookup-key km (kbd "<mouse-3>")) #'strata-mouse-context-menu)))
          (should (eq (lookup-key strata-default-keymap (kbd "S-<down>")) #'strata-shift-select-next))
          (should (eq (lookup-key strata-default-keymap (kbd "S-<up>")) #'strata-shift-select-prev))
          ;; Open src in Pane 1 and dst in Pane 2.
          (strata-open-location src)
          (strata-toggle-extra-pane)
          (strata-open-location dst)
          (let* ((tab (strata-active-tab))
                 (w1 (strata-pane-state-window (strata-tab-state-pane1 tab)))
                 (w2 (strata-pane-state-window (strata-tab-state-pane2 tab))))
            (select-window w1)
            (strata-panes--on-window-selection-change)
            ;; 1. `S-<down>' highlights both starting and next entry in Dired (`strata-entry-selected').
            (strata-goto-file fa)
            (strata-shift-select-next)
            (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                           '("a.txt" "b.txt")))
            (should (>= (length strata--selection-overlays) 2))
            ;; 2. `C-<mouse-1>' toggles `d.txt' in and out without clearing existing marks.
            (let ((pd (save-excursion (strata-goto-file fd) (point))))
              (strata-mouse-toggle-select `(mouse-1 (,w1 ,pd (10 . 10) 0) 1))
              (should (= (length (strata-marked-files-only)) 3))
              (strata-mouse-toggle-select `(mouse-1 (,w1 ,pd (10 . 10) 0) 1))
              (should (= (length (strata-marked-files-only)) 2)))
            ;; 3. Same-pane drag swipe highlights range `b.txt'..`d.txt' cleanly.
            (strata-clear-all-marks)
            (let ((pb (save-excursion (strata-goto-file fb) (point)))
                  (pd (save-excursion (strata-goto-file fd) (point))))
              (strata-mouse-drag-drop `(drag-mouse-1 (,w1 ,pb (10 . 10) 0) (,w1 ,pd (10 . 40) 0)))
              (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                             '("b.txt" "c.txt" "d.txt")))
              (should (>= (length strata--selection-overlays) 3))
              ;; 4. Cross-pane drag copies all highlighted files into Pane 2 (`dst').
              (cl-letf (((symbol-function 'read-char-choice) (lambda (&rest _) ?c)))
                (strata-mouse-drag-drop `(drag-mouse-1 (,w1 ,pb (10 . 10) 0) (,w2 1 (200 . 20) 0))))
              (should (file-exists-p (expand-file-name "b.txt" dst)))
              (should (file-exists-p (expand-file-name "c.txt" dst)))
              (should (file-exists-p (expand-file-name "d.txt" dst)))
              (should (file-exists-p fb)))
            ;; 5. `<S-drag-mouse-1>' moves `b.txt' across panes; `<C-drag-mouse-1>' copies `a.txt'.
            (delete-file (expand-file-name "b.txt" dst))
            (strata-clear-all-marks)
            (let ((pa (save-excursion (strata-goto-file fa) (point)))
                  (pb (save-excursion (strata-goto-file fb) (point))))
              (strata-mouse-drag-copy `(C-drag-mouse-1 (,w1 ,pa (10 . 10) 0) (,w2 1 (200 . 20) 0)))
              (should (file-exists-p (expand-file-name "a.txt" dst)))
              (should (file-exists-p fa))
              (strata-mouse-drag-move `(S-drag-mouse-1 (,w1 ,pb (10 . 20) 0) (,w2 1 (200 . 20) 0)))
              (should (file-exists-p (expand-file-name "b.txt" dst)))
              (should-not (file-exists-p fb)))
            ;; 6. Right-click (`strata-mouse-context-menu`) in Pane 1 while Pane 2 had cursor -> `Copy to Other Pane`.
            (delete-file (expand-file-name "a.txt" dst))
            (delete-file (expand-file-name "c.txt" dst))
            (select-window w1)
            (strata-clear-all-marks)
            (strata-goto-file fa)
            (strata-shift-select-next) ; selects a.txt + c.txt (since b.txt was moved)
            (should (= (length (strata-marked-files-only)) 2))
            (select-window w2)
            (strata-panes--on-window-selection-change)
            (let ((pa (with-selected-window w1 (save-excursion (strata-goto-file fa) (point)))))
              (cl-letf (((symbol-function 'strata-context-menu) #'strata-copy-to-other-pane))
                (strata-mouse-context-menu `(mouse-3 (,w1 ,pa (10 . 10) 0) 1))))
            (should (file-exists-p (expand-file-name "a.txt" dst)))
            (should (file-exists-p (expand-file-name "c.txt" dst)))
            ;; 7. Multi-selection highlighting works in Compact & Icons views too.
            (select-window w1)
            (dolist (m '(compact icons))
              (strata-switch-view-mode m)
              (strata-clear-all-marks)
              (strata-goto-file fa)
              (if (eq m 'icons)
                  (strata-shift-select-right)
                (strata-shift-select-next))
              (should (= (length (strata-marked-files-only)) 2))
              (should (>= (length strata--selection-overlays) 2)))))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(defun strata-test--wait-until (pred &optional timeout-secs)
  "Pump Emacs events and timers until PRED returns non-nil or TIMEOUT-SECS elapses."
  (let ((deadline (+ (float-time) (or timeout-secs 2.5))))
    (while (and (not (funcall pred))
                (< (float-time) deadline))
      (read-event nil nil 0.05)
      (accept-process-output nil 0.01))
    (funcall pred)))

(ert-deftest strata-test-live-watch-compact-icons-and-split-panes ()
  "External filesystem changes live-update Compact, Icons, and Split panes via filenotify."
  (let* ((tmp (make-temp-file "strata-watch-views-" t))
         (dirA (file-name-as-directory (expand-file-name "dirA" tmp)))
         (dirB (file-name-as-directory (expand-file-name "dirB" tmp)))
         (strata-dirvish-state-dir (make-temp-file "strata-watch-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-thumbnail-dir (expand-file-name "thumbnails" strata-dirvish-state-dir))
         (strata-workspace-tabs nil)
         (strata-preview-standalone-window nil)
         (strata-sidebar-window nil)
         bufA bufB)
    (make-directory dirA t)
    (make-directory dirB t)
    (write-region "alpha" nil (expand-file-name "alpha.txt" dirA) nil 'silent)
    (write-region "beta" nil (expand-file-name "beta.txt" dirB) nil 'silent)
    (unwind-protect
        (save-window-excursion
          (strata-dirvish-setup)
          (delete-other-windows)
          ;; 1. Compact view watches dirA and reacts to external file creation & deletion.
          (setq bufA (get-buffer-create "*Strata Test Compact*"))
          (switch-to-buffer bufA)
          (strata-compact-mode)
          (strata-compact-render dirA)
          (should (assoc (cons 'primary dirA) strata-watch--entries))
          (call-process "sh" nil nil nil "-c"
                        (format "printf 'gamma\\n' > %s"
                                (shell-quote-argument (expand-file-name "gamma.txt" dirA))))
          (should (strata-test--wait-until
                   (lambda ()
                     (with-current-buffer bufA
                       (string-match-p "gamma\\.txt" (buffer-string))))))
          ;; 2. Split pane with Icons view in dirB updates simultaneously in second window.
          (let ((w2 (split-window-right)))
            (setq bufB (get-buffer-create "*Strata Test Icons*"))
            (set-window-buffer w2 bufB)
            (with-selected-window w2
              (strata-icons-mode)
              (strata-icons-render dirB)
              (should (assoc (cons 'primary dirB) strata-watch--entries)))
            (call-process "sh" nil nil nil "-c"
                          (format "printf 'delta\\n' > %s && rm -f %s"
                                  (shell-quote-argument (expand-file-name "delta.txt" dirB))
                                  (shell-quote-argument (expand-file-name "beta.txt" dirB))))
            (should (strata-test--wait-until
                     (lambda ()
                       (with-current-buffer bufB
                         (let ((s (buffer-string)))
                           (and (string-match-p "delta\\.txt" s)
                                (not (string-match-p "beta\\.txt" s)))))))))
          ;; 3. Killing watched buffers removes descriptors cleanly.
          (let ((watched-descrs
                 (append (with-current-buffer bufA (mapcar #'cdr strata-watch--entries))
                         (with-current-buffer bufB (mapcar #'cdr strata-watch--entries)))))
            (kill-buffer bufA)
            (kill-buffer bufB)
            (dolist (d watched-descrs)
              (should-not (gethash d strata-watch--table)))))
      (dolist (b (list bufA bufB))
        (when (buffer-live-p b) (kill-buffer b)))
      (delete-other-windows)
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-live-watch-parent-subdir-and-preview-cache ()
  "External changes live-update Miller parents, hovered subfolders, and text/thumb caches."
  (let* ((tmp (make-temp-file "strata-watch-deep-" t))
         (parent (file-name-as-directory (expand-file-name "parent" tmp)))
         (child (file-name-as-directory (expand-file-name "child" parent)))
         (sub (file-name-as-directory (expand-file-name "sub" child)))
         (note (expand-file-name "note.txt" child))
         (strata-dirvish-state-dir (make-temp-file "strata-deep-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-thumbnail-dir (expand-file-name "thumbnails" strata-dirvish-state-dir))
         (strata-workspace-tabs nil)
         (strata-preview-standalone-window nil)
         (strata-sidebar-window nil)
         cbuf pbuf pwin prev-buf)
    (make-directory sub t)
    (write-region "initial-text" nil note nil 'silent)
    (write-region "inside" nil (expand-file-name "inside.txt" sub) nil 'silent)
    (unwind-protect
        (save-window-excursion
          (strata-dirvish-setup)
          (delete-other-windows)
          ;; 1. Miller parent column (`dirvish-directory-view-mode') live-updates & clears dv-parent-hash.
          (let* ((dv (dirvish--new :curr-layout '(1 0.14 0.48)))
                 (str (with-temp-buffer (dired-insert-directory parent "-alh") (buffer-string))))
            (puthash (directory-file-name parent) str (dv-parent-hash dv))
            (setq pbuf (dirvish--special-buffer "parent-1" dv t))
            (with-current-buffer pbuf
              (dirvish-directory-view-mode)
              (dirvish-prop :dv (dv-id dv))
              (let ((inhibit-read-only t)) (erase-buffer) (insert str))
              (setq-local dired-subdir-alist (list (cons (directory-file-name parent) (point-min-marker))))
              (strata-dirvish--parent-buffer-filter pbuf)
              (strata-watch-setup))
            (should (with-current-buffer pbuf
                      (assoc (cons 'parent parent) strata-watch--entries)))
            (call-process "sh" nil nil nil "-c"
                          (format "touch %s"
                                  (shell-quote-argument (expand-file-name "sibling.txt" parent))))
            (should (strata-test--wait-until
                     (lambda ()
                       (with-current-buffer pbuf
                         (string-match-p "sibling\\.txt" (buffer-string)))))))
          ;; 2. Hovered subfolder in browser live-updates standalone `*Strata Preview*` via subdir watch.
          (setq cbuf (get-buffer-create "*Strata Test Hover*"))
          (switch-to-buffer cbuf)
          (strata-compact-mode)
          (strata-compact-render child)
          (setq pwin (split-window-right))
          (setq strata-preview-standalone-window pwin)
          (strata-goto-file (directory-file-name sub))
          (strata-preview-update-standalone (directory-file-name sub) pwin)
          (strata-watch-sync cbuf)
          (should (assoc (cons 'preview-subdir sub) strata-watch--entries))
          (call-process "sh" nil nil nil "-c"
                        (format "touch %s"
                                (shell-quote-argument (expand-file-name "nested_new.txt" sub))))
          (should (strata-test--wait-until
                   (lambda ()
                     (when-let ((sb (get-buffer "*Strata Preview*")))
                       (with-current-buffer sb
                         (string-match-p "nested_new\\.txt" (buffer-string)))))))
          ;; 3. Overwritten file invalidates stale thumbnail files & `dv-preview-hash',
          ;;    and reloads an active `strata-preview-read-mode' buffer safely.
          (make-directory strata-thumbnail-dir t)
          (let* ((stale-thumb (expand-file-name (format "img-%s-100.png" (md5 note))
                                                strata-thumbnail-dir))
                 (dv2 (dirvish--new :curr-layout '(1 0.14 0.48))))
            (write-region "stale" nil stale-thumb nil 'silent)
            (puthash note "stale-cached-text" (dv-preview-hash dv2))
            (setq prev-buf (generate-new-buffer (format "PREVIEW :: %s :: note.txt" (dv-timestamp dv2))))
            (with-current-buffer prev-buf
              (insert "initial-text")
              (set-buffer-modified-p nil)
              (setq buffer-file-name note
                    strata-preview--file note)
              (strata-preview-read-mode 1))
            (set-window-buffer pwin prev-buf)
            (setf (dv-preview-window dv2) pwin
                  (dv-index dv2) (cons child cbuf))
            (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv2))
                      ((symbol-function 'dirvish--preview-update)
                       (lambda (d f)
                         (let ((nb (get-buffer-create
                                    (format "PREVIEW :: %s :: %s"
                                            (dv-timestamp d) (file-name-nondirectory f)))))
                           (with-current-buffer nb
                             (let ((inhibit-read-only t))
                               (erase-buffer)
                               (insert-file-contents f)
                               (setq buffer-file-name f)))
                           (set-window-buffer (dv-preview-window d) nb)))))
              (strata-goto-file note)
              (strata-watch-sync cbuf)
              (call-process "sh" nil nil nil "-c"
                            (format "printf 'updated-externally\\n' > %s"
                                    (shell-quote-argument note)))
              (should (strata-test--wait-until
                       (lambda ()
                         (let ((wb (and (window-live-p pwin) (window-buffer pwin))))
                           (and (buffer-live-p wb)
                                (with-current-buffer wb
                                  (string-match-p "updated-externally" (buffer-string))))))))
              (should-not (file-exists-p stale-thumb))
              (should-not (gethash note (dv-preview-hash dv2)))
              (should (with-current-buffer (window-buffer pwin)
                        strata-preview-read-mode))))
          ;; 4. Unsafe cloud FUSE directory must still be skipped by watcher setup.
          (cl-letf (((symbol-function 'strata-path-mount-kind) (lambda (_p) 'cloud)))
            (should-not (strata-watch--safe-dir-p child))
            (with-temp-buffer
              (setq default-directory child)
              (strata-watch-setup)
              (should-not strata-watch--entries))))
      (dolist (b (list cbuf pbuf prev-buf (get-buffer "*Strata Preview*")))
        (when (buffer-live-p b)
          (with-current-buffer b (set-buffer-modified-p nil))
          (kill-buffer b)))
      (delete-other-windows)
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-live-watch-trash-and-sidebar ()
  "External XDG Trash changes live-update `*Strata Trash*' and Sidebar Trash counter."
  (let* ((tmp (make-temp-file "strata-watch-trash-" t))
         (xdg (expand-file-name "xdg" tmp))
         (tfiles (expand-file-name "Trash/files" xdg))
         (tinfo (expand-file-name "Trash/info" xdg))
         (strata-dirvish-state-dir (make-temp-file "strata-trash-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (process-environment (cons (concat "XDG_DATA_HOME=" xdg) process-environment))
         tbuf sbuf)
    (make-directory tfiles t)
    (make-directory tinfo t)
    (unwind-protect
        (progn
          (strata-watch-install)
          (setq tbuf (strata-open-trash-buffer))
          (setq sbuf (get-buffer-create "*Strata Sidebar*"))
          (with-current-buffer sbuf
            (strata-sidebar-mode)
            (strata-sidebar-render))
          (should (with-current-buffer tbuf (string-match-p "Trash is empty" (buffer-string))))
          (should (with-current-buffer sbuf (string-match-p "Trash (0)" (buffer-string))))
          (call-process "sh" nil nil nil "-c"
                        (format "printf '[Trash Info]\\nPath=/tmp/gone.txt\\nDeletionDate=2026-11-15T19:00:00\\n' > %s && printf 'bye' > %s"
                                (shell-quote-argument (expand-file-name "gone.txt.trashinfo" tinfo))
                                (shell-quote-argument (expand-file-name "gone.txt" tfiles))))
          (should (strata-test--wait-until
                   (lambda ()
                     (and (with-current-buffer tbuf
                            (string-match-p "gone\\.txt" (buffer-string)))
                          (with-current-buffer sbuf
                            (string-match-p "Trash (1)" (buffer-string))))))))
      (dolist (b (list tbuf sbuf))
        (when (buffer-live-p b) (kill-buffer b)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(defun strata-test--play-events (&rest events)
  "Replay synthetic mouse/keyboard EVENTS through Emacs's live command loop."
  (execute-kbd-macro (apply #'vector events)))

(ert-deftest strata-test-hold-and-drag-live-select-and-reverse-dired ()
  "Live transient-map drag highlights in real time across List/Columns & handles cancel/clicks."
  (let* ((tmp (make-temp-file "strata-drag-live-" t))
         (dir-a (expand-file-name "subA" tmp))
         (fa (expand-file-name "a.txt" tmp))
         (fb (expand-file-name "b.txt" tmp))
         (fc (expand-file-name "c.txt" tmp))
         (fd (expand-file-name "d.txt" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-drag-live-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :browser-mode 'list :folders-first t :restore-tabs nil :sidebar-expanded nil))
         (strata-workspace-tabs nil)
         (strata-closed-tabs nil)
         (strata-active-tab-index 0)
         (strata-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory dir-a)
          (dolist (f (list fa fb fc fd))
            (write-region "x" nil f))
          (strata-open-location tmp)
          (let* ((w (selected-window))
                 (pa (save-excursion (strata-goto-file fa) (point)))
                 (pb (save-excursion (strata-goto-file fb) (point)))
                 (pc (save-excursion (strata-goto-file fc) (point)))
                 (pd (save-excursion (strata-goto-file fd) (point)))
                 (snapshots nil))
            ;; 1. Live drag via native `set-transient-map' highlights `a..d` then shrinks to `a..b`.
            (strata-goto-file dir-a)
            (strata-view--set-entry-mark dir-a t nil)
            (cl-letf (((symbol-function 'strata-mouse--apply-selection-keys)
                       (let ((orig (symbol-function 'strata-mouse--apply-selection-keys)))
                         (lambda (order target-keys &optional final-p)
                           (funcall orig order target-keys final-p)
                           (push (list final-p
                                       (length strata--selection-overlays)
                                       (eq track-mouse 'drag-tracking)
                                       (mapcar #'file-name-nondirectory (strata-marked-files-only)))
                                 snapshots)))))
              (strata-test--play-events
               `(down-mouse-1 (,w ,pa (10 . 10) 0) 1)
               `(mouse-movement (,w ,pc (10 . 30) 0))
               `(mouse-movement (,w ,pd (10 . 50) 0))
               `(mouse-movement (,w ,pb (10 . 20) 0))
               `(drag-mouse-1 (,w ,pa (10 . 10) 0) (,w ,pb (10 . 20) 0))))
            (setq snapshots (nreverse snapshots))
            (should (cl-some (lambda (s)
                               (and (not (car s))
                                    (>= (nth 1 s) 4)
                                    (nth 2 s)
                                    (equal (nth 3 s) '("a.txt" "b.txt" "c.txt" "d.txt"))))
                             snapshots))
            (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                           '("a.txt" "b.txt")))
            (should-not track-mouse)
            (should-not strata-mouse--drag-state)
            (should-not strata-mouse--finished-drag-state)
            ;; 2. Drag starting in empty space (`point-max`) sweeps upward to `b.txt` -> `b..d`.
            (strata-clear-all-marks)
            (let ((pmax (point-max)))
              (strata-test--play-events
               `(down-mouse-1 (,w ,pmax (10 . 80) 0) 1)
               `(mouse-movement (,w ,pd (10 . 60) 0))
               `(mouse-movement (,w ,pb (10 . 20) 0))
               `(drag-mouse-1 (,w ,pmax (10 . 80) 0) (,w ,pb (10 . 20) 0))))
            (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                           '("b.txt" "c.txt" "d.txt")))
            ;; 3. `C-<down-mouse-1>' drag adds `c..d` onto existing `a.txt` mark cleanly.
            (strata-clear-all-marks)
            (strata-view--set-entry-mark fa t nil)
            (strata-test--play-events
             `(C-down-mouse-1 (,w ,pc (10 . 30) 0) 1)
             `(C-mouse-movement (,w ,pd (10 . 50) 0))
             `(C-drag-mouse-1 (,w ,pc (10 . 30) 0) (,w ,pd (10 . 50) 0)))
            (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                           '("a.txt" "c.txt" "d.txt")))
            ;; 4. Right-click (`down-mouse-3` + `mouse-3`) cancels drag, suppresses menu, and ignores button-1 release.
            (let ((menu-opened nil))
              (cl-letf (((symbol-function 'strata-context-menu) (lambda () (setq menu-opened t))))
                (strata-test--play-events
                 `(down-mouse-1 (,w ,pa (10 . 10) 0) 1)
                 `(mouse-movement (,w ,pb (10 . 20) 0))
                 `(down-mouse-3 (,w ,pb (10 . 20) 0) 1)
                 `(mouse-3 (,w ,pb (10 . 20) 0) 1)
                 `(drag-mouse-1 (,w ,pa (10 . 10) 0) (,w ,pb (10 . 20) 0))))
              (should-not menu-opened)
              (should-not strata-mouse--suppress-mouse-3-once)
              (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                             '("a.txt" "c.txt" "d.txt"))))
            ;; 5. Micro-jitter release (<= 6px on same entry) falls back to single-click navigation/preview.
            (strata-clear-all-marks)
            (strata-goto-file fa)
            (strata-test--play-events
             `(down-mouse-1 (,w ,pb (10 . 20) 0) 1)
             `(drag-mouse-1 (,w ,pb (10 . 20) 0) (,w ,pb (11 . 21) 0)))
            (should-not (strata-marked-files-only))
            (should (equal (strata--path-key (strata-current-file)) (strata--path-key fb)))
            ;; 6. Columns view live drag also handles fringe/margin motion with `nil' buffer point.
            (strata-switch-view-mode 'columns)
            (strata-clear-all-marks)
            (let* ((pa-col (save-excursion (strata-goto-file fa) (point)))
                   ;; Derive an edge row beyond the last file for either GUI
                   ;; font metrics or batch character cells.
                   (edge-y (* (+ 2 (count-lines (window-start w) (point-max)))
                              (frame-char-height (window-frame w))))
                   (fringe-posn (list w 'left-fringe (cons 2 edge-y) 0 nil nil nil nil nil)))
              (strata-test--play-events
               `(down-mouse-1 (,w ,pa-col (10 . 10) 0) 1)
               `(left-fringe mouse-movement ,fringe-posn)
               `(drag-mouse-1 (,w ,pa-col (10 . 10) 0) ,fringe-posn)))
            (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                           '("a.txt" "b.txt" "c.txt" "d.txt")))
            (should (>= (length strata--selection-overlays) 4))))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(ert-deftest strata-test-hold-and-drag-icons-grid-blank-gaps-and-cross-pane ()
  "Icons/Compact modes share drag-select bindings, handle blank gaps & 2D grid, and drag marked batches across panes."
  (let* ((tmp (make-temp-file "strata-drag-grid-" t))
         (src (expand-file-name "src" tmp))
         (dst (expand-file-name "dst" tmp))
         (files (cl-loop for i from 1 to 6
                         collect (expand-file-name (format "f%d.txt" i) src)))
         (strata-dirvish-state-dir (make-temp-file "strata-drag-grid-st-" t))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-prefs-current (strata-prefs--create :browser-mode 'icons :folders-first t :restore-tabs nil :sidebar-expanded nil :show-thumbnails nil))
         (strata-workspace-tabs nil)
         (strata-closed-tabs nil)
         (strata-active-tab-index 0)
         (strata-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory src)
          (make-directory dst)
          (dolist (f files)
            (write-region "x" nil f))
          (dolist (km (list strata-compact-mode-map strata-icons-mode-map))
            (should (eq (lookup-key km (kbd "<down-mouse-1>")) #'strata-mouse-down-entry))
            (should (eq (lookup-key km (kbd "<drag-mouse-1>")) #'strata-mouse-drag-drop)))
          (strata-open-location src)
          (strata-toggle-extra-pane)
          (strata-open-location dst)
          (let* ((tab (strata-active-tab))
                 (w1 (strata-pane-state-window (strata-tab-state-pane1 tab)))
                 (w2 (strata-pane-state-window (strata-tab-state-pane2 tab))))
            (select-window w1)
            (strata-panes--on-window-selection-change)
            (strata-switch-view-mode 'icons)
            ;; Force 3-column grid geometry: row 0 = (f1 f2 f3), row 1 = (f4 f5 f6).
            (setq strata-icons--ncols 3)
            (let* ((p5 (save-excursion (strata-goto-file (nth 4 files)) (point)))
                   ;; Blank spacer position immediately left of tile 1 (`strata-entry' is nil there).
                   (p1-blank (max (point-min) (line-beginning-position))))
              ;; 1. Drag from blank gap before `f1' to `f5' selects 2x2 grid rectangle `{f1 f2 f4 f5}' (excludes `f3').
              (strata-test--play-events
               `(down-mouse-1 (,w1 ,p1-blank (2 . 10) 0) 1)
               `(mouse-movement (,w1 ,p5 (80 . 60) 0))
               `(drag-mouse-1 (,w1 ,p1-blank (2 . 10) 0) (,w1 ,p5 (80 . 60) 0)))
              (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                             '("f1.txt" "f2.txt" "f4.txt" "f5.txt")))
              (should (>= (length strata--selection-overlays) 4))
              ;; 2. Holding down on already-marked `f1' and dragging across to Pane 2 copies all 4 items.
              (let ((p1-lbl (save-excursion (strata-goto-file (nth 0 files)) (point))))
                (cl-letf (((symbol-function 'read-char-choice) (lambda (&rest _) ?c)))
                  (strata-test--play-events
                   `(down-mouse-1 (,w1 ,p1-lbl (10 . 10) 0) 1)
                   `(mouse-movement (,w2 1 (200 . 20) 0))
                   `(drag-mouse-1 (,w1 ,p1-lbl (10 . 10) 0) (,w2 1 (200 . 20) 0)))))
              (dolist (name '("f1.txt" "f2.txt" "f4.txt" "f5.txt"))
                (should (file-exists-p (expand-file-name name dst))))
              (should-not (file-exists-p (expand-file-name "f3.txt" dst))))
            ;; 3. Compact mode drag starting on trailing cell padding of `f2' to `f4' selects `{f2 f3 f4}'.
            (strata-switch-view-mode 'compact)
            (strata-clear-all-marks)
            (let* ((p2 (save-excursion (strata-goto-file (nth 1 files)) (point)))
                   (p2-pad (save-excursion (goto-char p2) (line-end-position)))
                   (p4 (save-excursion (strata-goto-file (nth 3 files)) (point))))
              (strata-test--play-events
               `(down-mouse-1 (,w1 ,p2-pad (180 . 20) 0) 1)
               `(mouse-movement (,w1 ,p4 (10 . 40) 0))
               `(drag-mouse-1 (,w1 ,p2-pad (180 . 20) 0) (,w1 ,p4 (10 . 40) 0)))
              (should (equal (mapcar #'file-name-nondirectory (strata-marked-files-only))
                             '("f2.txt" "f3.txt" "f4.txt")))
              (should (>= (length strata--selection-overlays) 3)))))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory strata-dirvish-state-dir t)))))

(defmacro strata-test--with-selection-view (view &rest body)
  "Run BODY in directory VIEW with six files and isolated state."
  (declare (indent 1) (debug t))
  `(let* ((strata-test--root (make-temp-file "strata-selection-" t))
          (strata-test--dir (expand-file-name "files" strata-test--root))
          (strata-test--files (mapcar (lambda (name) (expand-file-name name strata-test--dir))
                                     '("a.txt" "b.txt" "c.txt" "d.txt" "e.txt" "f.txt")))
          (strata-dirvish-state-dir (expand-file-name "state" strata-test--root))
          (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
          (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
          (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
          (strata-prefs-current (strata-prefs--create :browser-mode ,view :folders-first t
                                                     :restore-tabs nil :show-thumbnails nil))
          (strata-mouse--drag-state nil) (strata-mouse--finished-drag-state nil)
          (strata-workspace-tabs nil) (track-mouse nil)
          strata-test--buf)
     (unwind-protect
         (save-window-excursion
           (delete-other-windows)
           (make-directory strata-test--dir)
           (dolist (file strata-test--files) (write-region "test" nil file nil 'silent))
           (setq strata-test--buf
                 (if (memq ,view '(list columns))
                     (dired-noselect strata-test--dir)
                   (generate-new-buffer "*Strata Selection Test*")))
           (switch-to-buffer strata-test--buf)
           (pcase ,view
             ('compact (strata-compact-mode) (strata-compact-render strata-test--dir))
             ('icons (strata-icons-mode) (strata-icons-render strata-test--dir)))
           (strata-dirvish-mode 1)
           (strata-goto-file (car strata-test--files))
           (cl-letf (((symbol-function 'strata-view--sync-preview-on-move)
                      #'strata-view--update-selection-highlight))
             ,@body))
       (when strata-mouse--drag-state (strata-mouse--drag-cancel nil))
       (when strata-mouse--finished-drag-state
         (strata-mouse--stop-timer-field strata-mouse--finished-drag-state :cleanup-timer))
       (when (buffer-live-p strata-test--buf) (kill-buffer strata-test--buf))
       (ignore-errors (delete-directory strata-test--root t)))))

(defun strata-test--selection-names ()
  "Return marked basenames in directory order."
  (sort (mapcar #'file-name-nondirectory (strata-marked-files-only)) #'string<))

(defun strata-test--selection-event (kind path &optional y)
  "Make mouse event KIND on PATH at pixel row Y."
  (list kind (list (selected-window)
                   (save-excursion (strata-goto-file path) (point))
                   (cons 10 (or y 10)) 0) 1))

(ert-deftest strata-test-selection-all-invert-toggle-and-clear ()
  "Every entry is marked, and one-file toggles/unmarks stay at point in all views."
  (dolist (view '(list columns compact icons))
    (strata-test--with-selection-view view
      (let ((first (car strata-test--files)))
        (call-interactively (key-binding (kbd "C-a")))
        (should (equal (strata-test--selection-names)
                       '("a.txt" "b.txt" "c.txt" "d.txt" "e.txt" "f.txt")))
        (should (equal (strata-current-file) first))
        (call-interactively (key-binding (kbd "C-S-i")))
        (should-not (strata-marked-files-only))
        (dolist (key '("C-SPC" "m"))
          (call-interactively (key-binding (kbd key)))
          (should (equal (strata-test--selection-names) '("a.txt")))
          (should (equal (strata-current-file) first))
          (call-interactively (key-binding (kbd key)))
          (should-not (strata-marked-files-only)))
        (dolist (key '("u" "U" "C-S-a" "<escape>"))
          (strata-view--set-entry-mark first t)
          (call-interactively (key-binding (kbd key)))
          (should-not (strata-marked-files-only))
          (should (equal (strata-selected-files) (list first))))))))

(ert-deftest strata-test-selection-visual-range-includes-endpoints ()
  "10xer v marks forward/reverse ranges without skipping or overshooting."
  (dolist (view '(list columns compact icons))
    (strata-test--with-selection-view view
      (strata-dirvish-tenxer-mode 1)
      (call-interactively (key-binding (kbd "v")))
      (should (equal (strata-test--selection-names) '("a.txt")))
      (should (equal (strata-current-file) (car strata-test--files)))
      (strata-goto-file (nth 3 strata-test--files))
      (call-interactively (key-binding (kbd "v")))
      (should (equal (strata-test--selection-names) '("a.txt" "b.txt" "c.txt" "d.txt")))
      (should-not strata-visual-anchor)
      (strata-clear-all-marks)
      (call-interactively (key-binding (kbd "v")))
      (strata-goto-file (nth 1 strata-test--files))
      (call-interactively (key-binding (kbd "v")))
      (should (equal (strata-test--selection-names) '("b.txt" "c.txt" "d.txt"))))))

(ert-deftest strata-test-selection-ranges-reverse-and-add ()
  "Shift ranges shrink; Ctrl+Shift retains scattered marks outside the range."
  (dolist (view '(list columns compact icons))
    (strata-test--with-selection-view view
      (let ((a (nth 0 strata-test--files)) (b (nth 1 strata-test--files))
            (c (nth 2 strata-test--files)) (d (nth 3 strata-test--files)))
        (strata-view--set-entry-mark a t)
        (strata-goto-file b)
        (strata-view--reset-selection-range b)
        (strata-shift-select-move (lambda () (strata-goto-file d)))
        (should (equal (strata-test--selection-names) '("b.txt" "c.txt" "d.txt")))
        (strata-shift-select-move (lambda () (strata-goto-file c)))
        (should (equal (strata-test--selection-names) '("b.txt" "c.txt")))
        (strata-shift-select-move (lambda () (strata-goto-file b)))
        (should (equal (strata-test--selection-names) '("b.txt")))
        (strata-clear-all-marks)
        (strata-view--set-entry-mark a t)
        (strata-view--reset-selection-range b)
        (strata-mouse-add-range-select (strata-test--selection-event 'C-S-mouse-1 d))
        (should (equal (strata-test--selection-names) '("a.txt" "b.txt" "c.txt" "d.txt")))
        (strata-mouse-add-range-select (strata-test--selection-event 'C-S-mouse-1 c))
        (should (equal (strata-test--selection-names) '("a.txt" "b.txt" "c.txt")))
        (strata-clear-all-marks)
        (strata-goto-file a)
        (strata-shift-select-last)
        (should (= (length (strata-marked-files-only)) 6))
        (strata-shift-select-first)
        (should (equal (strata-test--selection-names) '("a.txt")))
        (strata-clear-all-marks)
        (strata-goto-file a)
        (strata-shift-select-prev)
        (should (equal (strata-test--selection-names) '("a.txt")))
        (should (equal (strata-current-file) a))))))

(ert-deftest strata-test-selection-grid-jumps-select-intermediate-files ()
  "Shift row/column jumps include intermediate entries, then shrink on reversal."
  (dolist (view '(compact icons))
    (strata-test--with-selection-view view
      (if (eq view 'icons)
          (progn
            (let ((columns strata-icons--ncols))
              (should (< columns (length strata-test--files)))
              (strata-shift-select-next)
              (should (equal (strata-test--selection-names)
                             (mapcar #'file-name-nondirectory
                                     (cl-subseq strata-test--files 0 (1+ columns))))))
            (strata-shift-select-prev))
        (strata-shift-select-right)
        (should (> (length (strata-marked-files-only)) 2))
        (strata-shift-select-left))
      (should (equal (strata-test--selection-names) '("a.txt"))))))

(ert-deftest strata-test-selection-click-and-menu-targets ()
  "Plain click replaces old marks, and context menus target the clicked item or batch."
  (dolist (view '(list columns compact icons))
    (strata-test--with-selection-view view
      (let* ((a (car strata-test--files)) (c (nth 2 strata-test--files))
             (f (nth 5 strata-test--files)))
        (strata-mouse-toggle-select (strata-test--selection-event 'C-mouse-1 a))
        (strata-mouse-toggle-select (strata-test--selection-event 'C-mouse-1 c))
        (should (= (length (strata-marked-files-only)) 2))
        ;; A mark can re-render a grid; generate each event at the current
        ;; label position rather than reusing pre-render buffer offsets.
        (strata-mouse-click-entry (strata-test--selection-event 'mouse-1 f))
        (should-not (strata-marked-files-only))
        (should (equal (strata-selected-files) (list f)))
        (strata-mouse-toggle-select (strata-test--selection-event 'C-mouse-1 a))
        (strata-mouse-toggle-select (strata-test--selection-event 'C-mouse-1 c))
        (cl-letf (((symbol-function 'strata-context-menu) (lambda () (interactive))))
          (strata-mouse-context-menu (strata-test--selection-event 'mouse-3 a))
          (should (equal (strata-test--selection-names) '("a.txt" "c.txt")))
          (strata-mouse-context-menu (strata-test--selection-event 'mouse-3 f))
          (should-not (strata-marked-files-only))
          (should (equal (strata-selected-files) (list f))))))))

(ert-deftest strata-test-selection-keymap-precedence-and-help ()
  "10xer overrides win, and ? documents selection in either mode."
  (strata-test--with-selection-view 'list
    (dolist (tenxer '(nil t nil))
      (strata-dirvish-tenxer-mode (if tenxer 1 -1))
      (should (eq (key-binding (kbd "C-r"))
                  (if tenxer #'strata-invert-selection #'strata-rename)))
      (should (eq (key-binding (kbd "C-d"))
                  (if tenxer #'strata-half-page-down #'strata-duplicate)))
      (should (eq (key-binding (kbd "C-f"))
                  (if tenxer #'scroll-up-command #'strata-filter-pane)))
      (should (eq (key-binding (kbd "?")) #'strata-open-shortcut-reference))
      (should (eq (key-binding (kbd "C-SPC")) #'strata-view-toggle-mark))
      (should (eq (key-binding (kbd "C-S-<down>")) #'strata-shift-select-next)))
    (dolist (tenxer '(nil t))
      (setf (strata-prefs-tenxer-mode strata-prefs-current) tenxer)
      (save-window-excursion
        (strata-open-shortcut-reference)
        (should (string-match-p "SELECTION (DIRECTORY VIEWS)" (buffer-string)))
        (should (string-match-p "C-SPC / C-Click" (buffer-string)))
        (should (string-match-p "C-Arrows" (buffer-string)))
        (should (string-match-p "Mouse Back / Forward" (buffer-string)))
        (should (string-match-p "reverse direction to shrink" (buffer-string)))
        (should (string-match-p "During drag: cancel" (buffer-string)))
        (should (string-match-p "Click View…" (buffer-string)))
        (should (string-match-p "C-c s / Click Sort By…" (buffer-string)))
        (should (string-match-p "Ascending / Descending; Folders first" (buffer-string)))
        (should-not (string-match-p "^   V / W.*Toggle Rendered" (buffer-string)))
        (when tenxer
          (should (string-match-p "C-S-i / C-r" (buffer-string)))
          (should (string-match-p "M-?" (buffer-string))))))))

(ert-deftest strata-test-selection-native-modifier-clicks ()
  "The real command loop preserves the anchor and additive base across clicks."
  (dolist (view '(list columns compact icons))
    (strata-test--with-selection-view view
      (cl-labels ((click (down up index)
                    (let ((file (nth index strata-test--files)))
                      (strata-test--play-events
                       (strata-test--selection-event down file)
                       (strata-test--selection-event up file)))))
        (click 'C-down-mouse-1 'C-mouse-1 0)
        (click 'C-down-mouse-1 'C-mouse-1 5)
        (should (equal (strata-test--selection-names) '("a.txt" "f.txt")))
        (click 'C-S-down-mouse-1 'C-S-mouse-1 2)
        (should (equal (strata-test--selection-names) '("a.txt" "c.txt" "d.txt" "e.txt" "f.txt")))
        (click 'C-S-down-mouse-1 'C-S-mouse-1 4)
        (should (equal (strata-test--selection-names) '("a.txt" "e.txt" "f.txt")))
        (click 'S-down-mouse-1 'S-mouse-1 3)
        (should (equal (strata-test--selection-names) '("d.txt" "e.txt" "f.txt")))
        (click 'S-down-mouse-1 'S-mouse-1 4)
        (should (equal (strata-test--selection-names) '("e.txt" "f.txt")))
        (execute-kbd-macro (kbd "<escape>"))
        (should-not (strata-marked-files-only))
        (should-not track-mouse)
        (should-not strata-mouse--drag-state)))))

(ert-deftest strata-test-selection-all-only-visible-entries ()
  "Select All respects hidden Dired rows and filtered grid/compact entries."
  (dolist (view '(list columns compact icons))
    (strata-test--with-selection-view view
      (if (memq view '(list columns))
          (save-excursion
            (strata-goto-file (nth 1 strata-test--files))
            (let ((inhibit-read-only t))
              (put-text-property (line-beginning-position) (1+ (line-end-position)) 'invisible t)))
        (setq strata-local-filter "a.txt")
        (strata-view--refresh-after-mark))
      (strata-select-all)
      (should (equal (strata-test--selection-names)
                     (if (memq view '(list columns))
                         '("a.txt" "c.txt" "d.txt" "e.txt" "f.txt")
                       '("a.txt"))))
      (strata-escape)
      (should-not (strata-marked-files-only))
      (should-not strata-local-filter))))

(ert-deftest strata-test-selection-drag-never-polls-pending-input ()
  "GTK pending input with no readable event cannot trap drag handling in a loop."
  (strata-test--with-selection-view 'list
    (let* ((down (strata-test--selection-event 'down-mouse-1 (car strata-test--files)))
           (motion (strata-test--selection-event 'mouse-movement (nth 3 strata-test--files) 60)))
      (strata-mouse-down-entry down)
      (cl-letf (((symbol-function 'input-pending-p) (lambda () t))
                ((symbol-function 'read-event)
                 (lambda (&rest _) (ert-fail "Drag handler tried to consume pending input")))
                ((symbol-function 'redisplay)
                 (lambda (&rest _) (ert-fail "Drag handler forced recursive redisplay"))))
        (strata-mouse--drag-move motion))
      (should (equal (strata-test--selection-names) '("a.txt" "b.txt" "c.txt" "d.txt")))
      (let ((last-input-event ?\C-g))
        (call-interactively (lookup-key (strata-mouse--drag-keymap) (kbd "C-g"))))
      (should-not track-mouse)
      (should-not strata-mouse--drag-state)
      (should-not (strata-marked-files-only)))))

(ert-deftest strata-test-selection-grid-marks-preserve-cached-order ()
  "Mark updates must not mutate the directory order cached by an active drag."
  (dolist (view '(compact icons))
    (strata-test--with-selection-view view
      (let* ((order (strata-view--entry-order))
             (original (copy-sequence order)))
        ;; Filtering may share its unchanged tail with ORDER.  Reversing
        ;; that result destructively used to truncate or reorder ORDER.
        (dolist (selected (list (nthcdr 3 original) original))
          (strata-mouse--apply-selection-keys order selected nil)
          (should (equal order original))
          (should (equal (strata-test--selection-names)
                         (mapcar #'file-name-nondirectory selected))))))))

(ert-deftest strata-test-selection-compact-drag-through-last-file ()
  "A live Compact file drag keeps its tail range after button release."
  (strata-test--with-selection-view 'compact
    (let* ((win (selected-window))
           (start (save-excursion (strata-goto-file (nth 3 strata-test--files)) (point)))
           (middle (save-excursion (strata-goto-file (nth 4 strata-test--files)) (point)))
           (end (save-excursion (strata-goto-file (nth 5 strata-test--files)) (point))))
      (dolist (positions (list (list start middle end) (list end middle start)))
        (strata-clear-all-marks)
        (let ((first (nth 0 positions)) (mid (nth 1 positions)) (last (nth 2 positions)))
          (strata-test--play-events
           `(down-mouse-1 (,win ,first (10 . 10) 0) 1)
           `(mouse-movement (,win ,mid (10 . 30) 0))
           `(mouse-movement (,win ,last (10 . 50) 0))
           `(drag-mouse-1 (,win ,first (10 . 10) 0) (,win ,last (10 . 50) 0))))
        (should (equal (strata-test--selection-names) '("d.txt" "e.txt" "f.txt")))
        (should-not strata-mouse--drag-state)
        (should-not track-mouse)))))

(ert-deftest strata-test-selection-drag-error-and-watchdog-release-tracking ()
  "Errors and abandoned button releases cancel timers and global tracking."
  (strata-test--with-selection-view 'list
    (let ((down (strata-test--selection-event 'down-mouse-1 (car strata-test--files)))
          (motion (strata-test--selection-event 'mouse-movement (nth 3 strata-test--files) 60)))
      (strata-mouse-down-entry down)
      (let ((st strata-mouse--drag-state))
        (should (timerp (plist-get st :watchdog-timer)))
        (cl-letf (((symbol-function 'strata-mouse--apply-selection-keys)
                   (lambda (&rest _) (error "Selection refresh failed"))))
          (should-error (strata-mouse--drag-move motion)))
        (should-not (plist-get st :scroll-timer))
        (should-not (plist-get st :watchdog-timer))
        (should-not track-mouse)
        (should-not strata-mouse--drag-state)
        (should (eq strata-mouse--finished-drag-state st))
        (should (plist-get st :cancelled-p)))
      (strata-mouse-down-entry down)
      (let ((st strata-mouse--drag-state))
        (plist-put st :scroll-timer (run-at-time 20 20 #'ignore))
        (cl-letf (((symbol-function 'strata-mouse--edge-scroll-step)
                   (lambda (&rest _) (error "Auto-scroll failed"))))
          (strata-mouse--scroll-tick st))
        (should-not (plist-get st :scroll-timer))
        (should-not (plist-get st :watchdog-timer))
        (should-not track-mouse)
        (should-not strata-mouse--drag-state)
        (should (plist-get st :cancelled-p))
        ;; The pending release must be swallowed rather than starting a
        ;; fallback selection or cross-pane file transfer after an error.
        (strata-mouse-drag-drop
         (list 'drag-mouse-1 (event-start down) (event-start motion)))
        (should-not strata-mouse--finished-drag-state))
      (strata-mouse-down-entry down)
      (strata-mouse--drag-watchdog strata-mouse--drag-state)
      (should-not track-mouse)
      (should-not strata-mouse--drag-state))))

(defun strata-test--popup-menu-command (menu label)
  "Return the actual popup menu command labeled LABEL."
  (let ((item (cl-find-if (lambda (item)
                            (and (consp item) (eq (cadr item) 'menu-item)
                                 (equal (nth 2 item) label)))
                          (cdr menu))))
    (should item)
    (nth 3 item)))

(defun strata-test--sort-menu-command (label)
  "Return the sort menu command labeled LABEL."
  (strata-test--popup-menu-command (strata-sort--menu) label))

(defun strata-test--rendered-sort-names ()
  "Read filenames from the displayed Dired rows or rendered grid cells."
  (if (derived-mode-p 'dired-mode)
      (mapcar #'file-name-nondirectory (strata-view--entry-order))
    (let ((pos (point-min)) paths)
      (while (< pos (point-max))
        (when-let ((path (get-text-property pos 'strata-entry)))
          (unless (member path paths) (push path paths)))
        (setq pos (next-single-property-change pos 'strata-entry nil (point-max))))
      ;; The small test fixture fits in one Compact column; Icons cells are
      ;; encountered in grid order, including repeated properties on cards.
      (mapcar #'file-name-nondirectory (nreverse paths)))))

(ert-deftest strata-test-sort-menu-orders-all-directory-layouts ()
  "Popup commands really reorder files in all four layouts and retain marks."
  (dolist (view '(list columns compact icons))
    (strata-test--with-selection-view view
      (cl-loop for old in strata-test--files
               for name in '("a.txt" "b.zip" "c.txt" "d.el" "e.txt" "f.png")
               for size in '(6 1 4 2 5 3)
               for seconds in '(600000 500000 400000 300000 200000 100000)
               for file = (expand-file-name name strata-test--dir)
               do (unless (equal file old) (rename-file old file))
               do (write-region (make-string size ?x) nil file nil 'silent)
               do (set-file-times file (seconds-to-time seconds)))
      (strata-sort-set 'name 'asc)
      (strata-goto-file (car strata-test--files))
      (strata-view-toggle-mark)
      (dolist (choice '(("Name" ("a.txt" "b.zip" "c.txt" "d.el" "e.txt" "f.png"))
                        ("Modification date" ("f.png" "e.txt" "d.el" "c.txt" "b.zip" "a.txt"))
                        ("Size" ("b.zip" "d.el" "f.png" "c.txt" "e.txt" "a.txt"))
                        ("Type / extension" ("d.el" "f.png" "a.txt" "c.txt" "e.txt" "b.zip"))))
        (call-interactively (strata-test--sort-menu-command (car choice)))
        (should (equal (strata-test--rendered-sort-names) (cadr choice)))
        ;; Rechoosing a radio item must keep its direction, unlike the chord.
        (call-interactively (strata-test--sort-menu-command (car choice)))
        (should (eq (strata-prefs-sort-direction strata-prefs-current) 'asc))
        (call-interactively #'strata-sort-descending)
        (should (equal (strata-test--rendered-sort-names) (reverse (cadr choice))))
        (should (equal (strata-test--selection-names) '("a.txt")))
        (should (equal (file-name-nondirectory (strata-current-file)) "a.txt"))
        (call-interactively #'strata-sort-ascending))
      (call-interactively (strata-test--sort-menu-command "Unsorted (directory order)"))
      (should (eq (strata-prefs-sort-key strata-prefs-current) 'unsorted))
      ;; Unsorted order is unspecified by directory-files and ls -U; it
      ;; must still display the complete directory without losing marks.
      (should (equal (sort (strata-test--rendered-sort-names) #'string<)
                     (directory-files strata-test--dir nil "\\`[^.]")))
      (should (equal (strata-test--selection-names) '("a.txt")))
      (should (file-exists-p strata-dirvish-state-file)))))

