(ert-deftest strata-test-mouse-drag-feedback-throttles-and-cleans-up ()
  "File badges follow carries, throttle motion, and restore state on every exit."
  (dolist (exit '(release cancel watchdog display-error))
    (strata-test--with-selection-view 'compact
      (let* ((src (selected-window))
             (other (split-window-right))
             (a (car strata-test--files))
             (original-tooltip tooltip-mode)
             (original-help show-help-function)
             (original-fine mouse-fine-grained-tracking)
             (now 10.0) shown hidden)
        (strata-view--set-entry-mark a t)
        (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                  ((symbol-function 'strata-icon-glyph) (lambda (&rest _) "▤"))
                  ((symbol-function 'float-time) (lambda (&rest _) now))
                  ((symbol-function 'x-show-tip)
                   (lambda (text &rest _)
                     (if (eq exit 'display-error) (error "Tooltip display failed")
                       (push text shown))))
                  ((symbol-function 'x-hide-tip) (lambda () (setq hidden t))))
          (let* ((down (strata-test--selection-event 'down-mouse-1 a))
                 (motion (list 'mouse-movement
                               (list src (save-excursion (strata-goto-file a) (point)) '(30 . 40) 0))))
            (strata-mouse-down-entry down)
            (let ((st strata-mouse--drag-state))
              ;; Carry a single marked file too, without sweeping in others.
              (should (plist-get st :carry-marked-p))
              (strata-mouse--drag-move motion)
              (if (eq exit 'display-error)
                  (progn
                    (should (plist-get st :feedback-disabled-p))
                    (should (eq tooltip-mode original-tooltip)))
                (should (= (length shown) 1))
                (should (string-match-p "1 item — Copy / Move" (car shown)))
                (should (string-match-p "a.txt" (car shown)))
                (should-not tooltip-mode)
                (setq now 10.01)
                (dotimes (_ 100) (strata-mouse--drag-move motion))
                (should (= (length shown) 1))
                (setq now 10.05)
                (strata-mouse--drag-move motion)
                (should (= (length shown) 2))
                ;; A modifier change updates the cue without waiting for the throttle.
                (strata-mouse--drag-move (cons 'C-mouse-movement (cdr motion)))
                (should (string-match-p "1 item — Copy\n" (car shown))))
              (pcase exit
                ('release (strata-mouse--on-drag-exit)
                          (strata-mouse-click-entry (list 'mouse-1 (event-start down) 1)))
                ('cancel (strata-mouse--drag-cancel))
                (_ (strata-mouse--drag-watchdog st)))
              (should hidden)
              (should-not (plist-get st :feedback-visible-p))
              (should-not strata-mouse--drag-state)
              (should (eq tooltip-mode original-tooltip))
              (should (eq show-help-function original-help))
              (should (eq mouse-fine-grained-tracking original-fine))
              (should (equal (strata-test--selection-names) '("a.txt"))))))
        (when (window-live-p other) (delete-window other))))))

