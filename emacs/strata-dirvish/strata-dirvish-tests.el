(ert-deftest strata-test-spc-preview-and-ret-direct-edit ()
  (should (eq (lookup-key strata-default-keymap (kbd "SPC")) #'strata-preview-at-point))
  (should (eq (lookup-key strata-default-keymap (kbd "RET")) #'strata-open-or-edit-at-point))
  (should (eq (lookup-key strata-compact-mode-map (kbd "SPC")) #'strata-preview-at-point))
  (should (eq (lookup-key strata-compact-mode-map (kbd "RET")) #'strata-open-or-edit-at-point))
  (should (eq (lookup-key strata-icons-mode-map (kbd "SPC")) #'strata-preview-at-point))
  (should (eq (lookup-key strata-icons-mode-map (kbd "RET")) #'strata-open-or-edit-at-point))
  (let* ((tmp (make-temp-file "strata-edit-" t))
         (subdir (expand-file-name "sub" tmp))
         (fpath (expand-file-name "sample.txt" tmp))
         (strata-dirvish-state-dir (make-temp-file "strata-state-" t))
         (strata-tabs-state-file (expand-file-name "tabs.eld" strata-dirvish-state-dir))
         (strata-dirvish-state-file (expand-file-name "prefs.eld" strata-dirvish-state-dir))
         (strata-history-file (expand-file-name "history.eld" strata-dirvish-state-dir))
         (strata-workspace-tabs nil)
         (strata-closed-tabs nil)
         (strata-active-tab-index 0)
         (strata-visited-folders nil)
         (strata-folder-view-lru nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory subdir t)
          (with-temp-file fpath
            (insert "hello strata"))
          (let* ((left-win (selected-window))
                 (right-win (split-window-right))
                 (dv (dirvish--new :curr-layout '(1 0.14 0.48)))
                 (strata-preview-standalone-window right-win)
                 (before-wins (window-list nil nil left-win))
                 (before-edges (mapcar #'window-edges (window-list nil nil left-win)))
                 (opened-dir nil))
            (unwind-protect
                (with-current-buffer (get-buffer-create " *strata-test-browser*")
                  (let ((inhibit-read-only t))
                    (erase-buffer)
                    (strata-compact-mode)
                    (insert (propertize "  sub/\n" 'strata-entry (file-name-as-directory subdir)))
                    (insert (propertize "  sample.txt\n" 'strata-entry fpath)))
                  (set-window-buffer left-win (current-buffer))
                  (select-window left-win)
                  ;; 1. SPC previews without closing preview pane or altering layout.
                  (goto-char (point-min))
                  (forward-line 1)
                  (strata-preview-at-point)
                  (should (window-live-p right-win))
                  (should (eq (selected-window) left-win))
                  (should (equal (window-list nil nil left-win) before-wins))
                  (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                  (should (string-match-p "hello strata"
                                          (with-current-buffer (window-buffer right-win)
                                            (buffer-string))))
                  ;; Pressing SPC again keeps preview pane open (does not close it).
                  (strata-preview-at-point)
                  (should (window-live-p right-win))
                  (should (equal (window-list nil nil left-win) before-wins))
                  ;; 2. RET replaces any Dirvish throwaway `PREVIEW :: ...' buffer with real writable buffer (ZERO layout change).
                  (let ((fake-preview (generate-new-buffer "PREVIEW :: 00:00 :: sample.txt")))
                    (with-current-buffer fake-preview
                      (insert "TRUNCATED PREVIEW")
                      (setq buffer-file-name fpath)
                      (set-buffer-modified-p nil)
                      (setq buffer-read-only t))
                    (cl-pushnew fake-preview (dv-preview-buffers dv))
                    (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv)))
                      (setf (dv-preview-window dv) right-win)
                      (strata-open-or-edit-at-point)
                      (should-not (buffer-live-p fake-preview))
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                      (should (eq (selected-window) right-win))
                      (let ((real-buf (window-buffer right-win)))
                        (should-not (string-prefix-p "PREVIEW :: " (buffer-name real-buf)))
                        (should-not (memq real-buf (dv-preview-buffers dv)))
                        (with-current-buffer real-buf
                          (should (equal (file-truename buffer-file-name)
                                         (file-truename fpath)))
                          (should-not buffer-read-only)
                          (should strata-preview-edit-mode)
                          (should (eq (key-binding (kbd "C-<left>")) #'strata-preview-edit-leave))
                          (should (eq (key-binding (kbd "C-c q")) #'strata-preview-edit-exit))
                          (should (eq (key-binding (kbd "C-<escape>")) #'strata-preview-edit-exit))
                          (should (eq (key-binding (kbd "C-c k")) #'strata-preview-edit-abort))
                          ;; Edit buffer, seed stale preview hash, cancel save-prompt with quit -> stays in edit mode.
                          (puthash fpath "STALE PREVIEW" (dv-preview-hash dv))
                          (goto-char (point-max))
                          (insert " + saved"))
                        (select-window right-win)
                        (condition-case nil
                            (cl-letf (((symbol-function 'map-y-or-n-p)
                                       (lambda (&rest _) (signal 'quit nil))))
                              (strata-preview-edit-leave))
                          (quit nil))
                        (with-current-buffer real-buf
                          (should strata-preview-edit-mode))
                        (should (eq (selected-window) right-win))
                        ;; Now confirm save in `C-<left>' (`save-some-buffers') -> saves, clears stale cache, returns left.
                        (select-window right-win)
                        (cl-letf (((symbol-function 'map-y-or-n-p)
                                   (lambda (_prompter actor list &rest _)
                                     (funcall actor (car list))
                                     1)))
                          (strata-preview-edit-leave))
                        (with-current-buffer real-buf
                          (should-not (buffer-modified-p real-buf))
                          (should-not strata-preview-edit-mode))
                        (should (eq (selected-window) left-win))
                        (should (equal (window-list nil nil left-win) before-wins))
                        (should (string-match-p "hello strata \\+ saved"
                                                (with-current-buffer (window-buffer right-win)
                                                  (buffer-string))))
                        ;; Abort (`C-c k`) still reverts dirty edits back to saved file contents.
                        (set-buffer (window-buffer left-win))
                        (strata-open-or-edit-at-point)
                        (with-current-buffer (window-buffer right-win)
                          (goto-char (point-max))
                          (insert " + discard-me"))
                        (select-window right-win)
                        (cl-letf (((symbol-function 'y-or-n-p) (lambda (_prompt) t)))
                          (strata-preview-edit-abort))
                        (should (eq (selected-window) left-win))
                        (with-current-buffer real-buf
                          (should-not (buffer-modified-p))
                          (should-not strata-preview-edit-mode)
                          (should (string= (string-trim-right (buffer-string))
                                           "hello strata + saved"))))))
                  ;; 3. RET on a directory opens it in the browser pane.
                  (select-window left-win)
                  (set-buffer (window-buffer left-win))
                  (goto-char (point-min))
                  (cl-letf (((symbol-function 'strata-open-location)
                             (lambda (loc &optional _hist) (setq opened-dir loc))))
                    (strata-open-or-edit-at-point)
                    (should (string= (directory-file-name opened-dir)
                                     (directory-file-name subdir))))
                  ;; 4. Right arrow / `strata-tree-expand-or-open' on a file enters preview in read-only mode,
                  ;;    and `C-<left>' (`strata-preview-read-leave') returns focus to the left browser pane.
                  (should (eq (lookup-key strata-default-keymap (kbd "<right>")) #'strata-tree-expand-or-open))
                  (should (eq (lookup-key strata-10xer-keymap (kbd "l")) #'strata-tree-expand-or-open))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "C-<left>")) #'strata-preview-read-leave))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "SPC")) #'strata-preview-read-scroll-down))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "DEL")) #'strata-preview-read-scroll-up))
                  (should (eq (lookup-key strata-preview-read-mode-map (kbd "q")) #'strata-preview-read-leave))
                  (select-window left-win)
                  (set-buffer (window-buffer left-win))
                  (goto-char (point-min))
                  (forward-line 1)
                  (let ((visited (find-buffer-visiting fpath)))
                    (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv))
                              ((symbol-function 'strata-dirvish--flatten-layout)
                               (lambda () (error "Must not flatten Dirvish layout")))
                              ((symbol-function 'dired-find-file)
                               (lambda () (error "Must not collapse Dirvish via dired-find-file"))))
                      (setf (dv-preview-window dv) right-win)
                      (strata-preview--capture-browser-context left-win)
                      (strata-tree-expand-or-open)
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                      (should (eq (selected-window) right-win))
                      (with-current-buffer (window-buffer right-win)
                        (should strata-preview-read-mode)
                        (should buffer-read-only)
                        (should-not strata-preview-edit-mode))
                      (with-current-buffer visited
                        (should-not strata-preview-edit-mode))
                      (strata-preview-read-leave)
                      (should (eq (selected-window) left-win))
                      ;; 4b. Clicking into the preview pane enables read-only mode & blocks background resets.
                      (strata-preview--on-window-selection-change)
                      (select-window right-win)
                      (strata-preview--on-window-selection-change)
                      (with-current-buffer (window-buffer right-win)
                        (should strata-preview-read-mode)
                        (should buffer-read-only)
                        (should-not strata-preview-edit-mode))
                      (let ((orig-pbuf (window-buffer right-win)))
                        (with-current-buffer orig-pbuf
                          (goto-char (point-max)))
                        (dirvish--preview-update dv fpath)
                        (should (eq (selected-window) right-win))
                        (should (eq (window-buffer right-win) orig-pbuf))
                        (with-current-buffer orig-pbuf
                          (should (= (point) (point-max)))))
                      (strata-preview-read-leave)
                      (should (eq (selected-window) left-win))
                      ;; 5. Mouse activation (double-click) or RET opens direct-edit without collapsing layout.
                      (strata-mouse--open-path fpath nil)
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (eq (selected-window) right-win))
                      (should (eq (window-buffer right-win) visited))
                      (with-current-buffer visited
                        (should strata-preview-edit-mode)
                        (should-not strata-preview-read-mode)
                        (should-not buffer-read-only))
                      (select-window right-win)
                      (strata-preview-edit-exit)
                      (should (eq (selected-window) left-win)))))
              (when-let ((b (find-buffer-visiting fpath)))
                (with-current-buffer b (set-buffer-modified-p nil))
                (kill-buffer b))
              (remhash (dv-id dv) dirvish--sessions))))
      (delete-directory tmp t)
      (delete-directory strata-dirvish-state-dir t))))

