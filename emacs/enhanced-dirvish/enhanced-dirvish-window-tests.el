;;; enhanced-dirvish-window-tests.el --- Window integration regression tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'term)
(require 'hl-line)
(require 'transpose-frame)
(require 'enhanced-dirvish)

(defmacro enhanced-dirvish-window-test--with-browser (mode &rest body)
  "Create an isolated browser in MODE, then evaluate BODY."
  (declare (indent 1) (debug t))
  `(let* ((directory (make-temp-file "enhanced-dirvish-window-test-" t))
          (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-window-state-" t))
          (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
          (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
          (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
          (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :browser-mode ,mode :sidebar-expanded t
                                                    :restore-tabs nil :show-thumbnails nil))
          (enhanced-dirvish-workspace-tabs nil) (enhanced-dirvish-active-tab-index 0)
          (enhanced-dirvish-sidebar-window nil) (enhanced-dirvish-preview-standalone-window nil)
          (enhanced-dirvish-visited-folders nil)
          (override dirvish-override-dired-mode)
          (width (frame-width)) (height (frame-height)))
     (unwind-protect
         (save-window-excursion
           (let ((ignore-window-parameters t))
             (enhanced-dirvish-windows--unatom (frame-root-window))
             (delete-other-windows)
             (enhanced-dirvish-windows--tag (selected-window) nil nil))
           (set-frame-size (selected-frame) 200 65)
           (make-directory (expand-file-name "literature" directory))
           (write-region "A preview file\n" nil (expand-file-name "sample.txt" directory) nil 'silent)
           (dirvish-override-dired-mode 1)
           (enhanced-dirvish-setup)
           (enhanced-dirvish-open-location directory)
           (when (eq ,mode 'columns)
             ;; Window-buffer-change hooks are deferred in batch Emacs.
             (setf (dv-curr-layout (dirvish-curr)) dirvish-default-layout)
             (dirvish--build-layout (dirvish-curr)))
           (let* ((main (selected-window))
                  (group (window-parameter main 'enhanced-dirvish-window-group))
                  (pane (enhanced-dirvish-active-pane)))
             ,@body))
       (dirvish-override-dired-mode (if override 1 -1))
       (set-frame-size (selected-frame) width height)
       (dolist (buffer (buffer-list))
         (when (and (buffer-live-p buffer)
                    (or (string-prefix-p "*Enhanced Dirvish Window Test" (buffer-name buffer))
                   (with-current-buffer buffer
                      (and default-directory (string-prefix-p directory default-directory)))))
           (let ((kill-buffer-query-functions nil))
             (when-let ((process (get-buffer-process buffer)))
               (delete-process process))
             (kill-buffer buffer))))
       (delete-directory directory t)
       (delete-directory enhanced-dirvish-state-dir t))))

(defun enhanced-dirvish-window-test--roles (group)
  "Return GROUP's sorted visible window roles."
  (sort (mapcar (lambda (w) (window-parameter w 'enhanced-dirvish-window-role))
                (enhanced-dirvish-windows--owned group)) #'string<))

(ert-deftest enhanced-dirvish-test-window-standard-splits-contain-columns ()
  "C-x 2/3 leave all browser windows together and preserve navigation."
  (enhanced-dirvish-window-test--with-browser 'columns
    (let ((roles (enhanced-dirvish-window-test--roles group))
          (buffer (get-buffer-create "*Enhanced Dirvish Window Test Editor*")))
      (should (memq 'parent roles))
      (should (memq 'preview roles))
      (should (memq 'sidebar roles))
      (should (eq (key-binding (kbd "C-x 3")) #'split-window-right))
      (dolist (split '(split-window-right split-window-below))
        (let ((other (funcall split)))
          (should-not (window-parameter other 'enhanced-dirvish-window-group))
          (should-not (window-dedicated-p other))
          ;; A new split initially clones the Dired buffer without stealing DV.
          (with-selected-window other
            (dirvish-pre-redisplay-h other)
            (dirvish-winbuf-change-h other))
          (should (eq (dv-root-window (enhanced-dirvish-windows--group-dv group)) main))
          (set-window-buffer other buffer)
          (enhanced-dirvish-open-location (expand-file-name "literature" directory))
          (dirvish--build-layout (dirvish-curr))
          (should (eq (window-buffer other) buffer))
          (should (equal roles (enhanced-dirvish-window-test--roles group)))
          (should-not (enhanced-dirvish-windows--ancestor-p
                       (enhanced-dirvish-windows--root (enhanced-dirvish-windows--owned group)) other))
          (delete-window other)
          (enhanced-dirvish-open-location directory))))))

(ert-deftest enhanced-dirvish-test-window-transpose-preserves-bundle-and-references ()
  "Transpose/rotate preserve columns, focus, window overlays and editor state."
  (enhanced-dirvish-window-test--with-browser 'columns
    (let* ((roles (enhanced-dirvish-window-test--roles group))
           (dv (dirvish-curr))
           (other (split-window-right))
           (buffer (get-buffer-create "*Enhanced Dirvish Window Test Editor*"))
           (overlay (with-current-buffer (window-buffer main) (make-overlay (point-min) (point-min)))))
      (set-window-buffer other buffer)
      (overlay-put overlay 'window main)
      (unwind-protect
          (dolist (command '(transpose-frame transpose-frame flop-frame flip-frame
                             rotate-frame-clockwise rotate-frame-anticlockwise))
            (funcall command)
            (setq main (dv-root-window dv))
            (should (window-live-p main))
            (should (eq (selected-window) main))
            (should (eq (enhanced-dirvish-pane-state-window pane) main))
            (should (eq (window-parameter (dv-preview-window dv) 'enhanced-dirvish-window-role) 'preview))
            (should (eq (window-parameter enhanced-dirvish-sidebar-window 'enhanced-dirvish-window-role) 'sidebar))
            (should (equal roles (enhanced-dirvish-window-test--roles group)))
            (should (eq (overlay-get overlay 'window) main))
            (let ((editor (get-buffer-window buffer)))
              (should (window-live-p editor))
              (should-not (window-parameter editor 'enhanced-dirvish-window-group)))
            (should (< (car (window-edges main)) (car (window-edges (dv-preview-window dv))))))
        (delete-overlay overlay)))))

(ert-deftest enhanced-dirvish-test-window-terminal-transpose-and-toggle ()
  "Transposition keeps terminal processes and pane references usable."
  (enhanced-dirvish-window-test--with-browser 'columns
    (let ((buffer (get-buffer-create "*Enhanced Dirvish Window Test Terminal*")))
      (with-current-buffer buffer (term-mode))
      (let ((process (make-process :name "enhanced-dirvish-window-test-terminal" :buffer buffer
                                   :command '("cat") :noquery t)))
        (cl-letf (((symbol-function 'enhanced-dirvish-pane--spawn-terminal) (lambda (&rest _) buffer)))
          (enhanced-dirvish-toggle-pane-terminal))
        (let* ((terminal (selected-window))
               (dv (enhanced-dirvish-windows--group-dv group))
               (roles (enhanced-dirvish-window-test--roles group)))
          (should (eq (window-parameter terminal 'enhanced-dirvish-window-role) 'terminal))
          (transpose-frame)
          (setq terminal (get-buffer-window buffer) main (dv-root-window dv))
          (should (eq (selected-window) terminal))
          (should (eq (enhanced-dirvish-pane-state-window pane) main))
          (should (< (car (window-edges main)) (car (window-edges terminal))))
          (should (equal roles (enhanced-dirvish-window-test--roles group)))
          (enhanced-dirvish-panes--sync-active-pane-from-window terminal)
          (should (eq (enhanced-dirvish-pane-state-window pane) main))
          (enhanced-dirvish-toggle-pane-terminal)
          (should-not (get-buffer-window buffer))
          (should (eq (selected-window) main))
          (should (process-live-p process))
          (enhanced-dirvish-toggle-pane-terminal)
          (should (eq (window-buffer (selected-window)) buffer))
          (should (eq (get-buffer-process buffer) process))
          ;; With an outside editor, transpose the complete app as one unit.
          (let* ((editor (split-window-right))
                 (editor-buffer (get-buffer-create "*Enhanced Dirvish Window Test Editor*")))
            (set-window-buffer editor editor-buffer)
            (transpose-frame)
            (should (window-live-p (get-buffer-window editor-buffer)))
            (should (equal roles (enhanced-dirvish-window-test--roles group)))
            (should (eq (get-buffer-process buffer) process))
            (enhanced-dirvish-toggle-pane-terminal)
            (should (window-live-p (enhanced-dirvish-pane-state-window pane)))))))))

(ert-deftest enhanced-dirvish-test-window-view-switch-and-quit-preserve-editor ()
  "All views, preview/sidebar toggles and quitting stay within the browser."
  (enhanced-dirvish-window-test--with-browser 'columns
    (let* ((other (split-window-right))
           (buffer (get-buffer-create "*Enhanced Dirvish Window Test Editor*")))
      (set-window-buffer other buffer)
      (dolist (mode '(list compact icons columns list columns))
        (enhanced-dirvish-switch-view-mode mode)
        (should (eq (window-buffer other) buffer))
        (should (eq (window-parameter (selected-window) 'enhanced-dirvish-window-group) group))
        (if (eq mode 'columns)
            (dirvish--build-layout (dirvish-curr))
          (enhanced-dirvish-goto-file (expand-file-name "sample.txt" directory))
          (enhanced-dirvish-preview-at-point)
          (should (window-live-p enhanced-dirvish-preview-standalone-window)))
        (transpose-frame)
        (setq other (get-buffer-window buffer))
        (should (window-live-p other))
        (should-not (window-parameter other 'enhanced-dirvish-window-group))
        (unless (eq mode 'columns)
          (should (eq (window-parameter enhanced-dirvish-preview-standalone-window 'enhanced-dirvish-window-role)
                      'standalone-preview))))
      (enhanced-dirvish-sidebar-toggle)
      (should (window-live-p (selected-window)))
      (should (eq (window-buffer other) buffer))
      (enhanced-dirvish-sidebar-toggle)
      (should (window-live-p enhanced-dirvish-sidebar-window))
      (dirvish-quit)
      (should (window-live-p other))
      (should (eq (window-buffer other) buffer)))))

(ert-deftest enhanced-dirvish-test-window-default-maximize-close-and-switch-buffer ()
  "C-x 0/1 and C-x b retain normal Emacs meanings around the browser."
  (enhanced-dirvish-window-test--with-browser 'columns
    (let ((other (split-window-right))
          (buffer (get-buffer-create "*Enhanced Dirvish Window Test Editor*"))
          (roles (enhanced-dirvish-window-test--roles group)))
      (set-window-buffer other buffer)
      (call-interactively (key-binding (kbd "C-x 1")))
      (should-not (window-live-p other))
      (should (equal roles (enhanced-dirvish-window-test--roles group)))
      ;; Keeping the only application group is harmless.
      (call-interactively (key-binding (kbd "C-x 1")))
      (let ((editor (split-window-right)))
        (set-window-buffer editor buffer)
        (delete-window main)
        (should (eq (window-buffer (selected-window)) buffer))
        (should (one-window-p t)))
      (enhanced-dirvish-open-location directory)
      (when (dv-curr-layout (dirvish-curr)) (dirvish--build-layout (dirvish-curr)))
      (switch-to-buffer buffer)
      (enhanced-dirvish-windows--reconcile)
      (should (eq (window-buffer (selected-window)) buffer))
      (should (one-window-p t))
      (should-not (window-parameter (selected-window) 'enhanced-dirvish-window-group)))))

(ert-deftest enhanced-dirvish-test-window-interactive-keep-and-close-f3-panes ()
  "The actual C-x 1/0 commands keep or close either F3 pane in every view."
  (dolist (mode '(columns list compact icons))
    (dolist (side '(1 2))
      (dolist (key '("C-x 1" "C-x 0"))
        (ert-info ((format "%s, pane %d, %s" mode side key))
          (enhanced-dirvish-window-test--with-browser mode
            (call-interactively (key-binding (kbd "<f3>")))
            (let* ((tab (enhanced-dirvish-active-tab))
                   (p1 (enhanced-dirvish-tab-state-pane1 tab))
                   (p2 (enhanced-dirvish-tab-state-pane2 tab))
                   (window (enhanced-dirvish-pane-state-window (if (= side 1) p1 p2)))
                   (other (enhanced-dirvish-pane-state-window (if (= side 1) p2 p1)))
                   (buffer (window-buffer window)))
              (should (window-live-p window))
              (should (window-live-p other))
              (select-window window)
              (enhanced-dirvish-panes--sync-active-pane-from-window)
              (call-interactively (key-binding (kbd key)))
              (if (equal key "C-x 1")
                  (progn
                    (should (eq (selected-window) window))
                    (should (eq (window-buffer window) buffer))
                    (should-not (window-live-p other)))
                (should-not (window-live-p window))
                (should (window-live-p other)))
              ;; Closing/maximizing a pane must not kill its file browser.
              (should (buffer-live-p buffer)))))))))

(ert-deftest enhanced-dirvish-test-window-preview-zoom-survives-return-and-refresh ()
  "Keyboard zoom persists after leaving/rebuilding previews in every layout."
  (dolist (mode '(compact icons list columns))
    (dolist (keys '("C-x C-+ + C-<left>" "C-+ + C-<left>" "C-= = C-<left>"))
      (ert-info ((format "%s: %s" mode keys))
        (enhanced-dirvish-window-test--with-browser mode
          (let ((file (expand-file-name "sample.txt" directory))
                (other (expand-file-name "another.txt" directory)))
            (write-region "Another text preview\n" nil other nil 'silent)
            (enhanced-dirvish-goto-file file)
            (call-interactively (if (eq mode 'icons) #'enhanced-dirvish-preview-enter-at-point
                                  (key-binding (kbd "<right>"))))
            (should (bound-and-true-p enhanced-dirvish-preview-read-mode))
            (execute-kbd-macro (kbd keys))
            (should (eq (selected-window) main))
            (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 2))
            ;; A redraw used to restore the old preference, undoing native zoom.
            (enhanced-dirvish-preview-at-point)
            (let ((preview (enhanced-dirvish-preview--active-window)))
              (should (window-live-p preview))
              (should (= (buffer-local-value 'text-scale-mode-amount (window-buffer preview)) 2)))
            ;; It is a shared text preference, including newly visited files.
            (enhanced-dirvish-refresh-active-view)
            (enhanced-dirvish-goto-file other)
            (call-interactively (if (eq mode 'icons) #'enhanced-dirvish-preview-enter-at-point
                                  (key-binding (kbd "<right>"))))
            (should (bound-and-true-p enhanced-dirvish-preview-read-mode))
            (should (= text-scale-mode-amount 2))
            (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs-load)) 2))
            (should (= (enhanced-dirvish-prefs-preview-image-scale (enhanced-dirvish-prefs)) 1.0))
            (should (= (enhanced-dirvish-prefs-preview-pdf-scale (enhanced-dirvish-prefs)) 1.0))
            ;; Native Emacs reset is persisted too.
            (execute-kbd-macro (kbd "C-x C-0 C-<left>"))
            (should (eq (selected-window) main))
            (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 0))
            (enhanced-dirvish-preview-at-point)
            (let ((preview (enhanced-dirvish-preview--active-window)))
              (should-not (buffer-local-value 'text-scale-mode (window-buffer preview))))))))))

(ert-deftest enhanced-dirvish-test-window-text-zoom-stays-out-of-images-and-follows-edit ()
  "Text zoom skips image previews; RET edit opens at it and zoom keys persist it."
  (dolist (mode '(compact icons list columns))
    (ert-info ((format "%s" mode))
      (enhanced-dirvish-window-test--with-browser mode
        (let ((file (expand-file-name "sample.txt" directory))
              (image (expand-file-name "photo.png" directory)))
          (write-region "not really a png" nil image nil 'silent)
          (enhanced-dirvish-refresh-active-view)
          (setf (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 2)
          ;; An image preview right after zoomed text renders at text scale 0.
          (enhanced-dirvish-goto-file image)
          (enhanced-dirvish-preview-at-point)
          (should (eq enhanced-dirvish-active-preview-kind 'image))
          (let ((preview (enhanced-dirvish-preview--active-window)))
            (should (window-live-p preview))
            (should-not (buffer-local-value 'text-scale-mode (window-buffer preview))))
          ;; RET on a text file edits it at the saved text zoom...
          (enhanced-dirvish-goto-file file)
          (call-interactively (key-binding (kbd "RET")))
          (should (bound-and-true-p enhanced-dirvish-preview-edit-mode))
          (should (equal buffer-file-name file))
          (should (eq enhanced-dirvish-active-preview-kind 'text))
          (should (= text-scale-mode-amount 2))
          ;; ...and both zoom keys change the text zoom, not the image zoom.
          (execute-kbd-macro (kbd "C-+"))
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 3))
          (should (= text-scale-mode-amount 3))
          (execute-kbd-macro (kbd "C-x C-+"))
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs-load)) 4))
          (should (= (enhanced-dirvish-prefs-preview-image-scale (enhanced-dirvish-prefs)) 1.0)))))))

(ert-deftest enhanced-dirvish-test-window-transpose-error-restores-usable-layout ()
  "A failed layout transformation restores editor buffers and window roles."
  (enhanced-dirvish-window-test--with-browser 'columns
    (let* ((other (split-window-right))
           (buffer (get-buffer-create "*Enhanced Dirvish Window Test Editor*"))
           (roles (enhanced-dirvish-window-test--roles group))
           (dv (dirvish-curr)))
      (set-window-buffer other buffer)
      (let ((arrangement (transpose-frame-get-arrangement)))
        (should-error (enhanced-dirvish-windows--transpose-set
                       (lambda (&rest _) (delete-other-windows) (error "Test interrupted layout"))
                       arrangement nil 'transpose)))
      (should (window-live-p (get-buffer-window buffer)))
      (should (window-live-p (dv-root-window dv)))
      (should (eq (enhanced-dirvish-pane-state-window pane) (dv-root-window dv)))
      (should (window-live-p (dv-preview-window dv)))
      (should (equal roles (enhanced-dirvish-window-test--roles group))))))

(ert-deftest enhanced-dirvish-test-window-delete-retains-adjacent-highlight-after-watch ()
  "A full Columns session keeps one adjacent highlight through live refresh."
  (enhanced-dirvish-window-test--with-browser 'columns
    (dolist (name '("a.txt" "b.txt" "c.txt" "d.txt" "e.txt" "f.txt"))
      (write-region "Delete regression\n" nil (expand-file-name name directory) nil 'silent))
    (revert-buffer nil t)
    (enhanced-dirvish-goto-file (expand-file-name "c.txt" directory))
    (let ((old-highlight (car enhanced-dirvish--selection-overlays)))
      (cl-letf (((symbol-function 'enhanced-dirvish-ui-yes-or-no-p) (lambda (&rest _) t)))
        (let ((this-command 'enhanced-dirvish-delete-permanently))
          (call-interactively #'enhanced-dirvish-delete-permanently)
          (run-hooks 'post-command-hook)))
      (should-not (overlay-buffer old-highlight)))
    (dolist (refresh '(nil t))
      (when refresh
        (enhanced-dirvish-watch--refresh-dired (current-buffer) (list (expand-file-name "c.txt" directory)) nil))
      (should (equal (enhanced-dirvish-current-file) (expand-file-name "d.txt" directory)))
      (should (= (length enhanced-dirvish--selection-overlays) 1))
      (let ((overlay (car enhanced-dirvish--selection-overlays)))
        (should (equal (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))
                       "d.txt")))
      (should (eq (selected-window) main))
      (should (equal (enhanced-dirvish-window-test--roles group) '(footer header index parent preview sidebar))))
    ;; Dirvish's subtree restoration must also accept an entirely empty folder.
    (enhanced-dirvish-select-all)
    (cl-letf (((symbol-function 'enhanced-dirvish-ui-yes-or-no-p) (lambda (&rest _) t)))
      (let ((this-command 'enhanced-dirvish-delete-permanently))
        (call-interactively #'enhanced-dirvish-delete-permanently)
        (run-hooks 'post-command-hook)))
    (should-not (enhanced-dirvish-current-file))
    (should-not (enhanced-dirvish-marked-files-only))
    (should-not enhanced-dirvish--selection-overlays)
    (should-not (directory-files directory nil directory-files-no-dot-files-regexp))))

(provide 'enhanced-dirvish-window-tests)
