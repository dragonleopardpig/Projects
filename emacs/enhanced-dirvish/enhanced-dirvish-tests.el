(ert-deftest enhanced-dirvish-test-selection-ranges-reverse-and-add ()
  "Shift ranges shrink; Ctrl+Shift retains scattered marks outside the range."
  (dolist (view '(list columns compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (let ((a (nth 0 enhanced-dirvish-test--files)) (b (nth 1 enhanced-dirvish-test--files))
            (c (nth 2 enhanced-dirvish-test--files)) (d (nth 3 enhanced-dirvish-test--files)))
        (enhanced-dirvish-view--set-entry-mark a t)
        (enhanced-dirvish-goto-file b)
        (enhanced-dirvish-view--reset-selection-range b)
        (enhanced-dirvish-shift-select-move (lambda () (enhanced-dirvish-goto-file d)))
        (should (equal (enhanced-dirvish-test--selection-names) '("b.txt" "c.txt" "d.txt")))
        (enhanced-dirvish-shift-select-move (lambda () (enhanced-dirvish-goto-file c)))
        (should (equal (enhanced-dirvish-test--selection-names) '("b.txt" "c.txt")))
        (enhanced-dirvish-shift-select-move (lambda () (enhanced-dirvish-goto-file b)))
        (should (equal (enhanced-dirvish-test--selection-names) '("b.txt")))
        (enhanced-dirvish-clear-all-marks)
        (enhanced-dirvish-view--set-entry-mark a t)
        (enhanced-dirvish-view--reset-selection-range b)
        (enhanced-dirvish-mouse-add-range-select (enhanced-dirvish-test--selection-event 'C-S-mouse-1 d))
        (should (equal (enhanced-dirvish-test--selection-names) '("a.txt" "b.txt" "c.txt" "d.txt")))
        (enhanced-dirvish-mouse-add-range-select (enhanced-dirvish-test--selection-event 'C-S-mouse-1 c))
        (should (equal (enhanced-dirvish-test--selection-names) '("a.txt" "b.txt" "c.txt")))
        (enhanced-dirvish-clear-all-marks)
        (enhanced-dirvish-goto-file a)
        (enhanced-dirvish-shift-select-last)
        (should (= (length (enhanced-dirvish-marked-files-only)) 6))
        (enhanced-dirvish-shift-select-first)
        (should (equal (enhanced-dirvish-test--selection-names) '("a.txt")))
        (enhanced-dirvish-clear-all-marks)
        (enhanced-dirvish-goto-file a)
        (enhanced-dirvish-shift-select-prev)
        (should (equal (enhanced-dirvish-test--selection-names) '("a.txt")))
        (should (equal (enhanced-dirvish-current-file) a))))))

(ert-deftest enhanced-dirvish-test-selection-grid-jumps-select-intermediate-files ()
  "Shift row/column jumps include intermediate entries, then shrink on reversal."
  (dolist (view '(compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (if (eq view 'icons)
          (progn
            (let ((columns enhanced-dirvish-icons--ncols))
              (should (< columns (length enhanced-dirvish-test--files)))
              (enhanced-dirvish-shift-select-next)
              (should (equal (enhanced-dirvish-test--selection-names)
                             (mapcar #'file-name-nondirectory
                                     (cl-subseq enhanced-dirvish-test--files 0 (1+ columns))))))
            (enhanced-dirvish-shift-select-prev))
        (enhanced-dirvish-shift-select-right)
        (should (> (length (enhanced-dirvish-marked-files-only)) 2))
        (enhanced-dirvish-shift-select-left))
      (should (equal (enhanced-dirvish-test--selection-names) '("a.txt"))))))

(ert-deftest enhanced-dirvish-test-selection-click-and-menu-targets ()
  "Plain click replaces old marks, and context menus target the clicked item or batch."
  (dolist (view '(list columns compact icons))
    (enhanced-dirvish-test--with-selection-view view
