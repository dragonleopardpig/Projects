        (enhanced-dirvish-mouse-toggle-select (enhanced-dirvish-test--selection-event 'C-mouse-1 a))
        (enhanced-dirvish-mouse-toggle-select (enhanced-dirvish-test--selection-event 'C-mouse-1 c))
        (cl-letf (((symbol-function 'enhanced-dirvish-context-menu) (lambda () (interactive))))
          (enhanced-dirvish-mouse-context-menu (enhanced-dirvish-test--selection-event 'mouse-3 a))
          (should (equal (enhanced-dirvish-test--selection-names) '("a.txt" "c.txt")))
          (enhanced-dirvish-mouse-context-menu (enhanced-dirvish-test--selection-event 'mouse-3 f))
          (should-not (enhanced-dirvish-marked-files-only))
          (should (equal (enhanced-dirvish-selected-files) (list f))))))))

(ert-deftest enhanced-dirvish-test-selection-keymap-precedence-and-help ()
  "10xer overrides win, and ? documents selection in either mode."
  (enhanced-dirvish-test--with-selection-view 'list
    (dolist (tenxer '(nil t nil))
      (enhanced-dirvish-tenxer-mode (if tenxer 1 -1))
