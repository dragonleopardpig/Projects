(ert-deftest enhanced-dirvish-test-selection-drag-never-polls-pending-input ()
  "GTK pending input with no readable event cannot trap drag handling in a loop."
  (enhanced-dirvish-test--with-selection-view 'list
    (let* ((down (enhanced-dirvish-test--selection-event 'down-mouse-1 (car enhanced-dirvish-test--files)))
           (motion (enhanced-dirvish-test--selection-event 'mouse-movement (nth 3 enhanced-dirvish-test--files) 60)))
      (enhanced-dirvish-mouse-down-entry down)
      (cl-letf (((symbol-function 'input-pending-p) (lambda () t))
                ((symbol-function 'read-event)
                 (lambda (&rest _) (ert-fail "Drag handler tried to consume pending input")))
                ((symbol-function 'redisplay)
                 (lambda (&rest _) (ert-fail "Drag handler forced recursive redisplay"))))
        (enhanced-dirvish-mouse--drag-move motion))
      (should (equal (enhanced-dirvish-test--selection-names) '("a.txt" "b.txt" "c.txt" "d.txt")))
      (let ((last-input-event ?\C-g))
        (call-interactively (lookup-key (enhanced-dirvish-mouse--drag-keymap) (kbd "C-g"))))
      (should-not track-mouse)
      (should-not enhanced-dirvish-mouse--drag-state)
      (should-not (enhanced-dirvish-marked-files-only)))))

(ert-deftest enhanced-dirvish-test-selection-grid-marks-preserve-cached-order ()
  "Mark updates must not mutate the directory order cached by an active drag."
  (dolist (view '(compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (let* ((order (enhanced-dirvish-view--entry-order))
             (original (copy-sequence order)))
        ;; Filtering may share its unchanged tail with ORDER.  Reversing
        ;; that result destructively used to truncate or reorder ORDER.
        (dolist (selected (list (nthcdr 3 original) original))
          (enhanced-dirvish-mouse--apply-selection-keys order selected nil)
          (should (equal order original))
          (should (equal (enhanced-dirvish-test--selection-names)
                         (mapcar #'file-name-nondirectory selected))))))))

(ert-deftest enhanced-dirvish-test-selection-compact-drag-through-last-file ()
  "A live Compact file drag keeps its tail range after button release."
  (enhanced-dirvish-test--with-selection-view 'compact
    (let* ((win (selected-window))
           (start (save-excursion (enhanced-dirvish-goto-file (nth 3 enhanced-dirvish-test--files)) (point)))
           (middle (save-excursion (enhanced-dirvish-goto-file (nth 4 enhanced-dirvish-test--files)) (point)))
           (end (save-excursion (enhanced-dirvish-goto-file (nth 5 enhanced-dirvish-test--files)) (point))))
      (dolist (positions (list (list start middle end) (list end middle start)))
        (enhanced-dirvish-clear-all-marks)
        (let ((first (nth 0 positions)) (mid (nth 1 positions)) (last (nth 2 positions)))
          (enhanced-dirvish-test--play-events
           `(down-mouse-1 (,win ,first (10 . 10) 0) 1)
           `(mouse-movement (,win ,mid (10 . 30) 0))
           `(mouse-movement (,win ,last (10 . 50) 0))
           `(drag-mouse-1 (,win ,first (10 . 10) 0) (,win ,last (10 . 50) 0))))
        (should (equal (enhanced-dirvish-test--selection-names) '("d.txt" "e.txt" "f.txt")))
        (should-not enhanced-dirvish-mouse--drag-state)
        (should-not track-mouse)))))

(ert-deftest enhanced-dirvish-test-selection-drag-error-and-watchdog-release-tracking ()
  "Errors and abandoned button releases cancel timers and global tracking."
  (enhanced-dirvish-test--with-selection-view 'list
    (let ((down (enhanced-dirvish-test--selection-event 'down-mouse-1 (car enhanced-dirvish-test--files)))
          (motion (enhanced-dirvish-test--selection-event 'mouse-movement (nth 3 enhanced-dirvish-test--files) 60)))
      (enhanced-dirvish-mouse-down-entry down)
      (let ((st enhanced-dirvish-mouse--drag-state))
        (should (timerp (plist-get st :watchdog-timer)))
        (cl-letf (((symbol-function 'enhanced-dirvish-mouse--apply-selection-keys)
                   (lambda (&rest _) (error "Selection refresh failed"))))
          (should-error (enhanced-dirvish-mouse--drag-move motion)))
        (should-not (plist-get st :scroll-timer))
        (should-not (plist-get st :watchdog-timer))
        (should-not track-mouse)
        (should-not enhanced-dirvish-mouse--drag-state)
        (should (eq enhanced-dirvish-mouse--finished-drag-state st))
        (should (plist-get st :cancelled-p)))
      (enhanced-dirvish-mouse-down-entry down)
      (let ((st enhanced-dirvish-mouse--drag-state))
        (plist-put st :scroll-timer (run-at-time 20 20 #'ignore))
        (cl-letf (((symbol-function 'enhanced-dirvish-mouse--edge-scroll-step)
                   (lambda (&rest _) (error "Auto-scroll failed"))))
          (enhanced-dirvish-mouse--scroll-tick st))
        (should-not (plist-get st :scroll-timer))
        (should-not (plist-get st :watchdog-timer))
        (should-not track-mouse)
        (should-not enhanced-dirvish-mouse--drag-state)
        (should (plist-get st :cancelled-p))
        ;; The pending release must be swallowed rather than starting a
        ;; fallback selection or cross-pane file transfer after an error.
        (enhanced-dirvish-mouse-drag-drop
         (list 'drag-mouse-1 (event-start down) (event-start motion)))
        (should-not enhanced-dirvish-mouse--finished-drag-state))
      (enhanced-dirvish-mouse-down-entry down)
      (enhanced-dirvish-mouse--drag-watchdog enhanced-dirvish-mouse--drag-state)
      (should-not track-mouse)
      (should-not enhanced-dirvish-mouse--drag-state))))

(defun enhanced-dirvish-test--popup-menu-command (menu label)
  "Return the actual popup menu command labeled LABEL."
  (let ((item (cl-find-if (lambda (item)
                            (and (consp item) (eq (cadr item) 'menu-item)
                                 (equal (nth 2 item) label)))
                          (cdr menu))))
    (should item)
    (nth 3 item)))

(defun enhanced-dirvish-test--sort-menu-command (label)
  "Return the sort menu command labeled LABEL."
  (enhanced-dirvish-test--popup-menu-command (enhanced-dirvish-sort--menu) label))

(defun enhanced-dirvish-test--rendered-sort-names ()
  "Read filenames from the displayed Dired rows or rendered grid cells."
  (if (derived-mode-p 'dired-mode)
      (mapcar #'file-name-nondirectory (enhanced-dirvish-view--entry-order))
    (let ((pos (point-min)) paths)
      (while (< pos (point-max))
        (when-let ((path (get-text-property pos 'enhanced-dirvish-entry)))
          (unless (member path paths) (push path paths)))
        (setq pos (next-single-property-change pos 'enhanced-dirvish-entry nil (point-max))))
      ;; The small test fixture fits in one Compact column; Icons cells are
      ;; encountered in grid order, including repeated properties on cards.
      (mapcar #'file-name-nondirectory (nreverse paths)))))

(ert-deftest enhanced-dirvish-test-sort-menu-orders-all-directory-layouts ()
  "Popup commands really reorder files in all four layouts and retain marks."
  (dolist (view '(list columns compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (cl-loop for old in enhanced-dirvish-test--files
               for name in '("a.txt" "b.zip" "c.txt" "d.el" "e.txt" "f.png")
               for size in '(6 1 4 2 5 3)
               for seconds in '(600000 500000 400000 300000 200000 100000)
               for file = (expand-file-name name enhanced-dirvish-test--dir)
               do (unless (equal file old) (rename-file old file))
               do (write-region (make-string size ?x) nil file nil 'silent)
               do (set-file-times file (seconds-to-time seconds)))
      (enhanced-dirvish-sort-set 'name 'asc)
      (enhanced-dirvish-goto-file (car enhanced-dirvish-test--files))
      (enhanced-dirvish-view-toggle-mark)
      (dolist (choice '(("Name" ("a.txt" "b.zip" "c.txt" "d.el" "e.txt" "f.png"))
                        ("Modification date" ("f.png" "e.txt" "d.el" "c.txt" "b.zip" "a.txt"))
                        ("Size" ("b.zip" "d.el" "f.png" "c.txt" "e.txt" "a.txt"))
                        ("Type / extension" ("d.el" "f.png" "a.txt" "c.txt" "e.txt" "b.zip"))))
        (call-interactively (enhanced-dirvish-test--sort-menu-command (car choice)))
        (should (equal (enhanced-dirvish-test--rendered-sort-names) (cadr choice)))
        ;; Rechoosing a radio item must keep its direction, unlike the chord.
        (call-interactively (enhanced-dirvish-test--sort-menu-command (car choice)))
        (should (eq (enhanced-dirvish-prefs-sort-direction enhanced-dirvish-prefs-current) 'asc))
        (call-interactively #'enhanced-dirvish-sort-descending)
        (should (equal (enhanced-dirvish-test--rendered-sort-names) (reverse (cadr choice))))
        (should (equal (enhanced-dirvish-test--selection-names) '("a.txt")))
        (should (equal (file-name-nondirectory (enhanced-dirvish-current-file)) "a.txt"))
        (call-interactively #'enhanced-dirvish-sort-ascending))
      (call-interactively (enhanced-dirvish-test--sort-menu-command "Unsorted (directory order)"))
      (should (eq (enhanced-dirvish-prefs-sort-key enhanced-dirvish-prefs-current) 'unsorted))
      ;; Unsorted order is unspecified by directory-files and ls -U; it
      ;; must still display the complete directory without losing marks.
      (should (equal (sort (enhanced-dirvish-test--rendered-sort-names) #'string<)
                     (directory-files enhanced-dirvish-test--dir nil "\\`[^.]")))
      (should (equal (enhanced-dirvish-test--selection-names) '("a.txt")))
      (should (file-exists-p enhanced-dirvish-state-file)))))

(ert-deftest enhanced-dirvish-test-sort-menu-folders-and-natural-names ()
  "The folder and natural-name switches act consistently in every layout."
  (dolist (view '(list columns compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (make-directory (expand-file-name "z-folder" enhanced-dirvish-test--dir))
      (dolist (name '("item10.txt" "item2.txt"))
        (write-region "x" nil (expand-file-name name enhanced-dirvish-test--dir) nil 'silent))
      (enhanced-dirvish-sort-set 'name 'asc)
      (should (equal (car (enhanced-dirvish-test--rendered-sort-names)) "z-folder"))
      (enhanced-dirvish-sort-descending)
      (should (equal (car (enhanced-dirvish-test--rendered-sort-names)) "z-folder"))
      (enhanced-dirvish-sort-ascending)
      (call-interactively (enhanced-dirvish-test--sort-menu-command "Folders first"))
      (should (equal (car (enhanced-dirvish-test--rendered-sort-names)) "a.txt"))
      (let ((names (enhanced-dirvish-test--rendered-sort-names)))
        (should (< (cl-position "item2.txt" names :test #'equal)
                   (cl-position "item10.txt" names :test #'equal))))
      (call-interactively (enhanced-dirvish-test--sort-menu-command "Natural names (file2 before file10)"))
      (let ((names (enhanced-dirvish-test--rendered-sort-names)))
        (should (< (cl-position "item10.txt" names :test #'equal)
                   (cl-position "item2.txt" names :test #'equal)))))))

(ert-deftest enhanced-dirvish-test-sort-header-and-shortcut-in-every-layout ()
  "Both header controls are clickable and C-c s works in both keyboard modes."
  (dolist (view '(list columns compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (should header-line-format)
      (let* ((text (dirvish-enhanced-dirvish-view-info-ml))
             (pos (string-match "Sort By…" text))
             (map (get-text-property pos 'keymap text)))
        (should pos)
        (should (eq (lookup-key map [header-line mouse-1]) #'enhanced-dirvish-sort-menu))
        (let* ((view-pos (string-match "View…" text))
               (view-map (get-text-property view-pos 'keymap text)))
          (should view-pos)
          ;; Equal adjacent mouse-face spans merge during GUI hover.
          (let ((boundary (next-single-property-change pos 'mouse-face text)))
            (should (< boundary view-pos))
            (should-not (get-text-property boundary 'mouse-face text)))
          (should (eq (lookup-key view-map [header-line mouse-1]) #'enhanced-dirvish-view-menu))))
      ;; Choosing the already checked layout keeps the current marks and
      ;; buffer, rather than rebuilding the view and clearing selection.
      (enhanced-dirvish-view-toggle-mark)
      (let ((before (current-buffer)))
        (call-interactively
         (enhanced-dirvish-test--popup-menu-command
          (enhanced-dirvish-view--menu)
          (pcase view ('columns "Columns") ('icons "Icons")
                 ('list "List / Tree") ('compact "Compact"))))
        (should (eq (current-buffer) before))
        (should (equal (enhanced-dirvish-test--selection-names) '("a.txt"))))
      (enhanced-dirvish-test--with-file-manager-keys t
        (dolist (tenx '(nil t))
          (setf (enhanced-dirvish-prefs-tenxer-mode enhanced-dirvish-prefs-current) tenx)
          (enhanced-dirvish--apply-active-keymap)
          (should (eq (key-binding (kbd "C-c s")) #'enhanced-dirvish-sort-menu)))))))

(ert-deftest enhanced-dirvish-test-sort-header-targets-clicked-pane ()
  "Clicking an inactive pane's header opens the menu in that directory."
  (enhanced-dirvish-test--with-selection-view 'compact
    (let* ((first (selected-window))
           (second (split-window-right))
           (other (generate-new-buffer "*Enhanced Dirvish Sort Other Pane*"))
           (tab (enhanced-dirvish-active-tab))
           (pane1 (enhanced-dirvish-tab-state-pane1 tab))
           (pane2 (make-enhanced-dirvish-pane-state :id 2 :window second :buffer other
                                          :dir enhanced-dirvish-test--dir))
           menu-buffer)
      (unwind-protect
          (progn
            (with-current-buffer other (enhanced-dirvish-compact-mode))
            (set-window-buffer second other)
            (setf (enhanced-dirvish-pane-state-window pane1) first
                  (enhanced-dirvish-pane-state-buffer pane1) (current-buffer)
                  (enhanced-dirvish-tab-state-pane2 tab) pane2
                  (enhanced-dirvish-tab-state-split-p tab) t)
            (cl-letf (((symbol-function 'popup-menu)
                       (lambda (&rest _) (setq menu-buffer (current-buffer))))
                      ((symbol-function 'enhanced-dirvish-sidebar-refresh) #'ignore))
              (dolist (command '(enhanced-dirvish-sort-menu enhanced-dirvish-view-menu))
                (select-window first)
                (setf (enhanced-dirvish-tab-state-active-pane tab) 1)
                (funcall command (list 'mouse-1 (list second 'header-line '(10 . 10) 0)))
                (should (eq menu-buffer other))
                (should (= (enhanced-dirvish-tab-state-active-pane tab) 2)))))
        (when (buffer-live-p other) (kill-buffer other))))))

(ert-deftest enhanced-dirvish-test-sort-global-dirvish-header-targets-root ()
  "Columns' separate header window directs the menu back to the root browser."
  (enhanced-dirvish-test--with-selection-view 'columns
    (let* ((root (selected-window))
           (header (split-window-below))
           (aux (generate-new-buffer "*Enhanced Dirvish Sort Header*"))
           (dv (dirvish--new :root-window root))
           menu-buffer)
      (unwind-protect
          (progn
            (with-current-buffer aux
              (dirvish-misc-mode)
              (dirvish-prop :dv (dv-id dv)))
            (set-window-buffer header aux)
            (cl-letf (((symbol-function 'popup-menu)
                       (lambda (&rest _) (setq menu-buffer (current-buffer)))))
              (dolist (command '(enhanced-dirvish-sort-menu enhanced-dirvish-view-menu))
                (funcall command (list 'mouse-1 (list header 'header-line '(10 . 10) 0)))
                (should (eq menu-buffer enhanced-dirvish-test--buf))
                (should (eq (selected-window) root)))))
        (when (buffer-live-p aux) (kill-buffer aux))
        (remhash (dv-id dv) dirvish--sessions)))))

(ert-deftest enhanced-dirvish-test-mouse-empty-space-clears-selection ()
  "Empty-space clicks clear marks and focus; nearest hits remain for drags."
  (dolist (view '(columns list compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (dolist (raw-point '(nil end))
        (enhanced-dirvish-goto-file (car enhanced-dirvish-test--files))
        (enhanced-dirvish-view-toggle-mark)
        (let* ((win (selected-window))
               (point (when raw-point (point-max)))
               (event (list 'mouse-1 (list win point '(10 . 300) 0) 1)))
          (should-not (enhanced-dirvish-mouse--entry-at-posn (event-start event)))
          (should (enhanced-dirvish-mouse--entry-at-posn (event-start event) t))
          (enhanced-dirvish-mouse-click-entry event)
          (should-not (enhanced-dirvish-marked-files-only))
          (should-not (enhanced-dirvish-current-file))
          (should-not enhanced-dirvish--selection-overlays)))
      ;; Native down/release tracking must also avoid marking the final row.
      (enhanced-dirvish-goto-file (car enhanced-dirvish-test--files))
      (enhanced-dirvish-view-toggle-mark)
      (let ((posn (list (selected-window) (point-max) '(10 . 300) 0)))
        (enhanced-dirvish-test--play-events (list 'down-mouse-1 posn 1) (list 'mouse-1 posn 1)))
      (should-not (enhanced-dirvish-marked-files-only))
      (should-not (enhanced-dirvish-current-file)))))

(ert-deftest enhanced-dirvish-test-mouse-gui-context-menu-targets-selection ()
  "GUI right-click actions use the clicked group, with real View/Sort submenus."
  (dolist (view '(columns list compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (let ((a (car enhanced-dirvish-test--files)) (c (nth 2 enhanced-dirvish-test--files))
            (f (nth 5 enhanced-dirvish-test--files))
            (enhanced-dirvish-clipboard nil) menu menu-buffer)
        (enhanced-dirvish-mouse-toggle-select (enhanced-dirvish-test--selection-event 'C-mouse-1 a))
        (enhanced-dirvish-mouse-toggle-select (enhanced-dirvish-test--selection-event 'C-mouse-1 c))
        (cl-letf (((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                  ((symbol-function 'popup-menu)
                   (lambda (value &rest _) (setq menu value menu-buffer (current-buffer))))
                  ((symbol-function 'enhanced-dirvish-context-menu)
                   (lambda () (ert-fail "GUI right-click opened the keyboard menu"))))
          (enhanced-dirvish-mouse-context-menu (enhanced-dirvish-test--selection-event 'mouse-3 a))
          (should (eq menu-buffer enhanced-dirvish-test--buf))
          (call-interactively (enhanced-dirvish-test--popup-menu-command menu "Copy"))
          (should (equal (sort (plist-get enhanced-dirvish-clipboard :files) #'string<) (list a c)))
          (should (keymapp (lookup-key menu [view])))
          (should (keymapp (lookup-key menu [sort])))
          (enhanced-dirvish-mouse-context-menu (enhanced-dirvish-test--selection-event 'mouse-3 f))
          (call-interactively (enhanced-dirvish-test--popup-menu-command menu "Copy"))
          (should (equal (plist-get enhanced-dirvish-clipboard :files) (list f)))
          (enhanced-dirvish-mouse-context-menu
           (list 'mouse-3 (list (selected-window) (point-max) '(10 . 300) 0) 1))
          (should-not (enhanced-dirvish-selected-files))
          (let ((open (cl-find-if (lambda (entry) (and (consp entry) (equal (nth 2 entry) "Open")))
                                 (cdr menu))))
            (should (plist-member (nthcdr 4 open) :enable))
            (should-not (eval (plist-get (nthcdr 4 open) :enable) t))))))))

(ert-deftest enhanced-dirvish-test-mouse-drag-feedback-throttles-and-cleans-up ()
  "File badges follow carries, throttle motion, and restore state on every exit."
  (dolist (exit '(release cancel watchdog display-error))
    (enhanced-dirvish-test--with-selection-view 'compact
      (let* ((src (selected-window))
             (other (split-window-right))
             (a (car enhanced-dirvish-test--files))
             (original-tooltip tooltip-mode)
             (original-help show-help-function)
             (original-fine mouse-fine-grained-tracking)
             (now 10.0) shown hidden)
        (enhanced-dirvish-view--set-entry-mark a t)
        (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                  ((symbol-function 'enhanced-dirvish-icon-glyph) (lambda (&rest _) "▤"))
                  ((symbol-function 'float-time) (lambda (&rest _) now))
                  ((symbol-function 'x-show-tip)
                   (lambda (text &rest _)
                     (if (eq exit 'display-error) (error "Tooltip display failed")
                       (push text shown))))
                  ((symbol-function 'x-hide-tip) (lambda () (setq hidden t))))
          (let* ((down (enhanced-dirvish-test--selection-event 'down-mouse-1 a))
                 (motion (list 'mouse-movement
                               (list src (save-excursion (enhanced-dirvish-goto-file a) (point)) '(30 . 40) 0))))
            (enhanced-dirvish-mouse-down-entry down)
            (let ((st enhanced-dirvish-mouse--drag-state))
              ;; Carry a single marked file too, without sweeping in others.
              (should (plist-get st :carry-marked-p))
              (enhanced-dirvish-mouse--drag-move motion)
              (if (eq exit 'display-error)
                  (progn
                    (should (plist-get st :feedback-disabled-p))
                    (should (eq tooltip-mode original-tooltip)))
                (should (= (length shown) 1))
                (should (string-match-p "1 item — Copy / Move" (car shown)))
                (should (string-match-p "a.txt" (car shown)))
                (should-not tooltip-mode)
                (setq now 10.01)
                (dotimes (_ 100) (enhanced-dirvish-mouse--drag-move motion))
                (should (= (length shown) 1))
                (setq now 10.05)
                (enhanced-dirvish-mouse--drag-move motion)
                (should (= (length shown) 2))
                ;; A modifier change updates the cue without waiting for the throttle.
                (enhanced-dirvish-mouse--drag-move (cons 'C-mouse-movement (cdr motion)))
                (should (string-match-p "1 item — Copy\n" (car shown))))
              (pcase exit
                ('release (enhanced-dirvish-mouse--on-drag-exit)
                          (enhanced-dirvish-mouse-click-entry (list 'mouse-1 (event-start down) 1)))
                ('cancel (enhanced-dirvish-mouse--drag-cancel))
                (_ (enhanced-dirvish-mouse--drag-watchdog st)))
              (should hidden)
              (should-not (plist-get st :feedback-visible-p))
              (should-not enhanced-dirvish-mouse--drag-state)
              (should (eq tooltip-mode original-tooltip))
              (should (eq show-help-function original-help))
              (should (eq mouse-fine-grained-tracking original-fine))
              (should (equal (enhanced-dirvish-test--selection-names) '("a.txt"))))))
        (when (window-live-p other) (delete-window other))))))

(ert-deftest enhanced-dirvish-test-ui-keyboard-keeps-original-prompts ()
  "An explicit keyboard action keeps text prompts even after a prior mouse event."
  (let ((enhanced-dirvish-ui-input-method 'keyboard)
        (last-input-event ?r)
        (last-nonmenu-event '(mouse-1 nil)))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
              ((symbol-function 'read-string) (lambda (&rest _) "typed name"))
              ((symbol-function 'completing-read) (lambda (&rest _) "zip"))
              ((symbol-function 'read-directory-name) (lambda (&rest _) "/tmp/"))
              ((symbol-function 'read-passwd) (lambda (&rest _) "typed password"))
              ((symbol-function 'y-or-n-p) (lambda (&rest _) t))
              ((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
              ((symbol-function 'x-popup-dialog) (lambda (&rest _) (ert-fail "Keyboard opened GUI")))
              ((symbol-function 'enhanced-dirvish-ui--gtk-entry) (lambda (&rest _) (ert-fail "Keyboard opened GTK"))))
      (should (equal (enhanced-dirvish-ui-read-string "Name:") "typed name"))
      (should (equal (enhanced-dirvish-ui-completing-read "Format:" '("zip") nil t) "zip"))
      (should (equal (enhanced-dirvish-ui-read-directory-name "Directory:") "/tmp/"))
      (should (equal (enhanced-dirvish-ui-read-passwd "Password:") "typed password"))
      (should (enhanced-dirvish-ui-y-or-n-p "Replace?"))
      (should (enhanced-dirvish-ui-yes-or-no-p "Delete?")))))

(ert-deftest enhanced-dirvish-test-ui-mouse-menu-follow-up-uses-gui ()
  "A GUI menu action keeps GUI name and confirmation prompts through completion."
  (enhanced-dirvish-test--with-selection-view 'compact
    (let ((a (car enhanced-dirvish-test--files)) (b (nth 1 enhanced-dirvish-test--files))
          (last-input-event ?x) (last-nonmenu-event ?x) asked)
      (cl-letf (((symbol-function 'enhanced-dirvish-ui-mouse-p)
                 (lambda () (eq enhanced-dirvish-ui-input-method 'mouse)))
                ((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                ((symbol-function 'popup-menu)
                 (lambda (menu &rest _)
                   (call-interactively (enhanced-dirvish-test--popup-menu-command menu "Rename…"))))
                ((symbol-function 'enhanced-dirvish-ui--gtk-entry)
                 (lambda (&rest _) (push 'entry asked) "b.txt"))
                ((symbol-function 'x-popup-dialog)
                 (lambda (&rest _) (push 'confirm asked) t))
                ((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Mouse name was textual")))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) (ert-fail "Mouse confirm was textual")))
                ((symbol-function 'enhanced-dirvish-refresh-active-view) #'ignore))
        (enhanced-dirvish-mouse-context-menu (enhanced-dirvish-test--selection-event 'mouse-3 a))
        (should (equal (nreverse asked) '(entry confirm)))
        (should-not (file-exists-p a))
