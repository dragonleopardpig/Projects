(ert-deftest enhanced-dirvish-test-paste-replace-directories-and-self ()
  "Replacing directories via Copy/Cut replaces cleanly and self-replace errors."
  (let* ((tmp (make-temp-file "enhanced-dirvish-replace-" t))
         (src-root (expand-file-name "src" tmp))
         (dst-root (expand-file-name "dst" tmp))
         (src-sub (expand-file-name "sub" src-root))
         (dst-sub (expand-file-name "sub" dst-root))
         (same (expand-file-name "same.txt" tmp))
         (enhanced-dirvish-undo-stack nil))
    (unwind-protect
        (progn
          (make-directory src-sub t)
          (make-directory dst-sub t)
          (write-region "new" nil (expand-file-name "new.txt" src-sub) nil 'silent)
          (write-region "old" nil (expand-file-name "stale.txt" dst-sub) nil 'silent)
          (write-region "self" nil same nil 'silent)
          (cl-letf (((symbol-function 'enhanced-dirvish-refresh-active-view) #'ignore))
            ;; Same-folder replace refuses to overwrite itself
            (let ((default-directory (file-name-as-directory tmp)))
              (should-error (enhanced-dirvish--transfer-files (list same) tmp 'copy nil t) :type 'user-error))
            ;; Copy+replace replaces destination directory cleanly without stale files
            (let ((default-directory (file-name-as-directory dst-root)))
              (enhanced-dirvish--transfer-files (list src-sub) dst-root 'copy nil t)
              (should (file-exists-p (expand-file-name "new.txt" dst-sub)))
              (should-not (file-exists-p (expand-file-name "stale.txt" dst-sub)))
              (should-not (file-exists-p (expand-file-name "sub/new.txt" dst-sub)))
              ;; Cut+replace onto non-empty directory succeeds cleanly
              (write-region "stale2" nil (expand-file-name "stale2.txt" dst-sub) nil 'silent)
              (enhanced-dirvish--transfer-files (list src-sub) dst-root 'cut nil t)
              (should (file-exists-p (expand-file-name "new.txt" dst-sub)))
              (should-not (file-exists-p (expand-file-name "stale2.txt" dst-sub)))
              (should-not (file-exists-p src-sub)))))
      (ignore-errors (delete-directory tmp t)))))

