                  (dolist (entry entries)
                    (cond ((vectorp entry)
                           (should (fboundp (aref entry 1)))
                           (push (aref entry 1) listed))
                          ((consp entry) (walk (cdr entry)))))))
      (walk enhanced-dirvish-menu--catalog))
    (dolist (command (apropos-internal "\\`enhanced-dirvish-" #'commandp))
      (unless (or (string-match-p "--\\|mouse\\|chord\\|-mode\\'" (symbol-name command))
                  ;; Context menu is the keyboard-only hub; the other two
                  ;; are equivalent wrappers of commands/submenus above.
                  (memq command '(enhanced-dirvish-context-menu enhanced-dirvish-view-activate-at-point enhanced-dirvish-view-menu)))
        (should (memq command listed))))))

