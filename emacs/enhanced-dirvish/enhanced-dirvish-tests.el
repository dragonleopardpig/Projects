      (should (eq (key-binding (kbd "?")) #'enhanced-dirvish-open-shortcut-reference))
      (should (eq (key-binding (kbd "C-SPC")) #'enhanced-dirvish-view-toggle-mark))
      (should (eq (key-binding (kbd "C-S-<down>")) #'enhanced-dirvish-shift-select-next)))
    (dolist (tenxer '(nil t))
