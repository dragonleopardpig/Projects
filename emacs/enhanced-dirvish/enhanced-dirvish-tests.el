(ert-deftest enhanced-dirvish-test-clickable-directories-and-verified-icons ()
  (let* ((tmp (make-temp-file "enhanced-dirvish-mouse-" t))
         (sub (expand-file-name "sub_folder" tmp))
         (fil (expand-file-name "note.txt" tmp)))
    (unwind-protect
        (progn
          (make-directory sub t)
          (write-region "hi" nil fil)
          ;; Compact view: directory gets pointer 'hand + mouse-face 'highlight
          (with-temp-buffer
            (enhanced-dirvish-compact-mode)
            (setq enhanced-dirvish-view-directory (file-name-as-directory tmp))
            (enhanced-dirvish-compact-render)
            (goto-char (point-min))
            (should (search-forward "sub_folder" nil t))
            (let ((p (match-beginning 0)))
              (should (eq (get-text-property p 'pointer) 'hand))
              (should (eq (get-text-property p 'mouse-face) 'highlight))
              (should (equal (directory-file-name (get-text-property p 'enhanced-dirvish-entry))
                             (directory-file-name sub))))
            (goto-char (point-min))
            (should (search-forward "note.txt" nil t))
            (should-not (eq (get-text-property (match-beginning 0) 'pointer) 'hand)))
          ;; Icons view: directory tile gets pointer 'hand + mouse-face 'highlight
          (with-temp-buffer
            (enhanced-dirvish-icons-mode)
            (setq enhanced-dirvish-view-directory (file-name-as-directory tmp))
            (enhanced-dirvish-icons-render)
            (goto-char (point-min))
            (should (search-forward "sub_folder" nil t))
            (let ((p (match-beginning 0)))
              (should (eq (get-text-property p 'pointer) 'hand))
              (should (eq (get-text-property p 'mouse-face) 'highlight))))
          ;; Breadcrumbs: clickable segment with pointer 'hand & header/mode-line click map
          (let* ((seg (enhanced-dirvish-crumb--make-segment "Projects" sub))
                 (km (get-text-property 0 'keymap seg)))
            (should (eq (get-text-property 0 'pointer seg) 'hand))
            (should (eq (get-text-property 0 'mouse-face seg) 'highlight))
            (should (keymapp km))
            (should (lookup-key km [header-line mouse-1]))
            (should (lookup-key km [mode-line mouse-1])))
          ;; Sidebar Places: clickable, hand cursor, zero broken missing glyphs
          (let ((sb (get-buffer-create "*Enhanced Dirvish Sidebar*")))
            (with-current-buffer sb
              (enhanced-dirvish-sidebar-mode)
              (enhanced-dirvish-sidebar-render)
              (goto-char (point-min))
              (should (search-forward "Home" nil t))
              (let ((p (match-beginning 0)))
                (should (eq (get-text-property p 'pointer) 'hand))
                (should (eq (get-text-property p 'mouse-face) 'highlight)))
              (should-not (string-search "🖵" (buffer-string)))
              (should-not (string-search "🖴" (buffer-string))))))
      (ignore-errors (kill-buffer "*Enhanced Dirvish Sidebar*"))
      (ignore-errors (delete-directory tmp t))))
  ;; Icon table & tinting keep :family intact without missing glyphs
  (should-not (string-search "🖵" (enhanced-dirvish-icon-glyph 'desktop)))
  (should-not (string-search "🖴" (enhanced-dirvish-icon-glyph 'hdd)))
  (let* ((base (propertize "X" 'face '(:family "Symbols Nerd Font Mono")))
         (tinted (enhanced-dirvish-icon-tint base 'highlight))
         (f (get-text-property 0 'face tinted)))
    (should (listp f))
    (should (equal (car f) '(:family "Symbols Nerd Font Mono")))
    (should (memq 'highlight f))))

(ert-deftest enhanced-dirvish-test-swift-startup-skips-devices-and-guards-fuse ()
  "Startup sidebar skips device scans and FUSE/cloud mounts are never synchronously probed."
  (require 'dirvish-collapse)
  (let* ((tmp (make-temp-file "enhanced-dirvish-swift-" t))
         (state-dir (expand-file-name "state" tmp))
         (enhanced-dirvish-config-dir (expand-file-name "cfg" tmp))
         (enhanced-dirvish-state-dir state-dir)
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" state-dir))
         (enhanced-dirvish-devices-cache nil)
         (enhanced-dirvish-sidebar-window nil))
    (unwind-protect
        (cl-letf (((symbol-function 'enhanced-dirvish-prefs)
                   (lambda () (enhanced-dirvish-prefs--create))))
          (enhanced-dirvish-setup)
          ;; Default setup omits synchronous `collapse` and puts `enhanced-dirvish-mount-guard` first.
          (should-not (memq 'collapse dirvish-attributes))
          (should (eq (car dirvish-preview-dispatchers) 'enhanced-dirvish-mount-guard))
          ;; Sidebar startup render must NEVER invoke synchronous `enhanced-dirvish-devices-list`.
          (cl-letf (((symbol-function 'enhanced-dirvish-devices-list)
                     (lambda (&rest _) (error "Unexpected synchronous device scan at startup"))))
            (let ((sb (get-buffer-create "*Enhanced Dirvish Sidebar*")))
              (with-current-buffer sb
                (enhanced-dirvish-sidebar-mode)
                (enhanced-dirvish-sidebar-render)
                (should (string-search "[Scan drives (g)]" (buffer-string)))
                (goto-char (point-min))
                (should (search-forward "[Scan drives (g)]" nil t))
                (should (eq (get-text-property (match-beginning 0) 'enhanced-dirvish-sidebar-action)
                            'scan-devices))
                (should (eq (get-text-property (match-beginning 0) 'pointer) 'hand)))))
          ;; Mock /proc/mounts entries (never touching real FUSE mounts).
          (cl-letf (((symbol-function 'enhanced-dirvish-mounts--entries)
                     (lambda (&optional _force)
                       '(("/home/user/Cloud Drive" cloud "fuse.rclone" "cloud_drive:")
                         ("/run/media/user/usb" removable "vfat" "/dev/sdb1")
                         ("/" local "btrfs" "/dev/nvme0n1p2")))))
            (should (eq (enhanced-dirvish-path-mount-kind "/home/user/Cloud Drive") 'cloud))
            (should (eq (enhanced-dirvish-path-mount-kind "/home/user/Cloud Drive/nested") 'cloud))
            (should (enhanced-dirvish-path-unsafe-probe-p "/home/user/Cloud Drive"))
            (should (enhanced-dirvish-path-unsafe-probe-p "/run/media/user/usb"))
            (should (enhanced-dirvish-path-unsafe-probe-p "/ssh:example:/tmp"))
            (should-not (enhanced-dirvish-path-unsafe-probe-p "/home/user/Projects"))
            ;; `enhanced-dirvish-file--glyph` must classify cloud mount WITHOUT probing `.git`.
            (cl-letf (((symbol-function 'file-exists-p)
                       (lambda (p)
                         (when (string-search "Cloud Drive" p)
                           (error "Blocked sync probe inside FUSE mount: %s" p))
                         nil)))
              (should (equal (enhanced-dirvish-file--glyph "/home/user/Cloud Drive" t)
                             (enhanced-dirvish-icon-glyph 'cloud 'dired-directory))))
            ;; Advised `dirvish-collapse--cache` must short-circuit without `directory-files`.
            (cl-letf (((symbol-function 'directory-files)
                       (lambda (d &rest _)
                         (error "Blocked directory-files on %s" d))))
              (should (equal (dirvish-collapse--cache "/home/user/Cloud Drive")
                             '(nil . nil))))
            ;; Auto-revert and notify must be disabled buffer-locally inside FUSE mounts.
            (with-temp-buffer
              (setq-local dired-auto-revert-buffer t)
              (setq-local auto-revert-use-notify t)
              (let ((default-directory "/home/user/Cloud Drive/"))
                (enhanced-dirvish--sync-auto-revert)
                (should-not dired-auto-revert-buffer)
                (should-not auto-revert-use-notify))
              (let ((default-directory "/home/user/Projects/"))
                (enhanced-dirvish--sync-auto-revert)
                (should (eq dired-auto-revert-buffer (default-value 'dired-auto-revert-buffer)))))))
      (ignore-errors (kill-buffer "*Enhanced Dirvish Sidebar*"))
      (ignore-errors (delete-directory tmp t)))))

