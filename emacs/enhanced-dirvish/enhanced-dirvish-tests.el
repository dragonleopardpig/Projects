         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-closed-tabs nil)
         (enhanced-dirvish-active-tab-index 0)
         (enhanced-dirvish-undo-stack nil)
         (enhanced-dirvish-redo-stack nil)
         (enhanced-dirvish-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory src)
          (make-directory dst)
          (dolist (f (list fa fb fc fd))
            (write-region (concat "content-" (file-name-nondirectory f)) nil f))
          ;; Verify keymap mouse & Shift-arrow bindings exist in both maps.
          (dolist (km (list enhanced-dirvish-default-keymap enhanced-dirvish-10xer-keymap))
            (should (eq (lookup-key km (kbd "<drag-mouse-1>")) #'enhanced-dirvish-mouse-drag-drop))
            (should (eq (lookup-key km (kbd "<C-mouse-1>")) #'enhanced-dirvish-mouse-toggle-select))
            (should (eq (lookup-key km (kbd "<S-mouse-1>")) #'enhanced-dirvish-mouse-range-select))
            (should (eq (lookup-key km (kbd "<mouse-3>")) #'enhanced-dirvish-mouse-context-menu)))
          (should (eq (lookup-key enhanced-dirvish-default-keymap (kbd "S-<down>")) #'enhanced-dirvish-shift-select-next))
          (should (eq (lookup-key enhanced-dirvish-default-keymap (kbd "S-<up>")) #'enhanced-dirvish-shift-select-prev))
          ;; Open src in Pane 1 and dst in Pane 2.
          (enhanced-dirvish-open-location src)
          (enhanced-dirvish-toggle-extra-pane)
          (enhanced-dirvish-open-location dst)
          (let* ((tab (enhanced-dirvish-active-tab))
                 (w1 (enhanced-dirvish-pane-state-window (enhanced-dirvish-tab-state-pane1 tab)))
                 (w2 (enhanced-dirvish-pane-state-window (enhanced-dirvish-tab-state-pane2 tab))))
            (select-window w1)
            (enhanced-dirvish-panes--on-window-selection-change)
            ;; 1. `S-<down>' highlights both starting and next entry in Dired (`enhanced-dirvish-entry-selected').
            (enhanced-dirvish-goto-file fa)
            (enhanced-dirvish-shift-select-next)
            (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                           '("a.txt" "b.txt")))
            (should (>= (length enhanced-dirvish--selection-overlays) 2))
            ;; 2. `C-<mouse-1>' toggles `d.txt' in and out without clearing existing marks.
            (let ((pd (save-excursion (enhanced-dirvish-goto-file fd) (point))))
              (enhanced-dirvish-mouse-toggle-select `(mouse-1 (,w1 ,pd (10 . 10) 0) 1))
              (should (= (length (enhanced-dirvish-marked-files-only)) 3))
              (enhanced-dirvish-mouse-toggle-select `(mouse-1 (,w1 ,pd (10 . 10) 0) 1))
              (should (= (length (enhanced-dirvish-marked-files-only)) 2)))
            ;; 3. Same-pane drag swipe highlights range `b.txt'..`d.txt' cleanly.
            (enhanced-dirvish-clear-all-marks)
            (let ((pb (save-excursion (enhanced-dirvish-goto-file fb) (point)))
                  (pd (save-excursion (enhanced-dirvish-goto-file fd) (point))))
              (enhanced-dirvish-mouse-drag-drop `(drag-mouse-1 (,w1 ,pb (10 . 10) 0) (,w1 ,pd (10 . 40) 0)))
              (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                             '("b.txt" "c.txt" "d.txt")))
              (should (>= (length enhanced-dirvish--selection-overlays) 3))
              ;; 4. Cross-pane drag copies all highlighted files into Pane 2 (`dst').
              (cl-letf (((symbol-function 'read-char-choice) (lambda (&rest _) ?c)))
                (enhanced-dirvish-mouse-drag-drop `(drag-mouse-1 (,w1 ,pb (10 . 10) 0) (,w2 1 (200 . 20) 0))))
              (should (file-exists-p (expand-file-name "b.txt" dst)))
              (should (file-exists-p (expand-file-name "c.txt" dst)))
              (should (file-exists-p (expand-file-name "d.txt" dst)))
              (should (file-exists-p fb)))
            ;; 5. `<S-drag-mouse-1>' moves `b.txt' across panes; `<C-drag-mouse-1>' copies `a.txt'.
            (delete-file (expand-file-name "b.txt" dst))
            (enhanced-dirvish-clear-all-marks)
            (let ((pa (save-excursion (enhanced-dirvish-goto-file fa) (point)))
                  (pb (save-excursion (enhanced-dirvish-goto-file fb) (point))))
              (enhanced-dirvish-mouse-drag-copy `(C-drag-mouse-1 (,w1 ,pa (10 . 10) 0) (,w2 1 (200 . 20) 0)))
              (should (file-exists-p (expand-file-name "a.txt" dst)))
              (should (file-exists-p fa))
              (enhanced-dirvish-mouse-drag-move `(S-drag-mouse-1 (,w1 ,pb (10 . 20) 0) (,w2 1 (200 . 20) 0)))
              (should (file-exists-p (expand-file-name "b.txt" dst)))
              (should-not (file-exists-p fb)))
            ;; 6. Right-click (`enhanced-dirvish-mouse-context-menu`) in Pane 1 while Pane 2 had cursor -> `Copy to Other Pane`.
            (delete-file (expand-file-name "a.txt" dst))
            (delete-file (expand-file-name "c.txt" dst))
            (select-window w1)
            (enhanced-dirvish-clear-all-marks)
            (enhanced-dirvish-goto-file fa)
            (enhanced-dirvish-shift-select-next) ; selects a.txt + c.txt (since b.txt was moved)
            (should (= (length (enhanced-dirvish-marked-files-only)) 2))
            (select-window w2)
            (enhanced-dirvish-panes--on-window-selection-change)
            (let ((pa (with-selected-window w1 (save-excursion (enhanced-dirvish-goto-file fa) (point)))))
              (cl-letf (((symbol-function 'enhanced-dirvish-context-menu) #'enhanced-dirvish-copy-to-other-pane))
                (enhanced-dirvish-mouse-context-menu `(mouse-3 (,w1 ,pa (10 . 10) 0) 1))))
            (should (file-exists-p (expand-file-name "a.txt" dst)))
            (should (file-exists-p (expand-file-name "c.txt" dst)))
            ;; 7. Multi-selection highlighting works in Compact & Icons views too.
            (select-window w1)
            (dolist (m '(compact icons))
              (enhanced-dirvish-switch-view-mode m)
              (enhanced-dirvish-clear-all-marks)
              (enhanced-dirvish-goto-file fa)
              (if (eq m 'icons)
                  (enhanced-dirvish-shift-select-right)
                (enhanced-dirvish-shift-select-next))
              (should (= (length (enhanced-dirvish-marked-files-only)) 2))
              (should (>= (length enhanced-dirvish--selection-overlays) 2)))))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(defun enhanced-dirvish-test--wait-until (pred &optional timeout-secs)
  "Pump Emacs events and timers until PRED returns non-nil or TIMEOUT-SECS elapses."
  (let ((deadline (+ (float-time) (or timeout-secs 2.5))))
    (while (and (not (funcall pred))
                (< (float-time) deadline))
      (read-event nil nil 0.05)
      (accept-process-output nil 0.01))
    (funcall pred)))

(ert-deftest enhanced-dirvish-test-live-watch-compact-icons-and-split-panes ()
  "External filesystem changes live-update Compact, Icons, and Split panes via filenotify."
  (let* ((tmp (make-temp-file "enhanced-dirvish-watch-views-" t))
         (dirA (file-name-as-directory (expand-file-name "dirA" tmp)))
         (dirB (file-name-as-directory (expand-file-name "dirB" tmp)))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-watch-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-thumbnail-dir (expand-file-name "thumbnails" enhanced-dirvish-state-dir))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-preview-standalone-window nil)
         (enhanced-dirvish-sidebar-window nil)
         bufA bufB)
    (make-directory dirA t)
    (make-directory dirB t)
    (write-region "alpha" nil (expand-file-name "alpha.txt" dirA) nil 'silent)
    (write-region "beta" nil (expand-file-name "beta.txt" dirB) nil 'silent)
    (unwind-protect
        (save-window-excursion
          (enhanced-dirvish-setup)
          (delete-other-windows)
          ;; 1. Compact view watches dirA and reacts to external file creation & deletion.
          (setq bufA (get-buffer-create "*Enhanced Dirvish Test Compact*"))
          (switch-to-buffer bufA)
          (enhanced-dirvish-compact-mode)
          (enhanced-dirvish-compact-render dirA)
          (should (assoc (cons 'primary dirA) enhanced-dirvish-watch--entries))
          (call-process "sh" nil nil nil "-c"
                        (format "printf 'gamma\\n' > %s"
                                (shell-quote-argument (expand-file-name "gamma.txt" dirA))))
          (should (enhanced-dirvish-test--wait-until
                   (lambda ()
                     (with-current-buffer bufA
                       (string-match-p "gamma\\.txt" (buffer-string))))))
          ;; 2. Split pane with Icons view in dirB updates simultaneously in second window.
          (let ((w2 (split-window-right)))
            (setq bufB (get-buffer-create "*Enhanced Dirvish Test Icons*"))
            (set-window-buffer w2 bufB)
            (with-selected-window w2
              (enhanced-dirvish-icons-mode)
              (enhanced-dirvish-icons-render dirB)
              (should (assoc (cons 'primary dirB) enhanced-dirvish-watch--entries)))
            (call-process "sh" nil nil nil "-c"
                          (format "printf 'delta\\n' > %s && rm -f %s"
                                  (shell-quote-argument (expand-file-name "delta.txt" dirB))
                                  (shell-quote-argument (expand-file-name "beta.txt" dirB))))
            (should (enhanced-dirvish-test--wait-until
                     (lambda ()
                       (with-current-buffer bufB
                         (let ((s (buffer-string)))
                           (and (string-match-p "delta\\.txt" s)
                                (not (string-match-p "beta\\.txt" s)))))))))
          ;; 3. Killing watched buffers removes descriptors cleanly.
          (let ((watched-descrs
                 (append (with-current-buffer bufA (mapcar #'cdr enhanced-dirvish-watch--entries))
                         (with-current-buffer bufB (mapcar #'cdr enhanced-dirvish-watch--entries)))))
            (kill-buffer bufA)
            (kill-buffer bufB)
            (dolist (d watched-descrs)
              (should-not (gethash d enhanced-dirvish-watch--table)))))
      (dolist (b (list bufA bufB))
        (when (buffer-live-p b) (kill-buffer b)))
      (delete-other-windows)
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-live-watch-parent-subdir-and-preview-cache ()
  "External changes live-update Miller parents, hovered subfolders, and text/thumb caches."
  (let* ((tmp (make-temp-file "enhanced-dirvish-watch-deep-" t))
         (parent (file-name-as-directory (expand-file-name "parent" tmp)))
         (child (file-name-as-directory (expand-file-name "child" parent)))
         (sub (file-name-as-directory (expand-file-name "sub" child)))
         (note (expand-file-name "note.txt" child))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-deep-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-thumbnail-dir (expand-file-name "thumbnails" enhanced-dirvish-state-dir))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-preview-standalone-window nil)
         (enhanced-dirvish-sidebar-window nil)
         cbuf pbuf pwin prev-buf)
    (make-directory sub t)
    (write-region "initial-text" nil note nil 'silent)
    (write-region "inside" nil (expand-file-name "inside.txt" sub) nil 'silent)
    (unwind-protect
        (save-window-excursion
          (enhanced-dirvish-setup)
          (delete-other-windows)
          ;; 1. Miller parent column (`dirvish-directory-view-mode') live-updates & clears dv-parent-hash.
          (let* ((dv (dirvish--new :curr-layout '(1 0.14 0.48)))
                 (str (with-temp-buffer (dired-insert-directory parent "-alh") (buffer-string))))
            (puthash (directory-file-name parent) str (dv-parent-hash dv))
            (setq pbuf (dirvish--special-buffer "parent-1" dv t))
            (with-current-buffer pbuf
              (dirvish-directory-view-mode)
              (dirvish-prop :dv (dv-id dv))
              (let ((inhibit-read-only t)) (erase-buffer) (insert str))
              (setq-local dired-subdir-alist (list (cons (directory-file-name parent) (point-min-marker))))
              (enhanced-dirvish--parent-buffer-filter pbuf)
              (enhanced-dirvish-watch-setup))
            (should (with-current-buffer pbuf
                      (assoc (cons 'parent parent) enhanced-dirvish-watch--entries)))
            (call-process "sh" nil nil nil "-c"
                          (format "touch %s"
                                  (shell-quote-argument (expand-file-name "sibling.txt" parent))))
            (should (enhanced-dirvish-test--wait-until
                     (lambda ()
                       (with-current-buffer pbuf
                         (string-match-p "sibling\\.txt" (buffer-string)))))))
          ;; 2. Hovered subfolder in browser live-updates standalone `*Enhanced Dirvish Preview*` via subdir watch.
          (setq cbuf (get-buffer-create "*Enhanced Dirvish Test Hover*"))
          (switch-to-buffer cbuf)
          (enhanced-dirvish-compact-mode)
          (enhanced-dirvish-compact-render child)
          (setq pwin (split-window-right))
          (setq enhanced-dirvish-preview-standalone-window pwin)
          (enhanced-dirvish-goto-file (directory-file-name sub))
          (enhanced-dirvish-preview-update-standalone (directory-file-name sub) pwin)
          (enhanced-dirvish-watch-sync cbuf)
          (should (assoc (cons 'preview-subdir sub) enhanced-dirvish-watch--entries))
          (call-process "sh" nil nil nil "-c"
                        (format "touch %s"
                                (shell-quote-argument (expand-file-name "nested_new.txt" sub))))
          (should (enhanced-dirvish-test--wait-until
                   (lambda ()
                     (when-let ((sb (get-buffer "*Enhanced Dirvish Preview*")))
                       (with-current-buffer sb
                         (string-match-p "nested_new\\.txt" (buffer-string)))))))
          ;; 3. Overwritten file invalidates stale thumbnail files & `dv-preview-hash',
          ;;    and reloads an active `enhanced-dirvish-preview-read-mode' buffer safely.
          (make-directory enhanced-dirvish-thumbnail-dir t)
          (let* ((stale-thumb (expand-file-name (format "img-%s-100.png" (md5 note))
                                                enhanced-dirvish-thumbnail-dir))
                 (dv2 (dirvish--new :curr-layout '(1 0.14 0.48))))
            (write-region "stale" nil stale-thumb nil 'silent)
            (puthash note "stale-cached-text" (dv-preview-hash dv2))
            (setq prev-buf (generate-new-buffer (format "PREVIEW :: %s :: note.txt" (dv-timestamp dv2))))
            (with-current-buffer prev-buf
              (insert "initial-text")
              (set-buffer-modified-p nil)
              (setq buffer-file-name note
                    enhanced-dirvish-preview--file note)
              (enhanced-dirvish-preview-read-mode 1))
            (set-window-buffer pwin prev-buf)
            (setf (dv-preview-window dv2) pwin
                  (dv-index dv2) (cons child cbuf))
            (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv2))
                      ((symbol-function 'dirvish--preview-update)
                       (lambda (d f)
                         (let ((nb (get-buffer-create
                                    (format "PREVIEW :: %s :: %s"
                                            (dv-timestamp d) (file-name-nondirectory f)))))
                           (with-current-buffer nb
                             (let ((inhibit-read-only t))
                               (erase-buffer)
                               (insert-file-contents f)
                               (setq buffer-file-name f)))
                           (set-window-buffer (dv-preview-window d) nb)))))
              (enhanced-dirvish-goto-file note)
              (enhanced-dirvish-watch-sync cbuf)
              (call-process "sh" nil nil nil "-c"
                            (format "printf 'updated-externally\\n' > %s"
                                    (shell-quote-argument note)))
              (should (enhanced-dirvish-test--wait-until
                       (lambda ()
                         (let ((wb (and (window-live-p pwin) (window-buffer pwin))))
                           (and (buffer-live-p wb)
                                (with-current-buffer wb
                                  (string-match-p "updated-externally" (buffer-string))))))))
              (should-not (file-exists-p stale-thumb))
              (should-not (gethash note (dv-preview-hash dv2)))
              (should (with-current-buffer (window-buffer pwin)
                        enhanced-dirvish-preview-read-mode))))
          ;; 4. Unsafe cloud FUSE directory must still be skipped by watcher setup.
          (cl-letf (((symbol-function 'enhanced-dirvish-path-mount-kind) (lambda (_p) 'cloud)))
            (should-not (enhanced-dirvish-watch--safe-dir-p child))
            (with-temp-buffer
              (setq default-directory child)
              (enhanced-dirvish-watch-setup)
              (should-not enhanced-dirvish-watch--entries))))
      (dolist (b (list cbuf pbuf prev-buf (get-buffer "*Enhanced Dirvish Preview*")))
        (when (buffer-live-p b)
          (with-current-buffer b (set-buffer-modified-p nil))
          (kill-buffer b)))
      (delete-other-windows)
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-live-watch-trash-and-sidebar ()
  "External XDG Trash changes live-update `*Enhanced Dirvish Trash*' and Sidebar Trash counter."
  (let* ((tmp (make-temp-file "enhanced-dirvish-watch-trash-" t))
         (xdg (expand-file-name "xdg" tmp))
         (tfiles (expand-file-name "Trash/files" xdg))
         (tinfo (expand-file-name "Trash/info" xdg))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-trash-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (process-environment (cons (concat "XDG_DATA_HOME=" xdg) process-environment))
         tbuf sbuf)
    (make-directory tfiles t)
    (make-directory tinfo t)
    (unwind-protect
        (progn
          (enhanced-dirvish-watch-install)
          (setq tbuf (enhanced-dirvish-open-trash-buffer))
          (setq sbuf (get-buffer-create "*Enhanced Dirvish Sidebar*"))
          (with-current-buffer sbuf
            (enhanced-dirvish-sidebar-mode)
            (enhanced-dirvish-sidebar-render))
          (should (with-current-buffer tbuf (string-match-p "Trash is empty" (buffer-string))))
          (should (with-current-buffer sbuf (string-match-p "Trash (0)" (buffer-string))))
          (call-process "sh" nil nil nil "-c"
                        (format "printf '[Trash Info]\\nPath=/tmp/gone.txt\\nDeletionDate=2026-11-15T19:00:00\\n' > %s && printf 'bye' > %s"
                                (shell-quote-argument (expand-file-name "gone.txt.trashinfo" tinfo))
                                (shell-quote-argument (expand-file-name "gone.txt" tfiles))))
          (should (enhanced-dirvish-test--wait-until
                   (lambda ()
                     (and (with-current-buffer tbuf
                            (string-match-p "gone\\.txt" (buffer-string)))
                          (with-current-buffer sbuf
                            (string-match-p "Trash (1)" (buffer-string))))))))
      (dolist (b (list tbuf sbuf))
        (when (buffer-live-p b) (kill-buffer b)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(defun enhanced-dirvish-test--play-events (&rest events)
  "Replay synthetic mouse/keyboard EVENTS through Emacs's live command loop."
  (execute-kbd-macro (apply #'vector events)))

(ert-deftest enhanced-dirvish-test-hold-and-drag-live-select-and-reverse-dired ()
  "Live transient-map drag highlights in real time across List/Columns & handles cancel/clicks."
  (let* ((tmp (make-temp-file "enhanced-dirvish-drag-live-" t))
         (dir-a (expand-file-name "subA" tmp))
         (fa (expand-file-name "a.txt" tmp))
         (fb (expand-file-name "b.txt" tmp))
         (fc (expand-file-name "c.txt" tmp))
         (fd (expand-file-name "d.txt" tmp))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-drag-live-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :browser-mode 'list :folders-first t :restore-tabs nil :sidebar-expanded nil))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-closed-tabs nil)
         (enhanced-dirvish-active-tab-index 0)
         (enhanced-dirvish-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory dir-a)
          (dolist (f (list fa fb fc fd))
            (write-region "x" nil f))
          (enhanced-dirvish-open-location tmp)
          (let* ((w (selected-window))
                 (pa (save-excursion (enhanced-dirvish-goto-file fa) (point)))
                 (pb (save-excursion (enhanced-dirvish-goto-file fb) (point)))
                 (pc (save-excursion (enhanced-dirvish-goto-file fc) (point)))
                 (pd (save-excursion (enhanced-dirvish-goto-file fd) (point)))
                 (snapshots nil))
            ;; 1. Live drag via native `set-transient-map' highlights `a..d` then shrinks to `a..b`.
            (enhanced-dirvish-goto-file dir-a)
            (enhanced-dirvish-view--set-entry-mark dir-a t nil)
            (cl-letf (((symbol-function 'enhanced-dirvish-mouse--apply-selection-keys)
                       (let ((orig (symbol-function 'enhanced-dirvish-mouse--apply-selection-keys)))
                         (lambda (order target-keys &optional final-p)
                           (funcall orig order target-keys final-p)
                           (push (list final-p
                                       (length enhanced-dirvish--selection-overlays)
                                       (eq track-mouse 'drag-tracking)
                                       (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only)))
                                 snapshots)))))
              (enhanced-dirvish-test--play-events
               `(down-mouse-1 (,w ,pa (10 . 10) 0) 1)
               `(mouse-movement (,w ,pc (10 . 30) 0))
               `(mouse-movement (,w ,pd (10 . 50) 0))
               `(mouse-movement (,w ,pb (10 . 20) 0))
               `(drag-mouse-1 (,w ,pa (10 . 10) 0) (,w ,pb (10 . 20) 0))))
            (setq snapshots (nreverse snapshots))
            (should (cl-some (lambda (s)
                               (and (not (car s))
                                    (>= (nth 1 s) 4)
                                    (nth 2 s)
                                    (equal (nth 3 s) '("a.txt" "b.txt" "c.txt" "d.txt"))))
                             snapshots))
            (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                           '("a.txt" "b.txt")))
            (should-not track-mouse)
            (should-not enhanced-dirvish-mouse--drag-state)
            (should-not enhanced-dirvish-mouse--finished-drag-state)
            ;; 2. Drag starting in empty space (`point-max`) sweeps upward to `b.txt` -> `b..d`.
            (enhanced-dirvish-clear-all-marks)
            (let ((pmax (point-max)))
              (enhanced-dirvish-test--play-events
               `(down-mouse-1 (,w ,pmax (10 . 80) 0) 1)
               `(mouse-movement (,w ,pd (10 . 60) 0))
               `(mouse-movement (,w ,pb (10 . 20) 0))
               `(drag-mouse-1 (,w ,pmax (10 . 80) 0) (,w ,pb (10 . 20) 0))))
            (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                           '("b.txt" "c.txt" "d.txt")))
            ;; 3. `C-<down-mouse-1>' drag adds `c..d` onto existing `a.txt` mark cleanly.
            (enhanced-dirvish-clear-all-marks)
            (enhanced-dirvish-view--set-entry-mark fa t nil)
            (enhanced-dirvish-test--play-events
             `(C-down-mouse-1 (,w ,pc (10 . 30) 0) 1)
             `(C-mouse-movement (,w ,pd (10 . 50) 0))
             `(C-drag-mouse-1 (,w ,pc (10 . 30) 0) (,w ,pd (10 . 50) 0)))
            (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                           '("a.txt" "c.txt" "d.txt")))
            ;; 4. Right-click (`down-mouse-3` + `mouse-3`) cancels drag, suppresses menu, and ignores button-1 release.
            (let ((menu-opened nil))
              (cl-letf (((symbol-function 'enhanced-dirvish-context-menu) (lambda () (setq menu-opened t))))
                (enhanced-dirvish-test--play-events
                 `(down-mouse-1 (,w ,pa (10 . 10) 0) 1)
                 `(mouse-movement (,w ,pb (10 . 20) 0))
                 `(down-mouse-3 (,w ,pb (10 . 20) 0) 1)
                 `(mouse-3 (,w ,pb (10 . 20) 0) 1)
                 `(drag-mouse-1 (,w ,pa (10 . 10) 0) (,w ,pb (10 . 20) 0))))
              (should-not menu-opened)
              (should-not enhanced-dirvish-mouse--suppress-mouse-3-once)
              (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                             '("a.txt" "c.txt" "d.txt"))))
            ;; 5. Micro-jitter release (<= 6px on same entry) falls back to single-click navigation/preview.
            (enhanced-dirvish-clear-all-marks)
            (enhanced-dirvish-goto-file fa)
            (enhanced-dirvish-test--play-events
             `(down-mouse-1 (,w ,pb (10 . 20) 0) 1)
             `(drag-mouse-1 (,w ,pb (10 . 20) 0) (,w ,pb (11 . 21) 0)))
            (should-not (enhanced-dirvish-marked-files-only))
            (should (equal (enhanced-dirvish--path-key (enhanced-dirvish-current-file)) (enhanced-dirvish--path-key fb)))
            ;; 6. Columns view live drag also handles fringe/margin motion with `nil' buffer point.
            (enhanced-dirvish-switch-view-mode 'columns)
            (enhanced-dirvish-clear-all-marks)
            (let* ((pa-col (save-excursion (enhanced-dirvish-goto-file fa) (point)))
                   ;; Derive an edge row beyond the last file for either GUI
                   ;; font metrics or batch character cells.
                   (edge-y (* (+ 2 (count-lines (window-start w) (point-max)))
                              (frame-char-height (window-frame w))))
                   (fringe-posn (list w 'left-fringe (cons 2 edge-y) 0 nil nil nil nil nil)))
              (enhanced-dirvish-test--play-events
               `(down-mouse-1 (,w ,pa-col (10 . 10) 0) 1)
               `(left-fringe mouse-movement ,fringe-posn)
               `(drag-mouse-1 (,w ,pa-col (10 . 10) 0) ,fringe-posn)))
            (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                           '("a.txt" "b.txt" "c.txt" "d.txt")))
            (should (>= (length enhanced-dirvish--selection-overlays) 4))))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-hold-and-drag-icons-grid-blank-gaps-and-cross-pane ()
  "Icons/Compact modes share drag-select bindings, handle blank gaps & 2D grid, and drag marked batches across panes."
  (let* ((tmp (make-temp-file "enhanced-dirvish-drag-grid-" t))
         (src (expand-file-name "src" tmp))
         (dst (expand-file-name "dst" tmp))
         (files (cl-loop for i from 1 to 6
                         collect (expand-file-name (format "f%d.txt" i) src)))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-drag-grid-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :browser-mode 'icons :folders-first t :restore-tabs nil :sidebar-expanded nil :show-thumbnails nil))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-closed-tabs nil)
         (enhanced-dirvish-active-tab-index 0)
         (enhanced-dirvish-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory src)
          (make-directory dst)
          (dolist (f files)
            (write-region "x" nil f))
          (dolist (km (list enhanced-dirvish-compact-mode-map enhanced-dirvish-icons-mode-map))
            (should (eq (lookup-key km (kbd "<down-mouse-1>")) #'enhanced-dirvish-mouse-down-entry))
            (should (eq (lookup-key km (kbd "<drag-mouse-1>")) #'enhanced-dirvish-mouse-drag-drop)))
          (enhanced-dirvish-open-location src)
          (enhanced-dirvish-toggle-extra-pane)
          (enhanced-dirvish-open-location dst)
          (let* ((tab (enhanced-dirvish-active-tab))
                 (w1 (enhanced-dirvish-pane-state-window (enhanced-dirvish-tab-state-pane1 tab)))
                 (w2 (enhanced-dirvish-pane-state-window (enhanced-dirvish-tab-state-pane2 tab))))
            (select-window w1)
            (enhanced-dirvish-panes--on-window-selection-change)
            (enhanced-dirvish-switch-view-mode 'icons)
            ;; Force 3-column grid geometry: row 0 = (f1 f2 f3), row 1 = (f4 f5 f6).
            (setq enhanced-dirvish-icons--ncols 3)
            (let* ((p5 (save-excursion (enhanced-dirvish-goto-file (nth 4 files)) (point)))
                   ;; Blank spacer position immediately left of tile 1 (`enhanced-dirvish-entry' is nil there).
                   (p1-blank (max (point-min) (line-beginning-position))))
              ;; 1. Drag from blank gap before `f1' to `f5' selects 2x2 grid rectangle `{f1 f2 f4 f5}' (excludes `f3').
              (enhanced-dirvish-test--play-events
               `(down-mouse-1 (,w1 ,p1-blank (2 . 10) 0) 1)
               `(mouse-movement (,w1 ,p5 (80 . 60) 0))
               `(drag-mouse-1 (,w1 ,p1-blank (2 . 10) 0) (,w1 ,p5 (80 . 60) 0)))
              (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                             '("f1.txt" "f2.txt" "f4.txt" "f5.txt")))
              (should (>= (length enhanced-dirvish--selection-overlays) 4))
              ;; 2. Holding down on already-marked `f1' and dragging across to Pane 2 copies all 4 items.
              (let ((p1-lbl (save-excursion (enhanced-dirvish-goto-file (nth 0 files)) (point))))
                (cl-letf (((symbol-function 'read-char-choice) (lambda (&rest _) ?c)))
                  (enhanced-dirvish-test--play-events
                   `(down-mouse-1 (,w1 ,p1-lbl (10 . 10) 0) 1)
                   `(mouse-movement (,w2 1 (200 . 20) 0))
                   `(drag-mouse-1 (,w1 ,p1-lbl (10 . 10) 0) (,w2 1 (200 . 20) 0)))))
              (dolist (name '("f1.txt" "f2.txt" "f4.txt" "f5.txt"))
                (should (file-exists-p (expand-file-name name dst))))
              (should-not (file-exists-p (expand-file-name "f3.txt" dst))))
            ;; 3. Compact mode drag starting on trailing cell padding of `f2' to `f4' selects `{f2 f3 f4}'.
            (enhanced-dirvish-switch-view-mode 'compact)
            (enhanced-dirvish-clear-all-marks)
            (let* ((p2 (save-excursion (enhanced-dirvish-goto-file (nth 1 files)) (point)))
                   (p2-pad (save-excursion (goto-char p2) (line-end-position)))
                   (p4 (save-excursion (enhanced-dirvish-goto-file (nth 3 files)) (point))))
              (enhanced-dirvish-test--play-events
               `(down-mouse-1 (,w1 ,p2-pad (180 . 20) 0) 1)
               `(mouse-movement (,w1 ,p4 (10 . 40) 0))
               `(drag-mouse-1 (,w1 ,p2-pad (180 . 20) 0) (,w1 ,p4 (10 . 40) 0)))
              (should (equal (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only))
                             '("f2.txt" "f3.txt" "f4.txt")))
              (should (>= (length enhanced-dirvish--selection-overlays) 3)))))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(defmacro enhanced-dirvish-test--with-selection-view (view &rest body)
  "Run BODY in directory VIEW with six files and isolated state."
  (declare (indent 1) (debug t))
  `(let* ((enhanced-dirvish-test--root (make-temp-file "enhanced-dirvish-selection-" t))
          (enhanced-dirvish-test--dir (expand-file-name "files" enhanced-dirvish-test--root))
          (enhanced-dirvish-test--files (mapcar (lambda (name) (expand-file-name name enhanced-dirvish-test--dir))
                                     '("a.txt" "b.txt" "c.txt" "d.txt" "e.txt" "f.txt")))
          (enhanced-dirvish-state-dir (expand-file-name "state" enhanced-dirvish-test--root))
          (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
          (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
          (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
          (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :browser-mode ,view :folders-first t
                                                     :restore-tabs nil :show-thumbnails nil))
          (enhanced-dirvish-mouse--drag-state nil) (enhanced-dirvish-mouse--finished-drag-state nil)
          (enhanced-dirvish-workspace-tabs nil) (track-mouse nil)
          enhanced-dirvish-test--buf)
     (unwind-protect
         (save-window-excursion
           (delete-other-windows)
           (make-directory enhanced-dirvish-test--dir)
           (dolist (file enhanced-dirvish-test--files) (write-region "test" nil file nil 'silent))
           (setq enhanced-dirvish-test--buf
                 (if (memq ,view '(list columns))
                     (dired-noselect enhanced-dirvish-test--dir)
                   (generate-new-buffer "*Enhanced Dirvish Selection Test*")))
           (switch-to-buffer enhanced-dirvish-test--buf)
           (pcase ,view
             ('compact (enhanced-dirvish-compact-mode) (enhanced-dirvish-compact-render enhanced-dirvish-test--dir))
             ('icons (enhanced-dirvish-icons-mode) (enhanced-dirvish-icons-render enhanced-dirvish-test--dir)))
           (enhanced-dirvish-mode 1)
           (enhanced-dirvish-goto-file (car enhanced-dirvish-test--files))
           (cl-letf (((symbol-function 'enhanced-dirvish-view--sync-preview-on-move)
                      #'enhanced-dirvish-view--update-selection-highlight))
             ,@body))
       (when enhanced-dirvish-mouse--drag-state (enhanced-dirvish-mouse--drag-cancel nil))
       (when enhanced-dirvish-mouse--finished-drag-state
         (enhanced-dirvish-mouse--stop-timer-field enhanced-dirvish-mouse--finished-drag-state :cleanup-timer))
       (when (buffer-live-p enhanced-dirvish-test--buf) (kill-buffer enhanced-dirvish-test--buf))
       (ignore-errors (delete-directory enhanced-dirvish-test--root t)))))

(defun enhanced-dirvish-test--selection-names ()
  "Return marked basenames in directory order."
  (sort (mapcar #'file-name-nondirectory (enhanced-dirvish-marked-files-only)) #'string<))

(defun enhanced-dirvish-test--selection-event (kind path &optional y)
  "Make mouse event KIND on PATH at pixel row Y."
  (list kind (list (selected-window)
                   (save-excursion (enhanced-dirvish-goto-file path) (point))
                   (cons 10 (or y 10)) 0) 1))

(ert-deftest enhanced-dirvish-test-selection-all-invert-toggle-and-clear ()
  "Every entry is marked, and one-file toggles/unmarks stay at point in all views."
  (dolist (view '(list columns compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (let ((first (car enhanced-dirvish-test--files)))
        (call-interactively (key-binding (kbd "C-a")))
        (should (equal (enhanced-dirvish-test--selection-names)
                       '("a.txt" "b.txt" "c.txt" "d.txt" "e.txt" "f.txt")))
        (should (equal (enhanced-dirvish-current-file) first))
        (call-interactively (key-binding (kbd "C-S-i")))
        (should-not (enhanced-dirvish-marked-files-only))
        (dolist (key '("C-SPC" "m"))
          (call-interactively (key-binding (kbd key)))
          (should (equal (enhanced-dirvish-test--selection-names) '("a.txt")))
          (should (equal (enhanced-dirvish-current-file) first))
          (call-interactively (key-binding (kbd key)))
          (should-not (enhanced-dirvish-marked-files-only)))
        (dolist (key '("u" "U" "C-S-a" "<escape>"))
          (enhanced-dirvish-view--set-entry-mark first t)
          (call-interactively (key-binding (kbd key)))
          (should-not (enhanced-dirvish-marked-files-only))
          (should (equal (enhanced-dirvish-selected-files) (list first))))))))

(ert-deftest enhanced-dirvish-test-selection-visual-range-includes-endpoints ()
  "10xer v marks forward/reverse ranges without skipping or overshooting."
  (dolist (view '(list columns compact icons))
    (enhanced-dirvish-test--with-selection-view view
