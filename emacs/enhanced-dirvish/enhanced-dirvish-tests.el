(ert-deftest enhanced-dirvish-test-spc-preview-and-ret-direct-edit ()
  (should (eq (lookup-key enhanced-dirvish-default-keymap (kbd "SPC")) #'enhanced-dirvish-preview-at-point))
  (should (eq (lookup-key enhanced-dirvish-default-keymap (kbd "RET")) #'enhanced-dirvish-open-or-edit-at-point))
  (should (eq (lookup-key enhanced-dirvish-compact-mode-map (kbd "SPC")) #'enhanced-dirvish-preview-at-point))
  (should (eq (lookup-key enhanced-dirvish-compact-mode-map (kbd "RET")) #'enhanced-dirvish-open-or-edit-at-point))
  (should (eq (lookup-key enhanced-dirvish-icons-mode-map (kbd "SPC")) #'enhanced-dirvish-preview-at-point))
  (should (eq (lookup-key enhanced-dirvish-icons-mode-map (kbd "RET")) #'enhanced-dirvish-open-or-edit-at-point))
  (let* ((tmp (make-temp-file "enhanced-dirvish-edit-" t))
         (subdir (expand-file-name "sub" tmp))
         (fpath (expand-file-name "sample.txt" tmp))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-state-" t))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-closed-tabs nil)
         (enhanced-dirvish-active-tab-index 0)
         (enhanced-dirvish-visited-folders nil)
         (enhanced-dirvish-folder-view-lru nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory subdir t)
          (with-temp-file fpath
            (insert "hello enhanced-dirvish"))
          (let* ((left-win (selected-window))
                 (right-win (split-window-right))
                 (dv (dirvish--new :curr-layout '(1 0.14 0.48)))
                 (enhanced-dirvish-preview-standalone-window right-win)
                 (before-wins (window-list nil nil left-win))
                 (before-edges (mapcar #'window-edges (window-list nil nil left-win)))
                 (opened-dir nil))
            (unwind-protect
                (with-current-buffer (get-buffer-create " *enhanced-dirvish-test-browser*")
                  (let ((inhibit-read-only t))
                    (erase-buffer)
                    (enhanced-dirvish-compact-mode)
                    (insert (propertize "  sub/\n" 'enhanced-dirvish-entry (file-name-as-directory subdir)))
                    (insert (propertize "  sample.txt\n" 'enhanced-dirvish-entry fpath)))
                  (set-window-buffer left-win (current-buffer))
                  (select-window left-win)
                  ;; 1. SPC previews without closing preview pane or altering layout.
                  (goto-char (point-min))
                  (forward-line 1)
                  (enhanced-dirvish-preview-at-point)
                  (should (window-live-p right-win))
                  (should (eq (selected-window) left-win))
                  (should (equal (window-list nil nil left-win) before-wins))
                  (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                  (should (string-match-p "hello enhanced-dirvish"
                                          (with-current-buffer (window-buffer right-win)
                                            (buffer-string))))
                  ;; Pressing SPC again keeps preview pane open (does not close it).
                  (enhanced-dirvish-preview-at-point)
                  (should (window-live-p right-win))
                  (should (equal (window-list nil nil left-win) before-wins))
                  ;; 2. RET replaces any Dirvish throwaway `PREVIEW :: ...' buffer with real writable buffer (ZERO layout change).
                  (let ((fake-preview (generate-new-buffer "PREVIEW :: 00:00 :: sample.txt")))
                    (with-current-buffer fake-preview
                      (insert "TRUNCATED PREVIEW")
                      (setq buffer-file-name fpath)
                      (set-buffer-modified-p nil)
                      (setq buffer-read-only t))
                    (cl-pushnew fake-preview (dv-preview-buffers dv))
                    (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv)))
                      (setf (dv-preview-window dv) right-win)
                      (enhanced-dirvish-open-or-edit-at-point)
                      (should-not (buffer-live-p fake-preview))
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                      (should (eq (selected-window) right-win))
                      (let ((real-buf (window-buffer right-win)))
                        (should-not (string-prefix-p "PREVIEW :: " (buffer-name real-buf)))
                        (should-not (memq real-buf (dv-preview-buffers dv)))
                        (with-current-buffer real-buf
                          (should (equal (file-truename buffer-file-name)
                                         (file-truename fpath)))
                          (should-not buffer-read-only)
                          (should enhanced-dirvish-preview-edit-mode)
                          (should (eq (key-binding (kbd "C-<left>")) #'enhanced-dirvish-preview-edit-leave))
                          (should (eq (key-binding (kbd "C-c C-c")) #'enhanced-dirvish-preview-edit-exit))
                          (should (eq (key-binding (kbd "C-<escape>")) #'enhanced-dirvish-preview-edit-exit))
                          (should (eq (key-binding (kbd "C-c C-k")) #'enhanced-dirvish-preview-edit-abort))
                          ;; Edit buffer, seed stale preview hash, cancel save-prompt with quit -> stays in edit mode.
                          (puthash fpath "STALE PREVIEW" (dv-preview-hash dv))
                          (goto-char (point-max))
                          (insert " + saved"))
                        (select-window right-win)
                        (condition-case nil
                            (cl-letf (((symbol-function 'map-y-or-n-p)
                                       (lambda (&rest _) (signal 'quit nil))))
                              (enhanced-dirvish-preview-edit-leave))
                          (quit nil))
                        (with-current-buffer real-buf
                          (should enhanced-dirvish-preview-edit-mode))
                        (should (eq (selected-window) right-win))
                        ;; Now confirm save in `C-<left>' (`save-some-buffers') -> saves, clears stale cache, returns left.
                        (select-window right-win)
                        (cl-letf (((symbol-function 'map-y-or-n-p)
                                   (lambda (_prompter actor list &rest _)
                                     (funcall actor (car list))
                                     1)))
                          (enhanced-dirvish-preview-edit-leave))
                        (with-current-buffer real-buf
                          (should-not (buffer-modified-p real-buf))
                          (should-not enhanced-dirvish-preview-edit-mode))
                        (should (eq (selected-window) left-win))
                        (should (equal (window-list nil nil left-win) before-wins))
                        (should (string-match-p "hello enhanced-dirvish \\+ saved"
                                                (with-current-buffer (window-buffer right-win)
                                                  (buffer-string))))
                        ;; Abort (`C-c k`) still reverts dirty edits back to saved file contents.
                        (set-buffer (window-buffer left-win))
                        (enhanced-dirvish-open-or-edit-at-point)
                        (with-current-buffer (window-buffer right-win)
                          (goto-char (point-max))
                          (insert " + discard-me"))
                        (select-window right-win)
                        (cl-letf (((symbol-function 'y-or-n-p) (lambda (_prompt) t)))
                          (enhanced-dirvish-preview-edit-abort))
                        (should (eq (selected-window) left-win))
                        (with-current-buffer real-buf
                          (should-not (buffer-modified-p))
                          (should-not enhanced-dirvish-preview-edit-mode)
                          (should (string= (string-trim-right (buffer-string))
                                           "hello enhanced-dirvish + saved"))))))
                  ;; 3. RET on a directory opens it in the browser pane.
                  (select-window left-win)
                  (set-buffer (window-buffer left-win))
                  (goto-char (point-min))
                  (cl-letf (((symbol-function 'enhanced-dirvish-open-location)
                             (lambda (loc &optional _hist) (setq opened-dir loc))))
                    (enhanced-dirvish-open-or-edit-at-point)
                    (should (string= (directory-file-name opened-dir)
                                     (directory-file-name subdir))))
                  ;; 4. Right arrow / `enhanced-dirvish-tree-expand-or-open' on a file enters preview in read-only mode,
                  ;;    and `C-<left>' (`enhanced-dirvish-preview-read-leave') returns focus to the left browser pane.
                  (should (eq (lookup-key enhanced-dirvish-default-keymap (kbd "<right>")) #'enhanced-dirvish-tree-expand-or-open))
                  (should (eq (lookup-key enhanced-dirvish-10xer-keymap (kbd "l")) #'enhanced-dirvish-tree-expand-or-open))
                  (should (eq (lookup-key enhanced-dirvish-preview-read-mode-map (kbd "C-<left>")) #'enhanced-dirvish-preview-read-leave))
                  (should (eq (lookup-key enhanced-dirvish-preview-read-mode-map (kbd "SPC")) #'enhanced-dirvish-preview-read-scroll-down))
                  (should (eq (lookup-key enhanced-dirvish-preview-read-mode-map (kbd "DEL")) #'enhanced-dirvish-preview-read-scroll-up))
                  (should (eq (lookup-key enhanced-dirvish-preview-read-mode-map (kbd "q")) #'enhanced-dirvish-preview-read-leave))
                  (select-window left-win)
                  (set-buffer (window-buffer left-win))
                  (goto-char (point-min))
                  (forward-line 1)
                  (let ((visited (find-buffer-visiting fpath)))
                    (cl-letf (((symbol-function 'dirvish-curr) (lambda () dv))
                              ((symbol-function 'enhanced-dirvish--flatten-layout)
                               (lambda () (error "Must not flatten Dirvish layout")))
                              ((symbol-function 'dired-find-file)
                               (lambda () (error "Must not collapse Dirvish via dired-find-file"))))
                      (setf (dv-preview-window dv) right-win)
                      (enhanced-dirvish-preview--capture-browser-context left-win)
                      (enhanced-dirvish-tree-expand-or-open)
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (equal (mapcar #'window-edges (window-list nil nil left-win)) before-edges))
                      (should (eq (selected-window) right-win))
                      (with-current-buffer (window-buffer right-win)
                        (should enhanced-dirvish-preview-read-mode)
                        (should buffer-read-only)
                        (should-not enhanced-dirvish-preview-edit-mode))
                      (with-current-buffer visited
                        (should-not enhanced-dirvish-preview-edit-mode))
                      (enhanced-dirvish-preview-read-leave)
                      (should (eq (selected-window) left-win))
                      ;; 4b. Clicking into the preview pane enables read-only mode & blocks background resets.
                      (enhanced-dirvish-preview--on-window-selection-change)
                      (select-window right-win)
                      (enhanced-dirvish-preview--on-window-selection-change)
                      (with-current-buffer (window-buffer right-win)
                        (should enhanced-dirvish-preview-read-mode)
                        (should buffer-read-only)
                        (should-not enhanced-dirvish-preview-edit-mode))
                      (let ((orig-pbuf (window-buffer right-win)))
                        (with-current-buffer orig-pbuf
                          (goto-char (point-max)))
                        (dirvish--preview-update dv fpath)
                        (should (eq (selected-window) right-win))
                        (should (eq (window-buffer right-win) orig-pbuf))
                        (with-current-buffer orig-pbuf
                          (should (= (point) (point-max)))))
                      (enhanced-dirvish-preview-read-leave)
                      (should (eq (selected-window) left-win))
                      ;; 5. Mouse activation (double-click) or RET opens direct-edit without collapsing layout.
                      (enhanced-dirvish-mouse--open-path fpath nil)
                      (should (equal (window-list nil nil left-win) before-wins))
                      (should (eq (selected-window) right-win))
                      (should (eq (window-buffer right-win) visited))
                      (with-current-buffer visited
                        (should enhanced-dirvish-preview-edit-mode)
                        (should-not enhanced-dirvish-preview-read-mode)
                        (should-not buffer-read-only))
                      (select-window right-win)
                      (enhanced-dirvish-preview-edit-exit)
                      (should (eq (selected-window) left-win)))))
              (when-let ((b (find-buffer-visiting fpath)))
                (with-current-buffer b (set-buffer-modified-p nil))
                (kill-buffer b))
              (remhash (dv-id dv) dirvish--sessions))))
      (delete-directory tmp t)
      (delete-directory enhanced-dirvish-state-dir t))))

(ert-deftest enhanced-dirvish-test-preview-read-mode-click-scroll-and-leave ()
  "Right-arrow and clicking preview enter read-only mode, allow scrolling, and C-<left>/C-x k restore browser."
  (let* ((tmp (make-temp-file "enhanced-dirvish-ro-preview-" t))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-ro-state-" t))
         (fpath (expand-file-name "long.txt" tmp))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :folders-first t))
         (enhanced-dirvish-preview-standalone-window nil)
         (enhanced-dirvish-preview--last-browser-context nil)
         (dired-buf nil)
         (pbuf-preview nil))
    (unwind-protect
        (save-window-excursion
          (with-temp-file fpath
            (dotimes (i 120)
              (insert (format "line-%03d of sample preview document\n" (1+ i)))))
          (delete-other-windows)
          (setq dired-buf (dired-noselect tmp))
          (let* ((left-win (selected-window))
                 (right-win (split-window-right)))
            (setq enhanced-dirvish-preview-standalone-window right-win)
            (set-window-buffer left-win dired-buf)
            (select-window left-win)
            (goto-char (point-min))
            (re-search-forward "long\\.txt")
            (goto-char (match-beginning 0))
            (cl-letf (((symbol-function 'dirvish-curr) (lambda () nil)))
              ;; 1. `<right>' enters standalone preview in read-only mode & supports keyboard scrolling.
              (enhanced-dirvish-tree-expand-or-open)
              (should (eq (selected-window) right-win))
              (let ((sbuf (get-buffer "*Enhanced Dirvish Preview*")))
                (should (buffer-live-p sbuf))
                (should (eq (window-buffer right-win) sbuf))
                (with-current-buffer sbuf
                  (should enhanced-dirvish-preview-read-mode)
                  (should buffer-read-only)
                  (should cursor-type)
                  (should-not enhanced-dirvish-preview-edit-mode)
                  (goto-char (point-min))
                  (enhanced-dirvish-preview-read-scroll-down)
                  (enhanced-dirvish-preview-read-scroll-down)
                  (let ((scrolled-pos (point))
                        (scrolled-ws (window-start right-win)))
                    (should (> scrolled-pos 1))
                    (should (> scrolled-ws 1))
                    ;; Background move-sync must not overwrite or reset scroll while preview is selected.
                    (with-current-buffer dired-buf
                      (enhanced-dirvish-view--sync-preview-on-move))
                    (should (= (point) scrolled-pos))
                    (should (= (window-start right-win) scrolled-ws))
                    ;; `C-<left>' returns focus to left browser without losing scroll position.
                    (enhanced-dirvish-preview-read-leave)
                    (should (eq (selected-window) left-win))
                    (should (= (with-current-buffer sbuf (point)) scrolled-pos))
                    ;; Clicking preview again re-attaches read-only mode & scrolls back up.
                    (enhanced-dirvish-preview--on-window-selection-change)
                    (select-window right-win)
                    (enhanced-dirvish-preview--on-window-selection-change)
                    (should enhanced-dirvish-preview-read-mode)
                    (should buffer-read-only)
                    (enhanced-dirvish-preview-read-scroll-up)
                    (should (< (window-start right-win) scrolled-ws))
                    (enhanced-dirvish-preview-read-leave)
                    (should (eq (selected-window) left-win)))))
              ;; 2. Pressing RET after read-only preview unlocks into writable edit mode cleanly.
              (set-buffer (window-buffer (selected-window)))
              (enhanced-dirvish-open-or-edit-at-point)
              (let ((visited (find-buffer-visiting fpath)))
                (should (buffer-live-p visited))
                (should (eq (selected-window) right-win))
                (should (eq (window-buffer right-win) visited))
                (with-current-buffer visited
                  (should enhanced-dirvish-preview-edit-mode)
                  (should-not enhanced-dirvish-preview-read-mode)
                  (should-not buffer-read-only))
                (enhanced-dirvish-preview-edit-exit)
                (should (eq (selected-window) left-win)))
              ;; 3. Clicking a Dirvish `PREVIEW ::' buffer attaches read-only mode; maximizing + C-<left>/C-x k restores browser.
              (setq pbuf-preview (get-buffer-create "PREVIEW :: long.txt"))
              (with-current-buffer pbuf-preview
                (insert-file-contents fpath nil nil nil t)
                (setq-local buffer-read-only t)
                (setq-local enhanced-dirvish-active-preview-file fpath))
              (set-window-buffer right-win pbuf-preview)
              (enhanced-dirvish-preview--on-window-selection-change)
              (select-window right-win)
              (enhanced-dirvish-preview--on-window-selection-change)
              (with-current-buffer pbuf-preview
                (should enhanced-dirvish-preview-read-mode)
                (should buffer-read-only))
              (delete-other-windows right-win)
              (should (one-window-p t))
              (enhanced-dirvish-preview-read-leave)
              (should (eq (window-buffer (selected-window)) dired-buf))
              (let ((rw (or (window-in-direction 'right (selected-window))
                            (split-window-right))))
                (set-window-buffer rw pbuf-preview)
                (enhanced-dirvish-preview--on-window-selection-change)
                (select-window rw)
                (enhanced-dirvish-preview--on-window-selection-change)
                (delete-other-windows rw)
                (should (one-window-p t))
                (kill-buffer pbuf-preview)
                (should (eq (window-buffer (selected-window)) dired-buf))))))
      (when (buffer-live-p pbuf-preview)
        (kill-buffer pbuf-preview))
      (when-let ((sb (get-buffer "*Enhanced Dirvish Preview*")))
        (kill-buffer sb))
      (when-let ((fb (find-buffer-visiting fpath)))
        (kill-buffer fb))
      (when (buffer-live-p dired-buf)
        (kill-buffer dired-buf))
      (delete-directory tmp t)
      (delete-directory enhanced-dirvish-state-dir t))))

(ert-deftest enhanced-dirvish-test-icons-no-wrap-grid-nav-and-wrapping ()
  "Icons & Compact suppress `global-visual-line-mode', wrap long names, and navigate 2D cards."
  (let* ((tmp (make-temp-file "enhanced-dirvish-icons-" t))
         (orig-gvl global-visual-line-mode)
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :icons-thumbnail-size 64 :folders-first t)))
    (unwind-protect
        (progn
          ;; Create 6 entries -> with batch window width 80 and stride 20, ncols = 4 (2 rows).
          (make-directory (expand-file-name "01-dir" tmp))
          (dolist (nm '("02-alpha.txt" "03-beta.txt" "04-gamma.txt"
                        "05-delta.txt" "06-very-long-filename-archive-2026.txt"))
            (write-region "x" nil (expand-file-name nm tmp)))
          ;; Enable global-visual-line-mode to replicate init.el behavior.
          (global-visual-line-mode 1)
          (dolist (mode '(compact icons))
            (with-temp-buffer
              (if (eq mode 'compact) (enhanced-dirvish-compact-mode) (enhanced-dirvish-icons-mode))
              (should-not visual-line-mode)
              (should truncate-lines)
              (should-not word-wrap)))
          ;; Verify clean 1-or-2-line name wrapping helper.
          (should (equal (enhanced-dirvish-icons--wrap-name "Desktop" 16) '("Desktop")))
          (let ((wrapped (enhanced-dirvish-icons--wrap-name "my_very_long_project_archive.tar.gz" 16)))
            (should (= (length wrapped) 2))
            (should (<= (string-width (car wrapped)) 16))
            (should (<= (string-width (cadr wrapped)) 16)))
          ;; Render Icons grid cleanly and verify 2D navigation & label cursor placement.
          (with-temp-buffer
            (let ((w (selected-window)))
              (set-window-buffer w (current-buffer))
              (enhanced-dirvish-icons-mode)
              (setq enhanced-dirvish-view-directory (file-name-as-directory tmp))
              (enhanced-dirvish-icons-render)
              (should-not visual-line-mode)
              (should truncate-lines)
              (should (> enhanced-dirvish-icons--ncols 1))
              (should (= enhanced-dirvish-icons--count 6))
              ;; Point starts cleanly on card 0 label (NOT on the icon span).
              (should (= (get-text-property (point) 'enhanced-dirvish-grid-idx) 0))
              (should (get-text-property (point) 'enhanced-dirvish-grid-label))
              ;; Right / `enhanced-dirvish-tree-expand-or-open' steps right one card.
              (enhanced-dirvish-tree-expand-or-open)
              (should (= (get-text-property (point) 'enhanced-dirvish-grid-idx) 1))
              (should (get-text-property (point) 'enhanced-dirvish-grid-label))
              ;; Down / `enhanced-dirvish-nav-next-line' steps down one grid row cleanly.
              (let ((expected-row-idx (min (1- enhanced-dirvish-icons--count) (+ 1 enhanced-dirvish-icons--ncols))))
                (enhanced-dirvish-nav-next-line)
                (should (= (get-text-property (point) 'enhanced-dirvish-grid-idx) expected-row-idx))
                (should (get-text-property (point) 'enhanced-dirvish-grid-label))
                ;; Up / `enhanced-dirvish-nav-prev-line' returns to card 1 when ncols < 6.
                (when (< enhanced-dirvish-icons--ncols 6)
                  (enhanced-dirvish-nav-prev-line)
                  (should (= (get-text-property (point) 'enhanced-dirvish-grid-idx) 1))))
              ;; Left / `enhanced-dirvish-tree-collapse-or-up' steps back to card 0.
              (enhanced-dirvish-goto-file (expand-file-name "02-alpha.txt" tmp))
              (should (= (get-text-property (point) 'enhanced-dirvish-grid-idx) 1))
              (enhanced-dirvish-tree-collapse-or-up)
              (should (= (get-text-property (point) 'enhanced-dirvish-grid-idx) 0))
              ;; Footer hints must not mention removed F1 binding.
              (should-not (string-search "F1" (dirvish-enhanced-dirvish-footer-ml))))))
      (global-visual-line-mode (if orig-gvl 1 -1))
      (delete-directory tmp t))))

(ert-deftest enhanced-dirvish-test-selection-highlight-all-views ()
  "Navigating Up/Down highlights the full file/dir name across Dired, Compact, and Icons."
  (let* ((tmp (make-temp-file "enhanced-dirvish-sel-" t))
         (d1 (expand-file-name "01-folder" tmp))
         (f1 (expand-file-name "02-document-example.txt" tmp))
         (f2 (expand-file-name "03-another-long-file-name-wrap.txt" tmp))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :folders-first t)))
    (unwind-protect
        (progn
          (make-directory d1 t)
          (write-region "a" nil f1)
          (write-region "b" nil f2)
          ;; 1. Dired (Columns / List): hl-line off, full filename highlighted cleanly.
          (let ((dbuf (dired-noselect tmp)))
            (unwind-protect
                (with-current-buffer dbuf
                  (enhanced-dirvish--enable-in-browser)
                  (should-not hl-line-mode)
                  (dired-goto-file d1)
                  (enhanced-dirvish-view--update-selection-highlight)
                  (should (= (length enhanced-dirvish--selection-overlays) 1))
                  (let ((ov (car enhanced-dirvish--selection-overlays)))
                    (should (eq (overlay-get ov 'face) 'enhanced-dirvish-entry-selected))
                    (should (string= (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))
                                     "01-folder"))
                    (should (= (point) (overlay-start ov))))
                  (enhanced-dirvish-nav-next-line)
                  (enhanced-dirvish-view--update-selection-highlight)
                  (let ((ov (car enhanced-dirvish--selection-overlays)))
                    (should (string= (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))
                                     "02-document-example.txt"))
                    (should (= (point) (overlay-start ov)))))
              (when (buffer-live-p dbuf) (kill-buffer dbuf))))
          ;; 2. Compact view: full shown filename highlighted cleanly with cursor at name start.
          (with-temp-buffer
            (enhanced-dirvish-compact-mode)
            (enhanced-dirvish-compact-render tmp)
            (enhanced-dirvish-goto-file d1)
            (should (= (length enhanced-dirvish--selection-overlays) 1))
            (let ((ov (car enhanced-dirvish--selection-overlays)))
              (should (eq (overlay-get ov 'face) 'enhanced-dirvish-entry-selected))
              (should (string= (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))
                               "01-folder"))
              (should (= (point) (overlay-start ov))))
            (enhanced-dirvish-compact-next-item)
            (let ((ov (car enhanced-dirvish--selection-overlays)))
              (should (string-prefix-p "02-document"
                                       (buffer-substring-no-properties (overlay-start ov) (overlay-end ov))))
              (should (= (point) (overlay-start ov)))))
          ;; 3. Icons view: 1-line and 2-line wrapped filenames highlight cleanly across spans.
          (with-temp-buffer
            (let ((w (selected-window)))
              (set-window-buffer w (current-buffer))
              (enhanced-dirvish-icons-mode)
