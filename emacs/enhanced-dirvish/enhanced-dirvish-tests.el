                  (label . "M90APROGEN6 Windows 18/9/2025")
                  (partlabel . "Basic data partition")
                  (parttype . "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7")
                  (uuid . "51f5ab80-3c35-46a6-8b5b-c0a44d5a73ad") (size . 253672554496))
