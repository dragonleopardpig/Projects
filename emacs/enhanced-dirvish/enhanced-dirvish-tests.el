             (buffer (generate-new-buffer " *Enhanced Dirvish Mouse History*"))
             (pane1 (make-enhanced-dirvish-pane-state :id 1 :dir "left" :window left :buffer enhanced-dirvish-test--buf))
             (pane2 (make-enhanced-dirvish-pane-state :id 2 :dir "third" :window right :buffer buffer
                                            :history-back '("second" "first")))
             (tab (make-enhanced-dirvish-tab-state :split-p t :pane1 pane1 :pane2 pane2))
             (enhanced-dirvish-workspace-tabs (list tab)) (enhanced-dirvish-active-tab-index 0))
        (unwind-protect
            (progn
              (with-current-buffer buffer (enhanced-dirvish-compact-mode))
              (set-window-buffer right buffer)
              (cl-letf (((symbol-function 'enhanced-dirvish-open-location)
                         (lambda (location &optional _)
                           (setf (enhanced-dirvish-pane-state-dir (enhanced-dirvish-active-pane)) location))))
                (dolist (tenxer '(nil t))
                  (select-window left)
                  (enhanced-dirvish-tenxer-mode (if tenxer 1 -1))
                  (setf (enhanced-dirvish-tab-state-active-pane tab) 1)
                  (let ((last-input-event (list 'mouse-8 (list right 1 '(10 . 10) 0) 1)))
                    (call-interactively (key-binding [mouse-8])))
                  (should (= (enhanced-dirvish-tab-state-active-pane tab) 2))
                  (should (equal (enhanced-dirvish-pane-state-dir pane2) "second"))
                  (should (equal (enhanced-dirvish-pane-state-dir pane1) "left"))
                  ;; Press is consumed; release, double-click and hardware
                  ;; aliases each represent exactly one navigation action.
                  (call-interactively (lookup-key enhanced-dirvish-default-keymap [down-mouse-8]))
                  (should (equal (enhanced-dirvish-pane-state-dir pane2) "second"))
                  (let ((last-input-event 'XF86Forward))
                    (call-interactively (lookup-key enhanced-dirvish-default-keymap [XF86Forward])))
                  (should (equal (enhanced-dirvish-pane-state-dir pane2) "third"))
                  (enhanced-dirvish-mouse-history-forward)
                  (should (equal (enhanced-dirvish-pane-state-dir pane2) "third")))
                (enhanced-dirvish-mouse-history-back (list 'double-mouse-8 (list right 1 '(10 . 10) 0) 2))
                (should (equal (enhanced-dirvish-pane-state-dir pane2) "second"))
                (enhanced-dirvish-mouse-history-back (list 'mouse-8 (list right 1 '(10 . 10) 0) 1))
                (should (equal (enhanced-dirvish-pane-state-dir pane2) "first"))
                (enhanced-dirvish-mouse-history-back)
                (should (equal (enhanced-dirvish-pane-state-dir pane2) "first"))))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(defun enhanced-dirvish-test--wait-for-job (job)
  "Wait for archive JOB and require success, including its output on failure."
  (let ((deadline (+ (float-time) 20)))
    (while (and (eq (plist-get job :status) 'running) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (equal (list (plist-get job :status) (and (not (eq (plist-get job :status) 'done))
                                                   (plist-get job :output)))
                   '(done nil)))))

(defun enhanced-dirvish-test--archive-roundtrip (format encrypted)
  "Create and extract real archives in FORMAT, optionally ENCRYPTED."
  (let* ((root (make-temp-file "enhanced-dirvish-archive-test-" t))
         (default-directory (file-name-as-directory root))
         (file (expand-file-name "-notes with spaces.txt" root))
         (folder (expand-file-name "folder with spaces" root))
         (archive (expand-file-name (concat "bundle." format) root))
         (destination (expand-file-name "extracted" root))
         (enhanced-dirvish-jobs-list nil) (enhanced-dirvish-next-job-id 0)
         (secret "test archive password")
         confirmed)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory (file-name-as-directory root))
          (write-region "file contents" nil file nil 'silent)
          (make-directory folder)
          (write-region "nested contents" nil (expand-file-name "nested.txt" folder) nil 'silent)
          (make-directory destination)
          (cl-letf (((symbol-function 'enhanced-dirvish-selected-files) (lambda () (list file folder)))
                    ((symbol-function 'enhanced-dirvish-ui-read-string) (lambda (&rest _) "bundle"))
                    ((symbol-function 'enhanced-dirvish-ui-completing-read) (lambda (&rest _) format))
                    ((symbol-function 'enhanced-dirvish-ui-y-or-n-p) (lambda (&rest _) nil))
                    ((symbol-function 'enhanced-dirvish-ui-read-passwd)
                     (lambda (_prompt &optional confirm &rest _)
                       (setq confirmed confirm) (copy-sequence secret)))
                    ((symbol-function 'enhanced-dirvish-refresh-active-view) #'ignore)
                    ((symbol-function 'enhanced-dirvish-goto-file) #'ignore))
            (if encrypted (enhanced-dirvish-archive-compress-encrypted) (enhanced-dirvish-archive-compress))
            (enhanced-dirvish-test--wait-for-job (car enhanced-dirvish-jobs-list))
            (should (file-exists-p archive))
            (should (eq (not (null confirmed)) encrypted))
            (should (equal (sort (enhanced-dirvish-archive--top-level-roots archive (when encrypted secret)) #'string<)
                           '("-notes with spaces.txt" "folder with spaces")))
            (when encrypted
              ;; Both ZIP data and 7z encrypted headers reject a wrong password.
              (should-not (eq 0 (call-process "7z" nil nil nil "t" "-pwrong" "--" archive))))
            (cl-letf (((symbol-function 'enhanced-dirvish-current-file) (lambda () archive))
                      ((symbol-function 'enhanced-dirvish-ui-read-directory-name) (lambda (&rest _) destination)))
              (enhanced-dirvish-archive-extract t))
            (enhanced-dirvish-test--wait-for-job (car enhanced-dirvish-jobs-list))
            (let ((unpacked (expand-file-name "bundle" destination)))
              (should (equal (with-temp-buffer
                               (insert-file-contents (expand-file-name "-notes with spaces.txt" unpacked))
                               (buffer-string)) "file contents"))
              (should (equal (with-temp-buffer
                               (insert-file-contents (expand-file-name "folder with spaces/nested.txt" unpacked))
                               (buffer-string)) "nested contents")))))
      (delete-directory root t))))

(ert-deftest enhanced-dirvish-test-archive-compress-and-extract-real-formats ()
  "ZIP, 7z and compressed tar round trips preserve files, folders and spaces."
  (skip-unless (and (executable-find "7z") (executable-find "tar") (executable-find "zstd")))
  (dolist (format '("zip" "7z" "tar" "tar.gz" "tar.zst"))
    (ert-info ((format "Archive format: %s" format))
      (enhanced-dirvish-test--archive-roundtrip format nil))))

(ert-deftest enhanced-dirvish-test-archive-encrypted-roundtrip ()
  "Encrypted archives require confirmation, reject wrong passwords and reopen."
  (skip-unless (executable-find "7z"))
  (dolist (format '("7z" "zip"))
    (ert-info ((format "Encrypted format: %s" format))
      (enhanced-dirvish-test--archive-roundtrip format t))))

(ert-deftest enhanced-dirvish-test-archive-invalid-name-and-empty-password ()
  "Invalid names and empty encryption passwords never start a background job."
  (enhanced-dirvish-test--with-selection-view 'list
    (let ((name "../escape") (password "unused") started)
      (cl-letf (((symbol-function 'enhanced-dirvish-ui-read-string) (lambda (&rest _) name))
                ((symbol-function 'enhanced-dirvish-ui-completing-read) (lambda (&rest _) "7z"))
                ((symbol-function 'enhanced-dirvish-ui-read-passwd) (lambda (&rest _) (copy-sequence password)))
                ((symbol-function 'enhanced-dirvish-run-job) (lambda (&rest _) (setq started t))))
        (should-error (enhanced-dirvish-archive-compress-encrypted) :type 'user-error)
        (setq name "encrypted" password "")
        (should-error (enhanced-dirvish-archive-compress-encrypted) :type 'user-error)
        (should-not started)
        (should-not (file-exists-p (expand-file-name "encrypted.7z" enhanced-dirvish-test--dir)))))))

(ert-deftest enhanced-dirvish-test-archive-failed-job-skips-success-callback ()
  "A failed archive command records the error without announcing extraction."
  (let ((enhanced-dirvish-jobs-list nil) called)
    (let* ((job (enhanced-dirvish-run-job "Test failure" '("false") (lambda () (setq called t))))
           (deadline (+ (float-time) 5)))
      (while (and (eq (plist-get job :status) 'running) (< (float-time) deadline))
        (accept-process-output nil 0.05))
      (should (eq (plist-get job :status) 'failed))
      (should-not called))))

(ert-deftest enhanced-dirvish-test-context-archive-actions-at-top-level ()
  "Right-click exposes extraction, compression and encryption in all views."
  (dolist (view '(columns list compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (let ((archive (expand-file-name "example.ZIP" enhanced-dirvish-test--dir)) menu)
        (write-region "fixture" nil archive nil 'silent)
        (enhanced-dirvish-refresh-active-view)
        (cl-letf (((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                  ((symbol-function 'popup-menu) (lambda (value &rest _) (setq menu value))))
          (enhanced-dirvish-mouse-context-menu (enhanced-dirvish-test--selection-event 'mouse-3 archive))
          (should (eq (enhanced-dirvish-test--popup-menu-command menu "Extract Here") 'enhanced-dirvish-archive-extract))
          (should (eq (enhanced-dirvish-test--popup-menu-command menu "Compress…") 'enhanced-dirvish-archive-compress))
          (should (eq (enhanced-dirvish-test--popup-menu-command menu "Compress with Encryption…")
                      'enhanced-dirvish-archive-compress-encrypted))
          (let ((item (cl-find-if (lambda (entry) (and (consp entry) (equal (nth 2 entry) "Extract Here")))
                                  (cdr menu))))
            (should (or (not (plist-member (nthcdr 4 item) :visible))
                        (plist-get (nthcdr 4 item) :visible))))
          ;; A marked group keeps the batch; extraction is hidden for that group.
          (enhanced-dirvish-view--set-entry-mark archive t)
          (enhanced-dirvish-view--set-entry-mark (car enhanced-dirvish-test--files) t)
          (enhanced-dirvish-mouse-context-menu (enhanced-dirvish-test--selection-event 'mouse-3 archive))
          (let ((item (cl-find-if (lambda (entry) (and (consp entry) (equal (nth 2 entry) "Extract Here")))
                                  (cdr menu))))
            (should-not (plist-get (nthcdr 4 item) :visible)))
          (should (= (length (enhanced-dirvish-selected-files)) 2)))))))

(ert-deftest enhanced-dirvish-test-mouse-drop-selection-into-sibling-folder ()
  "Marked files drop into sibling folders, with native tracking and fallback."
  (dolist (view '(columns list compact icons))
    (dolist (tracked '(t nil))
      (enhanced-dirvish-test--with-selection-view view
        (let* ((folder (expand-file-name "target folder" enhanced-dirvish-test--dir))
               (a (car enhanced-dirvish-test--files)) (c (nth 2 enhanced-dirvish-test--files))
               (enhanced-dirvish-sidebar-window nil) (enhanced-dirvish-undo-stack nil) (enhanced-dirvish-redo-stack nil))
          (make-directory folder)
          (enhanced-dirvish-refresh-active-view)
          (enhanced-dirvish-view--set-entry-mark a t)
          (enhanced-dirvish-view--set-entry-mark c t)
          (let* ((start (event-start (enhanced-dirvish-test--selection-event 'down-mouse-1 a)))
                 (end (event-start (enhanced-dirvish-test--selection-event 'mouse-1 folder 80))))
            (if tracked
                (progn
                  (enhanced-dirvish-mouse-down-entry (list 'down-mouse-1 start 1))
                  (should (plist-get enhanced-dirvish-mouse--drag-state :carry-marked-p))
                  ;; Passing another file must not add it to the carried group.
                  (enhanced-dirvish-mouse--drag-move (enhanced-dirvish-test--selection-event 'mouse-movement (nth 1 enhanced-dirvish-test--files) 30))
                  (enhanced-dirvish-mouse--drag-move (list 'S-mouse-movement end))
                  (enhanced-dirvish-mouse--on-drag-exit)
                  (enhanced-dirvish-mouse-drag-move (list 'S-drag-mouse-1 start end)))
              (enhanced-dirvish-mouse-drag-move (list 'S-drag-mouse-1 start end))))
          (dolist (file (list a c))
            (should-not (file-exists-p file))
            (should (file-exists-p (expand-file-name (file-name-nondirectory file) folder))))
          (should (file-exists-p (nth 1 enhanced-dirvish-test--files)))
          (should-not (enhanced-dirvish-marked-files-only))
          (enhanced-dirvish-undo)
          (should (file-exists-p a))
          (should (file-exists-p c)))))))

(ert-deftest enhanced-dirvish-test-mouse-copy-single-file-into-sibling-folder ()
  "Ctrl-drag copies an unmarked file rather than marks swept over en route."
  (dolist (view '(columns list compact icons))
    (enhanced-dirvish-test--with-selection-view view
      (let* ((folder (expand-file-name "target" enhanced-dirvish-test--dir))
             (a (car enhanced-dirvish-test--files)) (enhanced-dirvish-undo-stack nil))
        (make-directory folder)
        (enhanced-dirvish-refresh-active-view)
        (let* ((start (event-start (enhanced-dirvish-test--selection-event 'C-down-mouse-1 a)))
               (end (event-start (enhanced-dirvish-test--selection-event 'mouse-1 folder 80))))
          (enhanced-dirvish-mouse-down-entry (list 'C-down-mouse-1 start 1))
          (enhanced-dirvish-mouse--drag-move (enhanced-dirvish-test--selection-event 'C-mouse-movement (nth 2 enhanced-dirvish-test--files) 30))
          (enhanced-dirvish-mouse--on-drag-exit)
          (enhanced-dirvish-mouse-drag-copy (list 'C-drag-mouse-1 start end)))
        (should (file-exists-p a))
        (should (equal (directory-files folder nil "\\`[^.]") '("a.txt")))))))

(ert-deftest enhanced-dirvish-test-mouse-folder-drop-rejects-self-and-descendants ()
  "A drag cannot move its own destination or any ancestor into the destination."
  (enhanced-dirvish-test--with-selection-view 'list
    (let* ((folder (expand-file-name "parent" enhanced-dirvish-test--dir))
           (child (expand-file-name "child" folder))
           (a (car enhanced-dirvish-test--files)))
      (make-directory child t)
      (enhanced-dirvish-refresh-active-view)
      (enhanced-dirvish-view--set-entry-mark a t)
      (enhanced-dirvish-view--set-entry-mark folder t)
      (let* ((win (selected-window))
             (end (event-start (enhanced-dirvish-test--selection-event 'mouse-1 folder))))
        (should-not (enhanced-dirvish-mouse--drop-dir win win end a (list a folder)))
        (cl-letf (((symbol-function 'enhanced-dirvish-mouse--drag-target-dir) (lambda (&rest _) child)))
          (should-error (enhanced-dirvish-mouse--drag-drop-now win win nil end a (list a folder) 'cut)
                        :type 'user-error)))
      (should (file-exists-p a))
      (should (file-directory-p child)))))

(ert-deftest enhanced-dirvish-test-main-right-click-pins-selected-folder ()
  "The main view's right-click menu pins and unpins the selected folder."
  (enhanced-dirvish-test--with-selection-view 'compact
    (let* ((enhanced-dirvish-gtk-bookmarks-file (expand-file-name "bookmarks" enhanced-dirvish-test--root))
           (sub (expand-file-name "Sub Folder" enhanced-dirvish-test--dir)))
      (make-directory sub)
      (enhanced-dirvish-compact-refresh)
      (enhanced-dirvish-goto-file sub)
      (let ((menu (enhanced-dirvish-context--popup-menu)))
        (should (member "Pin to Sidebar" (enhanced-dirvish-test--visible-menu-labels menu)))
        (call-interactively (enhanced-dirvish-test--popup-menu-command menu "Pin to Sidebar")))
      (should (enhanced-dirvish-pinned-p sub))
      (let ((labels (enhanced-dirvish-test--visible-menu-labels (enhanced-dirvish-context--popup-menu))))
        (should (member "Unpin from Sidebar" labels))
        (should-not (member "Pin to Sidebar" labels))))))

