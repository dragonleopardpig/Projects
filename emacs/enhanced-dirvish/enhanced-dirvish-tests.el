(ert-deftest enhanced-dirvish-test-launch-skips-stale-or-missing-tab-directories ()
  "Launching `C-c d' skips stale tabs and always falls back to `~/'."
  (let* ((tmp (make-temp-file "enhanced-dirvish-stale-" t))
         (live-dir (expand-file-name "live" tmp))
         (missing-dir (expand-file-name "gone-dv-Q7Cf5Q" tmp))
         (home (directory-file-name (expand-file-name "~/")))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-stale-state-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :restore-tabs t :default-directory live-dir))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-closed-tabs nil)
         (enhanced-dirvish-active-tab-index 0)
         (enhanced-dirvish-visited-folders nil)
         (opened nil))
    (unwind-protect
        (progn
          (make-directory live-dir t)
          ;; 1. Saved `tabs.eld' with stale first tab and live second tab picks the live tab.
          (with-temp-file enhanced-dirvish-tabs-state-file
            (prin1 (list :active 0
                         :tabs (list (list :dir missing-dir :split-p nil)
                                     (list :dir live-dir :split-p nil)))
                   (current-buffer)))
          (with-current-buffer (get-buffer-create "*dashboard*")
            (cl-letf (((symbol-function 'enhanced-dirvish-open-location)
                       (lambda (loc &optional _rec) (setq opened loc))))
              (enhanced-dirvish-launch)
              (should (equal (directory-file-name opened)
                             (directory-file-name live-dir)))
              (should (= (length enhanced-dirvish-workspace-tabs) 1))))
          ;; 2. All saved/in-memory tabs stale from `*dashboard*' (even with another
          ;; buffer `default-directory' or `prefs' default-directory) -> falls back to `~/'.
          (setq enhanced-dirvish-workspace-tabs
                (list (make-enhanced-dirvish-tab-state
                       :id 99 :label "gone" :dir missing-dir
                       :pane1 (make-enhanced-dirvish-pane-state :id 1 :dir missing-dir)))
                enhanced-dirvish-active-tab-index 0
                opened nil)
          (with-current-buffer (get-buffer-create "*dashboard*")
            (let ((default-directory (file-name-as-directory live-dir)))
              (cl-letf (((symbol-function 'enhanced-dirvish-open-location)
                         (lambda (loc &optional _rec) (setq opened loc))))
                (enhanced-dirvish-launch)
                (should (equal (directory-file-name opened) home))
                (should (null enhanced-dirvish-workspace-tabs)))))
          ;; 3. Explicit non-existent `dir' falls back to `~/'.
          (setq opened nil)
          (with-temp-buffer
            (let ((default-directory (file-name-as-directory live-dir)))
              (cl-letf (((symbol-function 'enhanced-dirvish-open-location)
                         (lambda (loc &optional _rec) (setq opened loc))))
                (enhanced-dirvish-launch missing-dir)
                (should (equal (directory-file-name opened) home)))))
          ;; 4. `enhanced-dirvish-open-location' on non-existent path falls back to `~/' without error.
          (setq enhanced-dirvish-workspace-tabs nil
                enhanced-dirvish-active-tab-index 0
                opened nil)
          (let ((enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :restore-tabs nil)))
            (save-window-excursion
              (cl-letf (((symbol-function 'enhanced-dirvish-sidebar-ensure) (lambda () t))
                        ((symbol-function 'enhanced-dirvish-sidebar-refresh) (lambda () nil))
                        ((symbol-function 'enhanced-dirvish--flatten-layout) (lambda () nil))
                        ((symbol-function 'dirvish-find-entry-a) (lambda (&rest _) nil)))
                (enhanced-dirvish-open-location missing-dir)
                (should (equal (directory-file-name (enhanced-dirvish-tab-state-dir (enhanced-dirvish-active-tab)))
                               home))))))
      (when (get-buffer "*dashboard*")
        (kill-buffer "*dashboard*"))
      (delete-directory tmp t)
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-split-pane-address-and-places-target-cursor-pane ()
  "Clicking Places or address breadcrumbs updates the pane where cursor/click happened."
  (let* ((tmp (make-temp-file "enhanced-dirvish-split-target-" t))
         (dir-a (expand-file-name "dirA" tmp))
         (dir-b (expand-file-name "dirB" tmp))
         (dir-c (expand-file-name "dirC" tmp))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-split-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :browser-mode 'list :restore-tabs nil :sidebar-expanded t))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-closed-tabs nil)
         (enhanced-dirvish-active-tab-index 0)
         (enhanced-dirvish-sidebar-window nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory dir-a)
          (make-directory dir-b)
          (make-directory dir-c)
          (enhanced-dirvish-open-location dir-a)
          (enhanced-dirvish-toggle-extra-pane)
          (enhanced-dirvish-open-location dir-b)
          (let* ((tab (enhanced-dirvish-active-tab))
                 (p1 (enhanced-dirvish-tab-state-pane1 tab))
                 (p2 (enhanced-dirvish-tab-state-pane2 tab))
                 (w1 (enhanced-dirvish-pane-state-window p1))
                 (w2 (enhanced-dirvish-pane-state-window p2)))
            (should (window-live-p w1))
            (should (window-live-p w2))
            (should (not (eq w1 w2)))
            (should (= (enhanced-dirvish-tab-state-active-pane tab) 2))
            ;; 1. Move cursor into Pane 1 (`w1`) -> window selection change must activate Pane 1.
            (select-window w1)
            (enhanced-dirvish-panes--on-window-selection-change)
            (should (= (enhanced-dirvish-tab-state-active-pane tab) 1))
            ;; 2. Click Places entry inside sidebar while Pane 1 was last active -> must update Pane 1 only!
            (when (window-live-p enhanced-dirvish-sidebar-window)
              (select-window enhanced-dirvish-sidebar-window))
            (enhanced-dirvish-open-location dir-c t)
            (should (eq (selected-window) w1))
            (should (equal (directory-file-name (enhanced-dirvish-pane-state-dir p1))
                           (directory-file-name dir-c)))
            (should (equal (directory-file-name (enhanced-dirvish-pane-state-dir p2))
                           (directory-file-name dir-b)))
            ;; 3. Click address breadcrumb of inactive Pane 2 (`w2`) -> must update Pane 2 (`w2`), not Pane 1!
            (select-window w1)
            (enhanced-dirvish-panes--on-window-selection-change)
            (should (= (enhanced-dirvish-tab-state-active-pane tab) 1))
            (let* ((seg (with-current-buffer (window-buffer w2)
                          (enhanced-dirvish-crumb--make-segment "root" tmp)))
                   (km (get-text-property 0 'keymap seg))
                   (fn (lookup-key km [header-line mouse-1]))
                   (ev `(mouse-1 (,w2 1 (10 . 1) 0) 1)))
              (should (functionp fn))
              (funcall fn ev))
            (should (eq (selected-window) w2))
            (should (= (enhanced-dirvish-tab-state-active-pane tab) 2))
            (should (equal (directory-file-name (enhanced-dirvish-pane-state-dir p2))
                           (directory-file-name tmp)))
            (should (equal (directory-file-name (enhanced-dirvish-pane-state-dir p1))
                           (directory-file-name dir-c)))
            ;; 4. `C-l' (`enhanced-dirvish-location-prompt') syncs to the pane where cursor sits (`w1`).
            (select-window w1)
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt _coll &rest _) dir-a)))
              (enhanced-dirvish-location-prompt))
            (should (equal (directory-file-name (enhanced-dirvish-pane-state-dir p1))
                           (directory-file-name dir-a)))
            (should (equal (directory-file-name (enhanced-dirvish-pane-state-dir p2))
                           (directory-file-name tmp)))))
      (when (window-live-p enhanced-dirvish-sidebar-window)
        (ignore-errors (delete-window enhanced-dirvish-sidebar-window))
        (setq enhanced-dirvish-sidebar-window nil))
      (when-let ((sb (get-buffer "*Enhanced Dirvish Sidebar*")))
        (kill-buffer sb))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-file-manager-keys-are-opt-in ()
  "F5-F9 and C-c followed by a letter are Emacs's user keys: opt-in only.
`enhanced-dirvish-file-manager-keys' binds the Explorer/Nemo-style ones;
off, their commands keep keys that follow the conventions."
  (enhanced-dirvish-test--with-file-manager-keys nil
    (pcase-dolist (`(,map . ,bindings) enhanced-dirvish--file-manager-bindings)
      (pcase-dolist (`(,key . ,_command) bindings)
        (should-not (lookup-key (symbol-value map) (kbd key)))))
    (should-not (enhanced-dirvish-file-manager-keys-for #'enhanced-dirvish-toggle-pane-terminal))
    (should (eq (lookup-key enhanced-dirvish-compact-mode-map (kbd "g")) #'enhanced-dirvish-compact-refresh))
    (should (eq (lookup-key enhanced-dirvish-default-keymap (kbd "C-`")) #'enhanced-dirvish-toggle-pane-terminal))
    (should (eq (lookup-key enhanced-dirvish-preview-read-mode-map (kbd "q")) #'enhanced-dirvish-preview-read-leave))
    (should (eq (lookup-key enhanced-dirvish-preview-edit-mode-map (kbd "C-c C-c"))
                #'enhanced-dirvish-preview-edit-exit))
    (should (eq (lookup-key enhanced-dirvish-preview-edit-mode-map (kbd "C-c C-k"))
                #'enhanced-dirvish-preview-edit-abort)))
  (enhanced-dirvish-test--with-file-manager-keys t
    (pcase-dolist (`(,map . ,bindings) enhanced-dirvish--file-manager-bindings)
      (pcase-dolist (`(,key . ,command) bindings)
        (should (eq (lookup-key (symbol-value map) (kbd key)) command))))
    (should (equal (enhanced-dirvish-file-manager-keys-for #'enhanced-dirvish-toggle-pane-terminal)
                   '("<f9>" "C-c t"))))
  ;; Customize applies a change at once.
  (let ((enhanced-dirvish-file-manager-keys nil)
        (set (get 'enhanced-dirvish-file-manager-keys 'custom-set)))
    (unwind-protect
        (progn
          (funcall set 'enhanced-dirvish-file-manager-keys t)
          (should (eq (lookup-key enhanced-dirvish-default-keymap (kbd "<f6>"))
                      #'enhanced-dirvish-switch-other-pane))
          (funcall set 'enhanced-dirvish-file-manager-keys nil)
          (should-not (lookup-key enhanced-dirvish-default-keymap (kbd "<f6>"))))
      (let ((enhanced-dirvish-file-manager-keys
             (default-toplevel-value 'enhanced-dirvish-file-manager-keys)))
        (enhanced-dirvish-apply-file-manager-keys)))))

(ert-deftest enhanced-dirvish-test-loading-changes-nothing ()
  "Requiring the package adds no hooks, advice or file associations.
Only `enhanced-dirvish-setup' changes Emacs (MELPA's rule for packages)."
  (let* ((dir (file-name-directory (locate-library "enhanced-dirvish")))
         (probe
          `(progn
             (require 'package)
             (setq package-user-dir ,package-user-dir)
             (package-initialize)
             (dolist (feature '(dirvish dirvish-subtree dirvish-vc dirvish-emerge dirvish-narrow
                                dirvish-collapse dirvish-widgets transient filenotify face-remap
                                shr tooltip easymenu json))
               (require feature nil t))
             (let* ((hooks '(window-selection-change-functions dired-after-readin-hook
                             enable-theme-functions dirvish-preview-setup-hook dired-mode-hook
                             kill-emacs-hook after-make-frame-functions))
                    (before (mapcar (lambda (h) (copy-sequence (and (boundp h) (symbol-value h))))
                                    hooks))
                    (modes (copy-sequence auto-mode-alist)))
               (add-to-list 'load-path ,dir)
               (require 'enhanced-dirvish)
               (princ (format "%S"
                              (list (cl-loop for h in hooks for b in before
                                             unless (equal (and (boundp h) (symbol-value h)) b)
                                             collect h)
                                    (equal modes auto-mode-alist)
                                    (and (fboundp 'dirvish--preview-update)
                                         (advice-member-p #'enhanced-dirvish-preview--guard-dirvish-update
                                                          'dirvish--preview-update)))))))))
    (with-temp-buffer
      (should (zerop (call-process (expand-file-name invocation-name invocation-directory)
                                   nil (list t nil) nil
                                   "-Q" "--batch" "--eval" (prin1-to-string probe))))
      (should (equal (string-trim (buffer-string)) "(nil t nil)")))))

(ert-deftest enhanced-dirvish-test-launch-starts-with-one-pane-and-f3-opens-split ()
  "The browser always starts with one pane, so the first F3 opens the split.
The user's steps: a fresh Emacs, the dashboard's Dirvish button, F3.  A tab
saved split was restored as split with one pane on screen, so F3 said
\"Closed split pane\" and had to be pressed again.  The user chose to
always start with one pane; F3 reopens pane 2 where it was.  Switching
tabs shows each tab's own split."
  (let* ((tmp (make-temp-file "enhanced-dirvish-split-restore-" t))
         (one (expand-file-name "one" tmp))
         (two (expand-file-name "two" tmp))
         (three (expand-file-name "three" tmp))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-split-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-sidebar-window nil)
         (dashboard-navigator-buttons nil)
         (override dirvish-override-dired-mode)
         (width (frame-width)) (height (frame-height))
         (said nil)
         (shown (lambda ()
                  (mapcar (lambda (w)
                            (with-current-buffer (window-buffer w)
                              (directory-file-name
                               (expand-file-name
                                (or enhanced-dirvish-view-directory default-directory)))))
                          (cl-remove-if-not #'enhanced-dirvish-panes--valid-main-window-p
                                            (window-list nil 'nomini (frame-first-window))))))
         (press (lambda (key)
                  (cl-letf (((symbol-function 'message)
                             (lambda (fmt &rest args)
                               (when fmt (push (apply #'format fmt args) said)))))
                    (call-interactively (key-binding (kbd key)))))))
    (dolist (d (list one two three))
      (make-directory d t))
    (unwind-protect
        (dolist (mode '(compact list))
          (let ((enhanced-dirvish-prefs-current
                 (enhanced-dirvish-prefs--create :browser-mode mode :restore-tabs t
                                                 :sidebar-expanded t))
                (enhanced-dirvish-workspace-tabs nil)
                (enhanced-dirvish-closed-tabs nil)
                (enhanced-dirvish-active-tab-index 0))
            (with-temp-file enhanced-dirvish-tabs-state-file
              (prin1 (list :active 0 :tabs (list (list :dir one :split-p t :pane2-dir two)
                                                 (list :dir three :split-p nil)))
                     (current-buffer)))
            (save-window-excursion
              (let ((ignore-window-parameters t))
                (enhanced-dirvish-windows--unatom (frame-root-window))
                (delete-other-windows))
              (set-frame-size (selected-frame) 200 65)
              (dirvish-override-dired-mode 1)
              (enhanced-dirvish-setup)
              (enhanced-dirvish-dashboard-install)
              (switch-to-buffer (get-buffer-create "*dashboard*"))
              (let ((button (cl-find "Dirvish" (car dashboard-navigator-buttons)
                                     :key #'cadr :test #'equal)))
                (should button)
                (funcall (nth 3 button)))
              (let ((tab (enhanced-dirvish-active-tab)))
                (should (equal (funcall shown) (list one)))
                (should-not (enhanced-dirvish-split-active-p))
                (should (eq (selected-window)
                            (enhanced-dirvish-pane-state-window
                             (enhanced-dirvish-tab-state-pane1 tab)))))
              (funcall press "<f3>")
              (should (string-prefix-p "Opened Extra Pane" (car said)))
              (should (equal (funcall shown) (list one two)))
              ;; F6 back to pane 1: closing from pane 2 keeps pane 2's folder.
              ;; F6 is an opt-in key; the user's config turns them on.
              (enhanced-dirvish-test--with-file-manager-keys t
                (should (eq (key-binding (kbd "<f6>")) #'enhanced-dirvish-switch-other-pane))
                (funcall press "<f6>"))
              (funcall press "<f3>")
              (should (equal (car said) "Closed split pane"))
              (should (equal (funcall shown) (list one)))
              (funcall press "<f3>")
              (should (equal (funcall shown) (list one two)))
              ;; Each tab shows its own split.
              (enhanced-dirvish-tab-next)
              (should (equal (funcall shown) (list three)))
              (enhanced-dirvish-tab-previous)
              (should (equal (funcall shown) (list one two)))
              (should (= (enhanced-dirvish-tab-state-active-pane (enhanced-dirvish-active-tab)) 2))
              (enhanced-dirvish-tab-new one)
              (should (equal (funcall shown) (list one)))
              (enhanced-dirvish-tab-close)
              (should (equal (funcall shown) (list three)))
              (enhanced-dirvish-tab-switch-index 1)
              (should (equal (funcall shown) (list one two)))
              (funcall press "<f3>")
              (should (equal (car said) "Closed split pane")))))
      (dirvish-override-dired-mode (if override 1 -1))
      (set-frame-size (selected-frame) width height)
      (when-let ((sb (get-buffer "*Enhanced Dirvish Sidebar*")))
        (kill-buffer sb))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (or (equal (buffer-name b) "*dashboard*")
                      (and default-directory
                           (string-prefix-p (file-truename tmp)
                                            (file-truename default-directory))))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-split-panes-same-named-folders-stay-apart ()
  "Entering a folder in one split pane never moves the other pane.
The user's steps: F3, both panes in an unzipped B90120A-1/, then Enter on
its B90120A-1/ subfolder in one pane.  Compact and Icons buffers are named
after the folder, so the second pane must not reuse the first one's."
  (let* ((tmp (make-temp-file "enhanced-dirvish-split-same-" t))
         (outer (expand-file-name "B90120A-1" tmp))
         (inner (expand-file-name "B90120A-1" outer))
         (src-a (expand-file-name "a/src" tmp))
         (src-b (expand-file-name "b/src" tmp))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-split-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-sidebar-window nil)
         ;; As `enhanced-dirvish-setup' does, so F3 and RET are the real keys.
         (dired-mode-hook (list #'enhanced-dirvish--enable-in-browser))
         (enhanced-dirvish-compact-mode-hook (list #'enhanced-dirvish--enable-in-browser))
         (enhanced-dirvish-icons-mode-hook (list #'enhanced-dirvish--enable-in-browser))
         (same (lambda (a b) (equal (directory-file-name (expand-file-name a))
                                    (directory-file-name (expand-file-name b)))))
         (shown (lambda (w)
                  (with-current-buffer (window-buffer w)
                    (or enhanced-dirvish-view-directory default-directory)))))
    (dolist (d (list inner src-a src-b))
      (make-directory d t))
    (with-temp-file (expand-file-name "part.step" inner) (insert "x"))
    (unwind-protect
        (dolist (mode '(compact icons))
          (let ((enhanced-dirvish-prefs-current
                 (enhanced-dirvish-prefs--create :browser-mode mode :restore-tabs nil
                                                 :sidebar-expanded nil))
                (enhanced-dirvish-workspace-tabs nil)
                (enhanced-dirvish-closed-tabs nil)
                (enhanced-dirvish-active-tab-index 0))
            (save-window-excursion
              (delete-other-windows)
              (enhanced-dirvish-open-location outer)
              (should (eq (key-binding (kbd "<f3>")) #'enhanced-dirvish-toggle-extra-pane))
              (call-interactively (key-binding (kbd "<f3>")))
              (enhanced-dirvish-open-location outer t)
              (let* ((tab (enhanced-dirvish-active-tab))
                     (w1 (enhanced-dirvish-pane-state-window (enhanced-dirvish-tab-state-pane1 tab)))
                     (w2 (enhanced-dirvish-pane-state-window (enhanced-dirvish-tab-state-pane2 tab))))
                (should (funcall same (funcall shown w1) outer))
                (should (funcall same (funcall shown w2) outer))
                (should-not (eq (window-buffer w1) (window-buffer w2)))
                ;; Enter on the same-named subfolder, in either pane.
                (dolist (pair (list (cons w1 w2) (cons w2 w1)))
                  (dolist (w (list (cdr pair) (car pair)))
                    (select-window w)
                    (enhanced-dirvish-panes--on-window-selection-change)
                    (enhanced-dirvish-open-location outer t))
                  (enhanced-dirvish-goto-file inner)
                  (should (funcall same (enhanced-dirvish-current-file) inner))
                  (call-interactively (key-binding (kbd "RET")))
                  (should (funcall same (funcall shown (car pair)) inner))
                  (should (funcall same (funcall shown (cdr pair)) outer)))
                ;; Same-named folders in different places stay apart too.
                (select-window w1)
                (enhanced-dirvish-panes--on-window-selection-change)
                (enhanced-dirvish-open-location src-a t)
                (select-window w2)
                (enhanced-dirvish-panes--on-window-selection-change)
                (enhanced-dirvish-open-location src-b t)
                (should (funcall same (funcall shown w1) src-a))
                (should (funcall same (funcall shown w2) src-b))))))
      (when (window-live-p enhanced-dirvish-sidebar-window)
        (ignore-errors (delete-window enhanced-dirvish-sidebar-window))
        (setq enhanced-dirvish-sidebar-window nil))
      (when-let ((sb (get-buffer "*Enhanced Dirvish Sidebar*")))
        (kill-buffer sb))
      (dolist (b (buffer-list))
        (when (buffer-live-p b)
          (with-current-buffer b
            (when (and default-directory
                       (string-prefix-p (file-truename tmp) (file-truename default-directory)))
              (kill-buffer b)))))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-multi-select-highlight-drag-and-context-copy ()
  "Multi-selection highlights across views and drags/right-clicks to copy or move across panes."
  (let* ((tmp (make-temp-file "enhanced-dirvish-multi-" t))
         (src (expand-file-name "src" tmp))
         (dst (expand-file-name "dst" tmp))
         (fa (expand-file-name "a.txt" src))
         (fb (expand-file-name "b.txt" src))
         (fc (expand-file-name "c.txt" src))
         (fd (expand-file-name "d.txt" src))
