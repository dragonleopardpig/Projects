(ert-deftest enhanced-dirvish-test-ui-drag-drop-and-conflicts-use-gui ()
  "Mouse Copy/Move/Cancel and subsequent conflicts never enter a text prompt."
  (dolist (action '(copy cut nil))
    (enhanced-dirvish-test--with-selection-view 'compact
      (let* ((src (selected-window))
             (dest (expand-file-name "dest" enhanced-dirvish-test--root))
             (target-buffer (generate-new-buffer "*Enhanced Dirvish Dialog Destination*"))
             (target-window (split-window-right))
             (a (car enhanced-dirvish-test--files)) (b (nth 1 enhanced-dirvish-test--files))
             (enhanced-dirvish-undo-stack nil) asked)
        (unwind-protect
            (progn
              (make-directory dest)
              (write-region "old target" nil (expand-file-name "a.txt" dest) nil 'silent)
              (with-current-buffer target-buffer (setq default-directory (file-name-as-directory dest)))
              (set-window-buffer target-window target-buffer)
              (enhanced-dirvish-view--set-entry-mark a t)
              (enhanced-dirvish-view--set-entry-mark b t)
              (cl-letf (((symbol-function 'enhanced-dirvish-ui-mouse-p)
                         (lambda () (eq enhanced-dirvish-ui-input-method 'mouse)))
                        ((symbol-function 'x-popup-dialog)
                         (lambda (_position contents &rest _)
                           (push (car contents) asked)
                           (if (string-prefix-p "Drop " (car contents)) action t)))
                        ((symbol-function 'x-popup-menu)
                         (lambda (&rest _) (push 'conflict asked) "keep-both"))
                        ((symbol-function 'read-char-choice) (lambda (&rest _) (ert-fail "Text drop prompt")))
                        ((symbol-function 'completing-read) (lambda (&rest _) (ert-fail "Text conflict prompt")))
                        ((symbol-function 'y-or-n-p) (lambda (&rest _) (ert-fail "Text apply-all prompt")))
                        ((symbol-function 'enhanced-dirvish-refresh-active-view) #'ignore))
                (let ((start (event-start (enhanced-dirvish-test--selection-event 'mouse-1 a))))
                  (enhanced-dirvish-mouse-drag-drop
                   (list 'drag-mouse-1 start (list target-window 1 '(200 . 50) 0)))))
              (if action
                  (progn
                    (should (member 'conflict asked))
                    (should (= (length asked) 3))
                    (should (= (length (directory-files dest nil "\\`[^.]")) 3))
                    (should (file-exists-p (expand-file-name "b.txt" dest)))
                    (should (eq (not (null (file-exists-p a))) (eq action 'copy))))
                (should (= (length asked) 1))
                (should (equal (directory-files dest nil "\\`[^.]") '("a.txt")))
                (should (file-exists-p a))))
          (when (window-live-p target-window) (delete-window target-window))
          (when (buffer-live-p target-buffer) (kill-buffer target-buffer)))))))

(ert-deftest enhanced-dirvish-test-ui-native-choice-password-and-folder-routing ()
  "Mouse application/format choices, passwords and directories use GUI backends."
  (let ((enhanced-dirvish-ui-input-method 'mouse) calls)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
              ((symbol-function 'x-popup-menu) (lambda (&rest _) (push 'menu calls) "zip"))
              ((symbol-function 'x-file-dialog) (lambda (&rest _) (push 'folder calls) "/tmp/"))
              ((symbol-function 'enhanced-dirvish-ui--gtk-entry)
               (lambda (_prompt _initial password) (push (if password 'password 'entry) calls) "value"))
              ((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Text prompt from mouse")))
              ((symbol-function 'completing-read) (lambda (&rest _) (ert-fail "Text choice from mouse")))
              ((symbol-function 'read-passwd) (lambda (&rest _) (ert-fail "Text password from mouse"))))
      (should (equal (enhanced-dirvish-ui-completing-read "Format:" '("zip" "tar") nil t) "zip"))
      (should (equal (enhanced-dirvish-ui-read-directory-name "Folder:") "/tmp/"))
      (should (equal (enhanced-dirvish-ui-read-passwd "Password:") "value"))
      (should (equal calls '(password folder menu))))))

(ert-deftest enhanced-dirvish-test-ui-gtk-output-cancel-and-quit-cleanup ()
  "GTK output excludes diagnostics, preserves literal names and cleans up on cancel/C-g."
  (let* ((root (make-temp-file "enhanced-dirvish-gtk-test-" t))
         (program (expand-file-name "dialog" root))
         (find-executable (symbol-function 'executable-find)))
    (unwind-protect
        (cl-letf (((symbol-function 'executable-find)
                   (lambda (name &rest args)
                     (if (equal name "zenity") program (apply find-executable name args)))))
          (dolist (outcome '(success cancel quit))
            (with-temp-file program
              (insert "#!/bin/sh\n")
              (pcase outcome
                ('success (insert "printf '%s\\n' 'GTK diagnostic' >&2\nprintf '%s\\n' 'a;$(literal) & <name>.txt'\n"))
                ('cancel (insert "exit 1\n"))
                ('quit (insert "exec sleep 30\n"))))
            (set-file-modes program #o700)
            (if (eq outcome 'success)
                (should (equal (enhanced-dirvish-ui--gtk-entry "Name:" "initial") "a;$(literal) & <name>.txt"))
              (should
               (eq (condition-case nil
                       (if (eq outcome 'quit)
                           (cl-letf (((symbol-function 'accept-process-output)
                                      (lambda (&rest _) (signal 'quit nil))))
                             (enhanced-dirvish-ui--gtk-entry "Name:"))
                         (enhanced-dirvish-ui--gtk-entry "Name:"))
                     (quit 'cancelled))
                   'cancelled)))
            (should-not (cl-some (lambda (buffer)
                                  (string-prefix-p " *Enhanced Dirvish dialog" (buffer-name buffer)))
                                (buffer-list)))
            (should-not (cl-some (lambda (process)
                                  (and (string-prefix-p "enhanced-dirvish-dialog" (process-name process))
                                       (process-live-p process)))
                                (process-list)))))
      (delete-directory root t))))

(defun enhanced-dirvish-test--main-menu-item (&rest labels)
  "Return the actual menu item reached through LABELS in the main menu."
  (let ((menu enhanced-dirvish-menu-map) item)
    (dolist (label labels)
      (setq item (cl-find-if (lambda (entry) (and (consp entry) (eq (cadr entry) 'menu-item)
                                                (equal (nth 2 entry) label))) (cdr menu)))
      (should item)
      (setq menu (nth 3 item)))
    item))

(defun enhanced-dirvish-test--main-menu-enabled-p (&rest labels)
  "Evaluate the real menu enable expression for LABELS."
  (eval (plist-get (nthcdr 4 (apply #'enhanced-dirvish-test--main-menu-item labels)) :enable) t))

