          (enhanced-dirvish-open-location tmp)
          (cl-letf (((symbol-function 'enhanced-dirvish-preview-edit-file) (lambda (f) (setq opened f)))
                    ((symbol-function 'find-file) (lambda (f &optional _w) (setq opened f))))
            ;; Double-click on folder: click 1 opens sub/, click 2 double-mouse-1 is suppressed
            (let* ((ev1 (enhanced-dirvish-test--selection-event 'mouse-1 sub))
                   (pt1 (posn-point (event-end ev1))))
