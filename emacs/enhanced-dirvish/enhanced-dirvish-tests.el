        (should-not (member "11111111-2222-3333-4444-555555555555" names))
        ;; BitLocker partition is marked locked.
        (let ((win (cl-find "M90APROGEN6 Windows 18/9/2025" devs
                            :key #'enhanced-dirvish-device-name :test #'string=)))
          (should win)
          (should (enhanced-dirvish-device-locked-p win)))))))

(ert-deftest enhanced-dirvish-test-hover-highlight-per-row-not-whole-group ()
  (let ((d1 (make-enhanced-dirvish-device :id "d1" :name "Alpha" :device "/dev/nvme0n1p1"
                                :fstype "ext4" :mountpoint "/tmp"
                                :placement 'fixed :mounted-p t :usage '(1000 . 500)))
        (d2 (make-enhanced-dirvish-device :id "d2" :name "Beta" :device "/dev/nvme0n1p2"
                                :fstype "ext4" :mountpoint "/var"
                                :placement 'fixed :mounted-p t :usage '(1000 . 600)))
        (had-sidebar (get-buffer "*Enhanced Dirvish Sidebar*")))
    (unwind-protect
        (cl-letf (((symbol-function 'enhanced-dirvish-bookmarks-read)
                   (lambda () '(("/tmp" . "TmpPin") ("/var" . "VarPin"))))
                  ((symbol-function 'enhanced-dirvish-devices-cached)
                   (lambda (&optional _refresh) (list d1 d2)))
                  ((symbol-function 'enhanced-dirvish-devices-list)
                   (lambda (&optional _refresh) (list d1 d2))))
          (with-current-buffer (get-buffer-create "*Enhanced Dirvish Sidebar*")
            (unless (derived-mode-p 'enhanced-dirvish-sidebar-mode)
              (enhanced-dirvish-sidebar-mode)))
          (enhanced-dirvish-sidebar-render)
          (with-current-buffer "*Enhanced Dirvish Sidebar*"
            (let ((row-ends '()))
              (goto-char (point-min))
              (while (not (eobp))
                (let* ((bol (line-beginning-position))
                       (eol (line-end-position))
                       (loc (or (get-text-property bol 'enhanced-dirvish-sidebar-loc)
                                (get-text-property bol 'enhanced-dirvish-sidebar-device))))
                  (when (and loc (< bol eol))
                    (should (eq (get-text-property bol 'mouse-face) 'highlight))
                    (when (< eol (point-max))
                      (push eol row-ends)
                      (should-not (get-text-property eol 'mouse-face)))))
                (forward-line 1))
              (should (>= (length row-ends) 6))))
          (with-current-buffer (enhanced-dirvish-open-computer-buffer)
            (goto-char (point-min))
            (let ((dev-rows 0))
              (while (not (eobp))
                (let ((eol (line-end-position)))
                  (when (get-text-property (line-beginning-position) 'enhanced-dirvish-device)
                    (cl-incf dev-rows)
                    (should (eq (get-text-property (line-beginning-position) 'mouse-face) 'highlight))
                    (when (< eol (point-max))
                      (should-not (get-text-property eol 'mouse-face)))))
                (forward-line 1))
              (should (= dev-rows 2)))))
      (unless had-sidebar
        (when-let ((b (get-buffer "*Enhanced Dirvish Sidebar*")))
          (kill-buffer b))))))

(ert-deftest enhanced-dirvish-test-parent-column-click-and-valid-main-window ()
  (let* ((tmp (make-temp-file "enhanced-dirvish-parent-" t))
         (child (expand-file-name "child" tmp))
         (other (expand-file-name "other" tmp)))
    (unwind-protect
        (progn
          (make-directory child t)
          (make-directory other t)
          (with-temp-buffer
            (let ((inhibit-read-only t))
              (dirvish-directory-view-mode)
              (insert "  other\n"))
            ;; Simulate stale default-directory while dired-subdir-alist holds parent dir.
            (let ((default-directory (file-name-as-directory child)))
              (setq-local dired-subdir-alist (list (cons (file-name-as-directory tmp)
                                                         (point-min-marker))))
              (goto-char (point-min))
              (search-forward "other")
              (let ((resolved (enhanced-dirvish-mouse--entry-at-point)))
                (should (string= (directory-file-name resolved)
                                 (directory-file-name other))))
              (save-window-excursion
                (set-window-buffer (selected-window) (current-buffer))
                (should-not (enhanced-dirvish-panes--valid-main-window-p (selected-window))))))
          ;; Preview window holding a real buffer must still not be picked as main browser.
          (with-temp-buffer
            (let* ((win (selected-window))
                   (dv (dirvish--new :curr-layout '(1 0.14 0.48))))
              (unwind-protect
                  (progn
                    (setf (dv-preview-window dv) win)
                    (should-not (enhanced-dirvish-panes--valid-main-window-p win)))
                (remhash (dv-id dv) dirvish--sessions)))))
      (delete-directory tmp t))))

