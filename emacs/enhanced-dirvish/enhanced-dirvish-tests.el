(ert-deftest enhanced-dirvish-test-search-fd-flags-and-dir-trailing-slashes ()
  "Subfolder `fd' handles leading dashes and Global Search strips trailing slashes."
  (skip-unless (executable-find "fd"))
  (let* ((tmp (make-temp-file "enhanced-dirvish-fd-" t))
         (sub (expand-file-name "folder-sub" tmp))
         (dashed (expand-file-name "-dash-file.txt" sub))
         picked-loc)
    (unwind-protect
        (save-window-excursion
          (make-directory sub t)
          (write-region "x" nil dashed nil 'silent)
          (let ((dbuf (dired-noselect tmp)))
            (switch-to-buffer dbuf)
            (cl-letf (((symbol-function 'enhanced-dirvish-ui-read-string) (lambda (&rest _) "-dash"))
                      ((symbol-function 'enhanced-dirvish-ui-completing-read) (lambda (_p cands &rest _) (car cands)))
                      ((symbol-function 'enhanced-dirvish-open-location) (lambda (d &rest _) (setq picked-loc d)))
                      ((symbol-function 'enhanced-dirvish-goto-file) #'ignore))
              (enhanced-dirvish-filter-pane t)
              (should (equal (directory-file-name picked-loc) (directory-file-name sub))))
            (kill-buffer dbuf))
          ;; Under HOME, Dired keeps the folder as `~/...', which fd does not
          ;; expand ("fd exited with status 1").
          (let* ((process-environment (cons (concat "HOME=" tmp) process-environment))
                 (abbreviated-home-dir nil)
                 (dbuf (dired-noselect (abbreviate-file-name tmp))))
            (with-current-buffer dbuf
              (should (string-prefix-p "~" default-directory))
              (setq picked-loc nil)
              (cl-letf (((symbol-function 'enhanced-dirvish-ui-read-string) (lambda (&rest _) "-dash"))
                        ((symbol-function 'enhanced-dirvish-ui-completing-read) (lambda (_p cands &rest _) (car cands)))
                        ((symbol-function 'enhanced-dirvish-open-location) (lambda (d &rest _) (setq picked-loc d)))
                        ((symbol-function 'enhanced-dirvish-goto-file) #'ignore))
                (enhanced-dirvish-filter-pane t)
                (should (equal (directory-file-name (expand-file-name picked-loc))
                               (directory-file-name sub)))))
            (kill-buffer dbuf))
          ;; Search result open-folder strips trailing slash on directories
          (with-temp-buffer
            (insert (propertize "   dir  folder-sub\n" 'enhanced-dirvish-search-path (file-name-as-directory sub)))
            (goto-char (point-min))
            (cl-letf (((symbol-function 'enhanced-dirvish-open-location) (lambda (d &rest _) (setq picked-loc d)))
                      ((symbol-function 'enhanced-dirvish-goto-file) #'ignore))
              (enhanced-dirvish-search-open-folder-at-point)
              (should (equal (directory-file-name picked-loc) (directory-file-name tmp))))))
      (ignore-errors (delete-directory tmp t)))))

(ert-deftest enhanced-dirvish-test-custom-actions-order-compress-and-thumbs-scale ()
  "Custom actions preserve arg order; empty compress errors; nil scale resets."
  (let* ((tmp (make-temp-file "enhanced-dirvish-ops-fixes-" t))
         (enhanced-dirvish-config-dir (expand-file-name "cfg" tmp))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-ops-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :icons-thumbnail-size 96))
         (act-dir (expand-file-name "actions/order-act" enhanced-dirvish-config-dir))
         (file-a (expand-file-name "a.txt" tmp))
         (file-b (expand-file-name "b.txt" tmp))
         cmds)
    (unwind-protect
        (progn
          (make-directory act-dir t)
          (write-region "a" nil file-a nil 'silent)
          (write-region "b" nil file-b nil 'silent)
          (write-region
           "name = \"Order Act\"\n[run]\nruntime = \"bash\"\nentrypoint = \"run.sh\"\nmode = \"whole-selection\"\nargs = [\"--flag\", \"{parent}\", \"{path}\", \"{paths}\", \"--end\"]\n"
           nil (expand-file-name "action.toml" act-dir) nil 'silent)
          (cl-letf (((symbol-function 'enhanced-dirvish-run-job) (lambda (_n cmd &optional _cb) (push cmd cmds)))
                    ((symbol-function 'enhanced-dirvish-selected-files) (lambda () (list file-a file-b))))
            (let ((default-directory (file-name-as-directory tmp)))
              (enhanced-dirvish-run-custom-action 1)))
          (should (equal (cdr (cdr (car cmds)))
                         (list "--flag" (file-name-as-directory tmp) file-a file-a file-b "--end")))
          ;; Compress with empty selection signals user-error cleanly
          (cl-letf (((symbol-function 'enhanced-dirvish-selected-files) (lambda () nil)))
            (let ((default-directory (file-name-as-directory tmp)))
              (should-error (enhanced-dirvish-archive-compress) :type 'user-error)))
          ;; Interactive `enhanced-dirvish-thumbnails-scale' with nil resets to 64 without error
          (call-interactively #'enhanced-dirvish-thumbnails-scale)
          (should (= (enhanced-dirvish-prefs-icons-thumbnail-size (enhanced-dirvish-prefs)) 64)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-split-state-sync-and-desktop-parser ()
  "Split-pane state, view-mode pane sync, desktop parsing and mouse routing stay consistent."
  (let* ((tmp (make-temp-file "enhanced-dirvish-split-sync-" t))
         (d1 (expand-file-name "d1" tmp))
         (d2 (expand-file-name "d2" tmp))
         (desktop-dir (expand-file-name "apps" tmp))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-split-st-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :browser-mode 'list :restore-tabs t :sidebar-expanded nil))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-active-tab-index 0))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (make-directory d1 t)
          (make-directory d2 t)
          (make-directory desktop-dir t)
          ;; Dangling :split-p without pane2 cannot claim split active
          (with-temp-file enhanced-dirvish-tabs-state-file
            (prin1 (list :active 0 :tabs (list (list :dir d1 :split-p t))) (current-buffer)))
          (enhanced-dirvish-tabs-load)
          (should-not (enhanced-dirvish-split-active-p))
          ;; Switch view updates active pane buffer
          (enhanced-dirvish-open-location d1)
          (enhanced-dirvish-switch-view-mode 'compact)
          (should (eq (enhanced-dirvish-pane-state-buffer (enhanced-dirvish-active-pane)) (current-buffer)))
          ;; Desktop parser unquotes Exec=, skips NoDisplay=true and ignores Desktop Action
          (let ((good (expand-file-name "good.desktop" desktop-dir))
                (hidden (expand-file-name "hidden.desktop" desktop-dir)))
            (write-region
             "[Desktop Entry]\nType=Application\nName=GoodApp\nExec=\"/bin/sh\" -c %u\n\n[Desktop Action Extra]\nName=Wrong\nExec=/usr/bin/nonexistent\n"
             nil good nil 'silent)
            (write-region
             "[Desktop Entry]\nType=Application\nName=HiddenApp\nExec=/bin/sh\nNoDisplay=true\n"
             nil hidden nil 'silent)
            (should (equal (enhanced-dirvish-desktop--parse-file good) '("GoodApp (good.desktop)" . "/bin/sh")))
            (should-not (enhanced-dirvish-desktop--parse-file hidden)))
          ;; Mouse routing covers modifier selection & context menu guards single-file Rename
          (should (advice-member-p #'enhanced-dirvish-ui--mouse-command 'enhanced-dirvish-mouse-toggle-select))
          (should (advice-member-p #'enhanced-dirvish-ui--mouse-command 'enhanced-dirvish-view-menu))
          (write-region "1" nil (expand-file-name "a.txt" d1) nil 'silent)
          (write-region "2" nil (expand-file-name "b.txt" d1) nil 'silent)
          (enhanced-dirvish-compact-refresh)
          (enhanced-dirvish-select-all)
          (let* ((menu (enhanced-dirvish-context--popup-menu))
                 (rename-item (cl-find-if (lambda (it)
                                            (and (consp it) (eq (cadr it) 'menu-item)
                                                 (equal (nth 2 it) "Rename…")))
                                          (cdr menu))))
            (should rename-item)
            (should-not (eval (plist-get (nthcdr 4 rename-item) :enable)))))
      (dolist (b (buffer-list))
        (when (or (string-prefix-p "*Enhanced Dirvish" (buffer-name b))
                  (eq (buffer-local-value 'major-mode b) 'dired-mode))
          (kill-buffer b)))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-compact-columns-align-long-and-wide-names ()
  "Compact columns align with full long names, wide text and mixed icon widths."
  (enhanced-dirvish-test--with-selection-view 'compact
    (dolist (name (list "00-short.txt"
                        (concat "01-" (make-string 140 ?a) ".txt")
                        (concat "02-" (make-string 24 ?界) ".txt")
                        (concat "03-" (make-string 30 ?é) ".txt")))
      (write-region "fixture" nil (expand-file-name name enhanced-dirvish-test--dir) nil 'silent))
    (let ((focus (nth 1 enhanced-dirvish-test--files))
          (marked (car enhanced-dirvish-test--files)))
      (enhanced-dirvish-view--set-entry-mark marked t)
      (enhanced-dirvish-goto-file focus)
      (cl-letf (((symbol-function 'window-body-height) (lambda (&rest _) 8))
                ((symbol-function 'enhanced-dirvish-file--glyph)
                 (lambda (path &optional _)
                   (if (string-prefix-p "02-" (file-name-nondirectory path)) "界" "▤"))))
        (dolist (full '(nil t))
          (setf (enhanced-dirvish-prefs-compact-full-names enhanced-dirvish-prefs-current) full)
          (enhanced-dirvish-compact-refresh)
          (when full (should (> enhanced-dirvish-compact-col-width 140)))
          (should (equal (enhanced-dirvish-current-file) focus))
          (should (equal (enhanced-dirvish-marked-files-only) (list marked)))
          (save-excursion
            (goto-char (point-min))
            (let ((row 0) (column 0) match)
              (while (setq match (text-property-search-forward 'enhanced-dirvish-entry nil
                                                               (lambda (_ path) path)))
                (let* ((start (prop-match-beginning match))
                       (end (prop-match-end match))
                       (line (line-number-at-pos start)))
                  (unless (= line row) (setq row line column 0))
                  (save-excursion
                    (goto-char start)
                    (should (= (current-column) (* column enhanced-dirvish-compact-col-width))))
                  (when full
                    (let* ((label (next-single-property-change start 'enhanced-dirvish-entry-label nil end))
                           (text (buffer-substring-no-properties label end)))
                      (should (equal text (file-name-nondirectory (prop-match-value match))))))
                  (cl-incf column)))))
          ;; Wider cells retain the existing column navigation order.
          (let ((files (enhanced-dirvish-view--entry-order)))
            (enhanced-dirvish-goto-file (car files))
            (enhanced-dirvish-compact-next-col)
            (should (equal (enhanced-dirvish-current-file) (nth enhanced-dirvish-compact-rows files)))
            (enhanced-dirvish-compact-prev-col)
            (should (equal (enhanced-dirvish-current-file) (car files)))
            (enhanced-dirvish-goto-file focus)))))))

(ert-deftest enhanced-dirvish-test-compact-empty-click-keeps-viewport ()
  "Blank clicks deselect a full Compact listing without hiding its early rows."
  (enhanced-dirvish-test--with-selection-view 'compact
    (dotimes (i 80)
      (make-directory (expand-file-name (format "folder-%02d" i) enhanced-dirvish-test--dir)))
    (enhanced-dirvish-compact-refresh)
    (let ((entries (enhanced-dirvish-view--entry-order))
          (win (selected-window)))
      (dolist (kind '(mouse-1 native mouse-3))
        (enhanced-dirvish-goto-file (nth (+ enhanced-dirvish-compact-rows 4) entries))
        (enhanced-dirvish-view-toggle-mark)
        (set-window-start win (save-excursion (goto-char (point-min)) (forward-line 2) (point)) t)
        (set-window-hscroll win 3)
        (redisplay t)
        (let* ((start (window-start win))
               (hscroll (window-hscroll win))
               (posn (list win (point-max) '(800 . 200) 0)))
          (pcase kind
            ('native (enhanced-dirvish-test--play-events (list 'down-mouse-1 posn 1)
                                              (list 'mouse-1 posn 1)))
            ('mouse-3
             (cl-letf (((symbol-function 'display-popup-menus-p) (lambda (&rest _) t))
                       ((symbol-function 'popup-menu) #'ignore))
               (enhanced-dirvish-mouse-context-menu (list kind posn 1))))
            (_ (enhanced-dirvish-mouse-click-entry (list kind posn 1))))
          (let ((this-command 'enhanced-dirvish-mouse-click-entry)) (run-hooks 'post-command-hook))
          (redisplay t)
          (should (= (window-start win) start))
          (should (= (window-hscroll win) hscroll))
          (should (equal entries (enhanced-dirvish-view--entry-order)))
          (should-not (enhanced-dirvish-current-file))
          (should-not (enhanced-dirvish-marked-files-only))
          (should-not enhanced-dirvish--selection-overlays)
          ;; Every directory still has a rendered cell, including the first.
          (dolist (file entries)
            (should (save-excursion
                      (goto-char (point-min))
                      (text-property-search-forward 'enhanced-dirvish-entry file t))))
          (enhanced-dirvish-compact-next-item)
          (should (enhanced-dirvish-current-file))
          (should-not enhanced-dirvish--empty-click-p))))))

(ert-deftest enhanced-dirvish-test-delete-keeps-adjacent-file-in-all-views ()
  "Trash and permanent delete focus one surviving neighbour in listing order."
  (dolist (view '(columns list compact icons))
    (dolist (command '(enhanced-dirvish-move-to-trash enhanced-dirvish-delete-permanently))
      (dolist (spec '(((2) 3 2) ((0) 1 0) ((5) 4 5) ((1 2 3) 4 2)
                      ((1 4) 2 1) ((0 1 2 3 4 5) nil 2)))
        (ert-info ((format "%S / %S / %S" view command spec))
          (enhanced-dirvish-test--with-selection-view view
            (let* ((removed (mapcar (lambda (i) (nth i enhanced-dirvish-test--files)) (car spec)))
                   (expected (and (nth 1 spec) (nth (nth 1 spec) enhanced-dirvish-test--files)))
                   (trash (expand-file-name "trash" enhanced-dirvish-test--root))
                   (enhanced-dirvish-undo-stack nil) (enhanced-dirvish-redo-stack nil))
              (make-directory trash)
              (when (cdr removed)
                (dolist (file removed) (enhanced-dirvish-view--set-entry-mark file t t))
                (enhanced-dirvish-view--refresh-after-mark))
              (enhanced-dirvish-goto-file (nth (nth 2 spec) enhanced-dirvish-test--files))
              (cl-letf (((symbol-function 'enhanced-dirvish-ui-yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'enhanced-dirvish--trash-with-gio-fallback)
                         (lambda (file)
                           (let ((target (expand-file-name (file-name-nondirectory file) trash)))
                             (rename-file file target)
                             target))))
                (let ((this-command command))
                  (call-interactively command)
                  (run-hooks 'post-command-hook)))
              (dolist (file removed) (should-not (file-exists-p file)))
              (should (equal (enhanced-dirvish-current-file) expected))
              (should-not (enhanced-dirvish-marked-files-only))
              (should-not enhanced-dirvish--selection-range-active)
              (if expected
                  (progn
                    (should (= (length enhanced-dirvish--selection-overlays) 1))
                    (let ((overlay (car enhanced-dirvish--selection-overlays)))
                      (should (equal (buffer-substring-no-properties
                                      (overlay-start overlay) (overlay-end overlay))
                                     (file-name-nondirectory expected)))))
                (should-not enhanced-dirvish--selection-overlays)))))))))

