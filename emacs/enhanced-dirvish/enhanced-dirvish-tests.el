                  (uuid . "ABCD-1234") (size . 2199023255552)
                  (fssize . 2198486384640) (fsavail . 2198480420864))
                 ((name . "sda2") (kname . "sda2") (pkname . "sda") (type . "part")
                  (fstype . "ext4")
                  (mountpoint . "/run/media/user/11111111-2222-3333-4444-555555555555")
                  (uuid . "11111111-2222-3333-4444-555555555555") (size . 1801761849344)
                  (fssize . 1772344094720) (fsavail . 1569177272320))
                 ((name . "sda3") (kname . "sda3") (pkname . "sda") (type . "part")
                  (fstype . "ext4") (mountpoint . "/run/media/user/MediaDrive")
                  (uuid . "11111111-2222-3333-4444-555555555555") (size . 500000000000))))))))
    (cl-letf (((symbol-function 'enhanced-dirvish-devices--custom-label)
               (lambda (_id default-name) default-name))
              ((symbol-function 'enhanced-dirvish-parse-proc-mounts)
               (lambda ()
                 (list (list :device "gvfsd-fuse"
                             :mount (format "/run/user/%d/gvfs" (user-uid))
                             :fstype "fuse.gvfsd-fuse")
                       (list :device "ext4"
                             :mount "/run/media/user/99999999-aaaa-bbbb-cccc-dddddddddddd"
