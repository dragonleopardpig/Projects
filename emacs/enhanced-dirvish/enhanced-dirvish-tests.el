(defvar dashboard-navigator-buttons)

(defmacro enhanced-dirvish-test--with-file-manager-keys (on &rest body)
  "Run BODY with `enhanced-dirvish-file-manager-keys' ON and applied."
  (declare (indent 1) (debug t))
  `(let ((enhanced-dirvish-file-manager-keys ,on))
     (enhanced-dirvish-apply-file-manager-keys)
     (unwind-protect (progn ,@body)
       (let ((enhanced-dirvish-file-manager-keys
              (default-toplevel-value 'enhanced-dirvish-file-manager-keys)))
         (enhanced-dirvish-apply-file-manager-keys)))))

(ert-deftest enhanced-dirvish-test-toml-parsing-and-prefs ()
  (let ((tmp (make-temp-file "enhanced-dirvish-toml-")))
    (unwind-protect
        (progn
          (with-temp-file tmp
            (insert "browser_mode = \"compact\"\ncompact_full_names = true\nicons_thumbnail_size = 96\n"
                    "[folder_colors]\n\"/tmp/work\" = \"blue\"\n"))
          (let* ((parsed (enhanced-dirvish-toml-parse-file tmp))
                 (root (cdr (assoc "" parsed)))
                 (cols (cdr (assoc "folder_colors" parsed))))
            (should (equal (cdr (assoc "browser_mode" root)) "compact"))
            (should (eq (cdr (assoc "compact_full_names" root)) t))
            (should (equal (cdr (assoc "icons_thumbnail_size" root)) 96))
            (should (equal (cdr (assoc "/tmp/work" cols)) "blue"))))
      (delete-file tmp))))

(ert-deftest enhanced-dirvish-test-synthetic-fuse-capacity-filter ()
  ;; Valid local NVMe capacity passes cleanly
  (should (equal (enhanced-dirvish-sanitize-capacity 1000000000000 500000000000)
                 '(1000000000000 . 500000000000)))
  ;; Synthetic 1 PiB (2^50) FUSE/rclone placeholder must be rejected as nil
  (should-not (enhanced-dirvish-sanitize-capacity (expt 2 50) (expt 2 50)))
  ;; 18.4 EB bogus value must be rejected
  (should-not (enhanced-dirvish-sanitize-capacity (* 18 (expt 1024 6)) 1000))
  ;; Zero capacity rejected
  (should-not (enhanced-dirvish-sanitize-capacity 0 0)))

(ert-deftest enhanced-dirvish-test-accurate-drive-free-size ()
  ;; Free space stays in GB even when TB or GB rounding hides tiny usage.
  (should-not (string= (enhanced-dirvish-format-drive-free-size 5489790935040 5497558138880 'metric)
                       (enhanced-dirvish-format-bytes 5497558138880 'metric)))
  (dolist (case '((999000000 2000000000 "999 MB")
                  (1000000000 2000000000 "1 GB")
                  (1500000000 2000000000 "1.5 GB")
                  (1000000000 1000000001 "1 GB")
                  (1999900000 2000000000 "1.999 GB")
                  (1000000000000 1000000000000 "1000 GB")
                  (2198480420864 2198486384640 "2198.48 GB")
                  (5489790935040 5497558138880 "5489.8 GB")))
    (pcase-let ((`(,free ,total ,expected) case))
      (should (equal (enhanced-dirvish-format-drive-free-size free total 'metric) expected))))
  (let ((gib (expt 1024 3)))
    (should (equal (enhanced-dirvish-format-drive-free-size (* 1023 (expt 1024 2)) (* 2 gib) 'binary)
                   "1023 MiB"))
    (should (equal (enhanced-dirvish-format-drive-free-size gib (* 2 gib) 'binary) "1 GiB"))
    (should (equal (enhanced-dirvish-format-drive-free-size (* 1.5 gib) (* 2 gib) 'binary) "1.5 GiB"))
    (should (equal (enhanced-dirvish-format-drive-free-size (* 1024 gib) (* 1024 gib) 'binary)
                   "1024 GiB"))))

(ert-deftest enhanced-dirvish-test-capacity-bars-use-gigabytes-for-free-space ()
  "Both sidebar and detailed drive capacity bars use the GB free-space format."
  (let ((enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :unit-system 'metric))
        (usage '(2198486384640 . 2198480420864)))
    (should (string-suffix-p "2198.48 GB" (enhanced-dirvish-format-capacity-bar usage 10 t)))
    (should (string-match-p "2198\\.48 GB free of 2\\.2 TB"
                            (enhanced-dirvish-format-capacity-bar usage 18 nil)))))

(ert-deftest enhanced-dirvish-test-custom-device-icons-and-virtual-guards ()
  (let ((gd (make-enhanced-dirvish-device :name "Google Drive" :mountpoint "/home/u/Google Drive" :placement 'cloud))
        (pd (make-enhanced-dirvish-device :name "Proton Drive" :mountpoint "/home/u/Proton Drive" :placement 'cloud))
        (sc (make-enhanced-dirvish-device :name "Crypt" :mountpoint "/home/u/Crypt" :fstype "fuse.rclone"
                                         :placement 'cloud))
        (rt (make-enhanced-dirvish-device :name "File System" :mountpoint "/" :placement 'fixed)))
    (should (string= (enhanced-dirvish-device-icon gd) "▲"))
    (should (string= (enhanced-dirvish-device-icon pd) "◆"))
    (should (string= (enhanced-dirvish-device-icon sc) "☁"))
    (should (member (enhanced-dirvish-device-icon rt) '("❄" "🐧"))))
  (should (enhanced-dirvish-computer-location-p "computer:///"))
  (should (enhanced-dirvish-location-virtual-p "trash:///"))
  (should-error (enhanced-dirvish-guard-writable-location "computer:///" "Paste") :type 'user-error))

(ert-deftest enhanced-dirvish-test-natural-sort-and-folder-lru ()
  (should (< (enhanced-dirvish-natural-compare "file2.txt" "file10.txt") 0))
  (should (> (enhanced-dirvish-natural-compare "v10" "v2") 0))
  (let* ((tmp (make-temp-file "enhanced-dirvish-sort-" t))
         (d1 (expand-file-name "alpha_dir" tmp))
         (f1 (expand-file-name "item2.txt" tmp))
         (f2 (expand-file-name "item10.txt" tmp)))
    (unwind-protect
        (progn
          (make-directory d1)
          (write-region "a" nil f1)
          (write-region "b" nil f2)
          (let* ((p (enhanced-dirvish-prefs--create :sort-key 'name :folders-first t :natural-sort t :show-hidden nil))
                 (res (enhanced-dirvish-list-directory-entries tmp p)))
            (should (equal (mapcar (lambda (e) (plist-get e :name)) res)
                           '("alpha_dir" "item2.txt" "item10.txt")))))
      (delete-directory tmp t))))

(defun enhanced-dirvish-test--visible-menu-labels (menu)
  "Labels of the items of MENU that are shown."
  (let (labels)
    (dolist (item (cdr menu))
      (when (and (consp item) (eq (cadr item) 'menu-item))
        (let ((visible (plist-member (nthcdr 4 item) :visible)))
          (when (or (null visible) (eval (cadr visible) t))
            (push (nth 2 item) labels)))))
    (nreverse labels)))

(ert-deftest enhanced-dirvish-test-sidebar-right-click-pins-and-unpins ()
  "Right-click on a sidebar row offers Pin or Unpin; `p' toggles the same."
  (let* ((tmp (make-temp-file "enhanced-dirvish-pin-" t))
         (folder (expand-file-name "My Folder" tmp))
         (enhanced-dirvish-gtk-bookmarks-file (expand-file-name "bookmarks" tmp)))
    (unwind-protect
        (progn
          (make-directory folder)
          (with-temp-buffer
            (insert (propertize "  folder\n" 'enhanced-dirvish-sidebar-loc folder))
            (insert (propertize "  computer\n" 'enhanced-dirvish-sidebar-loc "computer:///"))
            (let ((row 3)
                  (virtual-row (+ 3 (length "  folder\n")))
                  (labels (lambda (pos) (enhanced-dirvish-test--visible-menu-labels
                                         (enhanced-dirvish-sidebar--context-menu pos)))))
              (should (member "Pin to Sidebar" (funcall labels row)))
              (should-not (member "Unpin from Sidebar" (funcall labels row)))
              (goto-char row)
              (enhanced-dirvish-sidebar-toggle-pin-at-point)
              (should (enhanced-dirvish-pinned-p folder))
              (should (member "Unpin from Sidebar" (funcall labels row)))
              (should-not (member "Pin to Sidebar" (funcall labels row)))
              (enhanced-dirvish-sidebar-toggle-pin-at-point)
              (should-not (enhanced-dirvish-pinned-p folder))
              ;; computer:/// and the like are never offered
              (should-not (member "Pin to Sidebar" (funcall labels virtual-row)))
              (should-not (member "Unpin from Sidebar" (funcall labels virtual-row)))
              (should (member "Open" (funcall labels virtual-row))))))
      (delete-directory tmp t))))

(ert-deftest enhanced-dirvish-test-slow-mount-listing-matches-local ()
  "A folder on a cloud/network mount lists the same through `find' as in-process."
  (let* ((tmp (make-temp-file "enhanced-dirvish-slow-" t))
         (p (enhanced-dirvish-prefs--create :sort-key 'name :folders-first t :natural-sort t :show-hidden t)))
    (unwind-protect
        (progn
          (make-directory (expand-file-name "sub dir" tmp))
          (write-region "hello" nil (expand-file-name "a file.txt" tmp))
          (write-region "x" nil (expand-file-name ".hidden" tmp))
          (write-region "line\n" nil (expand-file-name "new\nline.md" tmp))
          (let* ((local (enhanced-dirvish-list-directory-entries tmp p))
                 (slow (cl-letf (((symbol-function 'enhanced-dirvish-path-unsafe-probe-p) #'always))
                         (enhanced-dirvish-list-directory-entries tmp p)))
                 (key (lambda (e) (list (plist-get e :name) (plist-get e :dir-p)
                                        (plist-get e :size) (plist-get e :group)))))
            (should (= (length local) 4))
            (should (equal (mapcar key slow) (mapcar key local)))
            (cl-mapc (lambda (a b)
                       (should (< (abs (float-time (time-subtract (plist-get a :mtime) (plist-get b :mtime)))) 1)))
                     slow local)))
      (delete-directory tmp t))))

(ert-deftest enhanced-dirvish-test-slow-mount-listing-times-out ()
  "A mount that never answers costs the timeout, not a frozen Emacs."
  (let* ((tmp (make-temp-file "enhanced-dirvish-hang-" t))
         (bin (make-temp-file "enhanced-dirvish-bin-" t))
         (fake (expand-file-name "find" bin))
         (exec-path (cons bin exec-path))
         (enhanced-dirvish-slow-mount-list-timeout 1)
         (p (enhanced-dirvish-prefs--create :sort-key 'name)))
    (unwind-protect
        (progn
          (write-region "x" nil (expand-file-name "f.txt" tmp))
          (write-region "#!/bin/sh\nexec sleep 30\n" nil fake)
          (set-file-modes fake #o755)
          (let* ((start (float-time))
                 (res (cl-letf (((symbol-function 'enhanced-dirvish-path-unsafe-probe-p) #'always))
                        (enhanced-dirvish-list-directory-entries tmp p))))
            (should (null res))
            (should (< (- (float-time) start) 5))))
      (delete-directory tmp t)
      (delete-directory bin t))))

(ert-deftest enhanced-dirvish-test-independent-preview-zoom ()
  (let* ((enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-zoom-state-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create))
         (enhanced-dirvish-active-preview-kind 'text)
         (enhanced-dirvish-active-preview-file nil))
    (unwind-protect
        (progn
          (enhanced-dirvish-preview-zoom-in)
          (should (= (enhanced-dirvish-prefs-preview-text-scale enhanced-dirvish-prefs-current) 1))
          (should (= (enhanced-dirvish-prefs-preview-image-scale enhanced-dirvish-prefs-current) 1.0))
          (should (= (enhanced-dirvish-prefs-preview-pdf-scale enhanced-dirvish-prefs-current) 1.0))
          (setq enhanced-dirvish-active-preview-kind 'image)
          (enhanced-dirvish-preview-zoom-in)
          (should (> (enhanced-dirvish-prefs-preview-image-scale enhanced-dirvish-prefs-current) 1.1))
          (should (= (enhanced-dirvish-prefs-preview-pdf-scale enhanced-dirvish-prefs-current) 1.0))
          (enhanced-dirvish-preview-zoom-reset)
          (should (= (enhanced-dirvish-prefs-preview-image-scale enhanced-dirvish-prefs-current) 1.0))
          (should (= (enhanced-dirvish-prefs-preview-text-scale enhanced-dirvish-prefs-current) 1)))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-preview-native-zoom-only-persists-preview-changes ()
  "Native text zoom saves read/edit previews without affecting ordinary buffers."
  (let* ((enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-native-zoom-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create))
         (enhanced-dirvish-active-preview-kind 'text))
    (unwind-protect
        (with-temp-buffer
          (text-scale-set 1)
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 0))
          (enhanced-dirvish-preview-read-mode 1)
          (text-scale-set 2)
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 2))
          ;; Rendering may reset a buffer before restoring the saved scale.
          (let ((enhanced-dirvish-preview--applying-text-zoom t)) (text-scale-set 0))
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 2))
          (enhanced-dirvish-preview--set-text-scale)
          (should (= text-scale-mode-amount 2))
          (enhanced-dirvish-preview-read-mode -1)
          (text-scale-set 3)
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 2))
          (enhanced-dirvish-preview-edit-mode 1)
          (text-scale-set 4)
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 4))
          (should-not (lookup-key enhanced-dirvish-preview-edit-mode-map (kbd "+")))
          (enhanced-dirvish-preview-edit-mode -1)
          (setq enhanced-dirvish-active-preview-kind 'image)
          (enhanced-dirvish-preview-read-mode 1)
          (text-scale-set 5)
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs)) 4))
          (should (= (enhanced-dirvish-prefs-preview-image-scale (enhanced-dirvish-prefs)) 1.0))
          (should (= (enhanced-dirvish-prefs-preview-pdf-scale (enhanced-dirvish-prefs)) 1.0))
          (enhanced-dirvish-preview-read-mode -1)
          (should (= (enhanced-dirvish-prefs-preview-text-scale (enhanced-dirvish-prefs-load)) 4)))
      (delete-directory enhanced-dirvish-state-dir t))))

(ert-deftest enhanced-dirvish-test-compact-and-icons-render-and-filter ()
  (let ((tmp (make-temp-file "enhanced-dirvish-views-" t)))
    (unwind-protect
        (progn
          (write-region "x" nil (expand-file-name "alpha-note.md" tmp))
          (write-region "y" nil (expand-file-name "beta-file.txt" tmp))
          (with-temp-buffer
            (enhanced-dirvish-compact-mode)
            (enhanced-dirvish-compact-render tmp)
            (should (string-search "alpha-note.md" (buffer-string)))
            (should (string-search "beta-file.txt" (buffer-string)))
            (setq-local enhanced-dirvish-local-filter "alpha")
            (enhanced-dirvish-compact-refresh)
            (should (string-search "alpha-note.md" (buffer-string)))
            (should-not (string-search "beta-file.txt" (buffer-string))))
          (with-temp-buffer
            (enhanced-dirvish-icons-mode)
            (enhanced-dirvish-icons-render tmp)
            (should (string-search "alpha-note" (buffer-string)))))
      (delete-directory tmp t))))

(ert-deftest enhanced-dirvish-test-copy-keep-both-rename-and-undo-redo ()
  (let* ((tmp (make-temp-file "enhanced-dirvish-ops-" t))
         (src (expand-file-name "doc.txt" tmp))
         (enhanced-dirvish-undo-stack nil)
         (enhanced-dirvish-redo-stack nil)
         (enhanced-dirvish-clipboard nil))
    (unwind-protect
        (progn
          (write-region "hello" nil src)
          ;; Keep both creates doc (copy).txt
          (let ((default-directory (file-name-as-directory tmp)))
            (enhanced-dirvish--transfer-files (list src) tmp 'copy t nil)
            (let ((cp (expand-file-name "doc (copy).txt" tmp)))
              (should (file-exists-p cp))
              (should (= (length enhanced-dirvish-undo-stack) 1))
              ;; Undo deletes the copy
              (enhanced-dirvish-undo)
              (should-not (file-exists-p cp))
              ;; Redo recreates the copy
              (enhanced-dirvish-redo)
              (should (file-exists-p cp)))))
      (delete-directory tmp t))))

(ert-deftest enhanced-dirvish-test-custom-actions-toml-loader ()
  (let* ((cfg (make-temp-file "enhanced-dirvish-act-cfg-" t))
         (act-dir (expand-file-name "actions/sample" cfg))
         (enhanced-dirvish-config-dir cfg))
    (unwind-protect
        (progn
          (make-directory act-dir t)
          (with-temp-file (expand-file-name "action.toml" act-dir)
            (insert "schema_version = 1\nid = \"sample\"\nname = \"Sample Act\"\n"
                    "enabled = true\n[when]\nkinds = [\"file\"]\nextensions = [\"txt\"]\n"
                    "[run]\nruntime = \"bash\"\nentrypoint = \"run.sh\"\n"))
          (let* ((acts (enhanced-dirvish-actions-load))
                 (act (car acts))
                 (f-txt (make-temp-file "t" nil ".txt"))
                 (f-md (make-temp-file "m" nil ".md")))
            (unwind-protect
                (progn
                  (should (= (length acts) 1))
                  (should (equal (plist-get act :name) "Sample Act"))
                  (should (enhanced-dirvish-action-matches-p act (list f-txt)))
                  (should-not (enhanced-dirvish-action-matches-p act (list f-md))))
              (delete-file f-txt)
              (delete-file f-md))))
      (delete-directory cfg t))))

(ert-deftest enhanced-dirvish-test-dual-keymap-and-terminal-guard ()
  (let ((enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :tenxer-mode nil)))
    (with-temp-buffer
      (enhanced-dirvish-mode 1)
      ;; In Default mode, C-k -> global search and y is NOT copy
      (should (eq (key-binding (kbd "C-k")) #'enhanced-dirvish-global-search))
      (should-not (eq (key-binding (kbd "y")) #'enhanced-dirvish-copy-selection))
      ;; Switching to 10xer mode enables Vi/Yazi keys + chords cleanly
      (setf (enhanced-dirvish-prefs-tenxer-mode enhanced-dirvish-prefs-current) t)
      (enhanced-dirvish--apply-active-keymap)
      (should (eq (key-binding (kbd "y")) #'enhanced-dirvish-copy-selection))
      (should (eq (key-binding (kbd ";")) #'enhanced-dirvish-chord-actions))
      (should (eq (key-binding (kbd "g")) #'enhanced-dirvish-chord-go))
      ;; Verify global C-c d prefix is NOT clobbered inside browser buffer
      (let ((global-map-save (current-global-map)))
        (unwind-protect
            (progn
              (use-global-map (let ((m (make-sparse-keymap)))
                                (define-key m (kbd "C-c d") #'enhanced-dirvish-launch)
                                m))
              (should (eq (key-binding (kbd "C-c d")) #'enhanced-dirvish-launch)))
          (use-global-map global-map-save))))))

(ert-deftest enhanced-dirvish-test-dirvish-attributes-and-view-switching ()
  (let* ((tmp (make-temp-file "enhanced-dirvish-dv-" t))
         (enhanced-dirvish-state-dir (make-temp-file "enhanced-dirvish-t-state-" t))
         (enhanced-dirvish-state-file (expand-file-name "prefs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-tabs-state-file (expand-file-name "tabs.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-history-file (expand-file-name "history.eld" enhanced-dirvish-state-dir))
         (enhanced-dirvish-workspace-tabs nil)
         (enhanced-dirvish-closed-tabs nil)
         (enhanced-dirvish-active-tab-index 0)
         (enhanced-dirvish-visited-folders nil)
         (enhanced-dirvish-folder-view-lru nil)
         (enhanced-dirvish-prefs-current (enhanced-dirvish-prefs--create :browser-mode 'columns :sidebar-expanded nil))
         (override-before (advice-member-p #'dirvish-dired-noselect-a 'dired-noselect)))
    (unwind-protect
        (progn
          (write-region "hello" nil (expand-file-name "note.txt" tmp))
          (make-directory (expand-file-name "sub" tmp))
          (dirvish-override-dired-mode 1)
          (enhanced-dirvish-setup)
          ;; Must expand all custom Dirvish attributes without void-variable errors
          (should (listp (dirvish--attrs-expand dirvish-attributes)))
          (enhanced-dirvish-open-location tmp)
          (enhanced-dirvish-goto-file (expand-file-name "note.txt" tmp))
          ;; Exercise every source/destination pair using the actual menu
          ;; actions, including returning to reused Dired buffers.
          (dolist (source '(columns list compact icons))
            (dolist (choice '((columns "Columns") (icons "Icons")
                              (list "List / Tree") (compact "Compact")))
              (enhanced-dirvish-switch-view-mode source)
              (let ((mode (car choice)))
                (call-interactively
                 (enhanced-dirvish-test--popup-menu-command (enhanced-dirvish-view--menu) (cadr choice)))
                (should (eq (enhanced-dirvish-prefs-browser-mode (enhanced-dirvish-prefs)) mode))
                (should (eq enhanced-dirvish-local-view-mode mode))
                (should (equal (enhanced-dirvish-current-file) (expand-file-name "note.txt" tmp)))
                (pcase mode
                  ('columns (should (derived-mode-p 'dired-mode))
                            (should (dv-curr-layout (dirvish-curr))))
                  ('list (should (derived-mode-p 'dired-mode))
                         (should-not (dv-curr-layout (dirvish-curr))))
                  ('icons (should (derived-mode-p 'enhanced-dirvish-icons-mode)))
                  ('compact (should (derived-mode-p 'enhanced-dirvish-compact-mode))))
                (should (string-match-p
                         (pcase mode ('list "View… Tree")
                                (_ (concat "View… " (capitalize (symbol-name mode)))))
                         (dirvish-enhanced-dirvish-view-info-ml))))))
          ;; Full Columns sessions have a post-command hook that ordinarily
          ;; clamps EOB onto the last file.  Empty clicks must survive it.
          (enhanced-dirvish-switch-view-mode 'columns)
          (enhanced-dirvish-select-all)
          (let ((this-command 'enhanced-dirvish-mouse-click-entry))
            (enhanced-dirvish-mouse-click-entry
             (list 'mouse-1 (list (selected-window) (point-max) '(10 . 300) 0) 1))
            (run-hooks 'post-command-hook))
          (should-not (enhanced-dirvish-current-file))
          (should-not (enhanced-dirvish-marked-files-only))
          (should-not enhanced-dirvish--selection-overlays)
          ;; Keyboard navigation can focus a file again after deselection.
          (let ((this-command 'enhanced-dirvish-nav-prev-line))
            (enhanced-dirvish-nav-prev-line)
            (run-hooks 'post-command-hook))
          (should (enhanced-dirvish-current-file))
          (should-not enhanced-dirvish--empty-click-p))
      (ignore-errors (when (dirvish-curr) (dirvish-quit)))
      (dirvish-override-dired-mode (if override-before 1 -1))
      (ignore-errors (delete-directory tmp t))
      (ignore-errors (delete-directory enhanced-dirvish-state-dir t)))))

(ert-deftest enhanced-dirvish-test-split-pane-promotion-and-tab-reopen ()
  (let* ((tmp (make-temp-file "enhanced-dirvish-split-" t))
         (sub (expand-file-name "inner" tmp))
