# Ignore every top-level directory except those allow-listed below.
# Other dirs are either third-party clones with their own .git or
# scratch workspaces that will get their own repo later.
/*/
!/NixOS/
!/emacs/
!/org/

# Within org/, ignore generated assets / large data dumps.
/org/data/
/org/ltximg/

# Generated / cache files (anywhere in the tree)
.aider*
**/.devenv.flake.nix
**/.devenv/
**/.direnv/
**/.cache/
**/target/
**/__pycache__/
*.pyc

# Tool runtime state at top level (do not commit)
/.codex
/codex_resume.txt
/auth.json
/installation_id
/.personality_migration
/version.json
/history.jsonl
/config.toml
/models_cache.json
/logs_*.sqlite*
/state_*.sqlite*

# Lock files (top-level scratch devenv — intentionally untracked)
/devenv.lock
/flake.lock
